{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "jingyue-private-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-09",
  "vars": {
    "ALLOWED_ORIGIN": "https://blog.j1ngyue.cn",
    "REMINDER_FROM": "reminder@j1ngyue.cn"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jingyue-private-hub",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["0 12 * * *"] },
  "secrets": {
    "required": ["ADMIN_PASSWORD", "DEEPSEEK_API_KEY", "REMINDER_TO"]
  }
}
