# Optional: used only during the static build to load the GitHub contribution calendar.
GITHUB_TOKEN=

# 可选：自建 NeteaseCloudMusicApi 兼容服务，用于播放器扫码登录并读取个人歌单。
# 示例：https://music-api.example.com（不要在这里填写网易云账号、密码或 Cookie）
PUBLIC_NETEASE_API_BASE_URL=

# 留言板使用的自建 Waline 服务地址，例如 https://waline.example.com
PUBLIC_WALINE_SERVER_URL=

# 留言板社交登录入口。仅填写公开的 OAuth 启动地址，不要填写 client secret。
# QQ、微信和 Google 需要自建 OAuth 适配服务；登录完成后返回留言板并携带 ?token=<Waline token>。
# GitHub 未填写时会使用 Waline 自带的登录中心。
PUBLIC_WALINE_OAUTH_QQ_URL=
PUBLIC_WALINE_OAUTH_WECHAT_URL=
PUBLIC_WALINE_OAUTH_GOOGLE_URL=
PUBLIC_WALINE_OAUTH_GITHUB_URL=
