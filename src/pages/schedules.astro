---
import PrivateAccess from "@/components/pages/personal/PrivateAccess.svelte";
import ScheduleDashboard from "@/components/pages/personal/ScheduleDashboard.astro";
import RecordPageShell from "@/components/pages/record/RecordPageShell.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout
	title="日历"
	bannerTitle="我的"
	description="日程、生日与纪念日"
	articleHub
	contentOnly
	plainContent
>
	<Fragment slot="head"><meta name="robots" content="noindex,nofollow" /></Fragment>
	<RecordPageShell
		title="日历"
		description="用日历管理日程、生日与纪念日，重要时刻一目了然。"
		icon="material-symbols:calendar-month-outline-rounded"
		defaultSidebarsCollapsed
	>
		<div class="personal-dashboard-content">
			<PrivateAccess client:load mode="events" apiBase={import.meta.env.PUBLIC_PRIVATE_API_URL || "https://private.j1ngyue.cn"} />
			<div data-private-content hidden>
				<ScheduleDashboard />
			</div>
		</div>
	</RecordPageShell>
</MainGridLayout>

<style>
	.personal-dashboard-content { width: 100%; max-width: 80rem; margin-inline: auto; }
</style>
