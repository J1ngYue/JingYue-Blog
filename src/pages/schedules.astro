---
import PrivateHub from "@/components/pages/personal/PrivateHub.svelte";
import RecordPageShell from "@/components/pages/record/RecordPageShell.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout
	title="日历"
	bannerTitle="我的"
	description="日程、生日与纪念日"
	articleHub
	contentOnly
	plainContent
>
	<Fragment slot="head"><meta name="robots" content="noindex,nofollow" /></Fragment>
	<RecordPageShell
		title="日历"
		description="用日历管理日程、生日与纪念日，重要时刻一目了然。"
		icon="material-symbols:calendar-month-outline-rounded"
	>
		<PrivateHub client:load mode="events" apiBase={import.meta.env.PUBLIC_PRIVATE_API_URL ?? ""} />
	</RecordPageShell>
</MainGridLayout>
