---
import BillingDashboard from "@/components/pages/personal/BillingDashboard.astro";
import PrivateAccess from "@/components/pages/personal/PrivateAccess.svelte";
import RecordPageShell from "@/components/pages/record/RecordPageShell.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout
	title="账单"
	bannerTitle="我的"
	description="收支记录与月度回望"
	articleHub
	contentOnly
	plainContent
>
	<Fragment slot="head"><meta name="robots" content="noindex,nofollow" /></Fragment>
	<RecordPageShell
		title="账单"
		description="收支记录与月度回望。"
		icon="material-symbols:account-balance-wallet-outline"
		showHeader={false}
	>
		<PrivateAccess client:load mode="bills" apiBase={import.meta.env.PUBLIC_PRIVATE_API_URL ?? ""} />
		<div data-private-content hidden>
			<BillingDashboard />
		</div>
	</RecordPageShell>
</MainGridLayout>
