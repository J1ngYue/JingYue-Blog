---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@/components/common/Markdown.astro";
import ArticleReadingRails from "@/components/features/ArticleReadingRails.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import { getNotebookDefinition } from "@/config/notebookConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/article-reading.css";

export async function getStaticPaths() {
	const notes = await getCollection("notebooks", ({ data }) => !data.draft);
	return notes.flatMap((note) => {
		const notebook = getNotebookDefinition(note.data.notebook);
		return notebook
			? [
					{
						params: { notebook: notebook.slug, note: note.data.slug },
						props: { note, notebook },
					},
				]
			: [];
	});
}

const { note, notebook } = Astro.props;
const { Content, headings } = await render(note);
const { remarkPluginFrontmatter } = await render(note);
const notebookNotes = (
	await getCollection(
		"notebooks",
		({ data }) => !data.draft && data.notebook === notebook.slug,
	)
).sort((a, b) => a.data.published.getTime() - b.data.published.getTime());
const currentIndex = notebookNotes.findIndex((item) => item.id === note.id);
const previousNote =
	currentIndex > 0 ? notebookNotes[currentIndex - 1] : undefined;
const nextNote =
	currentIndex < notebookNotes.length - 1
		? notebookNotes[currentIndex + 1]
		: undefined;
const notePath = `/life/notebooks/${notebook.slug}/${note.data.slug}/`;
const bannerPostMeta = {
	title: note.data.title,
	published: note.data.published,
	updated: note.data.updated,
	words: remarkPluginFrontmatter.words,
	minutes: remarkPluginFrontmatter.minutes,
};
---

<MainGridLayout
	banner={notebook.cover}
	title={note.data.title}
	description={note.data.description}
	setOGTypeArticle={true}
	postSlug={note.id}
	headings={headings}
	bannerPostMeta={bannerPostMeta}
>
	<ArticleReadingRails
		headings={headings}
		currentId={note.id}
		currentCategory={notebook.title}
		libraryMode="notebooks"
	/>

	<div class="post-reading-shell flex w-full rounded-(--radius-large) overflow-hidden relative mb-4">
		<div id="post-container" class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
			<nav class="post-reading-breadcrumb onload-animation" aria-label="笔记位置">
				<a href="/life/notebooks/">笔记本</a>
				<Icon is:inline name="material-symbols:chevron-right-rounded" />
				<a href={`/life/notebooks/${notebook.slug}/`}>
					{notebook.title}<small>{notebookNotes.length}</small>
				</a>
				<Icon is:inline name="material-symbols:chevron-right-rounded" />
				<span aria-current="page">此笔记</span>
			</nav>

			<header class="post-reading-header onload-animation">
				<h1
					data-pagefind-body
					data-pagefind-weight="10"
					data-pagefind-meta="title"
					class="post-reading-title"
				>
					{note.data.title}
				</h1>

				<PostMetadata
					className="post-reading-meta"
					published={note.data.published}
					updated={note.data.updated}
					tags={note.data.tags}
					showCategory={false}
					id={note.id}
					customPath={notePath}
				/>

				<div class="post-reading-stats" aria-label="笔记阅读信息">
					<span>
						<Icon is:inline name="material-symbols:notes-rounded" />
						{remarkPluginFrontmatter.words} {i18n(I18nKey.wordsCount)}
					</span>
					<span>
						<Icon is:inline name="material-symbols:schedule-outline-rounded" />
						{remarkPluginFrontmatter.minutes} {i18n(
							remarkPluginFrontmatter.minutes === 1
								? I18nKey.minuteCount
								: I18nKey.minutesCount,
						)}
					</span>
					<span>
						<Icon is:inline name="material-symbols:menu-book-outline-rounded" />
						{notebook.title}
					</span>
				</div>
			</header>

			{note.data.description && (
				<aside class="post-reading-summary onload-animation" aria-label="笔记摘要">
					<Icon is:inline name="material-symbols:format-quote-rounded" />
					<div>
						<strong>笔记摘要</strong>
						<p>{note.data.description}</p>
					</div>
				</aside>
			)}

			<Markdown class="mb-6 markdown-content onload-animation">
				<Content />
			</Markdown>
		</div>
	</div>

	<nav class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full" aria-label="相邻笔记">
		{previousNote ? (
			<a
				href={`/life/notebooks/${notebook.slug}/${previousNote.data.slug}/`}
				class="w-full font-bold overflow-hidden active:scale-95"
			>
				<div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-start! gap-4">
					<Icon is:inline name="material-symbols:chevron-left-rounded" class="text-[2rem] text-(--ui-icon-color)" />
					<div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
						{previousNote.data.title}
					</div>
				</div>
			</a>
		) : (
			<span class="w-full"></span>
		)}

		{nextNote ? (
			<a
				href={`/life/notebooks/${notebook.slug}/${nextNote.data.slug}/`}
				class="w-full font-bold overflow-hidden active:scale-95"
			>
				<div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-end! gap-4">
					<div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
						{nextNote.data.title}
					</div>
					<Icon is:inline name="material-symbols:chevron-right-rounded" class="text-[2rem] text-(--ui-icon-color)" />
				</div>
			</a>
		) : (
			<span class="w-full"></span>
		)}
	</nav>
</MainGridLayout>
