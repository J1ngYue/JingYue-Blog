---
import { Icon } from "astro-icon/components";
import RecordPageShell from "@/components/pages/record/RecordPageShell.astro";
import { changelogEntries } from "@/config/recordConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const filters = [
	{ key: "all", label: "全部", icon: "material-symbols:apps" },
	{
		key: "feature",
		label: "功能新增",
		icon: "material-symbols:rocket-launch-outline",
	},
	{
		key: "optimize",
		label: "功能优化",
		icon: "material-symbols:build-outline",
	},
	{
		key: "fix",
		label: "问题修复",
		icon: "material-symbols:bug-report-outline",
	},
	{
		key: "remove",
		label: "功能删除",
		icon: "material-symbols:delete-outline-rounded",
	},
];
const typeLabels = {
	feature: "功能新增",
	optimize: "功能优化",
	fix: "问题修复",
	remove: "功能删除",
} as const;

type ChangelogLink = { t: number; p: string[] };

// Keep generic words out of the relation graph so arrows describe a real feature area.
const relationStopWords = new Set([
	"功能", "新增", "优化", "问题", "修复", "页面", "博客", "站点", "全站",
	"内容", "系统", "支持", "加入", "更新", "调整", "统一", "改为", "移除",
	"增加", "默认", "当前", "避免", "保持", "同步", "显示", "设置", "按钮",
	"布局", "模式", "背景", "加载", "效果", "动画", "文章", "数据", "组件",
]);

function relationTerms(entry: (typeof changelogEntries)[number]): Set<string> {
	const source = [entry.title, entry.summary, ...entry.changes].join(" ");
	const terms = new Set<string>();
	for (const match of source.matchAll(/[\u4e00-\u9fff]{2,}|[A-Za-z][A-Za-z0-9-]{2,}/g)) {
		const term = match[0].toLocaleLowerCase();
		if (!relationStopWords.has(term)) terms.add(term);
	}
	return terms;
}

const entryTerms = changelogEntries.map(relationTerms);
const relationLinks: ChangelogLink[][] = changelogEntries.map(() => []);

for (let index = 0; index < changelogEntries.length; index += 1) {
	const entry = changelogEntries[index];
	const candidates = changelogEntries
		.map((candidate, target) => {
			if (target === index) return null;
			const shared = [...entryTerms[index]].filter((term) => entryTerms[target].has(term));
			const sameType = candidate.type === entry.type;
			const featurePair = entry.type === "feature" && candidate.type === "feature";
			const distance = Math.abs(target - index);
			const score = shared.length * 8 + (featurePair ? 5 : 0) + (sameType ? 2 : 0) - distance * 0.04;
			return { target, shared, score };
		})
		.filter((candidate): candidate is { target: number; shared: string[]; score: number } => candidate !== null)
		.filter((candidate) => candidate.shared.length > 0 || (entry.type === "feature" && changelogEntries[candidate.target].type === "feature"))
		.sort((a, b) => b.score - a.score || a.target - b.target)
		.slice(0, entry.type === "feature" ? 4 : 2);

	for (const candidate of candidates) {
		const target = changelogEntries[candidate.target];
		const label = entry.type === "feature" || target.type === "feature"
			? "功能新增"
			: typeLabels[target.type];
		if (!relationLinks[index].some((link) => link.t === candidate.target)) {
			relationLinks[index].push({ t: candidate.target, p: [label] });
		}
		if (!relationLinks[candidate.target].some((link) => link.t === index)) {
			relationLinks[candidate.target].push({ t: index, p: [label] });
		}
	}
}
---

<MainGridLayout
	title="更新日志"
	bannerTitle="记录"
	description="记录每一次改进"
	articleHub
	contentOnly
	plainContent
>
	<RecordPageShell
		title="更新日志"
		description="记录博客项目的功能迭代、问题修复与重要变更。"
		icon="material-symbols:history"
	>
		<nav class="changelog-filter" aria-label="更新类型">
			{filters.map((filter, index) => (
				<button
					type="button"
					class:list={{ "is-active": index === 0 }}
					data-log-filter={filter.key}
					aria-pressed={index === 0 ? "true" : "false"}
				>
					<Icon is:inline name={filter.icon} />
					<span>{filter.label}</span>
					{index === 0 && <small>{changelogEntries.length}</small>}
				</button>
			))}
		</nav>

		<div class="changelog-board" data-changelog>
			<svg class="changelog-wires" data-changelog-wires aria-hidden="true">
				<defs>
					<marker id="changelog-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
						<path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
					</marker>
				</defs>
			</svg>
			<ol class="changelog-grid" data-changelog-grid>
			{changelogEntries.map((entry, index) => (
				<li
					class="changelog-card"
					data-changelog-card
					data-log-entry
					data-log-type={entry.type}
					data-log-index={index}
					data-index={index}
					data-links={JSON.stringify(relationLinks[index])}
					data-log-title={entry.title}
					data-log-summary={entry.summary}
					data-log-date={entry.date}
					data-log-time={entry.time}
					data-log-version={entry.version}
					data-log-type-label={typeLabels[entry.type]}
				>
					<button
						type="button"
						class="changelog-card__inner"
						data-log-toggle
						aria-expanded="false"
					>
						<span class="changelog-card__num" aria-hidden="true">{String(changelogEntries.length - index).padStart(2, "0")}</span>
						<span class="changelog-card__meta">
							<span class="changelog-card__type">{typeLabels[entry.type]}</span>
						<time datetime={`${entry.date}T${entry.time}`}>
								{entry.date}
						</time>
						</span>
						<strong class="changelog-card__title">{entry.title}</strong>
						<em class="changelog-card__summary">{entry.summary}</em>
						<span class="changelog-card__version">{entry.version}</span>
					</button>
				</li>
			))}
			</ol>
		</div>

		<dialog class="changelog-dialog" data-changelog-dialog aria-labelledby="changelog-dialog-title">
			<button type="button" class="changelog-dialog__close" data-changelog-dialog-close aria-label="关闭更新详情">
				<Icon is:inline name="material-symbols:close-rounded" />
			</button>
			<div class="changelog-dialog__body">
				<header class="changelog-dialog__meta">
					<strong data-dialog-number></strong>
					<b data-dialog-type></b>
					<time data-dialog-date></time>
				</header>
				<h2 id="changelog-dialog-title" data-dialog-title></h2>
				<p class="changelog-dialog__summary" data-dialog-summary></p>
				<p class="changelog-dialog__version" data-dialog-version></p>
				<section class="changelog-dialog__section">
					<h3>涉及页面</h3>
					<span class="changelog-dialog__type-pill" data-dialog-type-pill></span>
				</section>
				<section class="changelog-dialog__section">
					<h3>相关更新</h3>
					<div class="changelog-dialog__related" data-dialog-related></div>
				</section>
			</div>
		</dialog>
	</RecordPageShell>
</MainGridLayout>

<script>
	type ChangelogGraphWindow = Window & {
		__jingyueChangelogGraphCleanup?: () => void;
		__jingyueChangelogGraphBound?: boolean;
	};
	type ClientChangelogLink = { t: number; p: string[] };

	const changelogGraphWindow = window as ChangelogGraphWindow;

	function initChangelogGraph() {
		changelogGraphWindow.__jingyueChangelogGraphCleanup?.();
		const root = document.querySelector<HTMLElement>("[data-changelog]");
		const grid = root?.querySelector<HTMLOListElement>("[data-changelog-grid]");
		const wires = root?.querySelector<SVGSVGElement>("[data-changelog-wires]");
		if (!root || !grid || !wires) return;

		const controller = new AbortController();
		const { signal } = controller;
		const hoverAnimations = new Set<() => void>();
		let activeCard: HTMLElement | null = null;
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		const visibleCards = () =>
			Array.from(grid.querySelectorAll<HTMLElement>("[data-changelog-card]:not([hidden])"));
		const boardRect = () => root.getBoundingClientRect();
		const cardCenter = (card: HTMLElement) => {
			const rect = card.getBoundingClientRect();
			const board = boardRect();
			return { x: rect.left - board.left + rect.width / 2, y: rect.top - board.top + rect.height / 2 };
		};
		const cardEdgePoint = (card: HTMLElement, target: HTMLElement) => {
			const rect = card.getBoundingClientRect();
			const board = boardRect();
			const center = {
				x: rect.left - board.left + rect.width / 2,
				y: rect.top - board.top + rect.height / 2,
			};
			const targetRect = target.getBoundingClientRect();
			const targetCenter = {
				x: targetRect.left - board.left + targetRect.width / 2,
				y: targetRect.top - board.top + targetRect.height / 2,
			};
			const dx = targetCenter.x - center.x;
			const dy = targetCenter.y - center.y;
			if (Math.abs(dx) * rect.height >= Math.abs(dy) * rect.width) {
				const x = center.x + (dx < 0 ? -rect.width / 2 : rect.width / 2);
				return { x, y: center.y + (dx === 0 ? 0 : (dy * (x - center.x)) / dx) };
			}
			const y = center.y + (dy < 0 ? -rect.height / 2 : rect.height / 2);
			return { x: center.x + (dy === 0 ? 0 : (dx * (y - center.y)) / dy), y };
		};
		const makePath = (d: string, className: string, marker = true) => {
			const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
			path.setAttribute("d", d);
			path.setAttribute("class", className);
			if (marker) path.setAttribute("marker-end", "url(#changelog-arrow)");
			return path;
		};
		const clearHoverWires = () => {
			for (const cancel of hoverAnimations) cancel();
			hoverAnimations.clear();
			root.querySelectorAll("[data-hover-wire]").forEach((node) => node.remove());
			root.querySelectorAll(".is-active, .is-linked").forEach((node) => node.classList.remove("is-active", "is-linked"));
			root.classList.remove("is-hovering");
		};
		const drawRowArrows = (cards: HTMLElement[], columns: number) => {
			wires.setAttribute("viewBox", `0 0 ${Math.max(root.scrollWidth, root.clientWidth)} ${Math.max(root.scrollHeight, root.clientHeight)}`);
			wires.querySelectorAll("[data-row-arrow]").forEach((node) => node.remove());
			const board = boardRect();
			const rows = Math.ceil(cards.length / columns);
			for (let row = 0; row < rows - 1; row += 1) {
				const fromCard = cards[row * columns + columns - 1];
				const toCard = cards[(row + 1) * columns];
				if (!fromCard || !toCard) continue;
				const from = fromCard.getBoundingClientRect();
				const to = toCard.getBoundingClientRect();
				const fy = from.top - board.top + from.height / 2;
				const ty = to.top - board.top + to.height / 2;
				const x1 = row % 2 === 0 ? from.right - board.left : from.left - board.left;
				const x2 = row % 2 === 0 ? to.right - board.left : to.left - board.left;
				const outward = row % 2 === 0 ? Math.max(x1, x2) + 16 : Math.min(x1, x2) - 16;
				const path = makePath(`M ${x2} ${ty} H ${outward} V ${fy} H ${x1}`, "changelog-wire changelog-wire--row");
				path.setAttribute("data-row-arrow", "true");
				wires.appendChild(path);
			}
		};
		const layout = () => {
			const cards = visibleCards();
			if (!cards.length) return;
			const columns = Math.max(1, getComputedStyle(grid).gridTemplateColumns.trim().split(/\s+/).length);
			cards.forEach((card, index) => {
				const row = Math.floor(index / columns);
				const column = index % columns;
				const visualColumn = row % 2 === 0 ? column : columns - 1 - column;
				card.style.order = String(row * columns + visualColumn);
			});
			clearHoverWires();
			requestAnimationFrame(() => drawRowArrows(cards, columns));
		};
		const drawHoverWire = (d: string, midpoint: { x: number; y: number }, labelText: string) => {
			const path = makePath(d, "changelog-wire changelog-wire--hover", false);
			path.setAttribute("data-hover-wire", "true");
			wires.appendChild(path);
			const label = document.createElement("span");
			label.className = "changelog-wire-label";
			label.textContent = labelText;
			label.setAttribute("data-hover-wire", "true");
			label.style.left = `${midpoint.x}px`;
			label.style.top = `${midpoint.y}px`;
			root.appendChild(label);
			if (reducedMotion) {
				path.classList.add("is-drawn");
				path.setAttribute("marker-end", "url(#changelog-arrow)");
				label.classList.add("is-in");
				return;
			}
			const length = path.getTotalLength();
			const start = performance.now();
			let frame = 0;
			const cancel = () => cancelAnimationFrame(frame);
			hoverAnimations.add(cancel);
			const tick = (now: number) => {
				const progress = Math.min(1, (now - start) / Math.min(760, Math.max(350, length / 0.7)));
				path.style.strokeDasharray = `${length * progress} ${length + 20}`;
				if (progress < 1) {
					frame = requestAnimationFrame(tick);
					return;
				}
				hoverAnimations.delete(cancel);
				path.style.strokeDasharray = "6 5";
				path.classList.add("is-drawn");
				path.setAttribute("marker-end", "url(#changelog-arrow)");
				label.classList.add("is-in");
			};
			frame = requestAnimationFrame(tick);
		};
		const onCardEnter = (card: HTMLElement) => {
			clearHoverWires();
			root.classList.add("is-hovering");
			card.classList.add("is-active");
			const from = cardCenter(card);
			const cardIndex = Number(card.dataset.index);
			let links: ClientChangelogLink[] = [];
			try {
				links = JSON.parse(card.dataset.links ?? "[]") as ClientChangelogLink[];
			} catch {
				return;
			}
			for (const link of links) {
				const target = grid.querySelector<HTMLElement>(`[data-changelog-card][data-index="${link.t}"]:not([hidden])`);
				if (!target) continue;
				target.classList.add("is-linked");
				const to = cardCenter(target);
				const dx = to.x - from.x;
				const dy = to.y - from.y;
				const length = Math.max(1, Math.hypot(dx, dy));
				const curve = Math.min(56, length * 0.12);
				const cx = (from.x + to.x) / 2 - (dy / length) * curve;
				const cy = (from.y + to.y) / 2 + (dx / length) * curve;
				const midpoint = { x: from.x * 0.25 + cx * 0.5 + to.x * 0.25, y: from.y * 0.25 + cy * 0.5 + to.y * 0.25 };
				const source = link.t < cardIndex ? card : target;
				const destination = link.t < cardIndex ? target : card;
				const start = cardEdgePoint(source, destination);
				const end = cardEdgePoint(destination, source);
				drawHoverWire(`M ${start.x} ${start.y} Q ${cx} ${cy} ${end.x} ${end.y}`, midpoint, link.p.join("、"));
			}
		};

		grid.addEventListener("pointerover", (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const card = target.closest<HTMLElement>("[data-changelog-card]");
			if (!card || card === activeCard) return;
			activeCard = card;
			onCardEnter(card);
		}, { signal });
		grid.addEventListener("pointerleave", () => {
			activeCard = null;
			clearHoverWires();
		}, { signal });
		window.addEventListener("resize", layout, { signal });
		const mutationObserver = new MutationObserver(layout);
		mutationObserver.observe(grid, { subtree: true, attributes: true, attributeFilter: ["hidden"] });
		const resizeObserver = new ResizeObserver(layout);
		resizeObserver.observe(grid);
		changelogGraphWindow.__jingyueChangelogGraphCleanup = () => {
			controller.abort();
			mutationObserver.disconnect();
			resizeObserver.disconnect();
			clearHoverWires();
		};
		layout();
	}

	if (!changelogGraphWindow.__jingyueChangelogGraphBound) {
		changelogGraphWindow.__jingyueChangelogGraphBound = true;
		document.addEventListener("astro:page-load", initChangelogGraph);
		document.addEventListener("swup:contentReplaced", initChangelogGraph);
		document.addEventListener("swup:content:replaced", initChangelogGraph);
	}
	initChangelogGraph();
</script>

<script>
	type ClientChangelogLink = { t: number; p: string[] };
	type ChangelogDialogWindow = Window & {
		__jingyueChangelogDialogCleanup?: () => void;
		__jingyueChangelogDialogBound?: boolean;
	};

	const changelogDialogWindow = window as ChangelogDialogWindow;

	function initChangelogDialog() {
		changelogDialogWindow.__jingyueChangelogDialogCleanup?.();
		const dialog = document.querySelector<HTMLDialogElement>("[data-changelog-dialog]");
		const board = document.querySelector<HTMLElement>("[data-changelog]");
		if (!dialog || !board) return;

		const controller = new AbortController();
		const { signal } = controller;
		const numberEl = dialog.querySelector<HTMLElement>("[data-dialog-number]");
		const typeEl = dialog.querySelector<HTMLElement>("[data-dialog-type]");
		const dateEl = dialog.querySelector<HTMLElement>("[data-dialog-date]");
		const titleEl = dialog.querySelector<HTMLElement>("[data-dialog-title]");
		const summaryEl = dialog.querySelector<HTMLElement>("[data-dialog-summary]");
		const versionEl = dialog.querySelector<HTMLElement>("[data-dialog-version]");
		const typePillEl = dialog.querySelector<HTMLElement>("[data-dialog-type-pill]");
		const relatedEl = dialog.querySelector<HTMLElement>("[data-dialog-related]");

		const getCard = (index: number) => board.querySelector<HTMLElement>(`[data-changelog-card][data-index="${index}"]`);
		const readLinks = (card: HTMLElement) => {
			try {
				return JSON.parse(card.dataset.links ?? "[]") as ClientChangelogLink[];
			} catch {
				return [];
			}
		};
		const openEntry = (index: number) => {
			const card = getCard(index);
			if (!card) return;
			const total = board.querySelectorAll("[data-changelog-card]").length;
			if (numberEl) numberEl.textContent = `#${String(total - index).padStart(2, "0")}`;
			if (typeEl) typeEl.textContent = card.dataset.logTypeLabel ?? "";
			if (dateEl) {
				dateEl.textContent = card.dataset.logDate ?? "";
				dateEl.setAttribute("datetime", `${card.dataset.logDate ?? ""}T${card.dataset.logTime ?? "00:00"}`);
			}
			if (titleEl) titleEl.textContent = card.dataset.logTitle ?? "";
			if (summaryEl) summaryEl.textContent = card.dataset.logSummary ?? "";
			if (versionEl) versionEl.textContent = card.dataset.logVersion ?? "";
			if (typePillEl) typePillEl.textContent = card.dataset.logTypeLabel ?? "";
			if (relatedEl) {
				relatedEl.replaceChildren();
				for (const link of readLinks(card)) {
					const relatedCard = getCard(link.t);
					if (!relatedCard) continue;
					const button = document.createElement("button");
					button.type = "button";
					button.className = "changelog-dialog__related-item";
					button.dataset.dialogRelatedIndex = String(link.t);
					const title = document.createElement("strong");
					title.textContent = `#${String(total - link.t).padStart(2, "0")} ${relatedCard.dataset.logTitle ?? ""}`;
					const relation = document.createElement("span");
					relation.textContent = link.p.join("、");
					button.append(title, relation);
					relatedEl.appendChild(button);
				}
				if (!relatedEl.childElementCount) {
					const empty = document.createElement("span");
					empty.className = "changelog-dialog__empty";
					empty.textContent = "暂无关联更新";
					relatedEl.appendChild(empty);
				}
			}
			if (!dialog.open) dialog.showModal();
		};

		const close = () => {
			if (dialog.open) dialog.close();
		};
		window.addEventListener("firefly:changelog-open", (event) => {
			const index = (event as CustomEvent<{ index?: number }>).detail?.index;
			if (typeof index === "number") openEntry(index);
		}, { signal });
		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) close();
		}, { signal });
		dialog.querySelector("[data-changelog-dialog-close]")?.addEventListener("click", close, { signal });
		relatedEl?.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const button = target.closest<HTMLElement>("[data-dialog-related-index]");
			if (button) openEntry(Number(button.dataset.dialogRelatedIndex));
		}, { signal });
		changelogDialogWindow.__jingyueChangelogDialogCleanup = () => controller.abort();
	}

	if (!changelogDialogWindow.__jingyueChangelogDialogBound) {
		changelogDialogWindow.__jingyueChangelogDialogBound = true;
		document.addEventListener("astro:page-load", initChangelogDialog);
		document.addEventListener("swup:contentReplaced", initChangelogDialog);
		document.addEventListener("swup:content:replaced", initChangelogDialog);
	}
	initChangelogDialog();
</script>

<style>
	.changelog-filter {
		display: flex;
		min-height: 3.6rem;
		align-items: center;
		gap: 0.3rem;
		overflow-x: auto;
		margin: 0 0 2.4rem;
		border: 1px solid color-mix(in srgb, var(--record-ink, #111) 16%, transparent);
		border-radius: 1.25rem;
		background: color-mix(in srgb, var(--card-bg, #fff) 76%, transparent);
		padding: 0.38rem;
		scrollbar-width: none;
	}

	.changelog-filter::-webkit-scrollbar {
		display: none;
	}

	.changelog-filter button {
		display: inline-flex;
		min-height: 2.55rem;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.45rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		padding: 0.4rem 0.95rem;
		color: var(--record-ink, var(--deep-text));
		font: inherit;
		font-size: 0.8rem;
		font-weight: 620;
		cursor: pointer;
		transition: background-color 160ms ease, color 160ms ease;
	}

	.changelog-filter button:hover,
	.changelog-filter button:focus-visible {
		background: color-mix(in srgb, var(--record-ink, #111) 8%, transparent);
		outline: none;
	}

	.changelog-filter button:focus-visible {
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 22%, transparent);
	}

	.changelog-filter button.is-active {
		background: var(--record-ink, #111);
		color: var(--card-bg, #fff);
	}

	.changelog-filter button :global(svg) {
		width: 0.95rem;
		height: 0.95rem;
	}

	.changelog-filter small {
		display: grid;
		min-width: 1.35rem;
		height: 1.35rem;
		place-items: center;
		border-radius: 999px;
		background: color-mix(in srgb, currentColor 14%, transparent);
		font-size: 0.64rem;
	}

	.changelog-timeline {
		position: relative;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		column-gap: clamp(2.1rem, 4vw, 4.6rem);
		row-gap: clamp(3.4rem, 5vw, 5.2rem);
		padding: 0.7rem 0 2.5rem;
	}

	.changelog-entry {
		position: relative;
		min-width: 0;
		padding-top: 2.15rem;
	}

	.changelog-entry[hidden] {
		display: none;
	}

	.changelog-entry__dot {
		position: absolute;
		top: 0.55rem;
		left: 1.25rem;
		z-index: 2;
		width: 0.7rem;
		height: 0.7rem;
		border: 0.16rem solid var(--card-bg);
		border-radius: 50%;
		background: var(--primary, #0ea5a4);
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary, #0ea5a4) 55%, transparent);
	}

	.changelog-entry header {
		position: absolute;
		top: 0;
		left: 0;
		display: flex;
		width: 100%;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		padding-left: 2.2rem;
		color: var(--content-meta);
		font-size: 0.68rem;
		font-variant-numeric: tabular-nums;
	}

	.changelog-entry header > small {
		color: var(--record-muted, var(--content-meta));
		font-size: 0.68rem;
		font-weight: 700;
	}

	.changelog-entry header > span {
		margin-left: auto;
		border-radius: 999px;
		background: color-mix(in srgb, var(--primary, #0ea5a4) 12%, transparent);
		padding: 0.2rem 0.55rem;
		color: var(--record-ink, #111);
		font-size: 0.64rem;
		font-weight: 750;
	}

	.changelog-entry__box {
		position: relative;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--record-ink, #111) 12%, transparent);
		border-radius: 1rem;
		background: color-mix(in srgb, var(--card-bg, #fff) 86%, transparent);
		box-shadow: 0 1rem 2.5rem rgb(15 23 42 / 5%);
		backdrop-filter: blur(10px);
		transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
	}

	.changelog-entry__box:hover {
		border-color: color-mix(in srgb, var(--primary, #0ea5a4) 40%, transparent);
		box-shadow: 0 1.25rem 2.8rem rgb(15 23 42 / 9%);
		transform: translateY(-2px);
	}

	.changelog-entry__index {
		position: absolute;
		right: 0.55rem;
		bottom: -0.85rem;
		color: color-mix(in srgb, var(--record-ink, #111) 8%, transparent);
		font-size: clamp(3.5rem, 6vw, 5.2rem);
		font-weight: 850;
		letter-spacing: -0.06em;
		line-height: 1;
		pointer-events: none;
		user-select: none;
	}

	.changelog-entry__summary {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		gap: 0.85rem;
		border: 0;
		background: transparent;
		padding: 1.15rem 1.15rem 1.25rem;
		color: var(--record-ink, var(--deep-text));
		font: inherit;
		font-size: 0.84rem;
		line-height: 1.6;
		text-align: left;
		cursor: pointer;
		transition:
			background-color 180ms ease,
			color 180ms ease;
	}

	.changelog-entry__summary:hover,
	.changelog-entry__summary:focus-visible {
		background: color-mix(in srgb, var(--primary) 7%, transparent);
		outline: none;
	}

	.changelog-entry__summary:focus-visible {
		box-shadow: inset 0 0 0 3px color-mix(in srgb, var(--primary) 22%, transparent);
	}

	.changelog-entry__summary > span {
		min-width: 0;
		display: grid;
		gap: 0.45rem;
	}

	.changelog-entry__summary strong {
		font-size: 1rem;
		font-weight: 780;
		line-height: 1.4;
	}

	.changelog-entry__summary em {
		color: var(--record-muted, var(--content-meta));
		font-size: 0.76rem;
		font-style: normal;
		line-height: 1.65;
	}

	.changelog-entry__summary :global(svg) {
		width: 1.15rem;
		height: 1.15rem;
		flex: none;
		color: var(--content-meta);
		transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.changelog-entry[data-expanded="true"] .changelog-entry__summary {
		border-bottom: 1px solid color-mix(in srgb, var(--record-ink, #111) 18%, transparent);
	}

	.changelog-entry[data-expanded="true"] .changelog-entry__summary :global(svg) {
		transform: rotate(180deg);
	}

	.changelog-entry__content {
		display: grid;
		grid-template-rows: 0fr;
		overflow: hidden;
		opacity: 0;
		transition:
			grid-template-rows 360ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 220ms ease;
	}

	.changelog-entry[data-expanded="true"] .changelog-entry__content {
		grid-template-rows: 1fr;
		opacity: 1;
	}

	.changelog-entry__content-inner {
		min-height: 0;
		overflow: hidden;
		padding: 0 1.15rem;
		transition: padding 360ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.changelog-entry[data-expanded="true"] .changelog-entry__content-inner {
		padding: 0 1.15rem 1.2rem;
	}

	.changelog-entry__content-inner strong {
		display: block;
		font-size: 0.9rem;
		font-weight: 720;
	}

	.changelog-entry__content-inner ul {
		display: grid;
		gap: 0.55rem;
		margin: 0;
		padding: 0;
		color: var(--record-ink, var(--deep-text));
		font-size: 0.78rem;
		line-height: 1.6;
		list-style-position: inside;
	}

	.changelog-entry__content-inner li::marker {
		color: var(--content-meta);
	}

	/* Short connector segments keep the graph readable without forming a dense web. */
	@media (min-width: 861px) {
		.changelog-entry:nth-child(3n + 1):not(:first-child)::before {
			position: absolute;
			top: -3.7rem;
			left: -2.3rem;
			width: 2.3rem;
			height: 3.7rem;
			border-top: 1px solid color-mix(in srgb, var(--primary, #0ea5a4) 32%, transparent);
			border-left: 1px solid color-mix(in srgb, var(--primary, #0ea5a4) 32%, transparent);
			content: "";
		}

		.changelog-entry:nth-child(3n + 1):not(:first-child)::after,
		.changelog-entry:nth-child(3n + 2)::after {
			position: absolute;
			top: 0.9rem;
			right: calc(-1 * clamp(2.1rem, 4vw, 4.6rem) / 2);
			width: calc(clamp(2.1rem, 4vw, 4.6rem) / 2);
			border-top: 1px solid color-mix(in srgb, var(--primary, #0ea5a4) 32%, transparent);
			content: "";
		}

		.changelog-entry:nth-child(3n + 1):not(:first-child)::before {
			border-top-left-radius: 0.5rem;
		}

		.changelog-entry:nth-child(3n + 1):not(:first-child) .changelog-entry__dot,
		.changelog-entry:nth-child(3n + 2) .changelog-entry__dot,
		.changelog-entry:nth-child(3n + 3) .changelog-entry__dot {
			box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary, #0ea5a4) 55%, transparent), 0 0 0 5px color-mix(in srgb, var(--primary, #0ea5a4) 8%, transparent);
		}
	}

	@media (max-width: 860px) {
		.changelog-timeline {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 2rem;
			padding-left: 1.35rem;
		}

		.changelog-timeline::before {
			position: absolute;
			top: 0;
			bottom: 0;
			left: 0.35rem;
			border-left: 1px solid color-mix(in srgb, var(--primary, #0ea5a4) 28%, transparent);
			content: "";
		}

		.changelog-entry {
			padding-top: 2.05rem;
		}

		.changelog-entry__dot {
			left: -1.32rem;
		}

		.changelog-entry:not(:first-child)::before {
			position: absolute;
			top: -2rem;
			left: -1.32rem;
			height: 2rem;
			border-left: 1px solid color-mix(in srgb, var(--primary, #0ea5a4) 28%, transparent);
			content: "";
		}
	}

	@media (max-width: 620px) {
		.changelog-filter {
			margin-bottom: 1.7rem;
		}

		.changelog-timeline {
			padding-left: 1.15rem;
			padding-bottom: 1.5rem;
		}

		.changelog-entry__dot {
			left: -1.12rem;
		}

		.changelog-entry__box {
			margin-inline: 0;
		}

		.changelog-entry__summary {
			padding: 1rem;
		}

		.changelog-entry__content-inner {
			padding-inline: 1rem;
		}

		.changelog-entry[data-expanded="true"] .changelog-entry__content-inner {
			padding: 0 1rem 1rem;
		}

		.changelog-entry__index {
			font-size: 3.8rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.changelog-entry__summary,
		.changelog-entry__summary :global(svg),
		.changelog-entry__content,
		.changelog-entry__content-inner {
			transition: none;
		}
	}

	/* 关系图层：卡片保持方形网格，SVG 只负责连接关系，不参与布局。 */
	.changelog-board {
		position: relative;
		isolation: isolate;
		min-width: 0;
		overflow: visible;
	}

	.changelog-wires {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

	.changelog-grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.875rem;
		margin: 0;
		padding: 0.15rem 0 2.5rem;
		list-style: none;
	}

	.changelog-card {
		position: relative;
		min-width: 0;
		aspect-ratio: 1;
		transition: opacity 250ms ease;
	}

	.changelog-card[hidden] {
		display: none;
	}

	.changelog-card__inner {
		display: flex;
		position: relative;
		width: 100%;
		height: 100%;
		min-height: 0;
		flex-direction: column;
		align-items: stretch;
		gap: 0.42rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--record-ink, #111) 12%, transparent);
		border-radius: 0.8rem;
		background: color-mix(in srgb, var(--card-bg, #fff) 88%, transparent);
		padding: 0.85rem 0.9rem;
		color: var(--record-ink, var(--deep-text));
		font: inherit;
		text-align: left;
		cursor: pointer;
		backdrop-filter: blur(10px);
		box-shadow: 0 0.7rem 1.8rem rgb(15 23 42 / 5%);
		transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease, background-color 180ms ease;
	}

	.changelog-card__inner:hover,
	.changelog-card__inner:focus-visible,
	.changelog-card.is-active .changelog-card__inner,
	.changelog-card.is-linked .changelog-card__inner {
		border-color: color-mix(in srgb, #00a29b 76%, transparent);
		background: color-mix(in srgb, var(--card-bg, #fff) 96%, #00a29b 4%);
		box-shadow: 0 1rem 2rem rgb(15 23 42 / 10%);
		outline: none;
	}

	.changelog-card__inner:hover,
	.changelog-card__inner:focus-visible {
		transform: translateY(-2px);
	}

	.changelog-board.is-hovering .changelog-card:not(.is-active):not(.is-linked) {
		opacity: 0.48;
	}

	.changelog-card__num {
		position: absolute;
		right: 0.5rem;
		bottom: -0.72rem;
		color: color-mix(in srgb, var(--record-ink, #111) 8%, transparent);
		font-size: clamp(3.2rem, 5vw, 4.8rem);
		font-weight: 850;
		letter-spacing: -0.08em;
		line-height: 1;
		pointer-events: none;
		user-select: none;
	}

	.changelog-card__meta {
		display: flex;
		position: relative;
		z-index: 1;
		align-items: center;
		gap: 0.45rem;
		min-width: 0;
		color: var(--content-meta);
		font-size: 0.68rem;
		font-variant-numeric: tabular-nums;
		line-height: 1.35;
	}

	.changelog-card__type {
		color: #00a29b;
		font-weight: 760;
	}

	.changelog-card__meta time {
		white-space: nowrap;
	}

	.changelog-card__title,
	.changelog-card__summary {
		position: relative;
		z-index: 1;
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
	}

	.changelog-card__title {
		-webkit-line-clamp: 4;
		font-size: 0.94rem;
		font-weight: 780;
		line-height: 1.45;
	}

	.changelog-card__summary {
		margin-top: auto;
		-webkit-line-clamp: 3;
		color: var(--record-muted, var(--content-meta));
		font-size: 0.73rem;
		font-style: normal;
		line-height: 1.55;
	}

	.changelog-card__version {
		position: relative;
		z-index: 1;
		align-self: flex-start;
		border-radius: 999px;
		background: color-mix(in srgb, #00a29b 11%, transparent);
		padding: 0.18rem 0.48rem;
		color: var(--record-ink, #111);
		font-size: 0.62rem;
		font-weight: 730;
	}

	.changelog-dialog {
		position: relative;
		width: min(42rem, calc(100vw - 2rem));
		max-width: none;
		max-height: min(82vh, 48rem);
		margin: auto;
		border: 1px solid color-mix(in srgb, var(--record-ink, #111) 12%, transparent);
		border-radius: 1rem;
		background: color-mix(in srgb, var(--card-bg, #fff) 96%, transparent);
		padding: 0;
		color: var(--record-ink, var(--deep-text));
		box-shadow: 0 1.5rem 4rem rgb(15 23 42 / 22%);
		backdrop-filter: blur(18px);
	}

	.changelog-dialog::backdrop {
		background: rgb(12 16 22 / 48%);
		backdrop-filter: blur(8px) saturate(0.82);
	}

	.changelog-dialog[open] {
		animation: changelog-dialog-in 280ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.changelog-dialog__body {
		max-height: min(82vh, 48rem);
		overflow-y: auto;
		padding: clamp(1.35rem, 3vw, 2rem);
		scrollbar-width: thin;
	}

	.changelog-dialog__close {
		position: absolute;
		top: 0.85rem;
		right: 0.85rem;
		z-index: 2;
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: color-mix(in srgb, var(--record-ink, #111) 8%, transparent);
		color: var(--record-ink, var(--deep-text));
		cursor: pointer;
		transition: background-color 160ms ease, transform 160ms ease;
	}

	.changelog-dialog__close:hover,
	.changelog-dialog__close:focus-visible {
		background: color-mix(in srgb, var(--primary, #0ea5a4) 18%, transparent);
		outline: none;
		transform: rotate(6deg);
	}

	.changelog-dialog__close :global(svg) {
		width: 1.05rem;
		height: 1.05rem;
	}

	.changelog-dialog__meta {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding-right: 2.5rem;
		color: var(--content-meta);
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
	}

	.changelog-dialog__meta strong {
		color: var(--record-ink, var(--deep-text));
		font-weight: 800;
	}

	.changelog-dialog__meta b {
		color: var(--record-ink, var(--deep-text));
		font-weight: 750;
	}

	.changelog-dialog__meta time {
		color: var(--record-muted, var(--content-meta));
	}

	.changelog-dialog h2 {
		margin: 1.05rem 2.4rem 0.85rem 0;
		font-size: clamp(1.25rem, 2.3vw, 1.72rem);
		font-weight: 800;
		line-height: 1.38;
	}

	.changelog-dialog__summary {
		margin: 0;
		color: var(--record-muted, var(--content-meta));
		font-size: 0.88rem;
		line-height: 1.75;
	}

	.changelog-dialog__version {
		margin: 1rem 0 0;
		font-family: var(--font-jetbrains-mono), monospace;
		font-size: 0.76rem;
		font-weight: 650;
		color: var(--record-ink, var(--deep-text));
	}

	.changelog-dialog__section {
		margin-top: 1.45rem;
	}

	.changelog-dialog__section h3 {
		margin: 0 0 0.6rem;
		color: var(--record-muted, var(--content-meta));
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.04em;
	}

	.changelog-dialog__type-pill {
		display: inline-flex;
		align-items: center;
		border-radius: 999px;
		background: color-mix(in srgb, var(--primary, #0ea5a4) 12%, transparent);
		padding: 0.3rem 0.7rem;
		color: color-mix(in srgb, var(--primary, #0ea5a4) 78%, var(--record-ink, #111));
		font-size: 0.75rem;
		font-weight: 750;
	}

	.changelog-dialog__related {
		display: grid;
		gap: 0.5rem;
	}

	:global(.changelog-dialog__related-item) {
		display: grid;
		gap: 0.2rem;
		width: 100%;
		border: 0;
		border-radius: 0.7rem;
		background: color-mix(in srgb, var(--record-ink, #111) 3%, transparent);
		padding: 0.72rem 0.8rem;
		color: var(--record-ink, var(--deep-text));
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition: background-color 160ms ease, transform 160ms ease;
	}

	:global(.changelog-dialog__related-item:hover),
	:global(.changelog-dialog__related-item:focus-visible) {
		background: color-mix(in srgb, var(--primary, #0ea5a4) 9%, transparent);
		outline: none;
		transform: translateX(2px);
	}

	:global(.changelog-dialog__related-item strong) {
		font-size: 0.8rem;
		font-weight: 750;
		line-height: 1.45;
	}

	:global(.changelog-dialog__related-item span),
	:global(.changelog-dialog__empty) {
		color: var(--record-muted, var(--content-meta));
		font-size: 0.7rem;
	}

	@keyframes changelog-dialog-in {
		from { opacity: 0; transform: translateY(0.65rem) scale(0.98); }
		to { opacity: 1; transform: translateY(0) scale(1); }
	}

	:global(.changelog-wire) {
		fill: none;
		stroke-width: 1.5px;
	}

	:global(.changelog-wire--row) {
		stroke: #00a29b;
		opacity: 0.38;
	}

	:global(.changelog-wire--hover) {
		stroke: #00a29b;
		stroke-width: 1.75px;
	}

	:global(.changelog-wire--hover.is-drawn) {
		stroke-dasharray: 6 5;
		animation: changelog-dash 0.7s linear infinite;
	}

	:global(.changelog-wire-label) {
		position: absolute;
		z-index: 3;
		max-width: 12rem;
		overflow: hidden;
		transform: translate(-50%, -50%);
		visibility: hidden;
		border: 1px solid color-mix(in srgb, #00a29b 38%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--card-bg, #fff) 92%, transparent);
		padding: 0.25rem 0.62rem;
		color: #008e88;
		font-size: 0.68rem;
		font-weight: 750;
		line-height: 1.4;
		text-overflow: ellipsis;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		box-shadow: 0 0.25rem 0.8rem rgb(0 0 0 / 8%);
		transition: opacity 350ms ease 100ms, visibility 350ms ease 100ms;
	}

	:global(.changelog-wire-label.is-in) {
		visibility: visible;
		opacity: 1;
	}

	@keyframes changelog-dash {
		to { stroke-dashoffset: -11px; }
	}

	@media (max-width: 1024px) {
		.changelog-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
	}

	@media (max-width: 768px) {
		.changelog-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.7rem; }
		.changelog-card__inner { padding: 0.75rem; }
		.changelog-card__title { font-size: 0.84rem; }
		.changelog-card__summary { font-size: 0.68rem; }
	}

	@media (max-width: 560px) {
		.changelog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
		.changelog-card__inner { padding: 0.7rem; }
		.changelog-card__num { font-size: 3.2rem; }
		.changelog-card__title { -webkit-line-clamp: 5; font-size: 0.82rem; }
