---
import { Icon } from "astro-icon/components";
import RecordPageShell from "@/components/pages/record/RecordPageShell.astro";
import { changelogEntries } from "@/config/recordConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const filters = [
	{ key: "all", label: "全部", icon: "material-symbols:apps" },
	{
		key: "feature",
		label: "功能新增",
		icon: "material-symbols:rocket-launch-outline",
	},
	{
		key: "optimize",
		label: "功能优化",
		icon: "material-symbols:build-outline",
	},
	{
		key: "fix",
		label: "问题修复",
		icon: "material-symbols:bug-report-outline",
	},
	{
		key: "remove",
		label: "功能删除",
		icon: "material-symbols:delete-outline-rounded",
	},
];
---

<MainGridLayout
	title="更新日志"
	bannerTitle="记录"
	description="记录每一次改进"
	articleHub
	contentOnly
	plainContent
>
	<RecordPageShell
		title="更新日志"
		description="记录博客项目的功能迭代、问题修复与重要变更。"
		icon="material-symbols:history"
	>
		<nav class="changelog-filter" aria-label="更新类型">
			{filters.map((filter, index) => (
				<button
					type="button"
					class:list={{ "is-active": index === 0 }}
					data-log-filter={filter.key}
					aria-pressed={index === 0 ? "true" : "false"}
				>
					<Icon is:inline name={filter.icon} />
					<span>{filter.label}</span>
					{index === 0 && <small>{changelogEntries.length}</small>}
				</button>
			))}
		</nav>

		<div class="changelog-timeline" data-changelog-list>
			{changelogEntries.map((entry, index) => (
				<article class="changelog-entry" data-log-entry data-log-type={entry.type} data-expanded="false">
					<span class="changelog-entry__dot" aria-hidden="true"></span>
					<header>
						<time datetime={`${entry.date}T${entry.time}`}>
							{entry.date} · {entry.time}
						</time>
						<span>{entry.version}</span>
					</header>
					<div class="changelog-entry__box">
						<button
							type="button"
							class="changelog-entry__summary"
							data-log-toggle
							aria-expanded="false"
							aria-controls={`changelog-details-${index}`}
						>
							<span>{entry.summary}</span>
							<Icon is:inline name="material-symbols:expand-more-rounded" aria-hidden="true" />
						</button>
						<div
							id={`changelog-details-${index}`}
							class="changelog-entry__content"
							data-log-content
							aria-hidden="true"
						>
							<div class="changelog-entry__content-inner">
								<strong>{entry.title}</strong>
								<ul>
									{entry.changes.map((change) => <li>{change}</li>)}
								</ul>
							</div>
						</div>
					</div>
				</article>
			))}
		</div>
	</RecordPageShell>
</MainGridLayout>

<style>
	.changelog-filter {
		display: flex;
		min-height: 3.45rem;
		align-items: center;
		gap: 0.22rem;
		overflow-x: auto;
		margin: 0 0 1.6rem;
		border: 2px solid var(--record-ink, #111);
		border-radius: 1.1rem;
		padding: 0.34rem;
		scrollbar-width: none;
	}

	.changelog-filter::-webkit-scrollbar {
		display: none;
	}

	.changelog-filter button {
		display: inline-flex;
		min-height: 2.45rem;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.42rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		padding: 0.4rem 0.85rem;
		color: var(--record-ink, var(--deep-text));
		font: inherit;
		font-size: 0.8rem;
		font-weight: 620;
		cursor: pointer;
		transition: background-color 160ms ease, color 160ms ease;
	}

	.changelog-filter button:hover,
	.changelog-filter button:focus-visible {
		background: color-mix(in srgb, var(--record-ink, #111) 8%, transparent);
		outline: none;
	}

	.changelog-filter button:focus-visible {
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 22%, transparent);
	}

	.changelog-filter button.is-active {
		background: var(--record-ink, #111);
		color: var(--card-bg, #fff);
	}

	.changelog-filter button :global(svg) {
		width: 0.95rem;
		height: 0.95rem;
	}

	.changelog-filter small {
		display: grid;
		min-width: 1.35rem;
		height: 1.35rem;
		place-items: center;
		border-radius: 999px;
		background: color-mix(in srgb, currentColor 14%, transparent);
		font-size: 0.64rem;
	}

	.changelog-timeline {
		position: relative;
		display: grid;
		gap: 1.15rem;
		margin-left: 0.45rem;
		border-left: 1px solid color-mix(in srgb, var(--record-ink, #111) 20%, transparent);
		padding: 0 0 0.3rem 1.75rem;
	}

	.changelog-entry {
		position: relative;
		min-width: 0;
	}

	.changelog-entry[hidden] {
		display: none;
	}

	.changelog-entry__dot {
		position: absolute;
		top: 0.38rem;
		left: -2.13rem;
		width: 0.82rem;
		height: 0.82rem;
		border: 0.18rem solid var(--card-bg);
		border-radius: 50%;
		background: var(--record-ink, #111);
		box-shadow: 0 0 0 1px var(--record-ink, #111);
	}

	.changelog-entry header {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 0 0.55rem;
		color: var(--content-meta);
		font-size: 0.72rem;
		font-variant-numeric: tabular-nums;
	}

	.changelog-entry header > span {
		border-radius: 999px;
		background: color-mix(in srgb, var(--record-ink, #111) 8%, transparent);
		padding: 0.18rem 0.55rem;
		color: var(--record-ink, #111);
		font-weight: 750;
	}

	.changelog-entry__box {
		overflow: hidden;
		border: 2px solid var(--record-ink, #111);
		background: color-mix(in srgb, var(--card-bg, #fff) 96%, transparent);
	}

	.changelog-entry__summary {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border: 0;
		background: transparent;
		padding: 0.85rem 1rem;
		color: var(--record-ink, var(--deep-text));
		font: inherit;
		font-size: 0.78rem;
		line-height: 1.55;
		text-align: left;
		cursor: pointer;
		transition:
			background-color 180ms ease,
			color 180ms ease;
	}

	.changelog-entry__summary:hover,
	.changelog-entry__summary:focus-visible {
		background: color-mix(in srgb, var(--primary) 7%, transparent);
		outline: none;
	}

	.changelog-entry__summary:focus-visible {
		box-shadow: inset 0 0 0 3px color-mix(in srgb, var(--primary) 22%, transparent);
	}

	.changelog-entry__summary > span {
		min-width: 0;
	}

	.changelog-entry__summary :global(svg) {
		width: 1.15rem;
		height: 1.15rem;
		flex: none;
		color: var(--content-meta);
		transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.changelog-entry[data-expanded="true"] .changelog-entry__summary {
		border-bottom: 1px solid color-mix(in srgb, var(--record-ink, #111) 18%, transparent);
	}

	.changelog-entry[data-expanded="true"] .changelog-entry__summary :global(svg) {
		transform: rotate(180deg);
	}

	.changelog-entry__content {
		display: grid;
		grid-template-rows: 0fr;
		overflow: hidden;
		opacity: 0;
		transition:
			grid-template-rows 360ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 220ms ease;
	}

	.changelog-entry[data-expanded="true"] .changelog-entry__content {
		grid-template-rows: 1fr;
		opacity: 1;
	}

	.changelog-entry__content-inner {
		min-height: 0;
		overflow: hidden;
		padding: 0 1rem;
		transition: padding 360ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.changelog-entry[data-expanded="true"] .changelog-entry__content-inner {
		padding: 0.85rem 1rem 1rem;
	}

	.changelog-entry__content-inner strong {
		display: block;
		font-size: 0.9rem;
		font-weight: 720;
	}

	.changelog-entry__content-inner ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.15rem;
		margin: 0.55rem 0 0;
		padding: 0;
		color: var(--record-ink, var(--deep-text));
		font-size: 0.75rem;
		list-style-position: inside;
	}

	.changelog-entry__content-inner li::marker {
		color: var(--content-meta);
	}

	@media (max-width: 620px) {
		.changelog-filter {
			margin-bottom: 1.25rem;
		}

		.changelog-timeline {
			padding-left: 1.1rem;
		}

		.changelog-entry__dot {
			left: -1.49rem;
		}

		.changelog-entry__box {
			margin-inline: 0;
		}

		.changelog-entry__summary {
			padding: 0.75rem;
		}

		.changelog-entry__content-inner {
			padding-inline: 0.75rem;
		}

		.changelog-entry[data-expanded="true"] .changelog-entry__content-inner {
			padding: 0.75rem 0.75rem 0.85rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.changelog-entry__summary,
		.changelog-entry__summary :global(svg),
		.changelog-entry__content,
		.changelog-entry__content-inner {
			transition: none;
		}
	}
</style>
