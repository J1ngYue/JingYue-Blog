---
import { Icon } from "astro-icon/components";
import RecordPageShell from "@/components/pages/record/RecordPageShell.astro";
import { changelogEntries } from "@/config/recordConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const filters = [
	{ key: "all", label: "全部", icon: "material-symbols:apps" },
	{
		key: "feature",
		label: "功能新增",
		icon: "material-symbols:rocket-launch-outline",
	},
	{
		key: "optimize",
		label: "功能优化",
		icon: "material-symbols:build-outline",
	},
	{
		key: "fix",
		label: "问题修复",
		icon: "material-symbols:bug-report-outline",
	},
	{
		key: "remove",
		label: "功能删除",
		icon: "material-symbols:delete-outline-rounded",
	},
];
const typeLabels = {
	feature: "功能新增",
	optimize: "功能优化",
	fix: "问题修复",
	remove: "功能删除",
} as const;

type ChangelogLink = { t: number; p: string[] };

const entryIndexByVersion = new Map(
	changelogEntries.map((entry, index) => [entry.version, index]),
);
const relationLinks: ChangelogLink[][] = changelogEntries.map(() => []);

for (const [sourceIndex, entry] of changelogEntries.entries()) {
	for (const relatedVersion of entry.related ?? []) {
		const targetIndex = entryIndexByVersion.get(relatedVersion);
		if (targetIndex === undefined || targetIndex === sourceIndex) continue;
		const label = typeLabels[entry.type];
		for (const [from, to] of [
			[sourceIndex, targetIndex],
			[targetIndex, sourceIndex],
		] as const) {
			if (!relationLinks[from].some((link) => link.t === to)) {
				relationLinks[from].push({ t: to, p: [label] });
			}
		}
	}
}
---

<MainGridLayout
	title="更新日志"
	bannerTitle="记录"
	description="记录每一次改进"
	articleHub
	contentOnly
	plainContent
>
	<RecordPageShell
		title="更新日志"
		description="记录博客项目的功能迭代、问题修复与重要变更。"
		icon="material-symbols:history"
	>
		<div class="changelog-page" data-changelog-page>
		<nav class="changelog-filter" aria-label="更新类型">
			{filters.map((filter, index) => (
				<button
					type="button"
					class:list={{ "is-active": index === 0 }}
					data-log-filter={filter.key}
					aria-pressed={index === 0 ? "true" : "false"}
				>
					<Icon is:inline name={filter.icon} />
					<span>{filter.label}</span>
					{index === 0 && <small>{changelogEntries.length}</small>}
				</button>
			))}
		</nav>

		<div class="changelog-board" data-changelog>
			<svg class="changelog-wires" data-changelog-wires aria-hidden="true">
				<defs>
					<marker id="changelog-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
						<path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
					</marker>
				</defs>
			</svg>
			<ol class="changelog-grid" data-changelog-grid>
			{changelogEntries.map((entry, index) => (
				<li
					class="changelog-card"
					data-changelog-card
					data-log-entry
					data-log-type={entry.type}
					data-log-index={index}
					data-index={index}
					data-links={JSON.stringify(relationLinks[index])}
					data-log-title={entry.title}
					data-log-summary={entry.summary}
					data-log-date={entry.date}
					data-log-time={entry.time}
					data-log-version={entry.version}
					data-log-type-label={typeLabels[entry.type]}
					data-log-changes={JSON.stringify(entry.changes)}
				>
					<button
						type="button"
						class="changelog-card__inner"
						data-log-toggle
						aria-haspopup="dialog"
					>
						<span class="changelog-card__num" aria-hidden="true">{String(changelogEntries.length - index).padStart(2, "0")}</span>
						<span class="changelog-card__meta">
							<span class="changelog-card__type">{typeLabels[entry.type]}</span>
						<time datetime={`${entry.date}T${entry.time}`}>
								{entry.date}
						</time>
						</span>
						<strong class="changelog-card__title">{entry.title}</strong>
						<em class="changelog-card__summary">{entry.summary}</em>
						<span class="changelog-card__version">{entry.version}</span>
					</button>
				</li>
			))}
			</ol>
		</div>

		<dialog class="changelog-dialog" data-changelog-dialog aria-labelledby="changelog-dialog-title">
			<button type="button" class="changelog-dialog__close" data-changelog-dialog-close aria-label="关闭更新详情">
				<Icon is:inline name="material-symbols:close-rounded" />
			</button>
			<div class="changelog-dialog__body">
				<header class="changelog-dialog__meta">
					<strong data-dialog-number></strong>
					<b data-dialog-type></b>
					<time data-dialog-date></time>
				</header>
				<h2 id="changelog-dialog-title" data-dialog-title></h2>
				<p class="changelog-dialog__summary" data-dialog-summary></p>
				<p class="changelog-dialog__version" data-dialog-version></p>
				<section class="changelog-dialog__section">
					<h3>完整变更</h3>
					<ul class="changelog-dialog__changes" data-dialog-changes></ul>
				</section>
				<section class="changelog-dialog__section">
					<h3>涉及页面</h3>
					<span class="changelog-dialog__type-pill" data-dialog-type-pill></span>
				</section>
				<section class="changelog-dialog__section">
					<h3>相关更新</h3>
					<div class="changelog-dialog__related" data-dialog-related></div>
				</section>
			</div>
		</dialog>
		</div>
	</RecordPageShell>
</MainGridLayout>


<style>
	.changelog-page {
		min-width: 0;
	}

	.changelog-filter {
		display: flex;
		min-height: 3.6rem;
		align-items: center;
		gap: 0.3rem;
		overflow-x: auto;
		margin: 0 0 2.4rem;
		border: 1px solid color-mix(in srgb, var(--record-ink, #111) 16%, transparent);
		border-radius: 1.25rem;
		background: color-mix(in srgb, var(--card-bg, #fff) 76%, transparent);
		padding: 0.38rem;
		scrollbar-width: none;
	}

	.changelog-filter::-webkit-scrollbar {
		display: none;
	}

	.changelog-filter button {
		display: inline-flex;
		min-height: 2.55rem;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.45rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		padding: 0.4rem 0.95rem;
		color: var(--record-ink, var(--deep-text));
		font: inherit;
		font-size: 0.8rem;
		font-weight: 620;
		cursor: pointer;
		transition: background-color 160ms ease, color 160ms ease;
	}

	.changelog-filter button:hover,
	.changelog-filter button:focus-visible {
		background: color-mix(in srgb, var(--record-ink, #111) 8%, transparent);
		outline: none;
	}

	.changelog-filter button:focus-visible {
		box-shadow: 0 0 0 3px color-mix(in srgb, #00a29b 22%, transparent);
	}

	.changelog-filter button.is-active {
		background: var(--record-ink, #111);
		color: var(--card-bg, #fff);
	}

	.changelog-filter button :global(svg) {
		width: 0.95rem;
		height: 0.95rem;
	}

	.changelog-filter small {
		display: grid;
		min-width: 1.35rem;
		height: 1.35rem;
		place-items: center;
		border-radius: 999px;
		background: color-mix(in srgb, currentColor 14%, transparent);
		font-size: 0.64rem;
	}

	/* 关系图层：卡片保持方形网格，SVG 只负责连接关系，不参与布局。 */
	.changelog-board {
		position: relative;
		isolation: isolate;
		min-width: 0;
		overflow: visible;
	}

	.changelog-wires {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

	.changelog-grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.875rem;
		margin: 0;
		padding: 0.15rem 0 2.5rem;
		list-style: none;
	}

	.changelog-card {
		position: relative;
		min-width: 0;
		aspect-ratio: 1;
		transition: opacity 220ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.changelog-card[hidden] {
		display: none;
	}

	.changelog-card__inner {
		display: flex;
		position: relative;
		width: 100%;
		height: 100%;
		min-height: 0;
		flex-direction: column;
		align-items: stretch;
		gap: 0.42rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--record-ink, #111) 12%, transparent);
		border-radius: 0.7rem;
		background: color-mix(in srgb, var(--card-bg, #fff) 94%, transparent);
		padding: 0.85rem 0.9rem;
		color: var(--record-ink, var(--deep-text));
		font: inherit;
		text-align: left;
		cursor: pointer;
		backdrop-filter: blur(8px);
		box-shadow: 0 0.4rem 1rem rgb(15 23 42 / 4%);
		transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease, background-color 180ms ease;
	}

	.changelog-card__inner:hover,
	.changelog-card__inner:focus-visible,
	.changelog-card.is-active .changelog-card__inner,
	.changelog-card.is-linked .changelog-card__inner {
		border-color: color-mix(in srgb, #00a29b 76%, transparent);
		background: color-mix(in srgb, var(--card-bg, #fff) 96%, #00a29b 4%);
		box-shadow: 0 0.7rem 1.4rem rgb(15 23 42 / 8%);
		outline: none;
	}

	.changelog-card__inner:hover,
	.changelog-card__inner:focus-visible {
		transform: translateY(-2px);
	}

	.changelog-board.is-hovering .changelog-card:not(.is-active):not(.is-linked) {
		opacity: 0.48;
	}

	.changelog-card__num {
		position: absolute;
		right: 0.5rem;
		bottom: -0.72rem;
		color: color-mix(in srgb, var(--record-ink, #111) 8%, transparent);
		font-size: clamp(3rem, 4vw, 4rem);
		font-weight: 850;
		letter-spacing: -0.08em;
		line-height: 1;
		pointer-events: none;
		user-select: none;
	}

	.changelog-card__meta {
		display: flex;
		position: relative;
		z-index: 1;
		align-items: center;
		gap: 0.45rem;
		min-width: 0;
		color: var(--content-meta);
		font-size: 0.68rem;
		font-variant-numeric: tabular-nums;
		line-height: 1.35;
	}

	.changelog-card__type {
		color: #00a29b;
		font-weight: 760;
	}

	.changelog-card__meta time {
		white-space: nowrap;
	}

	.changelog-card__title,
	.changelog-card__summary {
		position: relative;
		z-index: 1;
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
	}

	.changelog-card__title {
		-webkit-line-clamp: 4;
		font-size: 0.9rem;
		font-weight: 650;
		line-height: 1.45;
	}

	.changelog-card__summary {
		margin-top: auto;
		-webkit-line-clamp: 3;
		color: var(--record-muted, var(--content-meta));
		font-size: 0.77rem;
		font-style: normal;
		line-height: 1.6;
	}

	.changelog-card__version {
		position: relative;
		z-index: 1;
		align-self: flex-start;
		border-radius: 999px;
		background: color-mix(in srgb, #00a29b 11%, transparent);
		padding: 0.18rem 0.48rem;
		color: var(--record-ink, #111);
		font-size: 0.62rem;
		font-weight: 730;
	}

	.changelog-dialog {
		position: relative;
		width: min(42rem, calc(100vw - 2rem));
		max-width: none;
		max-height: min(82vh, 48rem);
		margin: auto;
		border: 1px solid rgb(17 24 39 / 12%);
		border-radius: 1rem;
		background: #fff;
		padding: 0;
		color: #18181b;
		box-shadow: 0 1.25rem 3.5rem rgb(15 23 42 / 18%);
	}

	.changelog-dialog::backdrop {
		background: rgb(12 16 22 / 48%);
		backdrop-filter: blur(6px) saturate(0.86);
		animation: changelog-backdrop-in 190ms ease-out both;
	}

	.changelog-dialog[open] {
		animation: changelog-dialog-in 190ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.changelog-dialog.is-closing::backdrop {
		animation: changelog-backdrop-out 170ms cubic-bezier(0.4, 0, 1, 1) both;
	}

	.changelog-dialog__body {
		max-height: min(82vh, 48rem);
		overflow-y: auto;
		padding: clamp(1.35rem, 3vw, 2rem);
		scrollbar-width: thin;
	}

	.changelog-dialog__close {
		position: absolute;
		top: 0.85rem;
		right: 0.85rem;
		z-index: 2;
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: color-mix(in srgb, var(--record-ink, #111) 8%, transparent);
		color: #18181b;
		cursor: pointer;
		transition: background-color 160ms ease, transform 160ms ease;
	}

	.changelog-dialog__close:hover,
	.changelog-dialog__close:focus-visible {
		background: rgb(24 24 27 / 10%);
		outline: none;
		transform: rotate(6deg);
	}

	.changelog-dialog__close :global(svg) {
		width: 1.05rem;
		height: 1.05rem;
	}

	.changelog-dialog__meta {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding-right: 2.5rem;
		color: #71717a;
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
	}

	.changelog-dialog__meta strong {
		color: #18181b;
		font-weight: 800;
	}

	.changelog-dialog__meta b {
		color: #18181b;
		font-weight: 750;
	}

	.changelog-dialog__meta time {
		color: #71717a;
	}

	.changelog-dialog h2 {
		margin: 1.05rem 2.4rem 0.85rem 0;
		font-size: clamp(1.2rem, 2.1vw, 1.55rem);
		font-weight: 700;
		line-height: 1.38;
	}

	.changelog-dialog__summary {
		margin: 0;
		color: #52525b;
		font-size: 0.88rem;
		line-height: 1.75;
	}

	.changelog-dialog__version {
		margin: 1rem 0 0;
		font-family: var(--font-jetbrains-mono), monospace;
		font-size: 0.76rem;
		font-weight: 650;
		color: #18181b;
	}

	.changelog-dialog__section {
		margin-top: 1.45rem;
	}

	.changelog-dialog__section h3 {
		margin: 0 0 0.6rem;
		color: #71717a;
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.04em;
	}

	.changelog-dialog__type-pill {
		display: inline-flex;
		align-items: center;
		border-radius: 999px;
		background: color-mix(in srgb, #00a29b 12%, transparent);
		padding: 0.3rem 0.7rem;
		color: color-mix(in srgb, #00a29b 78%, #18181b);
		font-size: 0.75rem;
		font-weight: 750;
	}

	.changelog-dialog__changes {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding-left: 1.15rem;
		color: #3f3f46;
		font-size: 0.8rem;
		line-height: 1.65;
	}

	.changelog-dialog__changes li::marker {
		color: #00a29b;
	}

	.changelog-dialog__related {
		display: grid;
		gap: 0.5rem;
	}

	:global(.changelog-dialog__related-item) {
		display: grid;
		gap: 0.2rem;
		width: 100%;
		border: 0;
		border-radius: 0.7rem;
		background: color-mix(in srgb, var(--record-ink, #111) 3%, transparent);
		padding: 0.72rem 0.8rem;
		color: #18181b;
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition: background-color 160ms ease, transform 160ms ease;
	}

	:global(.changelog-dialog__related-item:hover),
	:global(.changelog-dialog__related-item:focus-visible) {
		background: color-mix(in srgb, #00a29b 9%, transparent);
		outline: none;
		transform: translateX(2px);
	}

	:global(.changelog-dialog__related-item strong) {
		font-size: 0.8rem;
		font-weight: 750;
		line-height: 1.45;
	}

	:global(.changelog-dialog__related-item span),
	:global(.changelog-dialog__empty) {
		color: #71717a;
		font-size: 0.7rem;
	}

	@keyframes changelog-dialog-in {
		from { opacity: 0; transform: translateY(6px) scale(0.97); }
		to { opacity: 1; transform: translateY(0) scale(1); }
	}

	@keyframes changelog-backdrop-in {
		from { background: rgb(12 16 22 / 0%); backdrop-filter: blur(0); }
		to { background: rgb(12 16 22 / 48%); backdrop-filter: blur(6px) saturate(0.86); }
	}

	@keyframes changelog-backdrop-out {
		from { background: rgb(12 16 22 / 48%); backdrop-filter: blur(6px) saturate(0.86); }
		to { background: rgb(12 16 22 / 0%); backdrop-filter: blur(0); }
	}

	:global(.changelog-wire) {
		fill: none;
		stroke-width: 1.5px;
	}

	:global(.changelog-wire--row) {
		stroke: #00a29b;
		opacity: 0.34;
	}

	:global(.changelog-wire--hover) {
		stroke: #00a29b;
		stroke-width: 1.75px;
		stroke-dasharray: 6 5;
		stroke-dashoffset: 11px;
		opacity: 0;
		transition: opacity 240ms ease-out, stroke-dashoffset 420ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	:global(.changelog-wire--hover.is-drawn) {
		stroke-dashoffset: 0;
		opacity: 0.84;
	}

	:global(.changelog-wire-label) {
		position: absolute;
		z-index: 3;
		max-width: 12rem;
		overflow: hidden;
		transform: translate(-50%, -50%);
		visibility: hidden;
		border: 1px solid color-mix(in srgb, #00a29b 38%, transparent);
		border-radius: 999px;
		background: rgb(255 255 255 / 94%);
		padding: 0.25rem 0.62rem;
		color: #008e88;
		font-size: 0.68rem;
		font-weight: 750;
		line-height: 1.4;
		text-overflow: ellipsis;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		box-shadow: 0 0.25rem 0.8rem rgb(0 0 0 / 8%);
		transition: opacity 220ms ease-out 70ms, visibility 220ms ease-out 70ms;
	}

	:global(.changelog-wire-label.is-in) {
		visibility: visible;
		opacity: 1;
	}

	@media (max-width: 1024px) {
		.changelog-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
	}

	@media (max-width: 768px) {
		.changelog-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.7rem; }
		.changelog-card__inner { padding: 0.75rem; }
		.changelog-card__title { font-size: 0.84rem; }
		.changelog-card__summary { font-size: 0.68rem; }
	}

	@media (max-width: 560px) {
		.changelog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
		.changelog-card__inner { padding: 0.7rem; }
		.changelog-card__num { font-size: 3.2rem; }
		.changelog-card__title { -webkit-line-clamp: 5; font-size: 0.82rem; }
		.changelog-card__summary { -webkit-line-clamp: 3; }
		.changelog-board.is-hovering .changelog-card:not(.is-active):not(.is-linked) { opacity: 1; }
		:global(.changelog-wire--hover),
		:global(.changelog-wire-label) { display: none; }
		.changelog-dialog { width: calc(100vw - 1rem); max-height: 88vh; }
		.changelog-dialog__body { max-height: 88vh; padding: 1.15rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.changelog-card,
		.changelog-card__inner,
		.changelog-dialog,
		:global(.changelog-wire--hover),
		:global(.changelog-wire-label) {
			transition: none;
			animation: none;
		}
	}

</style>
