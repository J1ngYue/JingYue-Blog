---
import { Icon } from "astro-icon/components";
import ArchiveReplicaSidebar from "@/components/controls/ArchiveReplicaSidebar.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import {
	getCategoryList,
	getSortedPostsList,
	getTagList,
} from "@/utils/content-utils";
import { getTagUrl } from "@/utils/url-utils";

const [categories, posts, tags] = await Promise.all([
	getCategoryList(),
	getSortedPostsList(),
	getTagList(),
]);

const uncategorizedLabel = i18n(I18nKey.uncategorized);
const tagCountsByCategory = new Map<string, Map<string, number>>();

for (const post of posts) {
	const category = post.data.category?.trim() || uncategorizedLabel;
	const categoryTags =
		tagCountsByCategory.get(category) ?? new Map<string, number>();
	for (const tag of post.data.tags ?? []) {
		const name = tag.trim();
		categoryTags.set(name, (categoryTags.get(name) ?? 0) + 1);
	}
	tagCountsByCategory.set(category, categoryTags);
}

const categoryFolders = categories.map((category) => ({
	...category,
	tags: [...(tagCountsByCategory.get(category.name) ?? new Map())]
		.map(([name, count]) => ({ name, count }))
		.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "zh-CN")),
}));
const categoryData = categoryFolders
	.slice()
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "zh-CN"));
const tagData = tags
	.slice()
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "zh-CN"));
const totalPosts = categories.reduce(
	(sum, category) => sum + category.count,
	0,
);
const maxCategoryCount = Math.max(
	...categoryData.map((category) => category.count),
	1,
);
const maxTagCount = Math.max(...tagData.map((tag) => tag.count), 1);
const totalTagAssignments = tags.reduce((sum, tag) => sum + tag.count, 0);
const averageTagsPerPost = posts.length
	? (totalTagAssignments / posts.length).toFixed(1)
	: "0.0";
---

<MainGridLayout
	title={i18n(I18nKey.categories)}
	bannerTitle="文章"
	description="按分类和标签浏览所有文章"
	articleHub
	contentOnly
	plainContent
>
	<div class="category-replica-page onload-animation">
		<ArchiveReplicaSidebar side="left" posts={posts} />

		<section class="category-workbench" data-category-workbench>
		<header class="category-workbench__header">
			<div class="category-workbench__title">
				<Icon is:inline name="material-symbols:category-rounded" />
				<div>
					<h1>分类标签</h1>
					<p>按分类和标签浏览所有文章</p>
				</div>
			</div>

			<div
				class="category-workbench__switch"
				role="tablist"
				aria-label="分类页视图"
			>
				<button
					type="button"
					role="tab"
					aria-selected="true"
					aria-controls="category-folder-panel"
					data-category-view="folders"
					class="is-active"
				>
					<Icon is:inline name="material-symbols:folder-rounded" />
					文件夹
				</button>
				<button
					type="button"
					role="tab"
					aria-selected="false"
					aria-controls="category-data-panel"
					data-category-view="data"
				>
					<Icon is:inline name="material-symbols:bar-chart-rounded" />
					数据图
				</button>
				<span class="category-workbench__indicator" aria-hidden="true"></span>
			</div>
		</header>

		<div
			id="category-folder-panel"
			class="category-folder-list"
			role="tabpanel"
			data-category-panel="folders"
		>
			{categoryFolders.map((category, index) => {
				const panelId = `category-folder-tags-${index}`;
				return (
					<details class="category-folder">
						<summary
							class="category-folder__summary"
							aria-controls={panelId}
							aria-expanded="false"
						>
							<span class="category-folder__icon" aria-hidden="true">
								<Icon is:inline class="category-folder__icon-closed" name="material-symbols:folder-rounded" />
								<Icon is:inline class="category-folder__icon-open" name="material-symbols:folder-open-rounded" />
							</span>
							<span class="category-folder__heading">
								<strong class="category-folder__name">{category.name}</strong>
								<span class="category-folder__meta">
									{category.count} 篇文章 · {category.tags.length} 个标签
								</span>
							</span>
							<a
								href={category.url}
								class="category-folder__link"
								aria-label={`查看 ${category.name} 分类的所有文章`}
								data-category-folder-link
							>
								<Icon is:inline name="material-symbols:arrow-outward-rounded" />
							</a>
							<Icon is:inline class="category-folder__chevron" name="material-symbols:keyboard-arrow-down-rounded" />
						</summary>

						<div id={panelId} class="category-folder__content">
							<div class="category-folder__tags" aria-label={`${category.name}分类下的标签`}>
							{category.tags.length > 0 ? (
								category.tags.map((tag) => (
									<a class="category-folder__tag" href={getTagUrl(tag.name)}>
										<span class="category-folder__tag-name">#{tag.name}</span>
										<span class="category-folder__tag-count">{tag.count}</span>
									</a>
								))
							) : (
								<span>这个分类暂时没有标签</span>
							)}
							</div>
						</div>
					</details>
				);
			})}
		</div>

		<div
			id="category-data-panel"
			class="category-data-panel"
			role="tabpanel"
			data-category-panel="data"
			hidden
		>
			<div class="category-data-panel__summary">
				<div>
					<span>{categories.length}</span>
					<small>文章分类</small>
				</div>
				<div>
					<span>{tags.length}</span>
					<small>内容标签</small>
				</div>
				<div>
					<span>{totalPosts}</span>
					<small>收录文章</small>
				</div>
				<div>
					<span>{averageTagsPerPost}</span>
					<small>平均标签 / 文章</small>
				</div>
			</div>

			<div class="category-data-panel__grid">
				<section class="category-data-card" aria-labelledby="category-distribution-title">
					<header class="category-data-card__header">
						<div>
							<h2 id="category-distribution-title">分类分布</h2>
							<p>按文章数量查看内容重心</p>
						</div>
						<Icon is:inline name="material-symbols:bar-chart-rounded" />
					</header>
					<div class="category-data-bars">
						{categoryData.length > 0 ? (
							categoryData.map((category) => {
								const share = totalPosts
									? Math.round((category.count / totalPosts) * 100)
									: 0;
								const width = Math.max(
									4,
									Math.round((category.count / maxCategoryCount) * 100),
								);
								return (
									<a
										class="category-data-bar-row"
										href={category.url}
										title={`查看 ${category.name} 分类 · ${category.count} 篇文章`}
									>
										<span class="category-data-bar-row__meta">
											<strong>{category.name}</strong>
											<small>{category.count} 篇 · {share}%</small>
										</span>
										<span
											class="category-data-bar"
											role="meter"
											aria-label={`${category.name}文章占比`}
											aria-valuemin="0"
											aria-valuemax="100"
											aria-valuenow={share}
										>
											<span style={`--bar-width: ${width}%`}></span>
										</span>
									</a>
								);
							})
						) : (
							<p class="category-data-card__empty">暂时没有可统计的分类</p>
						)}
					</div>
				</section>

				<section class="category-data-card" aria-labelledby="tag-ranking-title">
					<header class="category-data-card__header">
						<div>
							<h2 id="tag-ranking-title">标签活跃度</h2>
							<p>最常出现在文章中的标签</p>
						</div>
						<Icon is:inline name="material-symbols:local-fire-department-rounded" />
					</header>
					<ol class="category-tag-ranking">
						{tagData.length > 0 ? (
							tagData.slice(0, 8).map((tag, index) => (
								<li>
									<span class="category-tag-ranking__index">{String(index + 1).padStart(2, "0")}</span>
									<a href={getTagUrl(tag.name)} title={`查看 #${tag.name} 标签`}>
										<span class="category-tag-ranking__name">#{tag.name}</span>
										<span class="category-tag-ranking__track" aria-hidden="true">
											<span style={`--bar-width: ${Math.max(4, Math.round((tag.count / maxTagCount) * 100))}%`}></span>
										</span>
										<strong>{tag.count}</strong>
									</a>
								</li>
							))
						) : (
							<li class="category-data-card__empty">暂时没有可统计的标签</li>
						)}
					</ol>
				</section>
			</div>
		</div>

		{categories.length === 0 && (
			<div class="category-workbench__empty">
				<Icon is:inline name="material-symbols:folder-off-rounded" />
				<p>{i18n(I18nKey.noData)}</p>
			</div>
		)}
		</section>

		<ArchiveReplicaSidebar side="right" posts={posts} />
	</div>
</MainGridLayout>

<script>
	function initCategoryWorkbench() {
		const roots = document.querySelectorAll<HTMLElement>(
			"[data-category-workbench]",
		);

		for (const root of roots) {
			if (root.dataset.bound === "true") continue;
			root.dataset.bound = "true";

			const viewButtons = root.querySelectorAll<HTMLButtonElement>(
				"[data-category-view]",
			);
			const panels = root.querySelectorAll<HTMLElement>(
				"[data-category-panel]",
			);
			const viewSwitch = root.querySelector<HTMLElement>(
				".category-workbench__switch",
			);
			const indicator = root.querySelector<HTMLElement>(
				".category-workbench__indicator",
			);

			const moveIndicator = (button: HTMLButtonElement) => {
				if (!viewSwitch || !indicator) return;
				indicator.style.left = `${button.offsetLeft}px`;
				indicator.style.width = `${button.offsetWidth}px`;
				viewSwitch.classList.add("is-ready");
			};

			for (const button of viewButtons) {
				button.addEventListener("click", () => {
					const view = button.dataset.categoryView;
					for (const currentButton of viewButtons) {
						const active = currentButton === button;
						currentButton.classList.toggle("is-active", active);
						currentButton.setAttribute("aria-selected", String(active));
					}
					for (const panel of panels) {
						panel.hidden = panel.dataset.categoryPanel !== view;
					}
					moveIndicator(button);
				});
			}

			const activeView = root.querySelector<HTMLButtonElement>(
				"[data-category-view].is-active",
			);
			if (activeView) requestAnimationFrame(() => moveIndicator(activeView));
			for (const link of root.querySelectorAll<HTMLElement>(
				"[data-category-folder-link]",
			)) {
				link.addEventListener("click", (event) => event.stopPropagation());
			}
			for (const folder of root.querySelectorAll<HTMLDetailsElement>(
				".category-folder",
			)) {
				const summary = folder.querySelector<HTMLElement>(
					".category-folder__summary",
				);
				const content = folder.querySelector<HTMLElement>(
					".category-folder__content",
				);
				const closeDuration = window.matchMedia(
					"(prefers-reduced-motion: reduce)",
				).matches
					? 0
					: 420;
				let closeTimer: number | undefined;
				const syncContentState = () => {
					if (content) {
						content.inert = !folder.open || folder.dataset.state === "closing";
					}
					summary?.setAttribute(
						"aria-expanded",
						String(folder.open && folder.dataset.state !== "closing"),
					);
				};
				const finishClose = () => {
					if (folder.dataset.state !== "closing") return;
					folder.open = false;
					delete folder.dataset.state;
					syncContentState();
				};
				summary?.addEventListener("click", (event) => {
					event.preventDefault();
					if (folder.dataset.state) return;
					if (!folder.open) {
						folder.open = true;
						syncContentState();
						return;
					}
					folder.dataset.state = "closing";
					syncContentState();
					closeTimer = window.setTimeout(finishClose, closeDuration);
				});
				syncContentState();
				folder.addEventListener("toggle", syncContentState);
				content?.addEventListener("transitionend", (event) => {
					if (
						folder.dataset.state === "closing" &&
						event.target === content &&
						event.propertyName === "grid-template-rows"
					) {
						if (closeTimer !== undefined) window.clearTimeout(closeTimer);
						finishClose();
					}
				});
			}
			window.addEventListener("resize", () => {
				const active = root.querySelector<HTMLButtonElement>(
					"[data-category-view].is-active",
				);
				if (active) moveIndicator(active);
			});
		}
	}

	initCategoryWorkbench();
	document.addEventListener("swup:contentReplaced", initCategoryWorkbench);
</script>

<style>
	.category-workbench {
		--category-text: #14181b;
		--category-text-soft: #434b50;
		--category-muted: #747e84;
		--category-surface: color-mix(in srgb, var(--card-bg) 96%, var(--category-text) 4%);
		--category-border: color-mix(in srgb, var(--category-text) 18%, transparent);
		width: 100%;
		padding: 1.5rem 0 3rem;
		color: var(--category-text);
	}

	.category-replica-page {
		display: grid;
		grid-template-columns: 17.5rem minmax(0, 61rem) 17.5rem;
		gap: 1rem;
		width: min(98rem, calc(100vw - 2rem));
		min-width: 0;
		margin-left: 50%;
		transform: translateX(-50%);
	}

	:global(body:has(.category-replica-page) #main-column-wrapper) {
		min-width: 0;
		overflow: visible;
	}

	:global(html.dark) .category-workbench {
		--category-text: #f4f6f7;
		--category-text-soft: #d3d9dc;
		--category-muted: #929da3;
	}

	.category-workbench__header {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}

	.category-workbench__title {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
	}

	.category-workbench__title > :global(svg) {
		width: 1.875rem;
		height: 1.875rem;
		margin-top: 0.08rem;
		color: var(--category-text);
	}

	.category-workbench__title h1 {
		margin: 0;
		font-size: 1.875rem;
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1.1;
	}

	.category-workbench__title p {
		margin: 0.75rem 0 0;
		color: var(--category-muted);
		font-size: 1rem;
		line-height: 1.65;
	}

	.category-workbench__switch {
		position: relative;
		display: inline-flex;
		flex: 0 0 auto;
		gap: 0.25rem;
		max-width: 100%;
		padding: 0.25rem;
		border: 1px solid var(--category-text);
		border-radius: 999rem;
		background: transparent;
	}

	.category-workbench__switch button {
		position: relative;
		z-index: 1;
		display: inline-flex;
		min-width: 6rem;
		min-height: 2.25rem;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		padding: 0.5rem 0.75rem;
		border: 0;
		border-radius: 999rem;
		background: transparent;
		color: var(--category-text-soft);
		font-family: inherit;
		font-size: 0.8125rem;
		font-weight: 700;
		line-height: 1;
		cursor: pointer;
		user-select: none;
		transition: color 200ms ease, opacity 200ms ease, transform 200ms ease;
	}

	.category-workbench__switch button :global(svg) {
		width: 1.1rem;
		height: 1.1rem;
	}

	.category-workbench__switch button.is-active {
		background: var(--category-text);
		color: var(--card-bg);
	}

	.category-workbench__switch.is-ready button.is-active {
		background: transparent;
	}

	.category-workbench__switch button:hover:not(.is-active) {
		opacity: 0.7;
	}

	.category-workbench__switch button:active {
		transform: scale(0.96);
	}

	.category-workbench__indicator {
		position: absolute;
		top: 0.25rem;
		bottom: 0.25rem;
		left: 0.25rem;
		z-index: 0;
		width: 0;
		border-radius: 999rem;
		background: var(--category-text);
		box-shadow: 0 1px 3px color-mix(in srgb, var(--category-text) 15%, transparent);
		opacity: 0;
		pointer-events: none;
		transition: left 300ms cubic-bezier(0.4, 0, 0.2, 1), width 300ms cubic-bezier(0.4, 0, 0.2, 1), opacity 150ms ease;
	}

	.category-workbench__switch.is-ready .category-workbench__indicator {
		opacity: 1;
	}

	.category-workbench__switch button:focus-visible,
	.category-folder a:focus-visible,
	.category-folder button:focus-visible,
	.category-data-card a:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--category-text) 70%, white);
		outline-offset: 3px;
	}

	.category-folder-list {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: start;
		gap: 1.5rem;
		padding-top: 0.75rem;
	}

	.category-folder {
		position: relative;
		border: 1px solid var(--category-border);
		border-radius: 0 0.5rem 0.5rem;
		background: var(--category-surface);
		min-width: 0;
		transition: border-color 200ms ease, box-shadow 200ms ease;
	}

	.category-folder::before {
		position: absolute;
		top: -0.75rem;
		left: -1px;
		width: min(42%, 10rem);
		height: 0.75rem;
		border: 1px solid var(--category-border);
		border-bottom: 0;
		border-radius: 0.5rem 0.5rem 0 0;
		background: var(--category-surface);
		content: "";
		transition: border-color 200ms ease;
	}

	.category-folder:hover {
		border-color: color-mix(in srgb, var(--category-text) 38%, transparent);
		box-shadow: 0 0.5rem 1.25rem rgb(18 24 28 / 6%);
	}

	.category-folder__summary {
		display: flex;
		min-height: 6rem;
		align-items: center;
		gap: 0.875rem;
		padding: 1.125rem 1.25rem;
		color: inherit;
		cursor: pointer;
		list-style: none;
	}

	.category-folder__summary::-webkit-details-marker {
		display: none;
	}

	.category-folder__summary:focus-visible {
		outline: 2px solid var(--category-text);
		outline-offset: 3px;
	}

	.category-folder__icon {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		flex: 0 0 2.75rem;
		place-items: center;
		border: 1px solid var(--category-border);
		border-radius: 0.375rem;
		background: var(--card-bg);
		color: var(--category-text);
	}

	.category-folder__icon :global(svg) {
		width: 1.5rem;
		height: 1.5rem;
	}

	.category-folder__icon-open,
	.category-folder[open] .category-folder__icon-closed {
		display: none;
	}

	.category-folder[open] .category-folder__icon-open {
		display: block;
	}

	.category-folder__heading {
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: column;
		gap: 0.25rem;
	}

	.category-folder__name {
		overflow-wrap: anywhere;
		font-size: 1.0625rem;
		font-weight: 800;
		line-height: 1.35;
	}

	.category-folder__meta {
		color: var(--category-muted);
		font-size: 0.8125rem;
		line-height: 1.5;
	}

	.category-folder__link {
		display: flex;
		width: 1.75rem;
		height: 1.75rem;
		flex: 0 0 1.75rem;
		align-items: center;
		justify-content: center;
		border-radius: 0.375rem;
		color: var(--category-text-soft);
		transition: background-color 150ms ease, color 150ms ease;
	}

	.category-folder__link:hover {
		background: color-mix(in srgb, var(--category-text) 9%, transparent);
		color: var(--category-text);
	}

	.category-folder__link :global(svg) {
		width: 1.2rem;
		height: 1.2rem;
	}

	.category-folder__chevron {
		width: 1.5rem;
		height: 1.5rem;
		flex: 0 0 1.5rem;
		color: var(--category-muted);
		transition: color 200ms ease, transform 200ms ease;
	}

	.category-folder[open] .category-folder__chevron {
		color: var(--category-text);
		transform: rotate(180deg);
	}

	.category-folder__content {
		display: grid;
		grid-template-rows: 0fr;
		min-height: 0;
		padding: 0 1.25rem;
		border-top: 1px solid transparent;
		overflow: hidden;
		transition:
			grid-template-rows 420ms cubic-bezier(0.22, 1, 0.36, 1),
			padding 420ms cubic-bezier(0.22, 1, 0.36, 1),
			border-color 220ms ease;
	}

	.category-folder[open] .category-folder__content {
		grid-template-rows: 1fr;
		padding: 1rem 1.25rem 1.25rem;
		border-top-color: var(--category-border);
	}

	.category-folder[data-state="closing"] .category-folder__content {
		grid-template-rows: 0fr;
		padding: 0 1.25rem;
		border-top-color: transparent;
	}

	.category-folder__tags {
		display: flex;
		min-height: 0;
		flex-wrap: wrap;
		gap: 0.5rem;
		overflow: hidden;
		opacity: 0;
		transform: translateY(-0.35rem);
		transition:
			opacity 260ms ease,
			transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.category-folder[open] .category-folder__tags {
		opacity: 1;
		transform: translateY(0);
	}

	.category-folder[data-state="closing"] .category-folder__tags {
		opacity: 0;
		transform: translateY(-0.35rem);
	}

	.category-folder__tag,
	.category-folder__tags > span {
