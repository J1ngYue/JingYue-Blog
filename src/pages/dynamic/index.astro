---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import DynamicFeed from "@/components/pages/dynamic/DynamicFeed.svelte";
import DynamicItemTemplate from "@/components/pages/dynamic/DynamicItemTemplate.astro";
import {
	commentConfig,
	dynamicConfig,
	profileConfig,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/dynamic.css";
import { getCollection } from "astro:content";
import { url } from "@/utils/url-utils";

if (!siteConfig.pages.dynamic) {
	return Astro.redirect("/404/");
}

const title = dynamicConfig.title || i18n(I18nKey.dynamic);
const description =
	dynamicConfig.description || i18n(I18nKey.dynamicDescription);
const itemsPerPage = Math.max(1, dynamicConfig.itemsPerPage ?? 10);
const showInlineComments = Boolean(
	dynamicConfig.showComment !== false &&
		commentConfig.type &&
		commentConfig.type !== "none",
);
const dataUrl = url("/api/dynamic.json");
const dynamicCount = (await getCollection("dynamic")).length;
---

<MainGridLayout title={title} description={description}>
	<section class="dynamic-page" aria-labelledby="dynamic-page-title">
		<div>
			<header class="dynamic-editorial-hero">
				<div class="dynamic-editorial-hero__copy">
					<p class="dynamic-editorial-hero__eyebrow">MOMENTS · JINGYUE</p>
					<h1 id="dynamic-page-title">{title}</h1>
					<p>{description}</p>
					<div class="dynamic-editorial-hero__count">
						<span>共记录</span>
						<strong>{dynamicCount}</strong>
						<span>条片刻</span>
					</div>
				</div>
				<div class="dynamic-editorial-hero__profile">
					<a href="/about/" aria-label={`了解 ${profileConfig.name}`}>
						<ImageWrapper
							src={profileConfig.avatar || ""}
							alt={profileConfig.name}
							widths={[128]}
							sizes="72px"
							loading="eager"
							siteAvatar
							fadeIn={false}
						/>
					</a>
					<div>
						<strong>{profileConfig.name}</strong>
						<span>{profileConfig.bio}</span>
					</div>
				</div>
				<div class="dynamic-editorial-hero__orbit" aria-hidden="true">
					<i></i><i></i><i></i><i></i><i></i><i></i>
				</div>
			</header>

			<div class="dynamic-page-header">
				<div class="dynamic-filter">
					<label class="dynamic-search">
						<Icon is:inline name="material-symbols:search-rounded" />
						<input
							type="search"
							data-dynamic-search
							aria-label={i18n(I18nKey.dynamicSearch)}
							placeholder={i18n(I18nKey.dynamicSearch)}
						/>
					</label>
					<label class="dynamic-year-select">
						<Icon is:inline name="material-symbols:calendar-month-rounded" />
						<select data-year-select aria-label={i18n(I18nKey.year)}>
							<option value="all">{i18n(I18nKey.dynamicAllYears)}</option>
						</select>
						<Icon is:inline name="material-symbols:arrow-drop-down-rounded" />
					</label>
					<label class="dynamic-sort-select">
						<Icon is:inline name="material-symbols:swap-vert-rounded" />
						<select data-dynamic-sort aria-label="动态排序">
							<option value="newest">最新优先</option>
							<option value="oldest">最早优先</option>
						</select>
						<Icon is:inline name="material-symbols:arrow-drop-down-rounded" />
					</label>
				</div>
			</div>

			<DynamicFeed
				client:load
				source={dataUrl}
				{itemsPerPage}
				showComments={showInlineComments}
				emptyText={i18n(I18nKey.dynamicEmpty)}
				noResultsText={i18n(I18nKey.dynamicNoResults)}
				loadingText={i18n(I18nKey.dynamicLoading)}
				allYearsText={i18n(I18nKey.dynamicAllYears)}
				timezone={siteConfig.timezone || "UTC"}
			/>

			<DynamicItemTemplate />
		</div>
	</section>
</MainGridLayout>
