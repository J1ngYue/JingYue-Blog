---
import { Icon } from "astro-icon/components";
import ArchiveReplicaSidebar from "@/components/controls/ArchiveReplicaSidebar.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPostsList, getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/url-utils";

const [tags, posts] = await Promise.all([getTagList(), getSortedPostsList()]);
const sortedTags = tags
	.slice()
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "zh-CN"));
const topTags = sortedTags.slice(0, 10);
const topMaxCount = topTags[0]?.count ?? 1;
const totalTagAssignments = tags.reduce((sum, tag) => sum + tag.count, 0);
const taggedPostCount = posts.filter(
	(post) => (post.data.tags?.length ?? 0) > 0,
).length;
const averageTagsPerPost = posts.length
	? (totalTagAssignments / posts.length).toFixed(1)
	: "0.0";
const mostPopularTag = sortedTags[0];
---

<MainGridLayout
	title={i18n(I18nKey.tags)}
	bannerTitle="文章"
	description={i18n(I18nKey.allTags)}
	articleHub
	contentOnly
	plainContent
>
	<div class="tag-replica-page onload-animation">
		<ArchiveReplicaSidebar side="left" posts={posts} />

		<main class="tag-workbench" data-tag-workbench>
			<header class="tag-workbench__header">
				<div class="tag-workbench__title">
					<Icon is:inline name="material-symbols:tag-rounded" />
					<div>
						<h1>文章标签</h1>
						<p>从关键词出发，发现相互关联的内容</p>
					</div>
				</div>

				<div class="tag-workbench__switch" role="tablist" aria-label="标签页视图">
					<button
						type="button"
						role="tab"
						aria-selected="true"
						aria-controls="tag-index-panel"
						data-tag-view="index"
						class="is-active"
					>
						<Icon is:inline name="material-symbols:grid-view-rounded" />
						标签索引
					</button>
					<button
						type="button"
						role="tab"
						aria-selected="false"
						aria-controls="tag-ranking-panel"
						data-tag-view="ranking"
					>
						<Icon is:inline name="material-symbols:leaderboard-rounded" />
						热度排行
					</button>
				</div>
			</header>

			<section class="tag-overview" aria-label="标签概览">
				<div>
					<span class="tag-overview__icon" aria-hidden="true">
						<Icon is:inline name="material-symbols:tag-rounded" />
					</span>
					<span>
						<strong>{tags.length}</strong>
						<small>内容标签</small>
					</span>
				</div>
				<div>
					<span class="tag-overview__icon" aria-hidden="true">
						<Icon is:inline name="material-symbols:article-outline-rounded" />
					</span>
					<span>
						<strong>{taggedPostCount}</strong>
						<small>已标记文章</small>
					</span>
				</div>
				<div>
					<span class="tag-overview__icon" aria-hidden="true">
						<Icon is:inline name="material-symbols:data-usage-rounded" />
					</span>
					<span>
						<strong>{averageTagsPerPost}</strong>
						<small>平均标签 / 文章</small>
					</span>
				</div>
			</section>

			<section
				id="tag-index-panel"
				class="tag-panel"
				role="tabpanel"
				data-tag-panel="index"
			>
				<div class="tag-panel__toolbar">
					<div>
						<h2>全部标签</h2>
						<p><span data-tag-visible-count>{tags.length}</span> 个关键词</p>
					</div>
					<label class="tag-search">
						<Icon is:inline name="material-symbols:search-rounded" aria-hidden="true" />
						<span class="sr-only">搜索标签</span>
						<input
							type="search"
							placeholder="搜索标签"
							autocomplete="off"
							data-tag-search
						/>
					</label>
				</div>

				<div class="tag-card-grid" data-tag-grid>
					{sortedTags.map((tag, index) => (
						<a
							href={getTagUrl(tag.name)}
							class:list={["tag-card", { "is-featured": index < 3 }]}
							data-tag-card
							data-tag-name={tag.name.trim().toLocaleLowerCase()}
							style={`--tag-share: ${Math.max(8, Math.round((tag.count / topMaxCount) * 100))}%`}
						>
							<span class="tag-card__top">
								<span class="tag-card__symbol" aria-hidden="true">#</span>
								<span class="tag-card__rank">{String(index + 1).padStart(2, "0")}</span>
							</span>
							<strong>{tag.name.trim()}</strong>
							<span class="tag-card__meter" aria-hidden="true">
								<span></span>
							</span>
							<span class="tag-card__footer">
								<small>{tag.count} 篇文章</small>
								<Icon is:inline name="material-symbols:arrow-outward-rounded" />
							</span>
						</a>
					))}
				</div>

				<div class="tag-panel__empty" data-tag-search-empty hidden>
					<Icon is:inline name="material-symbols:search-off-rounded" />
					<strong>没有匹配的标签</strong>
					<p>换一个关键词试试</p>
				</div>
			</section>

			<section
				id="tag-ranking-panel"
				class="tag-panel"
				role="tabpanel"
				data-tag-panel="ranking"
				hidden
			>
				<div class="tag-ranking__intro">
					<div>
						<p>POPULAR TAGS</p>
						<h2>热度 Top 10</h2>
						<span>按照文章引用次数排序</span>
					</div>
					{mostPopularTag && (
						<a href={getTagUrl(mostPopularTag.name)} class="tag-ranking__leader">
							<span>当前最热</span>
							<strong>#{mostPopularTag.name}</strong>
							<small>{mostPopularTag.count} 篇文章</small>
						</a>
					)}
				</div>

				<ol class="tag-ranking">
					{topTags.map((tag, index) => (
						<li>
							<a
								href={getTagUrl(tag.name)}
								style={`--tag-share: ${Math.max(8, Math.round((tag.count / topMaxCount) * 100))}%`}
							>
								<span class="tag-ranking__index">{String(index + 1).padStart(2, "0")}</span>
								<span class="tag-ranking__content">
									<span class="tag-ranking__meta">
										<strong>#{tag.name.trim()}</strong>
										<small>{tag.count} 篇</small>
									</span>
									<span class="tag-ranking__track" aria-hidden="true"><span></span></span>
								</span>
								<Icon is:inline name="material-symbols:chevron-right-rounded" />
							</a>
						</li>
					))}
				</ol>
			</section>

			{tags.length === 0 && (
				<div class="tag-workbench__empty">
					<Icon is:inline name="material-symbols:tag-off-rounded" />
					<p>{i18n(I18nKey.noData)}</p>
				</div>
			)}
		</main>

		<ArchiveReplicaSidebar side="right" posts={posts} />
	</div>
</MainGridLayout>

<script>
	function initTagWorkbench() {
		const roots = document.querySelectorAll<HTMLElement>("[data-tag-workbench]");

		for (const root of roots) {
			if (root.dataset.bound === "true") continue;
			root.dataset.bound = "true";

			const viewButtons = root.querySelectorAll<HTMLButtonElement>("[data-tag-view]");
			const panels = root.querySelectorAll<HTMLElement>("[data-tag-panel]");
			const search = root.querySelector<HTMLInputElement>("[data-tag-search]");
			const cards = root.querySelectorAll<HTMLElement>("[data-tag-card]");
			const visibleCount = root.querySelector<HTMLElement>("[data-tag-visible-count]");
			const searchEmpty = root.querySelector<HTMLElement>("[data-tag-search-empty]");

			for (const button of viewButtons) {
				button.addEventListener("click", () => {
					const view = button.dataset.tagView;
					for (const currentButton of viewButtons) {
						const active = currentButton === button;
						currentButton.classList.toggle("is-active", active);
						currentButton.setAttribute("aria-selected", String(active));
					}
					for (const panel of panels) {
						panel.hidden = panel.dataset.tagPanel !== view;
					}
				});
			}

			search?.addEventListener("input", () => {
				const query = search.value.trim().toLocaleLowerCase();
				let visible = 0;
				for (const card of cards) {
					const matches = !query || (card.dataset.tagName ?? "").includes(query);
					card.hidden = !matches;
					if (matches) visible += 1;
				}
				if (visibleCount) visibleCount.textContent = String(visible);
				if (searchEmpty) searchEmpty.hidden = visible > 0;
			});
		}
	}

	initTagWorkbench();
	document.addEventListener("swup:contentReplaced", initTagWorkbench);
</script>

<style>
	.tag-replica-page {
		display: grid;
		grid-template-columns: 17.5rem minmax(0, 61rem) 17.5rem;
		gap: 1rem;
		width: min(98rem, calc(100vw - 2rem));
		min-width: 0;
		margin-left: 50%;
		transform: translateX(-50%);
	}

	:global(body:has(.tag-replica-page) #main-column-wrapper) {
		min-width: 0;
		overflow: visible;
	}

	.tag-workbench {
		--tag-text: #14181b;
		--tag-text-soft: #434b50;
		--tag-muted: #747e84;
		--tag-border: color-mix(in srgb, var(--tag-text) 18%, transparent);
		--tag-surface: color-mix(in srgb, var(--card-bg) 96%, var(--tag-text) 4%);
		width: 100%;
		min-width: 0;
		padding: 1.5rem 0 3rem;
		color: var(--tag-text);
	}

	:global(html.dark) .tag-workbench {
		--tag-text: #f4f6f7;
		--tag-text-soft: #d3d9dc;
		--tag-muted: #929da3;
	}

	.tag-workbench__header {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}

	.tag-workbench__title {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
	}

	.tag-workbench__title > :global(svg) {
		width: 1.875rem;
		height: 1.875rem;
		margin-top: 0.08rem;
	}

	.tag-workbench__title h1 {
		margin: 0;
		font-size: 1.875rem;
		font-weight: 800;
		line-height: 1.1;
	}

	.tag-workbench__title p {
		margin: 0.75rem 0 0;
		color: var(--tag-muted);
		font-size: 1rem;
		line-height: 1.65;
	}

	.tag-workbench__switch {
		display: inline-flex;
		gap: 0.25rem;
		max-width: 100%;
		padding: 0.25rem;
		border: 1px solid var(--tag-text);
		border-radius: 999rem;
	}

	.tag-workbench__switch button {
		display: inline-flex;
		min-width: 6rem;
		min-height: 2.25rem;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		padding: 0.5rem 0.75rem;
		border: 0;
		border-radius: 999rem;
		background: transparent;
		color: var(--tag-text-soft);
		font-family: inherit;
		font-size: 0.8125rem;
		font-weight: 700;
		line-height: 1;
		cursor: pointer;
		transition: background-color 180ms ease, color 180ms ease, opacity 180ms ease;
	}

	.tag-workbench__switch button :global(svg) {
		width: 1.1rem;
		height: 1.1rem;
	}

	.tag-workbench__switch button.is-active {
		background: var(--tag-text);
		color: var(--card-bg);
	}

	.tag-workbench__switch button:hover:not(.is-active) {
		opacity: 0.68;
	}

	.tag-workbench__switch button:focus-visible,
	.tag-search:has(input:focus-visible),
	.tag-card:focus-visible,
	.tag-ranking a:focus-visible,
	.tag-ranking__leader:focus-visible {
		outline: 3px solid var(--tag-text);
		outline-offset: 3px;
	}

	.tag-overview {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin: 0.25rem 0 2rem;
		border-block: 1px solid var(--tag-border);
	}

	.tag-overview > div {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem 1.15rem;
		border-right: 1px solid var(--tag-border);
	}

	.tag-overview > div:last-child {
		border-right: 0;
	}

	.tag-overview__icon {
		display: grid;
		width: 2.35rem;
		height: 2.35rem;
		flex: 0 0 2.35rem;
		place-items: center;
		border-radius: 0.45rem;
		background: color-mix(in srgb, var(--tag-text) 8%, transparent);
		color: var(--tag-text);
	}

	.tag-overview__icon :global(svg) {
		width: 1.2rem;
		height: 1.2rem;
	}

	.tag-overview strong,
	.tag-overview small {
		display: block;
	}

	.tag-overview strong {
		font-size: 1.35rem;
		font-weight: 850;
		line-height: 1;
	}

	.tag-overview small {
		margin-top: 0.28rem;
		color: var(--tag-muted);
		font-size: 0.72rem;
		line-height: 1.35;
	}

	.tag-panel[hidden] {
		display: none;
	}

	.tag-panel__toolbar {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.tag-panel__toolbar h2,
	.tag-ranking__intro h2 {
		margin: 0;
		font-size: 1.1rem;
		font-weight: 800;
		line-height: 1.3;
	}

	.tag-panel__toolbar p {
		margin: 0.25rem 0 0;
		color: var(--tag-muted);
		font-size: 0.75rem;
	}

	.tag-search {
		display: flex;
		width: min(15rem, 100%);
		min-height: 2.5rem;
		align-items: center;
		gap: 0.5rem;
		padding: 0 0.75rem;
		border: 1px solid var(--tag-border);
		border-radius: 0.5rem;
		background: var(--tag-surface);
		color: var(--tag-muted);
		transition: border-color 180ms ease, background-color 180ms ease;
	}

	.tag-search:hover,
	.tag-search:has(input:focus-visible) {
		border-color: var(--tag-text);
		background: var(--card-bg);
	}

	.tag-search :global(svg) {
		width: 1.15rem;
		height: 1.15rem;
		flex: 0 0 auto;
	}

	.tag-search input {
		width: 100%;
		min-width: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--tag-text);
		font-family: inherit;
		font-size: 0.8rem;
		font-weight: 600;
		line-height: 1.2;
	}

	.tag-search input::placeholder {
		color: var(--tag-muted);
	}

	.tag-card-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.tag-card {
		display: grid;
		min-width: 0;
		min-height: 9rem;
		grid-template-rows: auto 1fr auto auto;
		gap: 0.75rem;
		padding: 1rem;
		border: 1px solid var(--tag-border);
		border-radius: 0.5rem;
		background: var(--tag-surface);
		color: var(--tag-text);
		cursor: pointer;
		transition: border-color 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
	}

	.tag-card[hidden] {
		display: none;
	}

	.tag-card:hover {
		border-color: var(--tag-text);
		background: var(--card-bg);
		box-shadow: 0 0.55rem 1.25rem rgb(18 24 28 / 7%);
	}

	.tag-card.is-featured {
		border-color: color-mix(in srgb, var(--tag-text) 42%, var(--tag-border));
	}

	.tag-card__top,
	.tag-card__footer,
	.tag-ranking__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.tag-card__symbol {
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		border-radius: 0.4rem;
		background: color-mix(in srgb, var(--tag-text) 8%, transparent);
		font-size: 1.05rem;
		font-weight: 850;
	}

	.tag-card.is-featured .tag-card__symbol {
		background: color-mix(in srgb, var(--tag-text) 12%, transparent);
		color: var(--tag-text);
	}

	.tag-card__rank {
		color: var(--tag-muted);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.68rem;
		font-weight: 700;
	}

	.tag-card > strong {
		align-self: end;
		overflow-wrap: anywhere;
		font-size: 1rem;
		font-weight: 800;
		line-height: 1.3;
	}

	.tag-card__meter,
	.tag-ranking__track {
		display: block;
		height: 0.3rem;
		overflow: hidden;
		border-radius: 999rem;
		background: color-mix(in srgb, var(--tag-text) 9%, transparent);
	}

	.tag-card__meter > span,
	.tag-ranking__track > span {
		display: block;
		width: var(--tag-share);
		height: 100%;
		border-radius: inherit;
		background: var(--tag-text);
	}

	.tag-card.is-featured .tag-card__meter > span,
	.tag-ranking li:nth-child(-n + 3) .tag-ranking__track > span {
		background: var(--tag-text);
	}

	.tag-card__footer {
		color: var(--tag-muted);
	}

	.tag-card__footer small {
		font-size: 0.72rem;
	}

	.tag-card__footer :global(svg) {
		width: 1.05rem;
		height: 1.05rem;
		transition: color 180ms ease, transform 180ms ease;
	}

	.tag-card:hover .tag-card__footer :global(svg) {
		color: var(--tag-text);
		transform: translate(0.12rem, -0.12rem);
	}

	.tag-panel__empty,
	.tag-workbench__empty {
		display: grid;
		min-height: 15rem;
		place-items: center;
		align-content: center;
		gap: 0.4rem;
		color: var(--tag-muted);
		text-align: center;
	}

	.tag-panel__empty[hidden] {
		display: none;
	}

	.tag-panel__empty :global(svg),
	.tag-workbench__empty :global(svg) {
		width: 2.5rem;
		height: 2.5rem;
	}

	.tag-panel__empty strong,
	.tag-panel__empty p,
	.tag-workbench__empty p {
		margin: 0;
	}

	.tag-panel__empty p {
		font-size: 0.78rem;
	}

	.tag-ranking__intro {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--tag-border);
	}

	.tag-ranking__intro p {
		margin: 0 0 0.35rem;
		color: var(--tag-text);
		font-size: 0.68rem;
		font-weight: 850;
		letter-spacing: 0.14em;
	}

	.tag-ranking__intro > div > span {
		display: block;
		margin-top: 0.35rem;
		color: var(--tag-muted);
		font-size: 0.75rem;
	}

	.tag-ranking__leader {
		display: grid;
		min-width: 11rem;
		gap: 0.15rem;
		padding: 0.8rem 0.9rem;
		border: 1px solid color-mix(in srgb, var(--tag-text) 42%, var(--tag-border));
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--tag-text) 8%, var(--card-bg));
		color: var(--tag-text);
	}

	.tag-ranking__leader span,
	.tag-ranking__leader small {
		color: var(--tag-muted);
		font-size: 0.65rem;
	}

	.tag-ranking__leader strong {
		overflow-wrap: anywhere;
		font-size: 0.9rem;
	}

	.tag-ranking {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tag-ranking a {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr) 1.25rem;
		align-items: center;
		gap: 0.75rem;
		min-height: 4.5rem;
		padding: 0.8rem 0.9rem;
		border: 1px solid var(--tag-border);
		border-radius: 0.5rem;
		background: var(--tag-surface);
		color: var(--tag-text);
		transition: border-color 180ms ease, background-color 180ms ease;
	}

	.tag-ranking a:hover {
		border-color: var(--tag-text);
		background: var(--card-bg);
	}

	.tag-ranking__index {
		color: var(--tag-muted);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.72rem;
		font-weight: 800;
	}

	.tag-ranking li:nth-child(-n + 3) .tag-ranking__index {
		color: var(--tag-text);
	}

	.tag-ranking__content {
		display: grid;
		min-width: 0;
		gap: 0.55rem;
	}

	.tag-ranking__meta strong {
		overflow: hidden;
		min-width: 0;
		font-size: 0.8rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.tag-ranking__meta small {
		flex: 0 0 auto;
		color: var(--tag-muted);
		font-size: 0.68rem;
	}

	.tag-ranking a > :global(svg) {
		width: 1.25rem;
		height: 1.25rem;
		color: var(--tag-muted);
	}

	@media (max-width: 1399px) and (min-width: 1100px) {
		.tag-replica-page {
			grid-template-columns: 14rem minmax(0, 1fr) 14rem;
