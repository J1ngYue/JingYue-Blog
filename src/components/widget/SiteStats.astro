---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { siteConfig } from "@/config";
import { changelogEntries } from "@/config/recordConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
	variant?: "default" | "sidebar";
}

const {
	class: className,
	style,
	widgetConfig,
	variant = "default",
} = Astro.props;
const widgetClassName = [
	className,
	variant === "sidebar" ? "site-stats--sidebar" : "",
]
	.filter(Boolean)
	.join(" ");

const showTitle = widgetConfig?.showTitle !== false;

// 从配置中获取站点开始日期
const siteStartDate = siteConfig.siteStartDate || "2025-01-01";

// 获取所有文章
const posts = await getSortedPosts();
const dynamics = siteConfig.pages.dynamic ? await getCollection("dynamic") : [];
const categories = await getCategoryList();
const tags = await getTagList();

// 计算总字数
let totalWords = 0;
for (const post of posts) {
	if (post.body) {
		// 移除代码块和内联代码后计算字数
		let text = post.body
			.replace(/```[\s\S]*?```/g, "") // 移除代码块
			.replace(/`[^`]*`/g, "") // 移除内联代码
			.replace(/\s+/g, " ") // 合并空白
			.trim();

		// 分别计算中文字符和英文字符
		const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || [];
		const englishChars = text.match(/[a-zA-Z]/g) || [];

		totalWords += chineseChars.length + englishChars.length;
	}
}

// 格式化数字（添加千位分隔符）
function formatNumber(num: number): string {
	return num.toLocaleString();
}

// 获取「最后活动」时间：取每篇文章 published 与 updated 中较新的那个，再从全站所有文章里取最大值。这样新发文章和修改老文章都会刷新该字段。
const getActivityDate = (post: (typeof posts)[number]): Date => {
	const { published, updated } = post.data;
	if (updated && updated > published) return updated;
	return published;
};

const activityDates = [
	...posts.map(getActivityDate),
	...dynamics.map((entry) => entry.data.published),
	...changelogEntries.map(
		(entry) => new Date(`${entry.date}T${entry.time}:00+08:00`),
	),
].filter((date) => !Number.isNaN(date.getTime()));
const lastActivityDate = activityDates.reduce<Date | null>(
	(latest, current) => (!latest || current > latest ? current : latest),
	null,
);

const lastPostDate = lastActivityDate ? lastActivityDate.toISOString() : null;

const todayText = i18n(I18nKey.today);

const stats = [
	{
		icon: "material-symbols:article-outline",
		label: i18n(I18nKey.siteStatsPostCount),
		value: posts.length,
	},
	...(siteConfig.pages.dynamic
		? [
				{
					icon: "material-symbols:dynamic-feed-rounded",
					label: i18n(I18nKey.siteStatsDynamicCount),
					value: dynamics.length,
				},
			]
		: []),
	{
		icon: "material-symbols:edit-note-rounded",
		label: "记录次数",
		value: changelogEntries.length,
	},
	{
		icon: "material-symbols:folder-outline",
		label: i18n(I18nKey.siteStatsCategoryCount),
		value: categories.length,
	},
	{
		icon: "material-symbols:label-outline",
		label: i18n(I18nKey.siteStatsTagCount),
		value: tags.length,
	},
	{
		icon: "material-symbols:text-ad-outline-rounded",
		label: i18n(I18nKey.siteStatsTotalWords),
		value: totalWords,
		formatted: true,
	},
	{
		icon: "material-symbols:calendar-clock-outline",
		label: i18n(I18nKey.siteStatsRunningDays),
		value: 0, // 将由客户端更新
		suffix: i18n(I18nKey.siteStatsDays).replace("{days}", ""),
		dynamic: true,
		id: "running-days",
	},
	{
		icon: "mingcute:heartbeat-line",
		label: i18n(I18nKey.siteStatsLastUpdate),
		value: 0, // 将由客户端更新
		suffix: i18n(I18nKey.siteStatsDaysAgo).replace("{days}", ""),
		dynamic: true,
		id: "last-update",
	},
];
---

<WidgetLayout name={i18n(I18nKey.siteStats)} showTitle={showTitle} id="site-stats" class={widgetClassName} style={style}>
  <div class="site-stats__list flex flex-col gap-2">
    {stats.map((stat) => (
      <div class="site-stats__row flex items-center justify-between px-3 py-1.5">
        <div class="site-stats__label-group flex items-center gap-2.5">
          <div class="site-stats__icon text-(--ui-icon-color) text-xl">
            <Icon is:inline name={stat.icon} />
          </div>
          <span class="site-stats__label text-neutral-700 dark:text-neutral-300 font-medium text-sm">
            {stat.label}
          </span>
        </div>
        <div class="site-stats__number flex items-center">
          <span
            class="site-stats__value text-base font-bold text-neutral-900 dark:text-neutral-100"
            data-stat-id={stat.id}
          >
            {stat.formatted ? formatNumber(stat.value) : stat.value}
          </span>
          {stat.suffix && (
            <span class="ml-1 text-sm text-neutral-500 dark:text-neutral-400">
              {stat.suffix}
            </span>
          )}
        </div>
      </div>
    ))}
  </div>
</WidgetLayout>

<style>
  :global(widget-layout.site-stats--sidebar) {
    display: block;
    overflow: hidden;
    border: 1px solid rgb(0 0 0 / 8%);
    border-radius: 0.625rem;
    background: color-mix(in srgb, var(--card-bg) 97%, transparent);
    box-shadow: 0 0 0.75rem 0.125rem rgb(0 0 0 / 6%);
    backdrop-filter: blur(1rem);
  }

  :global(html.dark widget-layout.site-stats--sidebar) {
    border-color: rgb(255 255 255 / 10%);
    box-shadow: 0 0 0.75rem 0.125rem rgb(0 0 0 / 18%);
  }

  :global(widget-layout.site-stats--sidebar .widget-title) {
    margin: 1.35rem 1.25rem 0.75rem 2.2rem;
    color: var(--deep-text);
    font-size: 1.125rem;
    line-height: 1.4;
  }

  :global(widget-layout.site-stats--sidebar .widget-title::before) {
    top: 0.22rem;
    left: -1rem;
    width: 0.22rem;
    height: 1.2rem;
    border-radius: 0;
    background: var(--deep-text);
  }

  :global(widget-layout.site-stats--sidebar #site-stats) {
    padding: 0 1rem 1.1rem;
  }

  :global(widget-layout.site-stats--sidebar) .site-stats__list {
    gap: 0.1rem;
  }

  :global(widget-layout.site-stats--sidebar) .site-stats__row {
    display: grid;
    min-height: 2.75rem;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    padding: 0.32rem 0.7rem;
  }

  :global(widget-layout.site-stats--sidebar) .site-stats__label-group {
    display: grid;
    min-width: 0;
    grid-template-columns: 1.35rem minmax(0, 1fr);
    gap: 0.65rem;
  }

  :global(widget-layout.site-stats--sidebar) .site-stats__icon {
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    place-items: center;
    color: var(--deep-text);
    font-size: 1.25rem;
  }

  :global(widget-layout.site-stats--sidebar .site-stats__icon svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  :global(widget-layout.site-stats--sidebar) .site-stats__label {
    overflow: hidden;
    color: var(--content-meta);
    font-size: 0.9rem;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(widget-layout.site-stats--sidebar) .site-stats__number {
    justify-content: flex-end;
    min-width: 4.5rem;
    color: var(--deep-text);
    font-variant-numeric: tabular-nums;
  }

  :global(widget-layout.site-stats--sidebar) .site-stats__value {
    color: var(--deep-text);
    font-size: 1.05rem;
    font-weight: 700;
  }
</style>

<script is:inline define:vars={{ siteStartDate, lastPostDate, todayText }}>
  function updateDynamicStats() {
    const today = new Date();

    // 更新运行天数
    const startDate = new Date(siteStartDate);
    const diffTime = Math.abs(today.getTime() - startDate.getTime());
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    const runningDaysElements = document.querySelectorAll('[data-stat-id="running-days"]');
    runningDaysElements.forEach((element) => {
      element.textContent = diffDays.toString();
    });

    // 更新最后活动时间
    if (lastPostDate) {
      const lastPost = new Date(lastPostDate);
      const timeSinceLastPost = Math.abs(today.getTime() - lastPost.getTime());
      const daysSinceLastUpdate = Math.floor(timeSinceLastPost / (1000 * 60 * 60 * 24));

      const lastUpdateElements = document.querySelectorAll('[data-stat-id="last-update"]');
      lastUpdateElements.forEach((element) => {
        if (daysSinceLastUpdate === 0) {
          element.textContent = todayText;
          if (element.nextElementSibling) {
            element.nextElementSibling.style.display = 'none';
          }
        } else {
          element.textContent = daysSinceLastUpdate.toString();
          if (element.nextElementSibling) {
            element.nextElementSibling.style.display = '';
          }
        }
      });
    }
  }

  // 页面加载时更新
  updateDynamicStats();

  // 页面切换时重新更新
  document.addEventListener("swup:contentReplaced", () => {
    setTimeout(updateDynamicStats, 100);
  });
</script>
