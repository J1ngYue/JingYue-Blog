---
import type { KGMeta } from "@/utils/knowledge-graph-data";

interface Props {
	meta: KGMeta;
}

const { meta } = Astro.props;

const graphText = {
	category: "分类",
	tag: "标签",
	post: "文章",
	heading: "小标题",
	panel: "图谱控制",
	mindmap: "切换脑图布局",
	reset: "重置视图",
	collapse: "收起面板",
	expand: "展开面板",
	stats: "显示 {visible}/{total} 个节点 · {links} 条关系",
	filters: "筛选",
	search: "搜索节点",
	minPosts: "最少文章数",
	groups: "分类分组",
	appearance: "外观",
	cooccurrence: "显示标签共现连线",
	particles: "显示粒子",
	animation: "动画",
	play: "播放",
	pause: "暂停",
};

// 层级开关：标题层默认关 —— 179 个节点一上来就铺开会糊成一片
const tiers = [
	{
		key: "category",
		label: graphText.category,
		count: meta.counts.category,
		on: true,
	},
	{
		key: "tag",
		label: graphText.tag,
		count: meta.counts.tag,
		on: true,
	},
	{
		key: "post",
		label: graphText.post,
		count: meta.counts.post,
		on: true,
	},
	{
		key: "heading",
		label: graphText.heading,
		count: meta.counts.heading,
		on: false,
	},
];

const maxPosts = Math.max(1, ...meta.categories.map((c) => c.postCount));
const statsTemplate = graphText.stats;
---

{/* 悬浮在右上角。顶部固定一层（标题 + 工具 + 统计），主体按工具导航页
    （collections.css tools-accordion）的堆叠手风琴拆成四层：筛选 / 分类选择 /
    外观 / 动画。分区 data-open + grid-template-rows 过渡展开，交互由
    KnowledgeGraph.astro 单点委托。控件全部构建期渲染，交互只切属性，零 DOM 创建
    —— 与 CategoryExplorer.astro:100 记录的既有模式一致 */}
<aside
  class="graph-panel"
  id="graph-panel"
  data-kg-panel
  aria-label={graphText.panel}
>
  <div class="graph-panel__top">
    <header class="graph-panel__head">
      <h2 class="graph-panel__title">{graphText.panel}</h2>
      <div class="graph-panel__tools">
        <button
          type="button"
          class="graph-panel__tool"
          data-kg-action="toggle-layout"
          aria-pressed="false"
          title={graphText.mindmap}
          aria-label={graphText.mindmap}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
              <path d="M7 12h3.2M10.2 12c2.7 0 2.5-7 6.1-7M10.2 12c2.7 0 2.5 7 6.1 7M10.2 12h6.1" />
              <circle cx="5" cy="12" r="1.9" />
              <circle cx="18.3" cy="5" r="1.9" />
              <circle cx="18.3" cy="12" r="1.9" />
              <circle cx="18.3" cy="19" r="1.9" />
            </g>
          </svg>
        </button>
        <button
          type="button"
          class="graph-panel__tool"
          data-kg-action="reset-view"
          title={graphText.reset}
          aria-label={graphText.reset}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V1L7 6l5 5V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z"/></svg>
        </button>
        <button
          type="button"
          class="graph-panel__tool"
          data-kg-action="toggle-panel"
          title={graphText.collapse}
          aria-label={graphText.collapse}
          aria-expanded="true"
          aria-controls="graph-panel"
        >
          {/* 双箭头指向右侧：收起方向与面板滑出方向一致 */}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.6 17.6 10.2 13 5.6 8.4 7 7l6 6-6 6zm7.4 0 4.6-4.6L13 8.4 14.4 7l6 6-6 6z"/></svg>
        </button>
      </div>
    </header>
    <p class="graph-panel__stats" data-kg-stats data-template={statsTemplate}></p>
  </div>

  <div class="graph-panel__body">
    {/* 筛选：搜索 + 层级网格，最少文章数压底 */}
    <section class="graph-accordion" data-kg-accordion data-open>
      <button
        type="button"
        class="graph-accordion__head"
        data-kg-accordion-toggle
        aria-expanded="true"
      >
        <span class="graph-accordion__bar" aria-hidden="true"></span>
        <span class="graph-accordion__title">{graphText.filters}</span>
        <svg class="graph-accordion__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5z"/></svg>
      </button>
      <div class="graph-accordion__body">
        {/* padding 只能落在 inner 的子层：inner 自身带 padding 时 0fr 折叠不干净 */}
        <div class="graph-accordion__inner">
          <div class="graph-panel__fields">
            <label class="graph-panel__search">
              <input type="search" data-kg-filter="query" placeholder={graphText.search} />
            </label>
            <div class="graph-panel__grid">
              {tiers.map((tier) => (
                <label class="graph-panel__check">
                  <input type="checkbox" data-kg-tier={tier.key} checked={tier.on} />
                  <span class="graph-panel__check-label">{tier.label}</span>
                  <span class="graph-panel__count">{tier.count}</span>
                </label>
              ))}
            </div>
            <label class="graph-panel__range">
              <span>{graphText.minPosts}</span>
              <input type="range" data-kg-filter="minPosts" min="1" max={maxPosts} value="1" step="1" />
              <output data-kg-out="minPosts">1</output>
            </label>
          </div>
        </div>
      </div>
    </section>

    {/* 分类选择：带色点的分类勾选，图例与画布节点同色 */}
    <section class="graph-accordion" data-kg-accordion data-open>
      <button
        type="button"
        class="graph-accordion__head"
        data-kg-accordion-toggle
        aria-expanded="true"
      >
        <span class="graph-accordion__bar" aria-hidden="true"></span>
        <span class="graph-accordion__title">{graphText.groups}</span>
        <svg class="graph-accordion__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5z"/></svg>
      </button>
      <div class="graph-accordion__body">
        <div class="graph-accordion__inner">
          <div class="graph-panel__fields">
            <div class="graph-panel__grid">
              {meta.categories.map((category) => (
                <label class="graph-panel__check" data-color-index={category.colorIndex}>
                  <input type="checkbox" data-kg-category={category.id} checked />
                  <span class="graph-panel__dot" aria-hidden="true"></span>
                  <span class="graph-panel__check-label">{category.name}</span>
                  <span class="graph-panel__count">{category.postCount}</span>
                </label>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 外观：共现连线与粒子开关 */}
    <section class="graph-accordion" data-kg-accordion>
      <button
        type="button"
        class="graph-accordion__head"
        data-kg-accordion-toggle
        aria-expanded="false"
      >
        <span class="graph-accordion__bar" aria-hidden="true"></span>
        <span class="graph-accordion__title">{graphText.appearance}</span>
        <svg class="graph-accordion__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5z"/></svg>
      </button>
      <div class="graph-accordion__body">
        <div class="graph-accordion__inner">
          <div class="graph-panel__fields">
            <div class="graph-panel__grid">
              <label class="graph-panel__check">
                <input type="checkbox" data-kg-filter="cooccurrence" />
                <span class="graph-panel__check-label">{graphText.cooccurrence}</span>
              </label>
              <label class="graph-panel__check">
                <input type="checkbox" data-kg-filter="particles" checked />
                <span class="graph-panel__check-label">{graphText.particles}</span>
              </label>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 动画：播放/暂停（原视窗底部传输条移入面板） */}
    <section class="graph-accordion" data-kg-accordion>
      <button
        type="button"
        class="graph-accordion__head"
        data-kg-accordion-toggle
        aria-expanded="false"
      >
        <span class="graph-accordion__bar" aria-hidden="true"></span>
        <span class="graph-accordion__title">{graphText.animation}</span>
        <svg class="graph-accordion__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5z"/></svg>
      </button>
      <div class="graph-accordion__body">
        <div class="graph-accordion__inner">
          <div class="graph-panel__fields">
            <button type="button" class="graph-panel__play" data-kg-action="play" aria-label={graphText.play}>
              <svg class="graph-panel__play-icon" data-kg-icon="play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              <svg class="graph-panel__play-icon" data-kg-icon="pause" viewBox="0 0 24 24" aria-hidden="true" style="display: none;"><path d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>
              <span data-kg-play-label>{graphText.play}</span>
            </button>
          </div>
        </div>
      </div>
    </section>
  </div>
</aside>

{/* 收起后的伸缩小球：桌面端半嵌在视窗右缘（悬停整颗滑出，同看板娘的伸缩把手），
    移动端 fixed 到右下角、避开 mobile-dock 气泡。点击与面板头部的收起键共用
    data-kg-action="toggle-panel"，走 KnowledgeGraph.astro 的单点委托 */}
<button
  type="button"
  class="graph-panel-handle"
  data-kg-panel-handle
  data-kg-action="toggle-panel"
  title={graphText.expand}
  aria-label={graphText.expand}
  aria-expanded="false"
  aria-controls="graph-panel"
>
  <svg class="graph-panel-handle__icon" viewBox="0 0 24 24" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <path d="M4 7h9M17 7h3M4 17h3M11 17h9M4 12h5M13 12h7" />
      <circle cx="15" cy="7" r="1.8" />
      <circle cx="9" cy="17" r="1.8" />
      <circle cx="11" cy="12" r="1.8" />
    </g>
  </svg>
</button>

