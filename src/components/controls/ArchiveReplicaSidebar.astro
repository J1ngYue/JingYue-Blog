---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import Calendar from "@/components/widget/Calendar.astro";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import type { WidgetComponentConfig } from "@/types/config";
import {
	formatBilibiliHeat,
	getBilibiliHot,
	getBilibiliHotTag,
	getBilibiliSearchUrl,
} from "@/utils/bilibili-hot";
import type { PostForList } from "@/utils/content-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";

interface Props {
	side: "left" | "right";
	posts: PostForList[];
}

const { side, posts } = Astro.props;
const recentPosts = posts.slice(0, 5);
const bilibiliHot =
	side === "right" ? (await getBilibiliHot()).slice(0, 5) : [];
const archiveCalendarConfig: WidgetComponentConfig = {
	type: "calendar",
	enable: true,
	position: "top",
	showTitle: false,
	specificConfig: {
		calendar: {
			showHeatmap: false,
		},
	},
};
const startDate = new Date(`${siteConfig.siteStartDate}T00:00:00+08:00`);
const siteDays = Math.max(
	1,
	Math.floor((Date.now() - startDate.getTime()) / 86_400_000),
);

function formatPostDate(date: Date): string {
	return new Intl.DateTimeFormat("zh-CN", {
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
		timeZone: siteConfig.timezone || "Asia/Shanghai",
	})
		.format(date)
		.replaceAll("/", "-");
}
---

{
	side === "left" ? (
		<aside class="archive-side archive-side--left" aria-label="归档页左侧信息">
			<section class="archive-profile-card">
				<div class="archive-profile-card__cover" data-site-profile-cover>
					<ImageWrapper
						src="assets/images/cover.avif"
						alt=""
						class="archive-profile-card__cover-image"
						loading="eager"
						widths={[560]}
						sizes="280px"
					/>
				</div>
				<a class="archive-profile-card__avatar" href="/about/" aria-label="查看个人资料">
					<ImageWrapper
						src={profileConfig.avatar || ""}
						alt={`${profileConfig.name} 的头像`}
						loading="eager"
						widths={[160]}
						sizes="80px"
						siteAvatar
					/>
				</a>
				<div class="archive-profile-card__body">
					<strong>{profileConfig.name}</strong>
					<p>{profileConfig.bio}</p>
					<nav aria-label="个人链接">
						{profileConfig.links.map((item) => (
							<a
								href={item.url}
								target={item.url.startsWith("http") ? "_blank" : undefined}
								rel={item.url.startsWith("http") ? "me noreferrer" : "me"}
								aria-label={item.name}
							>
								<Icon is:inline name={item.icon} />
							</a>
						))}
					</nav>
				</div>
			</section>

			<section class="archive-side-card archive-weather" data-archive-weather>
				<header>
					<span>
						<Icon is:inline name="material-symbols:partly-cloudy-day-outline-rounded" />
						天气预报
					</span>
					<button type="button" data-weather-refresh aria-label="刷新天气" title="刷新天气">
						<Icon is:inline name="material-symbols:refresh-rounded" />
					</button>
				</header>
				<div class="archive-weather__content">
					<strong data-weather-temperature>--°</strong>
					<p>
						<span data-weather-location>上海 Shanghai</span>
						<span data-weather-description>正在获取天气</span>
					</p>
				</div>
				<footer>
					<span>高 <b data-weather-high>--°</b></span>
					<span>低 <b data-weather-low>--°</b></span>
				</footer>
			</section>

			<div class="archive-calendar">
				<Calendar widgetConfig={archiveCalendarConfig} />
				<nav class="archive-calendar__latest" aria-label="最近发布的文章">
					{recentPosts.map((post) => (
						<a href={getPostUrlBySlug(post.id)}>
							<strong>{post.data.title}</strong>
							<time datetime={post.data.published.toISOString()}>
								{new Intl.DateTimeFormat("zh-CN", {
									month: "2-digit",
									day: "2-digit",
									timeZone: siteConfig.timezone || "Asia/Shanghai",
								})
									.format(post.data.published)
									.replace("/", "-")}
							</time>
						</a>
					))}
				</nav>
			</div>
		</aside>
	) : (
		<aside class="archive-side archive-side--right" aria-label="归档页右侧信息">
			<section class="archive-side-card archive-milestone">
				<p>这片小天地已经记录了</p>
				<div class="archive-milestone__names">
					<span>JINGYUE</span>
					<Icon is:inline name="material-symbols:favorite-rounded" />
					<span>FIREFLY</span>
				</div>
				<div class="archive-milestone__avatars">
					<span>
						<ImageWrapper
							src={profileConfig.avatar || ""}
							alt=""
							loading="eager"
							widths={[128]}
							sizes="64px"
							siteAvatar
						/>
					</span>
					<Icon is:inline name="material-symbols:auto-awesome-rounded" />
					<span class="archive-milestone__brand">
						<Icon is:inline name="material-symbols:local-fire-department-rounded" />
					</span>
				</div>
				<strong>
					{siteDays.toLocaleString("zh-CN")}
					<small>天</small>
				</strong>
				<time datetime={siteConfig.siteStartDate}>始于 {siteConfig.siteStartDate}</time>
			</section>

			<section class="archive-side-card archive-ranking" data-bilibili-hot aria-label="Bilibili 热搜">
					<header class="archive-side-card__title">
						<span>
							<Icon is:inline name="simple-icons:bilibili" />
							<span class="archive-ranking__label">Bilibili 热搜</span>
					</span>
						<button type="button" data-bilibili-hot-refresh aria-label="刷新 Bilibili 热搜" title="刷新 Bilibili 热搜">
							<Icon is:inline name="material-symbols:refresh-rounded" />
						</button>
				</header>
					<ol data-bilibili-hot-list>
						{bilibiliHot.map((item, index) => (
							<li>
								<span class="archive-ranking__rank">{index + 1}</span>
								<a href={getBilibiliSearchUrl(item.keyword)} target="_blank" rel="noopener noreferrer">
									<strong class="archive-ranking__name">{item.showName}</strong>
									<small class="archive-ranking__heat">{formatBilibiliHeat(item.heatScore)}</small>
								</a>
								<i class="archive-ranking__tag" aria-hidden="true">{getBilibiliHotTag(item.wordType)}</i>
							</li>
						))}
					</ol>
					<p class="archive-ranking__status" data-bilibili-hot-status hidden></p>
			</section>

			<section class="archive-side-card archive-quote">
				<h2 class="archive-side-card__title">
					<span>今日一言</span>
				</h2>
				<blockquote>
					“ 把代码、生活与那些闪光的片刻，认真地留在时间里。 ”
				</blockquote>
				<p>—— {profileConfig.name}</p>
			</section>

			<section class="archive-side-card archive-recent">
				<header class="archive-side-card__title">
					<span>最近更新</span>
					<Icon is:inline name="material-symbols:history-rounded" />
				</header>
				<div>
					{recentPosts.map((post) => (
						<a href={getPostUrlBySlug(post.id)}>
							<span class="archive-recent__avatar">
								<ImageWrapper
									src={profileConfig.avatar || ""}
									alt=""
									loading="lazy"
									widths={[96]}
									sizes="48px"
									siteAvatar
								/>
							</span>
							<span>
								<strong>{post.data.title}</strong>
								<small>
									<time datetime={post.data.published.toISOString()}>
										{formatPostDate(post.data.published)}
									</time>
									<i>最新文章</i>
								</small>
							</span>
						</a>
					))}
				</div>
			</section>
		</aside>
	)
}

<script>
	function initArchiveWeather() {
		const cards = document.querySelectorAll<HTMLElement>("[data-archive-weather]");
		for (const card of cards) {
			if (card.dataset.bound === "true") continue;
			card.dataset.bound = "true";

			const descriptions: Record<number, string> = {
				0: "晴朗",
				1: "大部晴朗",
				2: "局部多云",
				3: "阴天",
				45: "有雾",
				48: "雾凇",
				51: "小毛毛雨",
				53: "毛毛雨",
				55: "较强毛毛雨",
				61: "小雨",
				63: "中雨",
				65: "大雨",
				71: "小雪",
				73: "中雪",
				75: "大雪",
				80: "阵雨",
				81: "中等阵雨",
				82: "强阵雨",
				95: "雷雨",
			};
			const temperature = card.querySelector<HTMLElement>(
				"[data-weather-temperature]",
			);
			const description = card.querySelector<HTMLElement>(
				"[data-weather-description]",
			);
			const high = card.querySelector<HTMLElement>("[data-weather-high]");
			const low = card.querySelector<HTMLElement>("[data-weather-low]");
			const refresh = card.querySelector<HTMLButtonElement>(
				"[data-weather-refresh]",
			);

			const loadWeather = async () => {
				refresh?.setAttribute("aria-busy", "true");
				if (description) description.textContent = "正在获取天气";
				try {
					const response = await fetch(
						"https://api.open-meteo.com/v1/forecast?latitude=31.2304&longitude=121.4737&current=temperature_2m,weather_code&daily=temperature_2m_max,temperature_2m_min&forecast_days=1&timezone=Asia%2FShanghai",
					);
					if (!response.ok) throw new Error("Weather request failed");
					const data = await response.json();
					if (temperature) {
						temperature.textContent = `${Math.round(data.current.temperature_2m)}°`;
					}
					if (description) {
						description.textContent =
							descriptions[data.current.weather_code] || "天气变化中";
					}
					if (high) {
						high.textContent = `${Math.round(data.daily.temperature_2m_max[0])}°`;
					}
					if (low) {
						low.textContent = `${Math.round(data.daily.temperature_2m_min[0])}°`;
					}
				} catch {
					if (description) description.textContent = "天气暂不可用";
				} finally {
					refresh?.removeAttribute("aria-busy");
				}
			};

			refresh?.addEventListener("click", loadWeather);
			loadWeather();
		}
	}

	function initBilibiliHot() {
		const cards = document.querySelectorAll<HTMLElement>("[data-bilibili-hot]");
		for (const card of cards) {
			if (card.dataset.bound === "true") continue;
			card.dataset.bound = "true";

			const list = card.querySelector<HTMLOListElement>("[data-bilibili-hot-list]");
			const status = card.querySelector<HTMLElement>("[data-bilibili-hot-status]");
			const refresh = card.querySelector<HTMLButtonElement>("[data-bilibili-hot-refresh]");
			if (!list) continue;

			const formatHeat = (score: unknown) => {
				const value = typeof score === "number" ? score : 0;
				if (!value) return "Bilibili 热搜";
				if (value >= 10000) return `${(value / 10000).toFixed(1)}万热度`;
				return `${value.toLocaleString("zh-CN")}热度`;
			};
			const formatTag = (wordType: unknown) => {
				if (wordType === 4) return "新";
				if (wordType === 9) return "梗";
				if (wordType === 11) return "话";
				return "热";
			};

			const renderItems = (items: Array<Record<string, unknown>>) => {
				list.replaceChildren(
					...items.slice(0, 5).map((item, index) => {
						const keyword = typeof item.keyword === "string" ? item.keyword : "";
						const showName =
							typeof item.showName === "string"
								? item.showName
								: keyword;
						const li = document.createElement("li");
						const rank = document.createElement("span");
						rank.className = "archive-ranking__rank";
						rank.textContent = String(index + 1);
						const link = document.createElement("a");
						link.href = `https://search.bilibili.com/all?keyword=${encodeURIComponent(keyword)}`;
						link.target = "_blank";
						link.rel = "noopener noreferrer";
						const title = document.createElement("strong");
						title.className = "archive-ranking__name";
						title.textContent = showName;
						const meta = document.createElement("small");
						meta.className = "archive-ranking__heat";
						meta.textContent = formatHeat(item.heatScore);
						link.append(title, meta);
						const tag = document.createElement("i");
						tag.className = "archive-ranking__tag";
						tag.setAttribute("aria-hidden", "true");
						tag.textContent = formatTag(item.wordType);
						li.append(rank, link, tag);
						return li;
					}),
				);
			};

			const loadHot = async () => {
				refresh?.setAttribute("aria-busy", "true");
				status?.setAttribute("hidden", "");
				try {
					const response = await fetch("/api/bilibili-hot.json", {
						cache: "no-store",
					});
					if (!response.ok) throw new Error(`Bilibili hot search failed: ${response.status}`);
					const payload = (await response.json()) as { items?: unknown };
					if (!Array.isArray(payload.items) || payload.items.length === 0) {
						throw new Error("Bilibili hot search returned no items");
					}
					renderItems(payload.items as Array<Record<string, unknown>>);
				} catch {
					if (status) {
						status.textContent = "Bilibili 热搜暂时不可用";
						status.removeAttribute("hidden");
					}
				} finally {
					refresh?.removeAttribute("aria-busy");
				}
			};

			refresh?.addEventListener("click", () => void loadHot());
			void loadHot();
			window.setInterval(() => void loadHot(), 60 * 60 * 1000);
		}
	}

	initArchiveWeather();
	initBilibiliHot();
	document.addEventListener("swup:contentReplaced", initArchiveWeather);
	document.addEventListener("swup:contentReplaced", initBilibiliHot);
</script>

<style>
	.archive-side {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		min-width: 0;
		align-self: start;
	}

	.archive-side-card,
	.archive-profile-card {
		overflow: hidden;
		border: 1px solid rgb(0 0 0 / 8%);
		border-radius: 0.625rem;
		background: color-mix(in srgb, var(--card-bg) 97%, transparent);
		box-shadow: 0 0 0.75rem 0.125rem rgb(0 0 0 / 6%);
		color: var(--deep-text);
		backdrop-filter: blur(1rem);
	}

	:global(html.dark) .archive-side-card,
	:global(html.dark) .archive-profile-card {
		border-color: rgb(255 255 255 / 10%);
		box-shadow: 0 0 0.75rem 0.125rem rgb(0 0 0 / 18%);
	}

	.archive-profile-card {
		position: relative;
		min-height: 16.25rem;
	}

	.archive-profile-card__cover {
		height: 6.5rem;
		overflow: hidden;
	}

	.archive-profile-card__cover :global(picture),
	.archive-profile-card__cover :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.archive-profile-card__cover :global(img) {
		object-fit: cover;
	}

	.archive-profile-card__cover::after {
		position: absolute;
		inset: 3.5rem 0 auto;
		height: 3rem;
		background: linear-gradient(to bottom, transparent, var(--card-bg));
		content: "";
	}

	.archive-profile-card__avatar {
		position: absolute;
		z-index: 2;
		top: 4.2rem;
		left: 50%;
		display: grid;
		width: 5rem;
		height: 5rem;
		overflow: hidden;
		place-items: center;
		border: 0.25rem solid var(--card-bg);
		border-radius: 50%;
		background: var(--card-bg);
		box-shadow: 0 0.25rem 0.75rem rgb(0 0 0 / 16%);
		transform: translateX(-50%);
		transition: transform 180ms ease;
	}

	.archive-profile-card__avatar:hover {
		transform: translateX(-50%) scale(1.05);
	}

	.archive-profile-card__avatar :global(picture),
	.archive-profile-card__avatar :global(img) {
		width: 100%;
		height: 100%;
	}

	.archive-profile-card__avatar :global(img) {
		object-fit: cover;
	}

	.archive-profile-card__body {
		padding: 2.65rem 1rem 1rem;
		text-align: center;
	}

	.archive-profile-card__body > strong {
		display: block;
		font-size: 1.125rem;
		font-weight: 800;
	}

	.archive-profile-card__body p {
		margin: 0.4rem 0 0.75rem;
		color: var(--content-meta);
		font-size: 0.75rem;
	}

	.archive-profile-card__body nav {
		display: flex;
		justify-content: center;
		gap: 0.55rem;
	}

	.archive-profile-card__body nav a {
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		border-radius: 0.45rem;
		color: var(--content-meta);
		transition: background-color 150ms ease, color 150ms ease,
			transform 150ms ease;
	}

	.archive-profile-card__body nav a:hover {
		background: var(--btn-plain-bg-hover);
		color: var(--primary);
		transform: translateY(-0.125rem);
	}

	.archive-profile-card__body nav :global(svg) {
		width: 1.15rem;
		height: 1.15rem;
	}

	.archive-weather {
		min-height: 9.2rem;
		padding: 0.75rem 1rem;
	}

	.archive-weather header,
	.archive-side-card__title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin: 0;
		font-size: 0.9rem;
		font-weight: 800;
	}

	.archive-weather header > span,
	.archive-side-card__title > span {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.archive-weather header :global(svg),
	.archive-side-card__title :global(svg) {
		width: 1.1rem;
		height: 1.1rem;
		color: var(--primary);
	}

	.archive-weather header button {
		display: grid;
		width: 1.75rem;
		height: 1.75rem;
		cursor: pointer;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--content-meta);
	}

	.archive-weather header button:hover {
		background: var(--btn-plain-bg-hover);
	}

	.archive-weather header button[aria-busy="true"] :global(svg) {
		animation: archive-weather-spin 900ms linear infinite;
	}

	.archive-ranking .archive-side-card__title > span {
		font-size: 0;
	}

	.archive-ranking__label {
		font-size: 0.9rem;
	}

	.archive-ranking .archive-side-card__title > button {
		display: grid;
		width: 1.75rem;
		height: 1.75rem;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--content-meta);
		cursor: pointer;
	}

	.archive-ranking .archive-side-card__title > button:hover,
	.archive-ranking .archive-side-card__title > button:focus-visible {
		background: var(--btn-plain-bg-hover);
		color: var(--primary);
		outline: none;
	}

	.archive-ranking .archive-side-card__title > button[aria-busy="true"] :global(svg) {
		animation: archive-weather-spin 900ms linear infinite;
	}

	.archive-weather__content {
		display: flex;
		align-items: end;
		gap: 0.65rem;
		margin-top: 0.5rem;
	}

	.archive-weather__content > strong {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 2.8rem;
		font-weight: 500;
		line-height: 1;
	}

	.archive-weather__content p {
		display: grid;
		margin: 0;
		padding-bottom: 0.15rem;
		color: var(--content-meta);
		font-size: 0.72rem;
		line-height: 1.35;
	}

	.archive-weather footer {
		display: flex;
		justify-content: flex-end;
		gap: 0.55rem;
		margin-top: 0.45rem;
		color: var(--content-meta);
		font-size: 0.7rem;
	}

	.archive-weather footer b {
		font-weight: 600;
	}

	.archive-calendar {
		min-height: 31.4375rem;
		overflow: hidden;
		border: 1px solid rgb(0 0 0 / 8%);
		border-radius: 0.625rem;
		background: color-mix(in srgb, var(--card-bg) 97%, transparent);
		box-shadow: 0 0 0.75rem 0.125rem rgb(0 0 0 / 6%);
		backdrop-filter: blur(1rem);
	}

	.archive-calendar :global(widget-layout) {
		display: block !important;
		border: 0 !important;
		border-radius: 0 !important;
		background: transparent !important;
		box-shadow: none !important;
	}

	.archive-calendar__latest {
		display: grid;
		gap: 0.1rem;
		margin: 0 1rem;
		padding: 0.75rem 0 0.6rem;
		border-top: 1px solid var(--line-divider);
	}

	.archive-calendar__latest a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.65rem;
		min-height: 1.75rem;
		padding: 0 0.3rem;
		border-radius: 0.4rem;
		color: inherit;
		transition: background-color 150ms ease;
	}

	.archive-calendar__latest a:hover {
		background: var(--btn-plain-bg-hover);
	}

	.archive-calendar__latest strong {
		overflow: hidden;
		min-width: 0;
		color: var(--content-meta);
		font-size: 0.7rem;
		font-weight: 500;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.archive-calendar__latest time {
		flex: 0 0 auto;
		color: var(--content-meta);
		font-size: 0.65rem;
	}

	.archive-milestone {
		min-height: 16.6rem;
		padding: 1.6rem 1rem 1.25rem;
		text-align: center;
	}

	.archive-milestone > p {
		margin: 0;
		font-size: 0.88rem;
		font-weight: 750;
	}

	.archive-milestone__names {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		margin-top: 0.65rem;
		font-size: 0.76rem;
		font-weight: 700;
	}

