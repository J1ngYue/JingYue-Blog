---
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getSortedPostsList } from "@/utils/content-utils";
import { getPostUrlBySlug, url } from "@/utils/url-utils";

// 归档列表：全量按年分组，服务端渲染。筛选（?tag=/?category=/?uncategorized）
// 与年份折叠由客户端脚本处理——数据本身在构建期已全部就绪。
const sortedPostsList = await getSortedPostsList();

// 严格按发布时间倒序（不受置顶影响），镜像原 Svelte 版行为
const posts = sortedPostsList
	.slice()
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

// 按年份分组
const grouped = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.published.getFullYear();
	if (!grouped.has(year)) grouped.set(year, []);
	grouped.get(year)?.push(post);
}
const groups = Array.from(grouped.entries())
	.map(([year, yearPosts]) => {
		const months = new Map<number, typeof posts>();
		for (const post of yearPosts) {
			const month = post.data.published.getMonth() + 1;
			if (!months.has(month)) months.set(month, []);
			months.get(month)?.push(post);
		}
		return {
			year,
			posts: yearPosts,
			months: Array.from(months.entries())
				.map(([month, monthPosts]) => ({ month, posts: monthPosts }))
				.sort((left, right) => right.month - left.month),
		};
	})
	.sort((a, b) => b.year - a.year);
const availableCategories = Array.from(
	new Set(
		posts
			.map((post) => post.data.category)
			.filter((category): category is string => Boolean(category)),
	),
).sort((left, right) => left.localeCompare(right, "zh-CN"));

// 初始折叠规则：foldArticle 非 false 且多于一年时，除首年外全部折叠
const foldArticle = siteConfig.foldArticle !== false;
const collapseAllButFirst = foldArticle && groups.length > 1;

function formatDate(date: Date) {
	const month = (date.getMonth() + 1).toString().padStart(2, "0");
	const day = date.getDate().toString().padStart(2, "0");
	return `${month}-${day}`;
}

function formatTag(tagList: string[]) {
	return tagList.map((t) => `#${t}`).join(" ");
}

// 传给客户端脚本的 i18n 文案与配置
const i18nStrings = {
	categories: i18n(I18nKey.categories),
	tags: i18n(I18nKey.tags),
	uncategorized: i18n(I18nKey.uncategorized),
	postCount: i18n(I18nKey.postCount),
	postsCount: i18n(I18nKey.postsCount),
};
const tagsBaseUrl = url("/tags/");
const categoriesBaseUrl = url("/categories/");
const searchBaseUrl = url("/search/");
const foldOnFilter = collapseAllButFirst;
---

<archive-panel
  class="card-base px-8 py-6"
  data-fold={foldOnFilter ? "true" : "false"}
>
  <div class="archive-toolbar mb-5 grid gap-2 md:grid-cols-[minmax(0,1fr)_9rem_10rem_auto]">
    <label class="archive-search flex min-w-0 items-center gap-2 rounded-lg border border-(--line-divider) bg-transparent px-3 text-50 transition-colors">
      <svg class="h-4 w-4 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        data-archive-search
        aria-label="搜索文章标题、分类或标签"
        class="h-10 min-w-0 flex-1 border-0 bg-transparent text-sm text-75 outline-none"
        placeholder="搜索文章标题、分类或标签"
        autocomplete="off"
      />
    </label>
    <label class="archive-category-filter relative flex items-center rounded-lg bg-(--btn-regular-bg) text-50">
      <span class="sr-only">按分类筛选</span>
      <select data-archive-category class="h-10 w-full appearance-none border-0 bg-transparent px-3 pr-8 text-sm text-75 outline-none">
        <option value="all">全部分类</option>
        {availableCategories.map((category) => <option value={category}>{category}</option>)}
      </select>
      <svg class="pointer-events-none absolute right-2 h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="m7 10 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </label>
    <label class="archive-year-filter relative flex items-center rounded-lg bg-(--btn-regular-bg) text-50">
      <span class="sr-only">按年份筛选</span>
      <select data-archive-year class="h-10 w-full appearance-none border-0 bg-transparent px-3 pr-8 text-sm text-75 outline-none">
        <option value="all">全部年份</option>
        {groups.map((group) => <option value={group.year}>{group.year} 年</option>)}
      </select>
      <svg class="pointer-events-none absolute right-2 h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="m7 10 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </label>
    <button
      type="button"
      data-archive-reset
      class="btn-regular h-10 rounded-lg px-4 text-sm font-medium"
      hidden
    >
      清除搜索
    </button>
  </div>

  <div class="archive-result-summary mb-4 flex items-center justify-between gap-3 text-xs text-50" aria-live="polite">
    <span data-archive-result-count>共 {posts.length} 篇文章</span>
    <span>可按标题、分类、标签或年份查找</span>
  </div>

  {/* 筛选头部：默认隐藏，客户端在有筛选时填充并显示 */}
  <div id="archive-filter-header" class="mb-5 hidden">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
      <div class="min-w-0 text-sm text-75">
        <a id="archive-filter-link" href={tagsBaseUrl} class="text-50 hover:text-(--primary) transition-colors"></a>
        <span class="mx-2 text-30">/</span>
        <span id="archive-filter-values" class="font-semibold text-(--primary)"></span>
        <span id="archive-filter-secondary" class="ml-2 text-50 hidden"></span>
      </div>
      <div class="shrink-0 text-xs text-50">
        <span id="archive-filter-count"></span> <span id="archive-filter-count-label"></span>
      </div>
    </div>
  </div>

  <div data-archive-empty class="archive-empty my-8 rounded-xl border border-dashed border-(--line-divider) px-5 py-10 text-center text-50" hidden>
    没有找到匹配的文章，换一个关键词或年份试试。
  </div>

  {groups.map((group, groupIndex) => {
    const collapsed = collapseAllButFirst && groupIndex > 0;
    return (
      <div class="archive-year-block" data-year={group.year} data-count={group.posts.length}>
        <button class="archive-year-toggle" aria-expanded={collapsed ? "false" : "true"}>
          <span class="archive-tree-column" aria-hidden="true">
            <i class="archive-year-node"></i>
          </span>
          <span class="archive-year-label">
            <strong class="archive-year-title">{group.year}年</strong>
            <span class="archive-year-meta">
              <span>共</span>
              <span class="archive-year-count">{group.posts.length}</span>
              <span class="archive-year-count-label">{i18n(group.posts.length === 1 ? I18nKey.postCount : I18nKey.postsCount)}</span>
            </span>
            <span class="archive-arrow" style={collapsed ? "transform: rotate(-90deg)" : ""}>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </span>
        </button>

        <div class="archive-year-content archive-months-area" hidden={collapsed}>
          {group.months.map((monthGroup) => (
            <section class="archive-month-block" data-archive-month>
              <header class="archive-month-heading">
                <span class="archive-tree-column" aria-hidden="true">
                  <i class="archive-branch archive-month-branch"></i>
                  <b class="archive-month-node"></b>
                </span>
                <h3 class="archive-month-label">
                  <strong>{monthGroup.month}月</strong>
                  <small>
                    <span data-archive-month-count>{monthGroup.posts.length}</span>
                    <span>篇文章</span>
                  </small>
                </h3>
              </header>
              <div class="archive-month-posts archive-posts-area">
                {monthGroup.posts.map((post) => (
                  <a
                    href={getPostUrlBySlug(post.id)}
                    aria-label={post.data.title}
                    class="archive-post"
                    data-tags={JSON.stringify(post.data.tags || [])}
                    data-category={post.data.category || ""}
                    data-search={`${post.data.title} ${post.data.category || ""} ${(post.data.tags || []).join(" ")} ${post.data.description || ""}`.toLocaleLowerCase()}
                  >
                    <span class="archive-tree-column" aria-hidden="true">
                      <i class="archive-branch archive-post-branch"></i>
                      <b class="archive-post-node"></b>
                    </span>
                    <span class="archive-post-link">
                      <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
                      {post.data.category && (
                        <span class="archive-post-category">{post.data.category}</span>
                      )}
                      <strong>{post.data.title}</strong>
                      <span class="archive-post-tags">{formatTag(post.data.tags || [])}</span>
                    </span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    );
  })}
</archive-panel>

<style>
	archive-panel {
		--archive-ink: oklch(0.1 0 0);
		--archive-muted: oklch(0.45 0 0);
		--archive-line: oklch(0.85 0 0);
		display: block;
		min-height: var(--archive-stable-height, 42rem);
		padding: 2rem 2.5rem;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		color: var(--archive-ink);
	}

	:global(:root.dark) archive-panel {
		--archive-ink: oklch(0.94 0.01 var(--hue));
		--archive-muted: oklch(0.72 0.01 var(--hue));
		--archive-line: oklch(0.4 0.01 var(--hue));
	}

	.archive-toolbar {
		padding-bottom: 1rem;
		border-bottom: 1px solid
			color-mix(in oklch, var(--archive-line) 72%, transparent);
	}

	.archive-year-block {
		position: relative;
		margin-bottom: 2.5rem;
	}

	.archive-year-block::before {
		position: absolute;
		z-index: 0;
		top: 1rem;
		bottom: 1rem;
		left: 1rem;
		border-left: 2px dashed var(--archive-line);
		content: "";
	}

	.archive-year-toggle {
		position: relative;
		z-index: 1;
		display: flex;
		width: 100%;
		min-height: 2.0625rem;
		padding: 0;
		cursor: pointer;
		border: 0;
		background: transparent;
		color: var(--archive-ink);
		text-align: left;
	}

	.archive-year-toggle:focus-visible {
		border-radius: 0.5rem;
		outline: 3px solid color-mix(in oklch, var(--primary) 55%, transparent);
		outline-offset: 0.2rem;
	}

	.archive-tree-column {
		position: relative;
		display: block;
		flex: 0 0 2rem;
		width: 2rem;
		align-self: stretch;
	}

	.archive-year-node {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 2;
		width: 0.75rem;
		height: 0.75rem;
		border: 2px solid var(--archive-line);
		border-radius: 50%;
		background: var(--card-bg);
		transform: translate(-50%, -50%);
		transition: border-color 150ms ease, background-color 150ms ease;
	}

	.archive-year-label {
		display: flex;
		flex: 1;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
		padding-left: 0.5rem;
	}

	.archive-year-title {
		font-size: 1.375rem;
		font-weight: 700;
		line-height: 2.0625rem;
		white-space: nowrap;
	}

	.archive-year-meta {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--archive-muted);
		font-size: 0.75rem;
		line-height: 1.125rem;
		white-space: nowrap;
	}

	.archive-arrow {
		display: none;
		margin-left: 0.1rem;
		color: var(--archive-muted);
		transition: transform 180ms ease;
	}

	.archive-months-area {
		padding-left: 2rem;
	}

	.archive-month-block {
		position: relative;
		margin-bottom: 0.5rem;
	}

	.archive-month-block::before {
		position: absolute;
		z-index: 0;
		top: 1rem;
		bottom: 1rem;
		left: 1rem;
		border-left: 2px dashed var(--archive-line);
		content: "";
	}

	.archive-month-block::after,
	.archive-year-block::after {
		position: absolute;
		z-index: 0;
		top: 1rem;
		left: 1rem;
		height: var(--archive-active-line, 0);
		border-left: 2px solid var(--archive-ink);
		content: "";
		opacity: 0;
		transition: height 120ms ease, opacity 120ms ease;
	}

	.archive-month-block.is-tree-active::after,
	.archive-year-block.is-tree-active::after {
		opacity: 1;
	}

	.archive-month-heading {
		position: relative;
		z-index: 1;
		display: flex;
		min-height: 2rem;
	}

	.archive-branch {
		position: absolute;
		top: 50%;
		right: 50%;
		left: -50%;
		border-top: 2px dashed var(--archive-line);
		transition: border-color 120ms ease, border-style 120ms ease;
	}

	.archive-month-node,
	.archive-post-node {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 2;
		border-radius: 50%;
		background: var(--archive-line);
		transform: translate(-50%, -50%);
		transition: background-color 120ms ease, transform 120ms ease;
	}

	.archive-month-node {
		width: 0.5rem;
		height: 0.5rem;
	}

	.archive-post-node {
		width: 0.4rem;
		height: 0.4rem;
	}

	.archive-month-label {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		min-width: 0;
		margin: 0;
		padding-left: 0.5rem;
	}

	.archive-month-label strong {
		font-size: 1.125rem;
		font-weight: 700;
		line-height: 1.7rem;
		white-space: nowrap;
	}

	.archive-month-label small {
		display: inline-flex;
		gap: 0.25rem;
		color: var(--archive-muted);
		font-size: 0.75rem;
		font-weight: 400;
		line-height: 1.125rem;
		white-space: nowrap;
	}

	.archive-posts-area {
		padding-left: 2rem;
	}

	.archive-post {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
		height: 2.25rem;
		border-radius: 0.5rem;
		color: inherit;
		text-decoration: none;
	}

	.archive-post-link {
		display: flex;
		flex: 1;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
		height: 100%;
		overflow: hidden;
		padding: 0.2rem 0.5rem 0.2rem 0;
		border-radius: 0.5rem;
		transition: background-color 150ms ease, color 150ms ease;
	}

	.archive-post:hover .archive-post-link,
	.archive-post:focus-visible .archive-post-link {
		background: color-mix(in srgb, var(--archive-ink) 6%, transparent);
		color: var(--archive-ink);
	}

	.archive-post:focus-visible {
		outline: 0;
	}

	.archive-post:focus-visible .archive-post-link {
		box-shadow: inset 0 0 0 2px
			color-mix(in oklch, var(--primary) 48%, transparent);
	}

	.archive-post time {
		flex: 0 0 2.8rem;
		width: 2.8rem;
		color: var(--archive-muted);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		line-height: 1.3125rem;
		white-space: nowrap;
	}

	.archive-post-category {
		flex: 0 0 auto;
		border: 1px solid var(--archive-line);
		border-radius: 0.25rem;
		padding: 0.1rem 0.4rem;
		color: var(--archive-muted);
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1.125rem;
		white-space: nowrap;
	}

	.archive-post-link > strong {
		overflow: hidden;
		min-width: 0;
		color: inherit;
		font-size: 0.9rem;
		font-weight: 500;
		line-height: 1.35rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.archive-post-tags {
		display: none;
	}

	.archive-month-block.is-tree-active .archive-month-branch,
	.archive-post.is-tree-active .archive-post-branch,
	.archive-post:has(~ .archive-post.is-tree-active) .archive-post-branch {
		border-top-color: var(--archive-ink);
		border-top-style: solid;
	}

	.archive-month-block.is-tree-active .archive-month-node,
	.archive-post.is-tree-active .archive-post-node,
	.archive-post:has(~ .archive-post.is-tree-active) .archive-post-node {
		background: var(--archive-ink);
	}

	.archive-year-block.is-tree-active .archive-year-node {
		border-color: var(--archive-ink);
		background: var(--archive-ink);
	}

	.archive-post.is-tree-active .archive-post-node {
		transform: translate(-50%, -50%) scale(1.15);
	}

	archive-panel [hidden] {
		display: none !important;
	}

	.archive-toolbar [data-archive-reset][hidden] {
		display: inline-flex !important;
		visibility: hidden;
		pointer-events: none;
	}

	.archive-search input::placeholder {
		color: var(--content-meta);
	}

	.archive-search:focus-within,
	.archive-year-filter:focus-within,
	.archive-category-filter:focus-within {
		background: var(--btn-regular-bg-hover);
	}

	.archive-search:focus-within {
		border-color: color-mix(in oklch, var(--primary) 44%, var(--line-divider));
		background: transparent;
		box-shadow: 0 0 0 0.18rem
			color-mix(in oklch, var(--primary) 10%, transparent);
	}

	@media (max-width: 767px) {
		archive-panel {
			padding: 1.5rem 0.4rem;
		}

		.archive-year-title {
			font-size: 1.15rem;
		}

		.archive-months-area,
		.archive-posts-area {
			padding-left: 1.3rem;
		}

		.archive-tree-column {
			flex-basis: 1.3rem;
			width: 1.3rem;
		}

		.archive-year-block::before,
		.archive-month-block::before,
		.archive-year-block::after,
		.archive-month-block::after {
			left: 0.65rem;
		}

		.archive-post time {
			flex-basis: 2.7rem;
			width: 2.7rem;
			font-size: 0.76rem;
		}

		.archive-post-category,
		.archive-post-tags {
			display: none;
		}

		.archive-post-link {
			gap: 0.4rem;
		}

		.archive-post-link > strong {
			font-size: 0.8rem;
		}

		.archive-result-summary > span:last-child {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.archive-arrow,
		.archive-post-link,
		.archive-branch,
		.archive-month-node,
		.archive-post-node,
		.archive-year-node,
		.archive-month-block::after,
		.archive-year-block::after {
			transition: none;
		}
	}
</style>

<script is:inline define:vars={{ i18nStrings, tagsBaseUrl, categoriesBaseUrl, searchBaseUrl }}>
  class ArchivePanel extends HTMLElement {
    constructor() {
      super();
      // 避免 swup 重复初始化
      if (this.dataset.initialized === "true") return;
      this.dataset.initialized = "true";
      this.init();
      requestAnimationFrame(() => {
        this.reserveStableHeight();
      });
    }

    init() {
      // Capture the unfiltered height before rows are hidden so search input
      // never changes the archive panel's outer geometry.
      this.reserveStableHeight();
      const params = new URLSearchParams(window.location.search);
      const tags = params.has("tag") ? params.getAll("tag") : [];
      const categories = params.has("category") ? params.getAll("category") : [];
      const uncategorized = params.get("uncategorized");
	  this.tags = tags;
	  this.categories = categories;
	  this.uncategorized = !!uncategorized;

      const hasFilter = tags.length > 0 || categories.length > 0 || !!uncategorized;
	  this.bindArchiveTools(params);

      this.applyFilter(tags, categories, !!uncategorized);

	  if (hasFilter) {
        this.updateBannerTitle(tags, categories, !!uncategorized);
      }

      this.bindYearToggles();
      this.bindTreeHighlight();
    }

    bindTreeHighlight() {
      const rows = Array.from(this.querySelectorAll(".archive-post"));

      const clear = () => {
        for (const row of rows) row.classList.remove("is-tree-active");
        for (const month of this.querySelectorAll(".archive-month-block")) {
          month.classList.remove("is-tree-active");
          month.style.removeProperty("--archive-active-line");
        }
        for (const year of this.querySelectorAll(".archive-year-block")) {
          year.classList.remove("is-tree-active");
          year.style.removeProperty("--archive-active-line");
        }
      };

      const activate = (row) => {
        clear();
        const month = row.closest(".archive-month-block");
        const year = row.closest(".archive-year-block");
        const monthHeader = month?.querySelector(".archive-month-heading");
        if (!month || !year || !monthHeader) return;

        const rowRect = row.getBoundingClientRect();
        const monthRect = month.getBoundingClientRect();
        const yearRect = year.getBoundingClientRect();
        const monthHeaderRect = monthHeader.getBoundingClientRect();
        const monthLine = Math.max(
          0,
          rowRect.top + rowRect.height / 2 - (monthRect.top + 16),
        );
        const yearLine = Math.max(
          0,
          monthHeaderRect.top + monthHeaderRect.height / 2 - (yearRect.top + 16),
        );

        row.classList.add("is-tree-active");
        month.classList.add("is-tree-active");
        year.classList.add("is-tree-active");
        month.style.setProperty("--archive-active-line", `${monthLine}px`);
        year.style.setProperty("--archive-active-line", `${yearLine}px`);
      };

      for (const row of rows) {
        row.addEventListener("pointerenter", () => activate(row));
        row.addEventListener("focus", () => activate(row));
      }
      this.addEventListener("pointerleave", clear);
      this.addEventListener("focusout", (event) => {
        if (!this.contains(event.relatedTarget)) clear();
      });
    }

    reserveStableHeight() {
      const currentHeight = this.getBoundingClientRect().height;
      const previousHeight = Number.parseFloat(this.style.minHeight) || 0;
      const height = Math.max(
        currentHeight,
        previousHeight,
        window.innerHeight * 0.72,
      );
      if (height > 0) {
        this.style.minHeight = `${Math.ceil(height)}px`;
      }
    }

	bindArchiveTools(params) {
	  this.searchInput = this.querySelector("[data-archive-search]");
	  this.yearSelect = this.querySelector("[data-archive-year]");
	  this.categorySelect = this.querySelector("[data-archive-category]");
	  this.resetButton = this.querySelector("[data-archive-reset]");
	  if (this.searchInput) this.searchInput.value = params.get("q") || "";
	  if (this.yearSelect) {
		const requestedYear = params.get("year") || "all";
		const exists = Array.from(this.yearSelect.options).some((option) => option.value === requestedYear);
		this.yearSelect.value = exists ? requestedYear : "all";
	  }
	  if (this.categorySelect) {
		const requestedCategory = params.getAll("category")[0] || "all";
		const exists = Array.from(this.categorySelect.options).some((option) => option.value === requestedCategory);
		this.categorySelect.value = exists ? requestedCategory : "all";
	  }

	  const refresh = () => {
		const selectedCategory = this.categorySelect?.value || "all";
		this.categories = selectedCategory === "all" ? [] : [selectedCategory];
		this.uncategorized = false;
		this.applyFilter(this.tags, this.categories, this.uncategorized);
		this.updateToolUrl();
	  };
	  this.searchInput?.addEventListener("input", refresh);
	  this.searchInput?.addEventListener("keydown", (event) => {
		if (event.key !== "Enter") return;
		const query = this.searchInput?.value.trim() || "";
		if (!query) return;
		event.preventDefault();
		const target = new URL(searchBaseUrl, window.location.origin);
		target.searchParams.set("q", query);
		if (window.swup?.navigate) window.swup.navigate(target.href);
		else window.location.assign(target.href);
	  });
	  this.yearSelect?.addEventListener("change", refresh);
	  this.categorySelect?.addEventListener("change", refresh);
	  this.resetButton?.addEventListener("click", () => {
		if (this.searchInput) this.searchInput.value = "";
		if (this.yearSelect) this.yearSelect.value = "all";
		if (this.categorySelect) this.categorySelect.value = "all";
		refresh();
		this.searchInput?.focus();
	  });
	}

	updateToolUrl() {
	  const current = new URL(window.location.href);
	  const query = this.searchInput?.value.trim() || "";
	  const year = this.yearSelect?.value || "all";
	  const category = this.categorySelect?.value || "all";
	  if (query) current.searchParams.set("q", query);
	  else current.searchParams.delete("q");
	  if (year !== "all") current.searchParams.set("year", year);
	  else current.searchParams.delete("year");
	  current.searchParams.delete("category");
	  current.searchParams.delete("uncategorized");
	  if (category !== "all") current.searchParams.set("category", category);
	  history.replaceState(history.state, "", current);
	}

	normalizeSearchValue(value) {
	  return String(value || "")
		.normalize("NFKD")
		.replace(/\p{Diacritic}/gu, "")
		.toLocaleLowerCase()
		.replace(/\s+/g, " ")
		.trim();
	}

	editDistanceWithin(left, right, limit) {
	  if (Math.abs(left.length - right.length) > limit) return false;
	  let previous = Array.from({ length: right.length + 1 }, (_, index) => index);
	  for (let row = 1; row <= left.length; row++) {
		const current = [row];
		let rowMinimum = current[0];
		for (let column = 1; column <= right.length; column++) {
		  const substitution =
			previous[column - 1] +
			(left[row - 1] === right[column - 1] ? 0 : 1);
		  current[column] = Math.min(
			previous[column] + 1,
			current[column - 1] + 1,
			substitution,
		  );
		  rowMinimum = Math.min(rowMinimum, current[column]);
		}
		if (rowMinimum > limit) return false;
		previous = current;
	  }
	  return previous[right.length] <= limit;
	}

	matchesArchiveQuery(searchValue, rawQuery) {
	  const query = this.normalizeSearchValue(rawQuery);
	  if (!query) return true;
	  const haystack = this.normalizeSearchValue(searchValue);
	  if (haystack.includes(query)) return true;

	  const words = haystack.split(" ").filter(Boolean);
	  return query.split(" ").filter(Boolean).every((token) => {
		if (haystack.includes(token)) return true;
		const limit =
		  token.length >= 4
			? Math.max(1, Math.floor(token.length * 0.35))
			: 0;
		return (
		  limit > 0 &&
		  words.some((word) => this.editDistanceWithin(token, word, limit))
		);
	  });
	}

    // 按筛选条件隐藏不匹配的文章行，重算每年计数，隐藏空年份，重新折叠
    applyFilter(tags, categories, uncategorized) {
      const foldOnFilter = this.dataset.fold === "true";
      const blocks = Array.from(this.querySelectorAll(".archive-year-block"));
      let totalVisible = 0;
      const visibleBlocks = [];
	  const query = this.searchInput?.value.toLocaleLowerCase().trim() || "";
	  const selectedYear = this.yearSelect?.value || "all";

      for (const block of blocks) {
        const rows = Array.from(block.querySelectorAll(".archive-post"));
        let visibleCount = 0;

        for (const row of rows) {
          let rowTags = [];
          try {
            rowTags = JSON.parse(row.dataset.tags || "[]");
          } catch {
            rowTags = [];
          }
          const rowCategory = row.dataset.category || "";

          let match = true;
          if (tags.length > 0) {
            match = match && rowTags.some((t) => tags.includes(t));
          }
          if (categories.length > 0) {
            match = match && !!rowCategory && categories.includes(rowCategory);
          }
          if (uncategorized) {
            match = match && !rowCategory;
          }
		  if (selectedYear !== "all") {
			match = match && block.dataset.year === selectedYear;
		  }
		  if (query) {
			match =
			  match &&
			  this.matchesArchiveQuery(row.dataset.search || "", query);
		  }

          row.hidden = !match;
          if (match) visibleCount++;
        }

		for (const monthBlock of block.querySelectorAll("[data-archive-month]")) {
		  const visibleMonthRows = Array.from(
			monthBlock.querySelectorAll(".archive-post"),
		  ).filter((row) => !row.hidden).length;
		  monthBlock.hidden = visibleMonthRows === 0;
		  const monthCount = monthBlock.querySelector("[data-archive-month-count]");
		  if (monthCount) monthCount.textContent = String(visibleMonthRows);
		}

        // 更新每年计数显示
        const countEl = block.querySelector(".archive-year-count");
        const labelEl = block.querySelector(".archive-year-count-label");
        if (countEl) countEl.textContent = String(visibleCount);
        if (labelEl) {
          labelEl.textContent =
            visibleCount === 1 ? i18nStrings.postCount : i18nStrings.postsCount;
        }

        // 隐藏没有可见文章的年份块
        block.hidden = visibleCount === 0;
        if (visibleCount > 0) {
          visibleBlocks.push(block);
          totalVisible += visibleCount;
        }
      }

      // 搜索时保持匹配年份展开，避免每次输入都折叠/展开整块内容造成布局抖动。
      // 清除搜索后再恢复原本的“首个年份展开、其余折叠”布局。
      const shouldAutoCollapse = foldOnFilter && !query;
      visibleBlocks.forEach((block, index) => {
        const shouldCollapse = shouldAutoCollapse && index > 0;
        this.setBlockCollapsed(block, shouldCollapse);
      });

      // 填充并显示筛选头部
      this.renderFilterHeader(tags, categories, uncategorized, totalVisible);
	  const resultCount = this.querySelector("[data-archive-result-count]");
	  if (resultCount) resultCount.textContent = `共 ${totalVisible} 篇文章`;
	  const empty = this.querySelector("[data-archive-empty]");
	  if (empty) empty.hidden = totalVisible > 0;
	  if (this.resetButton) {
		this.resetButton.hidden =
			!query && selectedYear === "all" && categories.length === 0;
	  }

	  const scopeLabel =
		tags.length > 0
		  ? "本标签文章"
		  : categories.length > 0 || uncategorized
			? "本分类文章"
			: query || selectedYear !== "all"
			  ? "筛选结果"
			  : "全部文章";
	  const stats = document.querySelector("archive-stats");
	  if (stats) {
		stats.dataset.scopeCount = String(totalVisible);
		stats.dataset.scopeLabel = scopeLabel;
		if (typeof stats.updateScope === "function") {
		  stats.updateScope(totalVisible, scopeLabel);
		}
	  }
    }

    setBlockCollapsed(block, collapsed) {
      const content = block.querySelector(".archive-year-content");
      const toggle = block.querySelector(".archive-year-toggle");
      const arrow = block.querySelector(".archive-arrow");
      if (content) content.hidden = collapsed;
      if (toggle) toggle.setAttribute("aria-expanded", collapsed ? "false" : "true");
      if (arrow) {
        arrow.style.transform = collapsed ? "rotate(-90deg)" : "";
      }
    }

    renderFilterHeader(tags, categories, uncategorized, count) {
      const header = this.querySelector("#archive-filter-header");
      if (!header) return;

      // 构造筛选项（tag 优先作为主筛选，镜像原逻辑）
      const filters = [];
      if (categories.length > 0)
        filters.push({ label: i18nStrings.categories, values: categories, isTag: false });
      if (uncategorized)
        filters.push({ label: i18nStrings.categories, values: [i18nStrings.uncategorized], isTag: false });
      if (tags.length > 0)
        filters.push({ label: i18nStrings.tags, values: tags, isTag: true });

      const primary =
        filters.find((f) => f.isTag) || filters[0] || null;
      if (!primary) {
		header.classList.add("hidden");
		return;
	  }
      const secondary = filters.filter((f) => f !== primary);

      const linkEl = header.querySelector("#archive-filter-link");
      const valuesEl = header.querySelector("#archive-filter-values");
      const secondaryEl = header.querySelector("#archive-filter-secondary");
      const countEl = header.querySelector("#archive-filter-count");
      const countLabelEl = header.querySelector("#archive-filter-count-label");

      const fmtValues = (f) => {
        const prefix = f.isTag ? "#" : "";
        return f.values.map((v) => `${prefix}${v}`).join(" / ");
      };

      if (linkEl) {
        linkEl.textContent = primary.label;
        linkEl.setAttribute("href", primary.isTag ? tagsBaseUrl : categoriesBaseUrl);
      }
      if (valuesEl) valuesEl.textContent = fmtValues(primary);
      if (secondaryEl) {
        if (secondary.length > 0) {
          const summary = secondary
            .map((f) => `${f.label}: ${fmtValues(f)}`)
            .join("  ·  ");
          secondaryEl.textContent = `· ${summary}`;
          secondaryEl.classList.remove("hidden");
        } else {
          secondaryEl.classList.add("hidden");
        }
      }
      if (countEl) countEl.textContent = String(count);
      if (countLabelEl) {
        countLabelEl.textContent =
          count === 1 ? i18nStrings.postCount : i18nStrings.postsCount;
      }

      header.classList.remove("hidden");
    }

    updateBannerTitle(tags, categories, uncategorized) {
      const bannerTitle = document.querySelector(".banner-page-title-text");
      if (!bannerTitle) return;

      let newTitle = "";
      if (categories.length > 0) {
        newTitle = categories.join(" / ");
      } else if (uncategorized) {
        newTitle = i18nStrings.uncategorized;
      } else if (tags.length > 0) {
        newTitle = tags.map((t) => `#${t}`).join(" / ");
      }
      // 直接设置（自定义元素在解析阶段升级、首帧前执行），避免默认标题闪烁
      if (newTitle && bannerTitle.textContent !== newTitle) {
        bannerTitle.textContent = newTitle;
      }
    }

    bindYearToggles() {
      const blocks = Array.from(this.querySelectorAll(".archive-year-block"));
      for (const block of blocks) {
        const toggle = block.querySelector(".archive-year-toggle");
        const content = block.querySelector(".archive-year-content");
        const arrow = block.querySelector(".archive-arrow");
        if (!toggle || !content) continue;

        toggle.addEventListener("click", () => {
          const willCollapse = !content.hidden;
          content.hidden = willCollapse;
          toggle.setAttribute("aria-expanded", willCollapse ? "false" : "true");

          // 用 Web Animations API 做旋转动画，绕开 Swup 对 CSS transition 的干扰
          if (arrow) {
            requestAnimationFrame(() => {
              arrow.animate(
                [
                  { transform: willCollapse ? "rotate(0deg)" : "rotate(-90deg)" },
                  { transform: willCollapse ? "rotate(-90deg)" : "rotate(0deg)" },
                ],
                { duration: 200, easing: "ease", fill: "forwards" },
              );
            });
          }
        });
      }
    }
  }

  if (!customElements.get("archive-panel")) {
    customElements.define("archive-panel", ArchivePanel);
  }
</script>
