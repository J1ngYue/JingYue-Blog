---
import { Icon } from "astro-icon/components";
import DisplaySettings from "@/components/controls/DisplaySettingsIntegrated.svelte";
import Search from "@/components/controls/Search.svelte";
import { announcementConfig } from "@/config/announcementConfig";

const announcementTitle = announcementConfig.title || "公告";
const announcementContent = announcementConfig.content;
const announcementSecondary =
	announcementConfig.secondaryContent || "最近更新：新增文章与动态模块";
---

<div class="navbar-utility" data-navbar-utility data-open="false" data-settings-open="false" data-announcement-open="false">
	<Search client:load hideTrigger />
	<button
		id="navbar-utility-trigger"
		class="navbar-utility__trigger"
		type="button"
		aria-label="打开快捷功能"
		aria-haspopup="dialog"
		aria-controls="navbar-utility-panel"
		aria-expanded="false"
	>
		<Icon is:inline name="material-symbols:tune-rounded" />
	</button>

	<div
		id="navbar-utility-panel"
		class="navbar-utility__panel"
		role="dialog"
		aria-label="快捷功能"
		aria-hidden="true"
		inert
	>
		<div class="navbar-utility__pointer" aria-hidden="true"></div>
		<div class="navbar-utility__quick-view" data-navbar-utility-quick-view>
		<div class="navbar-utility__actions" role="group" aria-label="快捷操作">
			<button
				class="navbar-utility__action"
				type="button"
				data-navbar-utility-announcement
				aria-label="查看公告"
				aria-controls="navbar-utility-announcement"
				aria-expanded="false"
			>
				<Icon is:inline name="material-symbols:notifications-outline-rounded" />
				<span>公告</span>
			</button>
			<button
				class="navbar-utility__action"
				type="button"
				data-navbar-utility-theme
				aria-label="切换为深色模式"
			>
				<span class="navbar-utility__theme-icon navbar-utility__theme-icon--dark" aria-hidden="true">
					<Icon is:inline name="material-symbols:dark-mode-outline-rounded" />
				</span>
				<span class="navbar-utility__theme-icon navbar-utility__theme-icon--light" aria-hidden="true">
					<Icon is:inline name="material-symbols:wb-sunny-outline-rounded" />
				</span>
				<span class="navbar-utility__theme-label--dark">深色</span>
				<span class="navbar-utility__theme-label--light">浅色</span>
			</button>
			<button class="navbar-utility__action" type="button" data-navbar-utility-search aria-label="搜索文章或内容" title="搜索文章或内容（Ctrl K）">
				<Icon is:inline name="material-symbols:search-rounded" />
				<span>搜索</span>
			</button>
			<button id="display-settings-switch" class="navbar-utility__action" type="button" aria-label="打开显示设置" aria-controls="navbar-display-settings-view" aria-expanded="false">
				<Icon is:inline name="material-symbols:palette-outline" />
				<span>显示设置</span>
			</button>
		</div>

		<div
			id="navbar-utility-announcement"
			class="navbar-utility__announcement-shell"
			aria-hidden="true"
			inert
		>
			<div class="navbar-utility__announcement-clip">
				<div class="navbar-utility__announcement">
					<div class="navbar-utility__announcement-heading">
						<span aria-hidden="true"></span>
						<strong>{announcementTitle}</strong>
					</div>
					<p>{announcementContent}</p>
					<p>{announcementSecondary}</p>
				</div>
			</div>
		</div>

		</div>

		<div id="navbar-display-settings-view" data-navbar-utility-settings-view hidden>
			<div class="navbar-utility__settings-header">
				<button class="navbar-utility__action" type="button" data-navbar-utility-back aria-label="返回快捷功能">
					<Icon is:inline name="material-symbols:arrow-back-rounded" />
					<span>返回</span>
				</button>
				<strong class="navbar-utility__title">显示设置</strong>
				<button class="navbar-utility__action" type="button" data-navbar-utility-close aria-label="关闭显示设置">
					<Icon is:inline name="material-symbols:close-rounded" />
				</button>
			</div>
			<DisplaySettings client:load />
		</div>
	</div>
</div>

<script>
	import { DARK_MODE, LIGHT_MODE } from "@/constants/constants";
	import { setTheme } from "@/utils/setting-utils";

	type UtilityPanelWindow = Window & {
		__fireflyNavbarUtilityCleanup?: () => void;
		__fireflyNavbarUtilityLifecycleBound?: boolean;
	};

	function initNavbarUtilityPanel() {
		const utilityWindow = window as UtilityPanelWindow;
		utilityWindow.__fireflyNavbarUtilityCleanup?.();

		const root = document.querySelector<HTMLElement>("[data-navbar-utility]");
		const trigger = root?.querySelector<HTMLButtonElement>("#navbar-utility-trigger");
		const panel = root?.querySelector<HTMLElement>("#navbar-utility-panel");
		const announcementButton = root?.querySelector<HTMLButtonElement>(
			"[data-navbar-utility-announcement]",
		);
		const announcement = root?.querySelector<HTMLElement>(
			"#navbar-utility-announcement",
		);
		const themeButton = root?.querySelector<HTMLButtonElement>(
			"[data-navbar-utility-theme]",
		);
		const searchButtons = Array.from(
			root?.querySelectorAll<HTMLButtonElement>("[data-navbar-utility-search]") || [],
		);
		const closeButton = root?.querySelector<HTMLButtonElement>("[data-navbar-utility-close]");
		const settingsPanel = root?.querySelector<HTMLElement>("#display-setting");
		const settingsButton = root?.querySelector<HTMLButtonElement>("#display-settings-switch");
		const quickView = root?.querySelector<HTMLElement>("[data-navbar-utility-quick-view]");
		const settingsView = root?.querySelector<HTMLElement>("[data-navbar-utility-settings-view]");
		const backButton = root?.querySelector<HTMLButtonElement>("[data-navbar-utility-back]");

		if (!root || !trigger || !panel || !announcementButton || !announcement || !themeButton || !settingsButton || !quickView || !settingsView) {
			utilityWindow.__fireflyNavbarUtilityCleanup = undefined;
			return;
		}

		let open = false;
		let settingsOpen = false;
		let announcementOpen = false;
		let restoreFocusOnClose = true;

		const syncPanelPosition = () => {
			if (window.matchMedia("(max-width: 767.98px)").matches) {
				panel.style.removeProperty("left");
				panel.style.removeProperty("right");
				return;
			}
			const anchor = root.getBoundingClientRect();
			const width = panel.offsetWidth;
			const left = Math.max(16, Math.min(anchor.right - width, window.innerWidth - width - 16));
			panel.style.left = `${left - anchor.left}px`;
			panel.style.right = "auto";
			panel.style.setProperty("--settings-pointer-left", `${anchor.left + anchor.width / 2 - left - panel.clientLeft}px`);
		};

		const syncThemeButton = () => {
			const isDark = document.documentElement.classList.contains("dark");
			themeButton.setAttribute(
				"aria-label",
				isDark ? "切换为浅色模式" : "切换为深色模式",
			);
		};

		const setAnnouncementOpen = (nextOpen: boolean) => {
			announcementOpen = nextOpen;
			root.dataset.announcementOpen = String(nextOpen);
			announcementButton.setAttribute("aria-expanded", String(nextOpen));
			announcement.setAttribute("aria-hidden", String(!nextOpen));
			announcement.inert = !nextOpen;
		};

		const setSettingsOpen = (nextOpen: boolean) => {
			settingsOpen = nextOpen;
			root.dataset.settingsOpen = String(nextOpen);
			quickView.hidden = nextOpen;
			settingsView.hidden = !nextOpen;
			settingsButton.setAttribute("aria-expanded", String(nextOpen));
			panel.setAttribute("aria-label", nextOpen ? "显示设置" : "快捷功能");
			settingsPanel?.classList.toggle("float-panel-closed", !nextOpen);
			if (open) syncPanelPosition();
		};

		const setOpen = (nextOpen: boolean, restoreFocus = true) => {
			if (open === nextOpen) return;
			open = nextOpen;
			restoreFocusOnClose = restoreFocus;
			root.dataset.open = String(nextOpen);
			trigger.setAttribute("aria-expanded", String(nextOpen));
			trigger.setAttribute(
				"aria-label",
				nextOpen ? "关闭快捷功能" : "打开快捷功能",
			);
			panel.setAttribute("aria-hidden", String(!nextOpen));
			panel.inert = !nextOpen;
			const topRow = document.getElementById("top-row");
			if (nextOpen) topRow?.style.setProperty("z-index", "1060", "important");
			else topRow?.style.removeProperty("z-index");
			if (nextOpen) syncPanelPosition();
			if (!nextOpen) {
				setSettingsOpen(false);
				setAnnouncementOpen(false);
				if (restoreFocusOnClose) {
					const focusTarget = window.matchMedia("(max-width: 767.98px)").matches
						? document.querySelector<HTMLElement>("[data-mobile-action=settings]") : trigger;
					focusTarget?.focus({ preventScroll: true });
				}
			}
		};

		const handleTriggerClick = (event: MouseEvent) => {
			event.stopPropagation();
			const nextOpen = !open;
			if (nextOpen) {
				window.dispatchEvent(
					new CustomEvent("jingyue:floating-panel-open", {
						detail: { panel: "navbar-utility" },
					}),
				);
			}
			setOpen(nextOpen, false);
		};

		const handleSettingsClick = () => {
			if (!open) {
				window.dispatchEvent(new CustomEvent("jingyue:floating-panel-open", {
					detail: { panel: "settings" },
				}));
				setOpen(true, false);
			}
			setSettingsOpen(true);
			backButton?.focus({ preventScroll: true });
		};
		const handleBackClick = () => {
			setSettingsOpen(false);
			settingsButton.focus({ preventScroll: true });
		};

		const handleAnnouncementClick = () => {
			setAnnouncementOpen(!announcementOpen);
		};

		const toggleTheme = () => {
			const nextTheme = document.documentElement.classList.contains("dark")
				? LIGHT_MODE
				: DARK_MODE;
			setTheme(nextTheme);
			window.dispatchEvent(new CustomEvent("theme-change"));
		};

		const handleThemeClick = () => toggleTheme();

		const handleSearchClick = () => {
			setOpen(false, false);
			window.dispatchEvent(new Event("firefly:open-search"));
		};

		const handleDocumentClick = (event: MouseEvent) => {
			if (!open || !(event.target instanceof Node) || root.contains(event.target)) return;
			setOpen(false, false);
		};

		const handleDocumentKeydown = (event: KeyboardEvent) => {
			if (!open || event.key !== "Escape") return;
			event.preventDefault();
			if (settingsOpen) handleBackClick();
			else setOpen(false, true);
		};

		const handleExclusivePanelOpen = (event: Event) => {
			const panelName = (event as CustomEvent<{ panel?: string }>).detail?.panel;
			if (panelName && panelName !== "settings" && panelName !== "navbar-utility") setOpen(false, false);
		};

		const themeObserver = new MutationObserver(syncThemeButton);
		themeObserver.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class"],
		});

		trigger.addEventListener("click", handleTriggerClick);
		settingsButton.addEventListener("click", handleSettingsClick);
		backButton?.addEventListener("click", handleBackClick);
		const handleCloseClick = () => setOpen(false, true);
		closeButton?.addEventListener("click", handleCloseClick);
		announcementButton.addEventListener("click", handleAnnouncementClick);
		themeButton.addEventListener("click", handleThemeClick);
		searchButtons.forEach((button) => button.addEventListener("click", handleSearchClick));
		document.addEventListener("click", handleDocumentClick);
		document.addEventListener("keydown", handleDocumentKeydown);
		window.addEventListener("jingyue:floating-panel-open", handleExclusivePanelOpen);
		window.addEventListener("firefly:toggle-theme", toggleTheme);
		window.addEventListener("resize", syncPanelPosition);
		syncThemeButton();

		utilityWindow.__fireflyNavbarUtilityCleanup = () => {
			setOpen(false, false);
			themeObserver.disconnect();
			trigger.removeEventListener("click", handleTriggerClick);
			settingsButton.removeEventListener("click", handleSettingsClick);
			backButton?.removeEventListener("click", handleBackClick);
			closeButton?.removeEventListener("click", handleCloseClick);
			announcementButton.removeEventListener("click", handleAnnouncementClick);
			themeButton.removeEventListener("click", handleThemeClick);
			searchButtons.forEach((button) => button.removeEventListener("click", handleSearchClick));
			document.removeEventListener("click", handleDocumentClick);
			document.removeEventListener("keydown", handleDocumentKeydown);
			window.removeEventListener("jingyue:floating-panel-open", handleExclusivePanelOpen);
			window.removeEventListener("firefly:toggle-theme", toggleTheme);
			window.removeEventListener("resize", syncPanelPosition);
		};
	}

	const utilityWindow = window as UtilityPanelWindow;
	if (!utilityWindow.__fireflyNavbarUtilityLifecycleBound) {
		utilityWindow.__fireflyNavbarUtilityLifecycleBound = true;
		document.addEventListener("astro:page-load", initNavbarUtilityPanel);
		document.addEventListener("swup:contentReplaced", initNavbarUtilityPanel);
		document.addEventListener("swup:content:replaced", initNavbarUtilityPanel);
	}
	initNavbarUtilityPanel();
</script>

<style>
    .navbar-utility {
        --settings-panel-bg: #fff;
        --settings-ink: #181818;
        --settings-muted: #646464;
        --settings-border: #d4d4d4;
        --settings-soft: #f4f4f4;
        --settings-hover: #e4e4e4;
        --settings-accent: #181818;
        position: relative;
        display: grid;
        width: 2.5rem;
        height: 2.5rem;
        place-items: center;
        color-scheme: light;
    }
    :global(html.dark) .navbar-utility {
        --settings-panel-bg: #181818;
        --settings-ink: #f4f4f4;
        --settings-muted: #a1a1a1;
        --settings-border: #424242;
        --settings-soft: #272727;
        --settings-hover: #363636;
        --settings-accent: #e4e4e4;
        color-scheme: dark;
    }
    .navbar-utility__trigger {
        display: grid;
        width: 100%;
        height: 100%;
        padding: 0;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: var(--settings-ink);
        cursor: pointer;
        place-items: center;
        transition: background-color 180ms ease;
    }
    .navbar-utility__trigger :global(svg) { width: 1.5rem; height: 1.5rem; transition: transform 240ms ease; }
    .navbar-utility__trigger:is(:hover, :focus-visible),
    .navbar-utility[data-open="true"] .navbar-utility__trigger { background: var(--settings-hover); }
    .navbar-utility__trigger:focus-visible { outline: 2px solid var(--settings-accent); outline-offset: 3px; }
    .navbar-utility[data-open="true"] .navbar-utility__trigger :global(svg) { transform: rotate(90deg); }

    .navbar-utility__panel {
        position: absolute;
        top: calc(100% + 0.9rem);
        right: 0;
        z-index: 90;
        box-sizing: border-box;
        width: min(60rem, calc(100vw - 2rem));
        padding: 0;
        border: 2px solid var(--settings-ink);
        border-radius: 1.1rem;
        background: var(--settings-panel-bg);
        box-shadow: 0 1.25rem 3rem rgb(0 0 0 / 16%);
        color: var(--settings-ink);
        opacity: 0;
        pointer-events: none;
        transform: translate3d(0, -0.5rem, 0);
        visibility: hidden;
        transition: opacity 180ms ease, transform 240ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 240ms;
    }
    .navbar-utility[data-open="true"] .navbar-utility__panel { opacity: 1; pointer-events: auto; transform: translate3d(0, 0, 0); visibility: visible; transition-delay: 0s; }
    .navbar-utility[data-open="true"][data-settings-open="true"] .navbar-utility__panel {
        transform-origin: var(--settings-pointer-left, 100%) top;
        animation: navbar-settings-enter 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes navbar-settings-enter {
        from { opacity: 0; transform: translate3d(0, -0.5rem, 0) scale(0.985); }
        to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
    }
    .navbar-utility__pointer {
        position: absolute;
        top: -0.5rem;
        left: var(--settings-pointer-left, calc(100% - 1.25rem));
        width: 0.85rem;
        height: 0.85rem;
        border-top: 2px solid var(--settings-ink);
        border-left: 2px solid var(--settings-ink);
        background: var(--settings-panel-bg);
        transform: translateX(-50%) rotate(45deg);
    }
    .navbar-utility__settings-header { display: flex; align-items: center; gap: 0.35rem; padding: 0.75rem 1rem; border-bottom: 1px solid var(--settings-border); }
    .navbar-utility__title { flex: 1; font-size: 1.05rem; white-space: nowrap; }
    .navbar-utility__action {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        min-height: 2.5rem;
        padding: 0.45rem 0.65rem;
        border: 0;
        border-radius: 0.6rem;
        background: transparent;
        color: var(--settings-ink);
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 650;
        transition: background-color 180ms ease;
    }
    .navbar-utility__action :global(svg), .navbar-utility__theme-icon :global(svg) { width: 1.2rem; height: 1.2rem; }
    .navbar-utility__action:is(:hover, :focus-visible),
    .navbar-utility[data-announcement-open="true"] [data-navbar-utility-announcement] { background: var(--settings-hover); }
    .navbar-utility__action:focus-visible { outline: 2px solid var(--settings-accent); outline-offset: 2px; }
    .navbar-utility__theme-icon { display: grid; place-items: center; }
    .navbar-utility__theme-icon--light, .navbar-utility__theme-label--light { display: none; }
    :global(html.dark) .navbar-utility__theme-icon--dark, :global(html.dark) .navbar-utility__theme-label--dark { display: none; }
    :global(html.dark) .navbar-utility__theme-icon--light, :global(html.dark) .navbar-utility__theme-label--light { display: grid; }

    .navbar-utility__quick-view { padding: 0.7rem; }
    .navbar-utility__actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.38rem; }
    .navbar-utility__quick-view .navbar-utility__action { display: grid; justify-items: center; min-height: 3.35rem; padding: 0.45rem 0.25rem; border-radius: 0.78rem; gap: 0.12rem; font-size: 0.68rem; font-weight: 720; line-height: 1; }
    .navbar-utility__quick-view .navbar-utility__action :global(svg), .navbar-utility__quick-view .navbar-utility__theme-icon :global(svg) { width: 1.42rem; height: 1.42rem; }
    .navbar-utility[data-settings-open="false"] .navbar-utility__panel { width: min(18rem, calc(100vw - 2rem)); border: 1px solid var(--settings-border); }
    .navbar-utility[data-settings-open="false"] .navbar-utility__pointer { border-top-width: 1px; border-left-width: 1px; border-color: var(--settings-border); }
    .navbar-utility__quick-view .navbar-utility__announcement { margin: 0.55rem 0 0; }

    .navbar-utility__announcement-shell { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 220ms ease; }
    .navbar-utility[data-announcement-open="true"] .navbar-utility__announcement-shell { grid-template-rows: 1fr; }
    .navbar-utility__announcement-clip { min-height: 0; overflow: hidden; }
    .navbar-utility__announcement { margin: 0.75rem 1.25rem 0; padding: 0.8rem; border: 1px solid var(--settings-border); border-radius: 0.65rem; background: var(--settings-soft); }
    .navbar-utility__announcement-heading { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem; font-size: 0.85rem; }
    .navbar-utility__announcement-heading > span { width: 0.3rem; height: 0.8rem; border-radius: 999px; background: var(--settings-accent); }
    .navbar-utility__announcement p { margin: 0; color: var(--settings-muted); font-size: 0.8rem; line-height: 1.6; }
    .navbar-utility__announcement p + p { margin-top: 0.25rem; }

    :global(body #top-row #navbar .navbar-actions .navbar-utility__panel),
    :global(body #top-row #navbar .navbar-actions .navbar-utility__panel button),
    :global(body #top-row #navbar .navbar-actions .navbar-utility__panel svg) { color: var(--settings-ink) !important; }

    @media (max-width: 1023px) {
        .navbar-utility__panel { width: calc(100vw - 2rem); }
    }
	@media (max-width: 767.98px) {
		.navbar-utility__panel {
			position: fixed; top: auto; bottom: calc(5.4rem + env(safe-area-inset-bottom, 0px));
			left: max(.75rem, env(safe-area-inset-left, 0px)) !important;
			right: max(.75rem, env(safe-area-inset-right, 0px)) !important;
			width: auto !important; max-width: 30rem; margin-inline: auto;
			max-height: min(76dvh, calc(100dvh - 7rem)); overflow-y: auto;
			overscroll-behavior: contain; border-width: 1px; border-radius: 1.4rem;
			transform: translate3d(0, .8rem, 0);
		}
		.navbar-utility__pointer { display: none; }
		.navbar-utility__settings-header { position: sticky; top: 0; z-index: 2; background: var(--settings-panel-bg); padding: .5rem .65rem; }
		.navbar-utility__action { min-width: 2.75rem; min-height: 2.75rem; }
		.navbar-utility[data-open="true"][data-settings-open="true"] .navbar-utility__panel { animation: mobile-settings-enter 260ms cubic-bezier(.22, 1, .36, 1) both; }
	}
	@keyframes mobile-settings-enter { from { opacity: 0; transform: translate3d(0, .8rem, 0) scale(.985); } to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); } }
    @media (max-width: 599px) {
        .navbar-utility__settings-header { padding: 0.65rem; gap: 0.15rem; }
        .navbar-utility__settings-header .navbar-utility__action { padding: 0.4rem; min-width: 2.4rem; }
        .navbar-utility__title { font-size: 1rem; }
    }
    @media (max-width: 420px) {
        .navbar-utility[data-settings-open="false"] .navbar-utility__panel { width: min(16.5rem, calc(100vw - 2rem)); }
    }
    @media (prefers-reduced-motion: reduce) {
        .navbar-utility__trigger, .navbar-utility__trigger :global(svg), .navbar-utility__panel, .navbar-utility__action, .navbar-utility__announcement-shell { transition-duration: 1ms !important; }
        .navbar-utility[data-open="true"][data-settings-open="true"] .navbar-utility__panel { animation: none; }
    }
</style>
