---
import { Icon } from "astro-icon/components";
import type { ArchiveKnowledgeGraphData } from "@/utils/archive-knowledge-graph";

interface Props {
	graph: ArchiveKnowledgeGraphData;
	id?: string;
	title?: string;
	eyebrow?: string;
	description?: string;
	variant?: "archive" | "categories";
}

const {
	graph,
	id = "knowledge-graph",
	title = "知识图谱",
	eyebrow = "KNOWLEDGE GRAPH",
	description = "根据文章标签的共同出现关系自动生成，点击节点即可筛选对应文章。",
	variant = "archive",
} = Astro.props;
const featuredTags = graph.nodes.slice(0, 7);
const graphGroups = [...new Set(graph.nodes.map((node) => node.group))].sort(
	(a, b) => a - b,
);
const accessibleLabel = `知识图谱，共 ${graph.nodes.length} 个标签、${graph.links.length} 条关联。节点大小表示包含该标签的文章数量。`;
---

<section
	id={id}
	class:list={["archive-knowledge", `archive-knowledge--${variant}`]}
	data-archive-knowledge-graph
	data-graph={JSON.stringify(graph)}
>
	<header class="archive-knowledge__header">
		<div>
			<span class="archive-knowledge__eyebrow">{eyebrow}</span>
			<h2>
				<Icon is:inline name="material-symbols:share" />
				{title}
			</h2>
			<p>{description}</p>
		</div>

		<div class="archive-knowledge__controls" aria-label="图谱视图控制">
			<button type="button" data-graph-action="out" aria-label="缩小图谱" title="缩小">
				<Icon is:inline name="material-symbols:zoom-out-rounded" />
			</button>
			<button type="button" data-graph-action="reset" aria-label="重置图谱视图" title="重置视图">
				<Icon is:inline name="material-symbols:center-focus-strong-rounded" />
			</button>
			<button type="button" data-graph-action="in" aria-label="放大图谱" title="放大">
				<Icon is:inline name="material-symbols:zoom-in-rounded" />
			</button>
		</div>
	</header>

	<div class:list={[
		"archive-knowledge__workspace",
		{ "archive-knowledge__workspace--with-panel": variant === "categories" },
	]}>
		<div
			class="archive-knowledge__surface"
			data-graph-surface
			data-state={graph.nodes.length === 0 ? "empty" : "loading"}
		>
			{
				graph.nodes.length > 0 ? (
					<svg
						data-graph-svg
						role="img"
						tabindex="0"
						aria-label={accessibleLabel}
					>
						<g data-graph-viewport></g>
					</svg>
				) : (
					<div class="archive-knowledge__empty">
						<Icon is:inline name="material-symbols:share" />
						<p>文章添加标签后，知识图谱会自动出现在这里。</p>
					</div>
				)
			}

			<div class="archive-knowledge__status" data-graph-status aria-live="polite">
				{graph.nodes.length === 0 ? "暂无标签关系" : "正在生成知识图谱…"}
			</div>

			<div class="archive-knowledge__tooltip" data-graph-tooltip role="tooltip" hidden>
				<strong data-tooltip-title></strong>
				<span data-tooltip-meta></span>
				<small data-tooltip-posts></small>
			</div>
		</div>

		{variant === "categories" && (
			<aside class="archive-knowledge__panel" aria-label="图谱控制">
				<div class="archive-knowledge__panel-heading">
					<div>
						<span>WORKSPACE</span>
						<h3>图谱控制</h3>
					</div>
					<Icon is:inline name="material-symbols:tune-rounded" />
				</div>
				<label class="archive-knowledge__search">
					<Icon is:inline name="material-symbols:search-rounded" />
					<input type="search" placeholder="搜索标签" aria-label="搜索标签" data-graph-search />
				</label>
				<div class="archive-knowledge__panel-section">
					<div class="archive-knowledge__panel-label">
						<span>类型</span><strong data-graph-match-count>{graph.nodes.length} 个</strong>
					</div>
					<div class="archive-knowledge__segmented" role="group" aria-label="节点类型">
						<button type="button" class="is-active" data-graph-type="all">全部</button>
						<button type="button" data-graph-type="connected">有关联</button>
						<button type="button" data-graph-type="isolated">独立</button>
					</div>
				</div>
				<div class="archive-knowledge__panel-section">
					<div class="archive-knowledge__panel-label">
						<span>最少文章数</span><strong><output data-graph-min-output>1</output> 篇</strong>
					</div>
					<input class="archive-knowledge__range" type="range" min="1" max={Math.max(1, Math.max(...graph.nodes.map((node) => node.value), 1))} value="1" data-graph-min />
				</div>
				<div class="archive-knowledge__panel-section">
					<div class="archive-knowledge__panel-label"><span>分类</span><span class="archive-knowledge__panel-hint">按连通分组</span></div>
					<div class="archive-knowledge__categories" role="group" aria-label="图谱分类">
						<button type="button" class="is-active" data-graph-group="all"><i></i>全部分组</button>
						{graphGroups.slice(0, 5).map((group) => (
							<button type="button" data-graph-group={group}><i style={`--group-color: ${["#f06b5f", "#5c9dff", "#38c9b2", "#e6bf58", "#a884f7"][group % 5]}`}></i>分组 {group + 1}</button>
						))}
					</div>
				</div>
				<details class="archive-knowledge__details" open>
					<summary>外观与动画 <Icon is:inline name="material-symbols:expand-more-rounded" /></summary>
					<label><span>显示连线</span><input type="checkbox" checked data-graph-links /></label>
					<label><span>力导向动画</span><input type="checkbox" checked data-graph-motion /></label>
				</details>
			</aside>
		)}
	</div>

	<footer class="archive-knowledge__footer">
		<p>
			<strong>{graph.nodes.length}</strong> 个标签
			<span aria-hidden="true">·</span>
			<strong>{graph.links.length}</strong> 条关联
		</p>
		<nav aria-label="热门标签">
			{featuredTags.map((tag) => (
				<a href={tag.url} data-no-swup>#{tag.name}<span>{tag.value}</span></a>
			))}
		</nav>
	</footer>
</section>

<script>
	import type {
		D3DragEvent,
		SimulationLinkDatum,
		SimulationNodeDatum,
	} from "d3";
	import type {
		ArchiveKnowledgeGraphData,
		ArchiveKnowledgeGraphLink,
		ArchiveKnowledgeGraphNode,
	} from "@/utils/archive-knowledge-graph";

	type GraphNode = ArchiveKnowledgeGraphNode & SimulationNodeDatum;
	type GraphLink = ArchiveKnowledgeGraphLink &
		SimulationLinkDatum<GraphNode>;

	const graphColors = [
		"#16a085",
		"#3b82f6",
		"#e05a54",
		"#d69b2d",
		"#8b5cf6",
		"#db4b83",
	];
	const graphWindow = window as Window & {
		__archiveKnowledgeCleanup?: () => void;
		__archiveKnowledgeEventsBound?: boolean;
	};

	function nodeRadius(node: GraphNode): number {
		return 8 + Math.sqrt(node.value) * 5;
	}

	async function mountKnowledgeGraph(root: HTMLElement) {
		const isCategoryGraph = root.classList.contains(
			"archive-knowledge--categories",
		);
		const surface = root.querySelector<HTMLElement>("[data-graph-surface]");
		const svgElement = root.querySelector<SVGSVGElement>("[data-graph-svg]");
		const viewportElement =
			root.querySelector<SVGGElement>("[data-graph-viewport]");
		const status = root.querySelector<HTMLElement>("[data-graph-status]");
		const tooltip = root.querySelector<HTMLElement>("[data-graph-tooltip]");
		if (!surface || !svgElement || !viewportElement || !tooltip) return () => {};

		const graph = JSON.parse(
			root.dataset.graph ?? '{"nodes":[],"links":[]}',
		) as ArchiveKnowledgeGraphData;
		const nodes: GraphNode[] = graph.nodes.map((node) => ({ ...node }));
		const links: GraphLink[] = graph.links.map((link) => ({ ...link }));
		const d3 = await import("d3");
		const svg = d3.select(svgElement);
		const viewport = d3.select(viewportElement);
		viewport.selectAll("*").remove();

		const linkSelection = viewport
			.append("g")
			.attr("class", "archive-knowledge__links")
			.selectAll<SVGLineElement, GraphLink>("line")
			.data(links)
			.join("line")
			.attr("stroke-width", (link) => Math.min(3, 0.8 + link.value * 0.45));

		const nodeSelection = viewport
			.append("g")
			.attr("class", "archive-knowledge__nodes")
			.selectAll<SVGAElement, GraphNode>("a")
			.data(nodes)
			.join("a")
			.attr("href", (node) => node.url)
			.attr("data-no-swup", "")
			.attr(
				"aria-label",
				(node) => `${node.name}，${node.value} 篇文章，点击筛选`,
			)
			.style(
				"--graph-node-color",
				(node) => graphColors[node.group % graphColors.length],
			);

		nodeSelection
			.append("circle")
			.attr("r", nodeRadius)
			.attr("tabindex", -1);

		nodeSelection
			.append("text")
			.attr("text-anchor", "middle")
			.attr("dy", (node) => nodeRadius(node) + 15)
			.attr("font-size", (node) => Math.min(17, 10 + node.value * 1.25))
			.text((node) => node.name);

		nodeSelection
			.append("title")
			.text((node) => `${node.name} · ${node.value} 篇文章`);

		let width = 0;
		let height = 0;
		const linkForce = d3
			.forceLink<GraphNode, GraphLink>(links)
			.id((node) => node.id)
			.distance((link) =>
				isCategoryGraph
					? Math.max(105, 154 - link.value * 8)
					: Math.max(72, 118 - link.value * 10),
			)
			.strength((link) => Math.min(0.9, 0.35 + link.value * 0.14));
		const simulation = d3
			.forceSimulation<GraphNode>(nodes)
			.force("link", linkForce)
			.force(
				"charge",
				d3.forceManyBody().strength(isCategoryGraph ? -410 : -190),
			)
			.force(
				"collide",
				d3
					.forceCollide<GraphNode>()
					.radius((node) => nodeRadius(node) + (isCategoryGraph ? 32 : 22)),
			)
			.force(
				"x",
				d3
					.forceX<GraphNode>()
					.strength(isCategoryGraph ? 0.018 : 0.045),
			)
			.force(
				"y",
				d3
				.forceY<GraphNode>()
					.strength(isCategoryGraph ? 0.018 : 0.045),
				);
		const searchInput = root.querySelector<HTMLInputElement>("[data-graph-search]");
		const minRange = root.querySelector<HTMLInputElement>("[data-graph-min]");
		const minOutput = root.querySelector<HTMLOutputElement>("[data-graph-min-output]");
		const matchCount = root.querySelector<HTMLElement>("[data-graph-match-count]");
		const linkToggle = root.querySelector<HTMLInputElement>("[data-graph-links]");
		const motionToggle = root.querySelector<HTMLInputElement>("[data-graph-motion]");
		let activeType = "all";
		let activeGroup = "all";
		let showLinks = true;
		const idOf = (value: string | GraphNode): string =>
			typeof value === "string" ? value : value.id;
		const visibleNode = (node: GraphNode) => {
			const query = searchInput?.value.trim().toLocaleLowerCase() ?? "";
			const minValue = Number(minRange?.value ?? 1);
			const matchesSearch = !query || node.name.toLocaleLowerCase().includes(query);
			const matchesMin = node.value >= minValue;
			const matchesGroup = activeGroup === "all" || node.group === Number(activeGroup);
			const connected = links.some(
				(link) => idOf(link.source as string | GraphNode) === node.id || idOf(link.target as string | GraphNode) === node.id,
			);
			const matchesType = activeType === "all" || (activeType === "connected" ? connected : !connected);
			return matchesSearch && matchesMin && matchesGroup && matchesType;
		};
		const updateFilters = () => {
			const visible = new Set(nodes.filter(visibleNode).map((node) => node.id));
			nodeSelection
				.attr("opacity", (node) => (visible.has(node.id) ? 1 : 0.12))
				.style("pointer-events", (node) => (visible.has(node.id) ? "auto" : "none"));
			linkSelection.attr("opacity", (link) => {
				const source = idOf(link.source as string | GraphNode);
				const target = idOf(link.target as string | GraphNode);
				return showLinks && visible.has(source) && visible.has(target) ? 0.72 : 0;
			});
			if (minOutput) minOutput.value = minRange?.value ?? "1";
			if (matchCount) matchCount.textContent = `${visible.size} 个`;
		};
		const interactiveCleanup: Array<() => void> = [];
		const bind = (element: EventTarget | null, event: string, listener: EventListener) => {
			if (!element) return;
			element.addEventListener(event, listener);
			interactiveCleanup.push(() => element.removeEventListener(event, listener));
		};
		bind(searchInput, "input", updateFilters);
		bind(minRange, "input", updateFilters);
		root.querySelectorAll<HTMLButtonElement>("[data-graph-type]").forEach((button) => {
			bind(button, "click", () => {
				activeType = button.dataset.graphType ?? "all";
				root.querySelectorAll("[data-graph-type]").forEach((item) => item.classList.toggle("is-active", item === button));
				updateFilters();
			});
		});
		root.querySelectorAll<HTMLButtonElement>("[data-graph-group]").forEach((button) => {
			bind(button, "click", () => {
				activeGroup = button.dataset.graphGroup ?? "all";
				root.querySelectorAll("[data-graph-group]").forEach((item) => item.classList.toggle("is-active", item === button));
				updateFilters();
			});
		});
		bind(linkToggle, "change", () => {
			showLinks = linkToggle?.checked ?? true;
			updateFilters();
		});
		bind(motionToggle, "change", () => {
			if (motionToggle?.checked) simulation.alpha(0.35).restart();
			else simulation.stop();
		});

		const render = () => {
			if (isCategoryGraph && width > 0 && height > 0) {
				for (const node of nodes) {
					const radius = nodeRadius(node) + 48;
					node.x = Math.max(radius, Math.min(width - radius, node.x ?? 0));
					node.y = Math.max(radius, Math.min(height - radius - 18, node.y ?? 0));
				}
			}
			linkSelection
				.attr("x1", (link) => (link.source as GraphNode).x ?? 0)
				.attr("y1", (link) => (link.source as GraphNode).y ?? 0)
				.attr("x2", (link) => (link.target as GraphNode).x ?? 0)
				.attr("y2", (link) => (link.target as GraphNode).y ?? 0);
			nodeSelection.attr(
				"transform",
				(node) => `translate(${node.x ?? 0},${node.y ?? 0})`,
			);
		};
		simulation.on("tick", render);
		updateFilters();

		const showTooltip = (
			node: GraphNode,
			clientX?: number,
			clientY?: number,
		) => {
			const title = tooltip.querySelector<HTMLElement>("[data-tooltip-title]");
			const meta = tooltip.querySelector<HTMLElement>("[data-tooltip-meta]");
			const posts = tooltip.querySelector<HTMLElement>("[data-tooltip-posts]");
			if (title) title.textContent = node.name;
			if (meta) meta.textContent = `${node.value} 篇文章`;
			if (posts) posts.textContent = node.posts.slice(0, 3).join(" · ");

			const bounds = surface.getBoundingClientRect();
			const x = clientX === undefined ? (node.x ?? width / 2) : clientX - bounds.left;
			const y = clientY === undefined ? (node.y ?? height / 2) : clientY - bounds.top;
			tooltip.style.left = `${Math.min(bounds.width - 190, Math.max(12, x + 14))}px`;
			tooltip.style.top = `${Math.min(bounds.height - 88, Math.max(12, y + 14))}px`;
			tooltip.hidden = false;
		};
		const hideTooltip = () => {
			tooltip.hidden = true;
		};

		nodeSelection
			.on("pointerenter", (event, node) =>
				showTooltip(node, event.clientX, event.clientY),
			)
			.on("pointermove", (event, node) =>
				showTooltip(node, event.clientX, event.clientY),
			)
			.on("pointerleave", hideTooltip)
			.on("focus", (_event, node) => showTooltip(node))
			.on("blur", hideTooltip);

		const drag = d3
			.drag<SVGAElement | HTMLAnchorElement, GraphNode>()
			.on(
				"start",
				(
					event: D3DragEvent<
						SVGAElement | HTMLAnchorElement,
						GraphNode,
						GraphNode
					>,
					node,
				) => {
					if (!event.active) simulation.alphaTarget(0.2).restart();
					node.fx = node.x;
					node.fy = node.y;
				},
			)
			.on(
				"drag",
				(
					event: D3DragEvent<
						SVGAElement | HTMLAnchorElement,
						GraphNode,
						GraphNode
					>,
					node,
				) => {
					node.fx = event.x;
					node.fy = event.y;
				},
			)
			.on(
				"end",
				(
					event: D3DragEvent<
						SVGAElement | HTMLAnchorElement,
						GraphNode,
						GraphNode
					>,
					node,
				) => {
					if (!event.active) simulation.alphaTarget(0);
					node.fx = null;
					node.fy = null;
				},
			);
		nodeSelection.call(drag);

		const zoom = d3
			.zoom<SVGSVGElement, unknown>()
			.scaleExtent([0.55, 3])
			.on("zoom", (event) => viewport.attr("transform", event.transform));
		svg.call(zoom);

		const controlListeners: Array<{
			button: HTMLButtonElement;
			listener: () => void;
		}> = [];
		root.querySelectorAll<HTMLButtonElement>("[data-graph-action]").forEach(
			(button) => {
				const listener = () => {
					const action = button.dataset.graphAction;
					if (action === "reset") {
						svg
							.transition()
							.duration(220)
							.call(zoom.transform, d3.zoomIdentity);
						simulation.alpha(0.25).restart();
						return;
					}
					svg
						.transition()
						.duration(180)
						.call(zoom.scaleBy, action === "in" ? 1.3 : 0.77);
				};
				button.addEventListener("click", listener);
				controlListeners.push({ button, listener });
			},
		);

		const resize = () => {
			const bounds = surface.getBoundingClientRect();
			width = Math.max(280, bounds.width);
			height = Math.max(320, bounds.height);
			svg.attr("viewBox", `0 0 ${width} ${height}`);
			simulation
				.force("center", d3.forceCenter(width / 2, height / 2))
				.force(
					"x",
					d3
						.forceX<GraphNode>(width / 2)
						.strength(isCategoryGraph ? 0.018 : 0.045),
				)
				.force(
					"y",
					d3
						.forceY<GraphNode>(height / 2)
						.strength(isCategoryGraph ? 0.018 : 0.045),
				)
				.alpha(0.35)
				.restart();
		};
		const resizeObserver = new ResizeObserver(resize);
		resizeObserver.observe(surface);
		resize();

		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			simulation.stop();
			simulation.tick(220);
			render();
		}

		surface.dataset.state = "ready";
		if (status) status.textContent = "知识图谱已加载";

		return () => {
			simulation.stop();
			resizeObserver.disconnect();
			svg.on(".zoom", null);
			nodeSelection.on(".drag", null);
			for (const { button, listener } of controlListeners) {
				button.removeEventListener("click", listener);
			}
			for (const cleanup of interactiveCleanup) cleanup();
		};
	}

	async function initArchiveKnowledgeGraph() {
		graphWindow.__archiveKnowledgeCleanup?.();
		const root = document.querySelector<HTMLElement>(
			"[data-archive-knowledge-graph]",
		);
		if (!root || root.dataset.bound === "true") return;
		root.dataset.bound = "true";

		try {
			graphWindow.__archiveKnowledgeCleanup =
				await mountKnowledgeGraph(root);
		} catch (error) {
			const surface = root.querySelector<HTMLElement>("[data-graph-surface]");
			const status = root.querySelector<HTMLElement>("[data-graph-status]");
			if (surface) surface.dataset.state = "error";
			if (status) status.textContent = "知识图谱加载失败";
			console.error("Failed to mount archive knowledge graph", error);
		}
	}

	void initArchiveKnowledgeGraph();
	if (!graphWindow.__archiveKnowledgeEventsBound) {
		graphWindow.__archiveKnowledgeEventsBound = true;
		document.addEventListener("swup:contentReplaced", () => {
			void initArchiveKnowledgeGraph();
		});
	}
</script>

<style>
	.archive-knowledge {
		--graph-ink: #171b1e;
		--graph-muted: #657077;
		margin-top: clamp(2.7rem, 5vw, 4.4rem);
	}

	:global(html.dark) .archive-knowledge {
		--graph-ink: #f4f6f7;
		--graph-muted: #aab2b6;
	}

	.archive-knowledge__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.25rem;
		margin-bottom: 1.1rem;
	}

	.archive-knowledge__eyebrow {
		color: var(--graph-muted);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.68rem;
		font-weight: 750;
		letter-spacing: 0.16em;
	}

	.archive-knowledge__header h2 {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0.38rem 0 0;
		color: var(--graph-ink);
		font-size: clamp(1.75rem, 3vw, 2.3rem);
		font-weight: 820;
		letter-spacing: -0.04em;
	}

	.archive-knowledge__header h2 :global(svg) {
		width: 1.9rem;
		height: 1.9rem;
	}

	.archive-knowledge__header p {
		margin: 0.5rem 0 0;
		color: var(--graph-muted);
		font-size: 0.86rem;
	}

	.archive-knowledge__controls {
		display: flex;
		gap: 0.4rem;
	}

	.archive-knowledge__controls button {
		display: grid;
		width: 2.35rem;
		height: 2.35rem;
		place-items: center;
		border: 1px solid color-mix(in srgb, var(--graph-ink) 18%, transparent);
		border-radius: 0.55rem;
		background: color-mix(in srgb, var(--card-bg) 92%, transparent);
		color: var(--graph-ink);
		cursor: pointer;
		transition: border-color 180ms ease, background-color 180ms ease;
	}

	.archive-knowledge__controls button:hover {
		border-color: color-mix(in srgb, var(--graph-ink) 48%, transparent);
		background: color-mix(in srgb, var(--graph-ink) 7%, var(--card-bg));
