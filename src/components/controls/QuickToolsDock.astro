---
import { Icon } from "astro-icon/components";
import { backgroundWallpaper, siteConfig } from "@/config";
import { musicPlayerConfig } from "@/config/musicConfig";
import { url } from "@/utils/url-utils";

const showThemeColor = !siteConfig.themeColor.fixed;
const isWallpaperSwitchable = backgroundWallpaper.switchable ?? true;
const allowLayoutSwitch = siteConfig.postListLayout.allowSwitch;
const hasDisplaySettings =
	showThemeColor || isWallpaperSwitchable || allowLayoutSwitch;

const quickLinks = [
	{
		key: "archive",
		label: "文章",
		description: "浏览归档",
		href: url("/archive/"),
	},
	{
		key: "dynamic",
		label: "动态",
		description: "查看近况",
		href: url("/dynamic/"),
	},
	{
		key: "gallery",
		label: "相册",
		description: "收藏光影",
		href: url("/gallery/"),
	},
	{
		key: "friends",
		label: "友链",
		description: "拜访朋友",
		href: url("/friends/"),
	},
	{
		key: "guestbook",
		label: "留言",
		description: "留下问候",
		href: url("/guestbook/"),
	},
	{
		key: "about",
		label: "关于",
		description: "认识这里",
		href: url("/about/"),
	},
];
---

<div id="quick-tools-dock" class="quick-tools-dock">
	<div
		id="quick-tools-menu"
		class="quick-tools-menu"
		role="dialog"
		aria-hidden="true"
		aria-labelledby="quick-tools-menu-title"
		inert
	>
		<div class="quick-tools-menu__header">
			<div>
				<p id="quick-tools-menu-title">快捷导航</p>
				<span>选择一个方向继续探索</span>
			</div>
			<button id="quick-tools-menu-close" type="button" aria-label="关闭快捷导航">
				<span aria-hidden="true">×</span>
			</button>
		</div>

		<nav class="quick-tools-links" aria-label="站点快捷入口">
			{
				quickLinks.map((item) => (
					<a href={item.href}>
						{item.key === "archive" && <Icon is:inline name="material-symbols:article-outline-rounded" />}
						{item.key === "dynamic" && <Icon is:inline name="material-symbols:forum-outline-rounded" />}
						{item.key === "gallery" && <Icon is:inline name="material-symbols:photo-library-outline-rounded" />}
						{item.key === "friends" && <Icon is:inline name="material-symbols:group-outline-rounded" />}
						{item.key === "guestbook" && <Icon is:inline name="material-symbols:chat-bubble-outline-rounded" />}
						{item.key === "about" && <Icon is:inline name="material-symbols:person-outline-rounded" />}
						<span>
							<strong>{item.label}</strong>
							<small>{item.description}</small>
						</span>
					</a>
				))
			}
		</nav>
	</div>

	<nav class="quick-tools-rail" aria-label="全局快捷工具栏">
		<div class="quick-tools-pinned">
			<a
				class="quick-tools-button quick-tools-profile-button"
				href={url("/about/")}
				data-tooltip="关于"
				aria-label="查看关于页面"
			>
				<Icon is:inline name="material-symbols:person-outline-rounded" />
			</a>
			{musicPlayerConfig.showInNavbar && (
				<button
					type="button"
					class="quick-tools-button quick-tools-music-button"
					data-quick-tools-music
					aria-label="打开音乐播放器"
					aria-controls="music-mini-panel"
					aria-expanded="false"
					data-tooltip="音乐播放器"
				>
					<Icon is:inline name="material-symbols:music-note-rounded" />
				</button>
			)}
		</div>
		<div id="quick-tools-actions" class="quick-tools-actions-shell">
			<div class="quick-tools-actions">
				{hasDisplaySettings && (
				<button
					id="display-settings-switch"
					class="quick-tools-button"
					type="button"
					data-tooltip="显示设置"
					aria-label="打开显示设置"
				>
					<Icon is:inline name="material-symbols:palette-outline" />
				</button>
			)}
				<button
					id="quick-tools-theme"
					class="quick-tools-button quick-tools-theme"
					type="button"
					data-tooltip="深色模式"
					aria-label="深色模式"
				>
					<span class="quick-tools-theme-icon quick-tools-theme-icon--dark" aria-hidden="true">
						<Icon is:inline name="material-symbols:dark-mode-outline-rounded" />
					</span>
					<span class="quick-tools-theme-icon quick-tools-theme-icon--light" aria-hidden="true">
						<Icon is:inline name="material-symbols:wb-sunny-outline-rounded" />
					</span>
				</button>
				<button
					id="quick-tools-navigation"
					class="quick-tools-button"
					type="button"
					data-tooltip="快捷导航"
					aria-label="打开快捷导航"
					aria-controls="quick-tools-menu"
					aria-expanded="false"
					aria-haspopup="dialog"
				>
					<Icon is:inline name="material-symbols:ads-click-rounded" />
				</button>
				<button
					id="quick-tools-wallpaper"
					class="quick-tools-button"
					type="button"
					data-tooltip="切换壁纸"
					aria-label="切换壁纸"
				>
					<Icon is:inline name="material-symbols:wallpaper" />
				</button>
			</div>
		</div>
		<button
			id="quick-tools-collapse"
			class="quick-tools-button quick-tools-collapse"
			type="button"
			data-tooltip="收起快捷工具"
			aria-label="收起快捷工具"
			aria-controls="quick-tools-actions"
			aria-expanded="true"
		>
			<span class="quick-tools-collapse-icon" aria-hidden="true">
				<Icon is:inline name="material-symbols:keyboard-arrow-up-rounded" />
			</span>
		</button>
	</nav>
</div>

<script>
	import { DARK_MODE, LIGHT_MODE } from "@/constants/constants";
	import { setTheme } from "@/utils/setting-utils";

	function initQuickToolsDock() {
		const dock = document.getElementById("quick-tools-dock");
		if (!dock || dock.dataset.bound === "true") return;
		dock.dataset.bound = "true";

		const menu = document.getElementById("quick-tools-menu");
		const navigationButton = document.getElementById("quick-tools-navigation");
		const closeButton = document.getElementById("quick-tools-menu-close");
		const settingsButton = document.getElementById("display-settings-switch");
		const settingsPanel = document.getElementById("display-setting");
		const themeButton = document.getElementById("quick-tools-theme");
		const wallpaperButton = document.getElementById("quick-tools-wallpaper");
		const collapseButton = document.getElementById("quick-tools-collapse");
		const actionsShell = document.getElementById("quick-tools-actions");
		const musicButton = dock.querySelector<HTMLElement>("[data-quick-tools-music]");
		const musicMiniPanel = document.getElementById("music-mini-panel");
		const musicPanel = document.getElementById("music-nav-panel");
		const collapsedStorageKey = "jingyue:quick-tools-collapsed";

		const setActionsCollapsed = (collapsed: boolean) => {
			dock.dataset.collapsed = String(collapsed);
			actionsShell?.setAttribute("aria-hidden", String(collapsed));
			if (actionsShell) actionsShell.inert = collapsed;
			collapseButton?.setAttribute("aria-expanded", String(!collapsed));
			collapseButton?.setAttribute(
				"aria-label",
				collapsed ? "展开快捷工具" : "收起快捷工具",
			);
			collapseButton?.setAttribute(
				"data-tooltip",
				collapsed ? "展开快捷工具" : "收起快捷工具",
			);
		};

		let actionsCollapsed = false;
		try {
			actionsCollapsed = localStorage.getItem(collapsedStorageKey) === "true";
		} catch {}
		setActionsCollapsed(actionsCollapsed);

		collapseButton?.addEventListener("click", (event) => {
			event.stopPropagation();
			actionsCollapsed = !actionsCollapsed;
			setActionsCollapsed(actionsCollapsed);
			try {
				localStorage.setItem(collapsedStorageKey, String(actionsCollapsed));
			} catch {}
		});
		if (musicMiniPanel && musicMiniPanel.parentElement !== document.body) {
			document.body.appendChild(musicMiniPanel);
		}
		if (musicPanel?.dataset.musicImmersive === "true" && musicPanel.parentElement !== document.body) {
			document.body.appendChild(musicPanel);
		}
		let musicLayoutFrame = 0;
		type FloatingPanelName =
			| "navigation"
			| "music"
			| "immersive"
			| "settings"
			| "wallpaper"
			| "search";

		const requestExclusivePanel = (panel: FloatingPanelName) => {
			window.dispatchEvent(
				new CustomEvent("jingyue:floating-panel-open", {
					detail: { panel },
				}),
			);
		};

		const closeSettingsPanel = () => {
			settingsPanel?.classList.add("float-panel-closed");
			settingsButton?.setAttribute("aria-expanded", "false");
		};

		const closeWallpaperPicker = () => {
			window.dispatchEvent(new Event("firefly:close-wallpaper-picker"));
		};

		const syncMusicPanelPosition = () => {
			if (!musicButton || !musicMiniPanel) return;
			if (musicLayoutFrame) cancelAnimationFrame(musicLayoutFrame);
			musicLayoutFrame = requestAnimationFrame(() => {
				musicLayoutFrame = 0;
				const buttonRect = musicButton.getBoundingClientRect();
				const panelWidth = Math.min(468, Math.max(0, buttonRect.left - 28));
				const panelHeight = musicMiniPanel.offsetHeight;
				const viewportLeft = Math.max(8, Math.round(buttonRect.left - panelWidth - 12));
				const viewportTop = Math.max(
					8,
					Math.min(Math.round(buttonRect.top), window.innerHeight - panelHeight - 8),
				);
				const containingBlock = musicMiniPanel.offsetParent?.getBoundingClientRect();
				const left = viewportLeft - (containingBlock?.left ?? 0);
				const top = viewportTop - (containingBlock?.top ?? 0);
				musicMiniPanel.style.setProperty("left", `${left}px`, "important");
				musicMiniPanel.style.setProperty("right", "auto", "important");
				musicMiniPanel.style.setProperty("top", `${top}px`, "important");
				musicMiniPanel.style.setProperty("width", `${panelWidth}px`, "important");
			});
		};

		const setMenuOpen = (open: boolean, focusMenu = false, restoreFocus = false) => {
			dock.dataset.open = open ? "true" : "false";
			navigationButton?.setAttribute("aria-expanded", String(open));
			menu?.setAttribute("aria-hidden", String(!open));
			menu?.toggleAttribute("inert", !open);
			if (open && focusMenu) {
				requestAnimationFrame(() => menu?.querySelector<HTMLAnchorElement>("a")?.focus());
			} else if (restoreFocus) {
				requestAnimationFrame(() => navigationButton?.focus());
			}
		};

		const setMusicOpen = (open: boolean) => {
			if (!musicMiniPanel) return;
			musicMiniPanel.classList.toggle("music-mini-panel-closed", !open);
			musicMiniPanel.setAttribute("aria-hidden", String(!open));
			musicMiniPanel.toggleAttribute("inert", !open);
			musicButton?.setAttribute("aria-expanded", String(open));
			window.dispatchEvent(
				new CustomEvent("jingyue:music-mini-state", { detail: { open } }),
			);
			syncMusicPanelPosition();
		};
		const setImmersiveOpen = (open: boolean) => {
			if (!musicPanel) return;
			musicPanel.classList.toggle("float-panel-closed", !open);
			musicPanel.setAttribute("aria-hidden", String(!open));
			musicPanel.toggleAttribute("inert", !open);
			document.body.classList.toggle("music-immersive-open", open);
			document.documentElement.classList.toggle("music-immersive-open", open);
			const topRow = document.getElementById("top-row");
			if (open) topRow?.style.setProperty("z-index", "1060", "important");
			else topRow?.style.removeProperty("z-index");
			window.dispatchEvent(
				new CustomEvent("jingyue:music-overlay-state", { detail: { open } }),
			);
		};
		const handleExclusivePanelOpen = (event: Event) => {
			const panel = (
				event as CustomEvent<{ panel?: FloatingPanelName }>
			).detail?.panel;
			if (!panel) return;
			if (panel !== "navigation") setMenuOpen(false);
			if (panel !== "music") setMusicOpen(false);
			if (panel !== "immersive") setImmersiveOpen(false);
			if (panel !== "settings") closeSettingsPanel();
			if (panel !== "wallpaper") closeWallpaperPicker();
			if (panel !== "search") {
				window.dispatchEvent(new Event("firefly:close-search"));
			}
		};
		window.addEventListener(
			"jingyue:floating-panel-open",
			handleExclusivePanelOpen,
		);
		navigationButton?.addEventListener("click", (event) => {
			const open = dock.dataset.open !== "true";
			if (open) requestExclusivePanel("navigation");
			setMenuOpen(open, open && event.detail === 0, !open);
		});
		closeButton?.addEventListener("click", () => setMenuOpen(false, false, true));
		menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenuOpen(false)));

		const syncThemeButton = () => {
			if (!themeButton) return;
			const nextTheme = document.documentElement.classList.contains("dark")
				? "浅色"
				: "深色";
			const label = `${nextTheme}模式`;
			themeButton.setAttribute("aria-label", label);
			themeButton.dataset.tooltip = label;
		};

		themeButton?.addEventListener("click", (event) => {
			event.stopPropagation();
			const nextTheme = document.documentElement.classList.contains("dark")
				? LIGHT_MODE
				: DARK_MODE;
			setTheme(nextTheme);
			window.dispatchEvent(new CustomEvent("theme-change"));
			syncThemeButton();
		});
		new MutationObserver(syncThemeButton).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class"],
		});

		settingsButton?.addEventListener("click", (event) => {
			event.stopPropagation();
			queueMicrotask(() => {
				const open =
					settingsPanel &&
					!settingsPanel.classList.contains("float-panel-closed");
				settingsButton.setAttribute("aria-expanded", String(Boolean(open)));
				if (open) requestExclusivePanel("settings");
			});
		});

		wallpaperButton?.addEventListener("click", (event) => {
			event.stopPropagation();
			requestExclusivePanel("wallpaper");
			window.dispatchEvent(new Event("firefly:open-wallpaper-picker"));
		});
		musicButton?.addEventListener("click", (event) => {
			event.stopPropagation();
			const open =
				musicMiniPanel?.classList.contains("music-mini-panel-closed") ??
				true;
			if (open) requestExclusivePanel("music");
			setMusicOpen(open);
		});
		window.addEventListener("jingyue:toggle-music-mini", (event) => {
			const requestedState = (event as CustomEvent<{ open?: boolean }>).detail?.open;
			const open =
				typeof requestedState === "boolean"
					? requestedState
					: (musicMiniPanel?.classList.contains("music-mini-panel-closed") ?? true);
			if (open) requestExclusivePanel("music");
			setMusicOpen(open);
		});
		window.addEventListener("jingyue:close-music-mini", () => setMusicOpen(false));
		window.addEventListener("jingyue:open-immersive-music", () => {
			requestExclusivePanel("immersive");
			setImmersiveOpen(true);
		});
		document.addEventListener("click", (event) => {
			const actionButton =
				event.target instanceof Element
					? event.target.closest<HTMLButtonElement>("[data-music-page-action]")
					: null;
			if (!actionButton) return;

			if (actionButton.dataset.musicPageAction === "library") {
				setImmersiveOpen(false);
				setMusicOpen(false);
				window.dispatchEvent(
					new CustomEvent("jingyue:open-music-library", {
						detail: { tab: "queue" },
					}),
				);
				return;
			}

			requestExclusivePanel("immersive");
			setMusicOpen(false);
			setImmersiveOpen(true);
		});
		window.addEventListener("jingyue:close-music-player", () => {
			setImmersiveOpen(false);
			setMusicOpen(true);
		});
		window.addEventListener("resize", syncMusicPanelPosition, { passive: true });
		window.visualViewport?.addEventListener("resize", syncMusicPanelPosition, { passive: true });
		const syncMusicPlaying = (event?: Event) => {
			const eventState = event instanceof CustomEvent ? event.detail?.isPlaying : undefined;
			const managerState = (
				window as Window & { __fireflyMusic?: { getState: () => { isPlaying?: boolean } } }
			).__fireflyMusic?.getState().isPlaying;
			musicButton?.classList.toggle("is-playing", Boolean(eventState ?? managerState));
		};
		window.addEventListener("fm:play-state", syncMusicPlaying);

		document.addEventListener("click", (event) => {
			if (
				dock.dataset.open === "true" &&
				event.target instanceof Node &&
				!dock.contains(event.target)
			) {
				setMenuOpen(false);
			}
			if (
				musicMiniPanel &&
				!musicMiniPanel.classList.contains("music-mini-panel-closed") &&
				event.target instanceof Node &&
				!musicMiniPanel.contains(event.target) &&
				!musicPanel?.contains(event.target) &&
				!musicButton?.contains(event.target)
			) {
				setMusicOpen(false);
			}
		});
		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape") return;
			if (dock.dataset.open === "true") setMenuOpen(false, false, true);
			if (musicPanel && !musicPanel.classList.contains("float-panel-closed")) {
				setImmersiveOpen(false);
				setMusicOpen(true);
			} else if (musicMiniPanel && !musicMiniPanel.classList.contains("music-mini-panel-closed")) {
				setMusicOpen(false);
			}
			closeSettingsPanel();
		});

		const syncCurrentLink = () => {
			const normalizePath = (path: string) =>
				path === "/" ? path : `${path.replace(/\/+$/, "")}/`;
			const currentPath = normalizePath(window.location.pathname);
			menu?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
				const linkPath = normalizePath(new URL(link.href).pathname);
				if (linkPath === currentPath) link.setAttribute("aria-current", "page");
				else link.removeAttribute("aria-current");
			});
		};

		const bindSwup = () => {
			if (dock.dataset.swupBound === "true" || !window.swup?.hooks) return;
			dock.dataset.swupBound = "true";
			window.swup.hooks.on("visit:start", () => {
				setMenuOpen(false);
				setMusicOpen(false);
				setImmersiveOpen(false);
				closeSettingsPanel();
			});
			window.swup.hooks.on("page:view", () => {
				syncCurrentLink();
				syncMusicPanelPosition();
			});
		};
		syncCurrentLink();
		syncThemeButton();
		syncMusicPlaying();
		syncMusicPanelPosition();
		if (window.swup?.hooks) bindSwup();
		else document.addEventListener("swup:enable", bindSwup, { once: true });
	}

	initQuickToolsDock();
</script>

<style>
	@keyframes quick-tools-spin {
		to {
			transform: rotate(1turn);
		}
	}

	.quick-tools-dock {
		--quick-tools-size: 3.25rem;
		--quick-tools-gap: 0.55rem;
		--quick-tools-right: max(1rem, env(safe-area-inset-right));
		--quick-tools-bottom: max(1rem, env(safe-area-inset-bottom));
		position: fixed;
		inset: 0;
		z-index: 1050;
		pointer-events: none;
	}

	.quick-tools-rail {
		position: fixed;
		right: var(--quick-tools-right);
		bottom: var(--quick-tools-bottom);
		z-index: 3;
		display: flex;
		align-items: flex-end;
		flex-direction: column;
		gap: var(--quick-tools-gap);
		width: auto;
		padding: 0;
		pointer-events: auto;
		transition:
			opacity 220ms ease,
			transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.quick-tools-pinned,
	.quick-tools-actions {
		display: flex;
		align-items: flex-end;
		flex-direction: column;
		gap: var(--quick-tools-gap);
	}

	.quick-tools-actions-shell {
		display: grid;
		grid-template-rows: 1fr;
		opacity: 1;
		transform: translateY(0);
		transition:
			grid-template-rows 320ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 200ms ease,
			transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s;
		visibility: visible;
	}

	.quick-tools-actions {
		min-height: 0;
		overflow: visible;
	}

	.quick-tools-dock[data-collapsed="true"] .quick-tools-actions-shell {
		grid-template-rows: 0fr;
		opacity: 0;
		transform: translateY(0.4rem);
		visibility: hidden;
	}

	.quick-tools-dock[data-collapsed="true"] .quick-tools-actions {
		overflow: hidden;
	}

	.quick-tools-collapse-icon {
		display: grid;
		transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
		place-items: center;
	}

	.quick-tools-dock[data-collapsed="true"] .quick-tools-collapse-icon {
		transform: rotate(180deg);
	}

	.quick-tools-button {
		position: relative;
		display: grid;
		flex: 0 0 auto;
		width: var(--quick-tools-size);
		height: var(--quick-tools-size);
		padding: 0;
		cursor: pointer;
		border-radius: 0.85rem;
		place-items: center;
		transition:
			border-color 180ms ease,
			background-color 180ms ease,
			box-shadow 180ms ease,
			color 180ms ease,
			transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.quick-tools-button {
		border: 2px solid rgb(15 23 42 / 78%);
		background: rgb(255 255 255 / 96%);
		box-shadow:
			0 0.55rem 1.35rem rgb(15 23 42 / 16%),
			inset 0 0 0 1px rgb(255 255 255 / 72%);
		color: #111827;
		backdrop-filter: blur(0.75rem) saturate(1.15);
	}

	.quick-tools-button :global(svg) {
		width: 1.65rem;
		height: 1.65rem;
	}

	.quick-tools-theme-icon {
		display: grid;
		place-items: center;
	}

	.quick-tools-theme-icon--light {
		display: none;
	}

	:global(html.dark) .quick-tools-theme-icon--dark {
		display: none;
	}

	:global(html.dark) .quick-tools-theme-icon--light {
		display: grid;
	}

	.quick-tools-background-player span {
		display: grid;
		place-items: center;
	}

	.quick-tools-background-player span.hidden {
		display: none;
	}

	.quick-tools-music-button.is-playing :global(svg) {
		animation: quick-tools-spin 6s linear infinite;
	}

	.quick-tools-button:hover,
	.quick-tools-button:focus-visible,
	.quick-tools-dock[data-open="true"] #quick-tools-navigation {
		border-color: color-mix(in oklch, var(--primary) 58%, #111827);
		background: #fff;
		box-shadow:
			0 0.75rem 1.6rem rgb(15 23 42 / 20%),
			0 0 0 3px color-mix(in oklch, var(--primary) 18%, transparent);
		color: color-mix(in oklch, var(--primary) 72%, #111827);
		outline: none;
		transform: translateX(-0.16rem);
	}

	.quick-tools-button:active {
		transform: translateX(-0.08rem) scale(0.94);
	}

	.quick-tools-button::after {
		position: absolute;
		top: 50%;
