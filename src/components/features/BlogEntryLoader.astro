    opacity: .13;
  }
  .blog-entry-loader__card::before { top: 17%; right: 13%; width: 2rem; aspect-ratio: 1; }
  .blog-entry-loader__card::after { bottom: 14%; left: 12%; width: 1rem; aspect-ratio: 1; }
