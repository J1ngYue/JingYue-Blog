<div class="blog-entry-loader" data-blog-entry-loader role="status" aria-label="菲比啾比正在加载博客">
  <div class="blog-entry-loader__composition">
  <div class="blog-entry-loader__orbit" aria-hidden="true">
    <span class="blog-entry-loader__runner"><span class="blog-entry-loader__pet"></span></span>
  </div>
  <div class="blog-entry-loader__center">
    <strong data-loader-progress>0%</strong>
    <span>JingYue</span>
  </div>
  <p class="blog-entry-loader__caption" data-loader-caption>稍等，马上见面。</p>
  </div>
</div>

<script is:inline>
  (() => {
    const loader = document.querySelector("[data-blog-entry-loader]");
    if (!loader || loader.dataset.loaderReady === "true") return;
    loader.dataset.loaderReady = "true";
    const progress = loader.querySelector("[data-loader-progress]");
    const caption = loader.querySelector("[data-loader-caption]");
    // Run on a fresh document, not on every Swup navigation or anchor change.
    if (window.__blogEntryStarted) return;
    window.__blogEntryStarted = true;
    const html = document.documentElement;
    html.classList.add("blog-entry-loading");
    loader.classList.add("is-visible");
    let value = 0;
    let target = 8;
    let frame = 0;
    let finished = false;
    const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    const decode = async (src) => {
      const image = new Image();
      image.src = src;
      return image.decode().catch(() => {});
    };
    const paintProgress = () => {
      value += (target - value) * .09;
      const displayed = Math.floor(value);
      if (progress) progress.textContent = `${displayed}%`;
      loader.style.setProperty("--loader-progress", `${value}%`);
      frame = requestAnimationFrame(paintProgress);
    };
    frame = requestAnimationFrame(paintProgress);
    const finish = async (timedOut = false) => {
      if (finished) return;
      finished = true;
      clearTimeout(failsafe);
      cancelAnimationFrame(frame);
      if (progress) progress.textContent = timedOut ? "…" : "100%";
      loader.style.setProperty("--loader-progress", "100%");
      if (caption) caption.textContent = timedOut ? "先见面，再慢慢加载。" : "欢迎回来。";
      await delay(180);
      loader.classList.remove("is-visible");
      await delay(320);
      html.classList.remove("blog-entry-loading");
      window.dispatchEvent(new CustomEvent("firefly:blog-entry-complete"));
    };
    const failsafe = setTimeout(() => finish(true), 9000);
    const domReady = document.readyState === "loading"
      ? new Promise((resolve) => document.addEventListener("DOMContentLoaded", resolve, { once: true }))
      : Promise.resolve();
    // Percentages represent completed preparation stages, not downloaded bytes.
    const petReady = decode("/pio/models/pets/feibi/loader-walk.webp").then(async () => {
      target = Math.max(target, 25);
      await delay(matchMedia("(prefers-reduced-motion: reduce)").matches ? 200 : 900);
    });
    const pageReady = domReady.then(async () => {
      const wallpaper = getComputedStyle(html).getPropertyValue("--home-wallpaper-bootstrap");
      const url = wallpaper.match(/url\(["']?(.*?)["']?\)/)?.[1];
      if (url) await decode(url);
      target = Math.max(target, 65);
      await Promise.all([
        document.fonts.ready,
        ...Array.from(document.querySelectorAll(".home-hero-dialogue__sticker img"), (img) => img.decode().catch(() => {})),
      ]);
      target = 95;
    });
    Promise.all([petReady, pageReady]).then(() => finish());
  })();
</script>

<style is:global>
  .blog-entry-loader {
    --loader-progress: 8%;
    --loader-ink: #303c39;
    --loader-accent: #69998c;
    position: fixed;
    inset: 0;
    z-index: 2147482000;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #f5f6f2;
    color: var(--loader-ink);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 320ms ease, visibility 320ms;
    letter-spacing: 0;
  }
  .dark .blog-entry-loader { --loader-ink: #e8eee8; --loader-accent: #a1c7b2; background: #202724; }
  .blog-entry-loader.is-visible { opacity: 1; pointer-events: auto; visibility: visible; transition: none; }
  html.blog-entry-loading .home-entrance,
  html.blog-entry-loading .home-entrance::after,
  html.blog-entry-loading .home-entrance__tile { animation-play-state: paused !important; }
  .blog-entry-loader__composition { position: relative; display: grid; place-items: center; width: min(18rem, 64vw); aspect-ratio: 1; margin-top: -3rem; }
  .blog-entry-loader__orbit { position: absolute; inset: 0; border: 1px solid color-mix(in srgb, var(--loader-accent) 28%, transparent); border-radius: 50%; }
  .blog-entry-loader__orbit::before { position: absolute; inset: -1px; border-radius: 50%; content: ""; background: conic-gradient(var(--loader-accent) var(--loader-progress), transparent 0); mask-image: radial-gradient(farthest-side, transparent calc(100% - 2px), black 0); }
  .blog-entry-loader__runner { position: absolute; inset: 0; animation: blog-loader-orbit 5s linear infinite; }
  .blog-entry-loader__pet { position: absolute; top: -2.5rem; left: calc(50% - 2.3rem); width: 4.6rem; aspect-ratio: 96 / 104; background: url("/pio/models/pets/feibi/loader-walk.webp") 0 0 / 800% 100% no-repeat; filter: drop-shadow(0 3px 2px rgb(30 40 35 / 10%)); animation: blog-loader-pet .8s steps(8, end) infinite, blog-loader-upright 5s linear infinite; }
  .blog-entry-loader__center { display: grid; justify-items: center; gap: .7rem; }
  .blog-entry-loader__center strong { font-family: Georgia, serif; font-size: 2.7rem; line-height: 1; font-weight: 400; font-variant-numeric: tabular-nums; }
  .blog-entry-loader__center span { font-size: .8rem; color: var(--loader-accent); }
  .blog-entry-loader__caption { position: absolute; top: calc(100% + 3.1rem); width: calc(100% + 4rem); margin: 0; text-align: center; font-size: .78rem; color: color-mix(in srgb, var(--loader-ink) 68%, transparent); }
  @keyframes blog-loader-orbit { to { transform: rotate(360deg); } }
  @keyframes blog-loader-upright { to { transform: rotate(-360deg); } }
  @keyframes blog-loader-pet { to { background-position: 114.285714% 0; } }
  @media (max-width: 640px) {
    .blog-entry-loader__composition { width: min(14rem, 60vw); }
    .blog-entry-loader__pet { width: 4rem; left: calc(50% - 2rem); top: -2.2rem; }
    .blog-entry-loader__center strong { font-size: 2.2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-entry-loader__runner, .blog-entry-loader__pet { animation: none; }
  }
</style>
