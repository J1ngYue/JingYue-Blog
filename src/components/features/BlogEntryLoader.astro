    --loader-ink: #f5f2e9;
    --loader-muted: #aaa7a1;
    --loader-line: rgb(245 242 233 / 12%);
    --loader-track: rgb(245 242 233 / 11%);
    --loader-pink: #f173ab;
    --loader-blue: #70bdd0;
  }
  .blog-entry-loader.is-visible { opacity: 1; clip-path: inset(0); pointer-events: auto; visibility: visible; }
  .blog-entry-loader.is-visible.is-leaving {
