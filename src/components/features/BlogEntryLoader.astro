    .blog-entry-loader__brand i { width: 1.75rem; }
    .blog-entry-loader__footer { font-size: .56rem; }
    .blog-entry-loader__composition { width: min(19rem, 76vw); }
    .blog-entry-loader__meta { margin-bottom: 2.2rem; }
    .blog-entry-loader__dial { width: min(15rem, 64vw); }
    .blog-entry-loader__pet { top: -2.9rem; width: 5rem; }
