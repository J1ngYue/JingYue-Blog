<div
  class="blog-entry-loader is-visible"
  data-blog-entry-loader
  data-active-mascot="feibi"
  role="status"
  aria-live="polite"
  aria-label="菲比啾比、Duro 与咕咕嘎嘎正在加载 JingYue 博客"
>
  <div class="blog-entry-loader__backdrop" aria-hidden="true"></div>
  <div class="blog-entry-loader__scribbles" aria-hidden="true">
    <i></i><i></i><i></i><i></i><i></i><i></i>
  </div>

  <main
    class="blog-entry-loader__scene"
    data-loader-scene
    role="progressbar"
    aria-label="博客加载进度"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <header class="blog-entry-loader__heading">
      <p><span>JINGYUE</span> NIGHT LETTER · 001</p>
      <h1>循着微光，<em>故事正在醒来。</em></h1>
    </header>

    <section class="blog-entry-loader__stage" aria-label="博客角色加载动画">
      <svg class="blog-entry-loader__route" viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true">
        <path class="blog-entry-loader__route-base" d="M 58 198 C 222 34 374 266 510 145 S 780 52 942 188" pathLength="100"></path>
        <path class="blog-entry-loader__route-progress" d="M 58 198 C 222 34 374 266 510 145 S 780 52 942 188" pathLength="100"></path>
      </svg>
      <article class="blog-entry-loader__mascot blog-entry-loader__mascot--feibi" data-loader-mascot="feibi">
        <div class="blog-entry-loader__card">
          <span class="blog-entry-loader__arrival">01</span>
          <div class="blog-entry-loader__sprite blog-entry-loader__sprite--feibi" aria-hidden="true"></div>
          <span class="blog-entry-loader__shadow" aria-hidden="true"></span>
        </div>
        <strong>菲比啾比</strong>
        <small>替月色轻轻叩门</small>
      </article>

      <article class="blog-entry-loader__mascot blog-entry-loader__mascot--doro" data-loader-mascot="doro">
        <div class="blog-entry-loader__card">
          <span class="blog-entry-loader__arrival">02</span>
          <div class="blog-entry-loader__sprite blog-entry-loader__sprite--doro" aria-hidden="true"></div>
          <span class="blog-entry-loader__shadow" aria-hidden="true"></span>
        </div>
        <strong>Duro</strong>
        <small>从纸箱里探出春天</small>
      </article>

      <article class="blog-entry-loader__mascot blog-entry-loader__mascot--gugu" data-loader-mascot="gugu">
        <div class="blog-entry-loader__card">
          <span class="blog-entry-loader__arrival">03</span>
          <div class="blog-entry-loader__sprite blog-entry-loader__sprite--gugu" aria-hidden="true"></div>
          <span class="blog-entry-loader__shadow" aria-hidden="true"></span>
        </div>
        <strong>咕咕嘎嘎</strong>
        <small>把最后一颗星送达</small>
      </article>
    </section>

    <section class="blog-entry-loader__progress">
      <div class="blog-entry-loader__status">
        <span data-loader-stage>正在拾取微光</span>
        <p data-loader-caption>今夜的第一页，正被风轻轻翻开</p>
      </div>
      <strong class="blog-entry-loader__percentage"><span data-loader-progress>0</span><small>%</small></strong>
      <div class="blog-entry-loader__track" aria-hidden="true"><i></i></div>
    </section>
  </main>

  <footer class="blog-entry-loader__footer" aria-hidden="true">
    <span>JINGYUE'S BLOG</span>
    <span>FEIBI · DURO · GUGUGAGA</span>
  </footer>
</div>

<script is:inline>
  (() => {
    const loader = document.querySelector("[data-blog-entry-loader]");
    if (!loader || loader.dataset.loaderReady === "true") return;
    loader.dataset.loaderReady = "true";
    if (window.__blogEntryStarted) {
      loader.classList.add("is-hidden");
      loader.setAttribute("aria-hidden", "true");
      return;
    }
    window.__blogEntryStarted = true;

    const progress = loader.querySelector("[data-loader-progress]");
    const scene = loader.querySelector("[data-loader-scene]");
    const stage = loader.querySelector("[data-loader-stage]");
    const caption = loader.querySelector("[data-loader-caption]");
    const html = document.documentElement;
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const mascotAssets = [
      "/pio/models/pets/feibi/loader-feibi-unified.webp",
      "/pio/models/pets/doro/loader-duro-unified.webp",
      "/pio/models/pets/gugugaga/loader-gugugaga-unified.webp",
    ];
    let value = 0;
    let target = 8;
    let frame = 0;
    let finished = false;
    let failsafe = 0;

    const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    const decode = async (src) => {
      const image = new Image();
      image.src = src;
      return image.decode().catch(() => {});
    };
    const updateStage = (label, message) => {
      if (stage) stage.textContent = label;
      if (caption) caption.textContent = message;
    };
    const renderProgress = (nextValue) => {
      const normalized = Math.max(0, Math.min(100, nextValue));
      const displayed = Math.floor(normalized);
      if (progress) progress.textContent = String(displayed);
      if (scene) scene.setAttribute("aria-valuenow", String(displayed));
      loader.style.setProperty("--loader-progress", `${normalized}%`);
      loader.style.setProperty("--loader-progress-number", String(normalized));
      loader.dataset.activeMascot = normalized < 34 ? "feibi" : normalized < 67 ? "doro" : "gugu";
    };
    const paintProgress = () => {
      if (finished) return;
      value += (target - value) * .075;
      renderProgress(value);
      frame = requestAnimationFrame(paintProgress);
    };
    const completeProgress = () => new Promise((resolve) => {
      cancelAnimationFrame(frame);
      if (reducedMotion) {
        value = 100;
        renderProgress(value);
        resolve();
        return;
      }
      const initialValue = value;
      const startedAt = performance.now();
      const completeFrame = (time) => {
        const position = Math.min(1, (time - startedAt) / 420);
        value = initialValue + (100 - initialValue) * (1 - Math.pow(1 - position, 3));
        renderProgress(value);
        if (position < 1) frame = requestAnimationFrame(completeFrame);
        else resolve();
      };
      frame = requestAnimationFrame(completeFrame);
    });
    const finish = async (timedOut = false) => {
      if (finished) return;
      finished = true;
      clearTimeout(failsafe);
      updateStage(timedOut ? "先去相见" : "欢迎抵达", timedOut ? "故事仍在路上，页面会在相见后继续醒来" : "山海有期，字句有光；欢迎来到 JingYue 的博客");
      await completeProgress();
      loader.classList.add("is-complete");
      await delay(reducedMotion ? 20 : 460);
      html.classList.remove("blog-entry-loading");
      const entrance = document.querySelector("[data-home-entrance]");
      if (entrance && !reducedMotion) await delay(260);
      loader.classList.add("is-leaving");
      await delay(reducedMotion ? 80 : 460);
      loader.classList.add("is-hidden");
      loader.classList.remove("is-visible", "is-complete", "is-leaving");
      loader.setAttribute("aria-hidden", "true");
      html.classList.remove("blog-entry-loader-active");
      window.dispatchEvent(new CustomEvent("firefly:blog-entry-complete"));
    };

    html.classList.add("blog-entry-loading", "blog-entry-loader-active");
    loader.classList.remove("is-hidden");
    loader.removeAttribute("aria-hidden");
    frame = requestAnimationFrame(paintProgress);
    failsafe = setTimeout(() => finish(true), 10000);

    const castReady = Promise.all(mascotAssets.map(decode)).then(async () => {
      target = Math.max(target, 30);
      updateStage("月光先到了", "菲比啾比沿着雨声，为你推开故事的门");
      await delay(reducedMotion ? 0 : 460);
      target = Math.max(target, 57);
      updateStage("花信落进纸箱", "Duro 探出头，把一小簇温柔放在窗边");
      await delay(reducedMotion ? 0 : 480);
      target = Math.max(target, 79);
      updateStage("星光已经到齐", "咕咕嘎嘎拍拍翅膀，替今夜点亮最后一盏灯");
    });
    const domReady = document.readyState === "loading"
      ? new Promise((resolve) => document.addEventListener("DOMContentLoaded", resolve, { once: true }))
      : Promise.resolve();
    const pageReady = domReady.then(async () => {
      const wallpaper = getComputedStyle(html).getPropertyValue("--home-wallpaper-bootstrap");
      const url = wallpaper.match(/url\(["']?(.*?)["']?\)/)?.[1];
      if (url) await decode(url);
      await Promise.all([
        document.fonts.ready,
        ...Array.from(document.querySelectorAll(".home-hero-dialogue__sticker img"), (img) => img.decode().catch(() => {})),
      ]);
    });
    Promise.all([castReady, pageReady, delay(reducedMotion ? 0 : 1380)]).then(() => {
      target = 94;
      updateStage("故事即将开场", "愿你在 JingYue 的字里，遇见一场恰好的雨");
      return delay(reducedMotion ? 0 : 300);
    }).then(() => finish());
  })();
</script>

