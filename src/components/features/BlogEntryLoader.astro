<script is:inline>
  (() => {
    const loader = document.querySelector("[data-blog-entry-loader]");
    if (!loader || loader.dataset.loaderReady === "true") return;
    loader.dataset.loaderReady = "true";
    const html = document.documentElement;
    if (window.__blogEntryStarted || html.classList.contains("blog-entry-visited")) {
      loader.remove();
      return;
    }
    window.__blogEntryStarted = true;
    try {
      localStorage.setItem("jingyue:cyberpunk-entry-seen:v1", "1");
      localStorage.setItem("jingyue:home-entrance-seen", "1");
    } catch {}

    const video = loader.querySelector("[data-entry-video]");
    const progress = loader.querySelector("[data-entry-progress]");
    const skip = loader.querySelector("[data-entry-skip]");
    let finished = false;
    let failsafe;
    const finish = () => {
      if (finished) return;
      finished = true;
      clearTimeout(failsafe);
      video?.pause();
      html.classList.remove("blog-entry-loading", "blog-entry-loader-active");
      loader.classList.add("is-leaving");
      window.setTimeout(() => {
        html.classList.add("blog-entry-visited");
        loader.remove();
        window.dispatchEvent(new CustomEvent("firefly:blog-entry-complete"));
      }, 480);
    };
    skip?.addEventListener("click", finish);
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      finish();
      return;
    }

    html.classList.add("blog-entry-loading", "blog-entry-loader-active");
    video?.addEventListener("timeupdate", () => {
      if (!video.duration || !progress) return;
      const percent = Math.min(100, Math.round(video.currentTime / video.duration * 100));
      progress.style.setProperty("--entry-progress", `${percent}%`);
      progress.setAttribute("aria-valuenow", String(percent));
    });
    video?.addEventListener("ended", finish, { once: true });
    video?.addEventListener("error", finish, { once: true });
    failsafe = window.setTimeout(finish, 11000);
    if (video) {
      video.src = video.dataset.src;
      video.play().catch(finish);
    }
  })();
</script>

