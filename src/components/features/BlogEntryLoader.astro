<div class="blog-entry-loader" data-blog-entry-loader role="status" aria-label="菲比啾比正在加载博客">
  <div class="blog-entry-loader__halo" aria-hidden="true"></div>
  <div class="blog-entry-loader__orbit" aria-hidden="true">
    <span class="blog-entry-loader__runner"><span class="blog-entry-loader__pet"></span></span>
  </div>
  <div class="blog-entry-loader__center">
    <strong data-loader-progress>0%</strong>
    <span>LOADING</span>
  </div>
  <p class="blog-entry-loader__caption" data-loader-caption>菲比啾比正在整理房间…</p>
</div>

<script is:inline>
  (() => {
    const loader = document.querySelector("[data-blog-entry-loader]");
    if (!loader || loader.dataset.loaderReady === "true") return;
    loader.dataset.loaderReady = "true";
    const progress = loader.querySelector("[data-loader-progress]");
    const caption = loader.querySelector("[data-loader-caption]");
    // Run on a fresh document, not on every Swup navigation or anchor change.
    if (window.__blogEntryStarted) return;
    window.__blogEntryStarted = true;
    const html = document.documentElement;
    html.classList.add("blog-entry-loading");
    loader.classList.add("is-visible");
    let value = 0;
    let target = 8;
    let frame = 0;
    let finished = false;
    const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    const decode = async (src) => {
      const image = new Image();
      image.src = src;
      return image.decode().catch(() => {});
    };
    const paintProgress = () => {
      value += (target - value) * .09;
      const displayed = Math.floor(value);
      if (progress) progress.textContent = `${displayed}%`;
      loader.style.setProperty("--loader-progress", `${value}%`);
      frame = requestAnimationFrame(paintProgress);
    };
    frame = requestAnimationFrame(paintProgress);
    const finish = async (timedOut = false) => {
      if (finished) return;
      finished = true;
      clearTimeout(failsafe);
      cancelAnimationFrame(frame);
      if (progress) progress.textContent = timedOut ? "…" : "100%";
      loader.style.setProperty("--loader-progress", "100%");
      if (caption) caption.textContent = timedOut ? "先进入博客，资源继续加载" : "准备好了，欢迎来到 JingYue";
      await delay(180);
      loader.classList.remove("is-visible");
      await delay(320);
      html.classList.remove("blog-entry-loading");
      window.dispatchEvent(new CustomEvent("firefly:blog-entry-complete"));
    };
    const failsafe = setTimeout(() => finish(true), 9000);
    const domReady = document.readyState === "loading"
      ? new Promise((resolve) => document.addEventListener("DOMContentLoaded", resolve, { once: true }))
      : Promise.resolve();
    // Percentages represent completed preparation stages, not downloaded bytes.
    const petReady = decode("/pio/models/pets/feibi/loader-walk.webp").then(async () => {
      target = Math.max(target, 25);
      await delay(matchMedia("(prefers-reduced-motion: reduce)").matches ? 400 : 1700);
    });
    const pageReady = domReady.then(async () => {
      const wallpaper = getComputedStyle(html).getPropertyValue("--home-wallpaper-bootstrap");
      const url = wallpaper.match(/url\(["']?(.*?)["']?\)/)?.[1];
      if (url) await decode(url);
      target = Math.max(target, 65);
      await Promise.all([
        document.fonts.ready,
        ...Array.from(document.querySelectorAll(".home-hero-dialogue__sticker img"), (img) => img.decode().catch(() => {})),
      ]);
      target = 95;
    });
    Promise.all([petReady, pageReady]).then(() => finish());
  })();
</script>

<style is:global>
  .blog-entry-loader {
    --loader-progress: 8%;
    position: fixed;
    inset: 0;
    z-index: 2147482000;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: radial-gradient(circle at 50% 44%, rgba(30, 66, 103, .96), rgba(5, 12, 27, .99) 68%);
    color: #f4f7ff;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 320ms ease, visibility 320ms;
  }

  .blog-entry-loader.is-visible {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transition: none;
  }

  html.blog-entry-loading .home-entrance,
  html.blog-entry-loading .home-entrance::after,
  html.blog-entry-loading .home-entrance__tile { animation-play-state: paused !important; }
  .blog-entry-loader::before,
  .blog-entry-loader::after { position: absolute; inset: 0; pointer-events: none; content: ""; }
  .blog-entry-loader::before { opacity: .2; background-image: linear-gradient(rgba(141, 238, 231, .12) 1px, transparent 1px), linear-gradient(90deg, rgba(141, 238, 231, .12) 1px, transparent 1px); background-size: 4rem 4rem; mask-image: radial-gradient(circle, black, transparent 68%); }
  .blog-entry-loader::after { background: radial-gradient(circle at center, transparent 19%, rgba(2, 6, 16, .42) 100%); }

  .blog-entry-loader__halo { position: absolute; width: min(24rem, 64vw); aspect-ratio: 1; border: 1px solid rgba(114, 245, 223, .24); border-radius: 50%; box-shadow: 0 0 70px rgba(114, 245, 223, .14), inset 0 0 70px rgba(255, 155, 207, .08); animation: blog-loader-breathe 2.8s ease-in-out infinite; }
  .blog-entry-loader__orbit { position: absolute; width: min(20rem, 54vw); aspect-ratio: 1; border: 1px solid rgba(255, 255, 255, .18); border-radius: 50%; box-shadow: 0 0 0 .45rem rgba(8, 24, 44, .36), 0 0 0 .5rem rgba(114, 245, 223, .15); }
  .blog-entry-loader__orbit::before { position: absolute; inset: 13%; border: 1px dashed rgba(255, 255, 255, .22); border-radius: 50%; content: ""; }
  .blog-entry-loader__runner { position: absolute; inset: 0; display: block; animation: blog-loader-orbit 3.5s linear infinite; }
  .blog-entry-loader__pet { position: absolute; top: -3rem; left: calc(50% - 2.75rem); width: 5.5rem; aspect-ratio: 96 / 104; background-image: url("/pio/models/pets/feibi/loader-walk.webp"); background-position: 0 0; background-repeat: no-repeat; background-size: 800% 100%; filter: drop-shadow(0 .65rem .7rem rgba(0, 0, 0, .4)); animation: blog-loader-pet .8s steps(8, end) infinite, blog-loader-upright 3.5s linear infinite; }
  .blog-entry-loader__center { position: relative; z-index: 2; display: grid; place-items: center; width: 8.8rem; height: 8.8rem; border: 1px solid rgba(255, 255, 255, .24); border-radius: 50%; background: rgba(7, 18, 37, .86); box-shadow: 0 15px 50px rgba(0, 0, 0, .35), inset 0 0 28px rgba(114, 245, 223, .09); backdrop-filter: blur(12px); }
  .blog-entry-loader__center::before { position: absolute; inset: .55rem; border-radius: 50%; content: ""; background: conic-gradient(#72f5df var(--loader-progress), rgb(255 255 255 / .1) 0); mask-image: radial-gradient(farthest-side, transparent calc(100% - 3px), black 0); }
  .blog-entry-loader__center strong { position: relative; font-size: 1.5rem; letter-spacing: .02em; }
  .blog-entry-loader__center span { position: relative; margin-top: -2.55rem; color: rgba(244, 247, 255, .5); font-size: .52rem; letter-spacing: .28em; }
  .blog-entry-loader__caption { position: absolute; bottom: 15%; margin: 0; color: rgba(244, 247, 255, .67); font-size: .72rem; letter-spacing: .16em; }

  @keyframes blog-loader-orbit { to { transform: rotate(360deg); } }
  @keyframes blog-loader-upright { to { transform: rotate(-360deg); } }
  @keyframes blog-loader-pet { to { background-position: 114.285714% 0; } }
  @keyframes blog-loader-breathe { 0%, 100% { transform: scale(.96); opacity: .68; } 50% { transform: scale(1.04); opacity: 1; } }

  @media (max-width: 640px) {
    .blog-entry-loader__halo { width: 18rem; }
    .blog-entry-loader__orbit { width: 14rem; }
    .blog-entry-loader__pet { width: 4.6rem; left: calc(50% - 2.3rem); top: -2.5rem; }
    .blog-entry-loader__center { width: 7.1rem; height: 7.1rem; }
    .blog-entry-loader__center strong { font-size: 1.2rem; }
    .blog-entry-loader__center span { margin-top: -2.15rem; }
    .blog-entry-loader__caption { bottom: 11%; font-size: .62rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-entry-loader__halo, .blog-entry-loader__runner, .blog-entry-loader__pet { animation: none; }
  }
</style>
