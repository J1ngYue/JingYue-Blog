<div
  class="blog-entry-loader"
  data-blog-entry-loader
  role="status"
  aria-live="polite"
  aria-label="菲比啾比正在加载 JingYue 博客"
>
  <div class="blog-entry-loader__frame" aria-hidden="true"></div>
  <div class="blog-entry-loader__brand" aria-hidden="true">
    <span>JY</span><i></i><span>JINGYUE / PERSONAL BLOG</span>
  </div>

  <div class="blog-entry-loader__composition">
    <div class="blog-entry-loader__meta">
      <span>ENTRY SEQUENCE</span><i></i><span data-loader-stage>正在连接</span>
    </div>
    <div
      class="blog-entry-loader__dial"
      data-loader-dial
      role="progressbar"
      aria-label="博客加载进度"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <span class="blog-entry-loader__ticks" aria-hidden="true"></span>
      <span class="blog-entry-loader__trail is-third" aria-hidden="true"><i></i></span>
      <span class="blog-entry-loader__trail is-second" aria-hidden="true"><i></i></span>
      <span class="blog-entry-loader__trail is-first" aria-hidden="true"><i></i></span>
      <span class="blog-entry-loader__runner" aria-hidden="true">
        <span class="blog-entry-loader__pet">
          <img src="/pio/models/pets/feibi/loader-idle.webp" width="192" height="208" alt="" decoding="sync" />
        </span>
      </span>
      <div class="blog-entry-loader__center">
        <span>LOADING</span>
        <strong><span data-loader-progress>0</span><small>%</small></strong>
        <i></i><b>JINGYUE</b>
      </div>
    </div>
    <p class="blog-entry-loader__caption" data-loader-caption>正在准备雨夜与故事</p>
  </div>

  <div class="blog-entry-loader__footer" aria-hidden="true">
    <span>HELLO, VISITOR</span><span>EST. 2025 / SHANGHAI</span>
  </div>
</div>

<script is:inline>
  (() => {
    const loader = document.querySelector("[data-blog-entry-loader]");
    if (!loader || loader.dataset.loaderReady === "true") return;
    loader.dataset.loaderReady = "true";
    if (window.__blogEntryStarted) return;
    window.__blogEntryStarted = true;

    const progress = loader.querySelector("[data-loader-progress]");
    const dial = loader.querySelector("[data-loader-dial]");
    const stage = loader.querySelector("[data-loader-stage]");
    const caption = loader.querySelector("[data-loader-caption]");
    const html = document.documentElement;
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let value = 0;
    let target = 10;
    let frame = 0;
    let finished = false;
    let failsafe = 0;

    const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    const decode = async (src) => {
      const image = new Image();
      image.src = src;
      return image.decode().catch(() => {});
    };
    const updateStage = (label, message) => {
      if (stage) stage.textContent = label;
      if (caption) caption.textContent = message;
    };
    const renderProgress = (nextValue) => {
      const normalized = Math.max(0, Math.min(100, nextValue));
      const displayed = Math.floor(normalized);
      if (progress) progress.textContent = String(displayed);
      if (dial) dial.setAttribute("aria-valuenow", String(displayed));
      loader.style.setProperty("--loader-progress", `${normalized}%`);
      loader.style.setProperty("--loader-angle", `${normalized * 3.6}deg`);
      loader.style.setProperty("--loader-counter-angle", `${normalized * -3.6}deg`);
    };
    const paintProgress = () => {
      if (finished) return;
      value += (target - value) * .085;
      renderProgress(value);
      frame = requestAnimationFrame(paintProgress);
    };
    const completeProgress = () => new Promise((resolve) => {
      cancelAnimationFrame(frame);
      if (reducedMotion) {
        value = 100;
        renderProgress(value);
        resolve();
        return;
      }
      const initialValue = value;
      const startedAt = performance.now();
      const completeFrame = (time) => {
        const position = Math.min(1, (time - startedAt) / 360);
        value = initialValue + (100 - initialValue) * (1 - Math.pow(1 - position, 3));
        renderProgress(value);
        if (position < 1) frame = requestAnimationFrame(completeFrame);
        else resolve();
      };
      frame = requestAnimationFrame(completeFrame);
    });
    const finish = async (timedOut = false) => {
      if (finished) return;
      finished = true;
      clearTimeout(failsafe);
      updateStage(timedOut ? "CONTINUE" : "READY", timedOut ? "先见面，内容继续加载" : "准备好了，欢迎回来");
      await completeProgress();
      loader.classList.add("is-complete");
      await delay(reducedMotion ? 40 : 220);
      loader.classList.add("is-leaving");
      await delay(reducedMotion ? 120 : 680);
      loader.classList.remove("is-visible", "is-complete", "is-leaving");
      html.classList.remove("blog-entry-loading");
      window.dispatchEvent(new CustomEvent("firefly:blog-entry-complete"));
    };

    html.classList.add("blog-entry-loading");
    loader.classList.add("is-visible");
    frame = requestAnimationFrame(paintProgress);
    failsafe = setTimeout(() => finish(true), 8000);
    const domReady = document.readyState === "loading"
      ? new Promise((resolve) => document.addEventListener("DOMContentLoaded", resolve, { once: true }))
      : Promise.resolve();
    const petReady = decode("/pio/models/pets/feibi/loader-idle.webp").then(() => {
      target = Math.max(target, 30);
      updateStage("菲比已就位", "正在整理沿途的星光");
    });
    const pageReady = domReady.then(async () => {
      const wallpaper = getComputedStyle(html).getPropertyValue("--home-wallpaper-bootstrap");
      const url = wallpaper.match(/url\(["']?(.*?)["']?\)/)?.[1];
      if (url) await decode(url);
      target = Math.max(target, 68);
      updateStage("正在展开首页", "雨夜、文字与故事正在抵达");
      await Promise.all([
        document.fonts.ready,
        ...Array.from(document.querySelectorAll(".home-hero-dialogue__sticker img"), (img) => img.decode().catch(() => {})),
      ]);
      target = 92;
      updateStage("最后整理", "马上就能见面了");
    });
    Promise.all([petReady, pageReady, delay(reducedMotion ? 0 : 650)]).then(() => finish());
  })();
</script>

<style is:global>
