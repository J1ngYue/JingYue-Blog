  @keyframes blog-loader-ready { 0% { transform: scale(1); } 45% { transform: scale(1.035); } 100% { transform: scale(1); } }
  @keyframes blog-loader-feibi-float {
    0%, 100% { transform: translate(-48%, -50%) rotate(-1deg); }
    50% { transform: translate(-48%, calc(-50% - .3rem)) rotate(1deg); }
  }
  @media (max-width: 640px) {
    .blog-entry-loader__footer span:last-child { display: none; }
    .blog-entry-loader__footer { font-size: .56rem; }
    .blog-entry-loader__composition { width: min(22rem, 82vw); }
    .blog-entry-loader__eyebrow { margin-bottom: 1.7rem; font-size: .53rem; }
    .blog-entry-loader__dial { width: min(18rem, 72vw); }
    .blog-entry-loader__feibi { width: calc(100% + 3rem); }
    .blog-entry-loader__center { width: 10.5rem; }
    .blog-entry-loader__center strong { font-size: 4rem; }
    .blog-entry-loader__caption { margin-top: 2.3rem; font-size: .78rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-entry-loader__feibi { animation: none; }
    .blog-entry-loader.is-visible.is-leaving { opacity: 0; transition: opacity 120ms ease; }
    .is-leaving .blog-entry-loader__composition { transform: none; }
  }
</style>
