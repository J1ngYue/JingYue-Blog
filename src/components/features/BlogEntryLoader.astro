<div class="blog-entry-loader" data-blog-entry-loader aria-live="polite" aria-label="正在进入博客">
  <div class="blog-entry-loader__halo" aria-hidden="true"></div>
  <div class="blog-entry-loader__orbit" aria-hidden="true">
    <span class="blog-entry-loader__runner"><span class="blog-entry-loader__pet"></span></span>
  </div>
  <div class="blog-entry-loader__center">
    <strong data-loader-progress>0%</strong>
    <span>LOADING</span>
  </div>
  <p class="blog-entry-loader__caption" data-loader-caption>菲比啾比正在整理房间…</p>
</div>

<script is:inline>
  (() => {
    const loader = document.querySelector("[data-blog-entry-loader]");
    if (!loader || loader.dataset.loaderReady === "true") return;
    loader.dataset.loaderReady = "true";
    const progress = loader.querySelector("[data-loader-progress]");
    const caption = loader.querySelector("[data-loader-caption]");
    let value = 8;
    let ticker = 0;
    let startedAt = performance.now();
    let finishTimer = 0;

    const setProgress = (next) => {
      value = Math.max(value, Math.min(100, Math.round(next)));
      if (progress) progress.textContent = `${value}%`;
      loader.style.setProperty("--loader-progress", `${value}%`);
    };
    const show = () => {
      window.clearTimeout(finishTimer);
      startedAt = performance.now();
      loader.classList.remove("is-done");
      loader.classList.add("is-visible");
      value = 8;
      setProgress(value);
      window.clearInterval(ticker);
      ticker = window.setInterval(() => {
        if (value < 86) setProgress(value + Math.max(1, (86 - value) * 0.08));
      }, 100);
    };
    const hide = () => {
      window.clearInterval(ticker);
      setProgress(100);
      if (caption) caption.textContent = "欢迎回来，房间已经亮灯。";
      const wait = Math.max(0, 440 - (performance.now() - startedAt));
      window.clearTimeout(finishTimer);
      finishTimer = window.setTimeout(() => {
        loader.classList.remove("is-visible");
        loader.classList.add("is-done");
        window.setTimeout(() => loader.classList.remove("is-done"), 580);
      }, wait);
    };

    show();
    if (document.readyState === "complete") hide();
    else window.addEventListener("load", hide, { once: true });
    document.addEventListener("swup:visit:start", show);
    document.addEventListener("swup:contentReplaced", hide);
    document.addEventListener("swup:content:replaced", hide);
  })();
</script>

