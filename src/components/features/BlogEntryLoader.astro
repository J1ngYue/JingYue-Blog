  .blog-entry-loader__footer { right: clamp(1.75rem, 3.2vw, 3rem); bottom: clamp(1.75rem, 3.2vw, 3rem); left: clamp(1.75rem, 3.2vw, 3rem); display: flex; justify-content: space-between; }
  .blog-entry-loader__composition {
