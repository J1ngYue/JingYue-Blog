    --loader-yellow-soft: #fff4bd;
    --loader-lilac: #e9ddff;
    position: fixed;
    inset: 0;
    z-index: 2147482000;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    background: var(--loader-paper);
    color: var(--loader-ink);
    color-scheme: light;
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transition: opacity 440ms cubic-bezier(.4, 0, 1, 1), visibility 0s linear 440ms;
  }
  .blog-entry-loader__backdrop {
