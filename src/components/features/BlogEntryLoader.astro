  .blog-entry-loader__center { display: grid; z-index: 2; justify-items: center; color: var(--loader-ink); }
  .blog-entry-loader__center > span,
  .blog-entry-loader__center b { font-family: var(--font-jetbrains-mono), monospace; font-size: .62rem; font-weight: 600; color: var(--loader-muted); letter-spacing: .14em; }
