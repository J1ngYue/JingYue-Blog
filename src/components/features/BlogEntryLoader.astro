  }
  .is-leaving .blog-entry-loader__composition { opacity: 0; transform: translateY(-1.25rem); }
  .blog-entry-loader__meta {
    display: flex;
    align-items: center;
    width: min(20rem, 100%);
    margin-bottom: 2.5rem;
    font-family: var(--font-jetbrains-mono), monospace;
    font-size: .63rem;
    font-weight: 600;
    color: var(--loader-muted);
    letter-spacing: .06em;
  }
  .blog-entry-loader__meta i { flex: 1; height: 1px; margin: 0 .8rem; background: var(--loader-line); }
  .blog-entry-loader__meta span:last-child { color: var(--loader-blue); }
  .blog-entry-loader__dial { position: relative; display: grid; place-items: center; width: clamp(14.5rem, 25vw, 20rem); aspect-ratio: 1; border-radius: 50%; }
  .blog-entry-loader__dial::before {
