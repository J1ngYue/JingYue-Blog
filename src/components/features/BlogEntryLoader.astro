<div
  class="blog-entry-loader"
  data-blog-entry-loader
  role="status"
  aria-live="polite"
  aria-label="菲比啾比正在加载 JingYue 博客"
>
  <div class="blog-entry-loader__backdrop" aria-hidden="true"></div>
  <div class="blog-entry-loader__veil" aria-hidden="true"></div>
  <div class="blog-entry-loader__composition">
    <p class="blog-entry-loader__eyebrow">JINGYUE <span>/</span> PERSONAL BLOG</p>
    <div
      class="blog-entry-loader__dial"
      data-loader-dial
      role="progressbar"
      aria-label="博客加载进度"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <span class="blog-entry-loader__halo" aria-hidden="true"></span>
      <img
        class="blog-entry-loader__feibi"
        src="/pio/models/pets/feibi/loader-orbit.webp"
        width="860"
        height="780"
        alt=""
        decoding="sync"
        aria-hidden="true"
      />
      <div class="blog-entry-loader__center">
        <span class="blog-entry-loader__label">WELCOME</span>
        <strong><span data-loader-progress>0</span><small>%</small></strong>
        <span class="blog-entry-loader__wordmark">JingYue</span>
      </div>
    </div>
    <p class="blog-entry-loader__caption" data-loader-caption>正在把故事带到你面前</p>
  </div>

  <div class="blog-entry-loader__footer" aria-hidden="true">
    <span data-loader-stage>正在准备</span><span>FEIBI ON DUTY</span>
  </div>
</div>

<script is:inline>
  (() => {
    const loader = document.querySelector("[data-blog-entry-loader]");
    if (!loader || loader.dataset.loaderReady === "true") return;
    loader.dataset.loaderReady = "true";
    if (window.__blogEntryStarted) return;
    window.__blogEntryStarted = true;

    const progress = loader.querySelector("[data-loader-progress]");
    const dial = loader.querySelector("[data-loader-dial]");
    const stage = loader.querySelector("[data-loader-stage]");
    const caption = loader.querySelector("[data-loader-caption]");
    const html = document.documentElement;
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let value = 0;
    let target = 10;
    let frame = 0;
    let finished = false;
    let failsafe = 0;

    const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    const decode = async (src) => {
      const image = new Image();
      image.src = src;
      return image.decode().catch(() => {});
    };
    const updateStage = (label, message) => {
      if (stage) stage.textContent = label;
      if (caption) caption.textContent = message;
    };
    const renderProgress = (nextValue) => {
      const normalized = Math.max(0, Math.min(100, nextValue));
      const displayed = Math.floor(normalized);
      if (progress) progress.textContent = String(displayed);
      if (dial) dial.setAttribute("aria-valuenow", String(displayed));
      loader.style.setProperty("--loader-progress", `${normalized}%`);
    };
    const paintProgress = () => {
      if (finished) return;
      value += (target - value) * .085;
      renderProgress(value);
      frame = requestAnimationFrame(paintProgress);
    };
    const completeProgress = () => new Promise((resolve) => {
      cancelAnimationFrame(frame);
      if (reducedMotion) {
        value = 100;
        renderProgress(value);
        resolve();
        return;
      }
      const initialValue = value;
      const startedAt = performance.now();
      const completeFrame = (time) => {
        const position = Math.min(1, (time - startedAt) / 360);
        value = initialValue + (100 - initialValue) * (1 - Math.pow(1 - position, 3));
        renderProgress(value);
        if (position < 1) frame = requestAnimationFrame(completeFrame);
        else resolve();
      };
      frame = requestAnimationFrame(completeFrame);
    });
    const finish = async (timedOut = false) => {
      if (finished) return;
      finished = true;
      clearTimeout(failsafe);
      updateStage(timedOut ? "CONTINUE" : "READY", timedOut ? "先见面，内容继续加载" : "准备好了，欢迎回来");
      await completeProgress();
      loader.classList.add("is-complete");
      await delay(reducedMotion ? 40 : 220);
      loader.classList.add("is-leaving");
      await delay(reducedMotion ? 120 : 680);
      loader.classList.remove("is-visible", "is-complete", "is-leaving");
      html.classList.remove("blog-entry-loading");
      window.dispatchEvent(new CustomEvent("firefly:blog-entry-complete"));
    };

    html.classList.add("blog-entry-loading");
    loader.classList.add("is-visible");
    frame = requestAnimationFrame(paintProgress);
    failsafe = setTimeout(() => finish(true), 8000);
    const domReady = document.readyState === "loading"
      ? new Promise((resolve) => document.addEventListener("DOMContentLoaded", resolve, { once: true }))
      : Promise.resolve();
    const petReady = decode("/pio/models/pets/feibi/loader-orbit.webp").then(() => {
      target = Math.max(target, 30);
      updateStage("菲比已就位", "正在整理沿途的星光");
    });
    const pageReady = domReady.then(async () => {
      const wallpaper = getComputedStyle(html).getPropertyValue("--home-wallpaper-bootstrap");
      const url = wallpaper.match(/url\(["']?(.*?)["']?\)/)?.[1];
      if (url) await decode(url);
      target = Math.max(target, 68);
      updateStage("正在展开首页", "雨夜、文字与故事正在抵达");
      await Promise.all([
        document.fonts.ready,
        ...Array.from(document.querySelectorAll(".home-hero-dialogue__sticker img"), (img) => img.decode().catch(() => {})),
      ]);
      target = 92;
      updateStage("最后整理", "马上就能见面了");
    });
    Promise.all([petReady, pageReady, delay(reducedMotion ? 0 : 420)]).then(() => finish());
  })();
</script>

<style is:global>
  .blog-entry-loader {
    --loader-progress: 0%;
    --loader-ink: #fffaf4;
    --loader-muted: rgb(255 250 244 / 70%);
    --loader-soft: rgb(255 250 244 / 22%);
    --loader-track: rgb(255 250 244 / 22%);
    --loader-pink: #ff8bbd;
    --loader-blue: #80d5dd;
    position: fixed;
    inset: 0;
    z-index: 2147482000;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    background: #090b12;
    color: var(--loader-ink);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 520ms cubic-bezier(.22, 1, .36, 1), visibility 520ms;
    letter-spacing: 0;
  }
  .blog-entry-loader__backdrop,
  .blog-entry-loader__veil { position: absolute; inset: -2rem; pointer-events: none; }
  .blog-entry-loader__backdrop {
    background:
      radial-gradient(circle at 50% 44%, rgb(71 35 72 / 24%) 0, transparent 28%),
      radial-gradient(circle at 50% 44%, rgb(15 104 126 / 18%) 0, transparent 50%),
      linear-gradient(135deg, #090b12 0%, #111421 52%, #0b0d16 100%);
    opacity: 1;
  }
  .blog-entry-loader__veil {
    background:
      linear-gradient(90deg, transparent 0 16%, rgb(255 255 255 / 3%) 16.05%, transparent 16.1% 83.9%, rgb(255 255 255 / 3%) 83.95%, transparent 84%),
      radial-gradient(circle at 50% 44%, transparent 0 29%, rgb(255 255 255 / 3%) 29.1%, transparent 29.2% 100%);
    opacity: .8;
  }
  .blog-entry-loader.is-visible { opacity: 1; pointer-events: auto; visibility: visible; }
  .blog-entry-loader.is-visible.is-leaving {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }
  html.blog-entry-loading .home-entrance,
  html.blog-entry-loading .home-entrance::after,
  html.blog-entry-loading .home-entrance__tile { animation-play-state: paused !important; }
  html.blog-entry-loading #wallpaper-wrapper,
  html.blog-entry-loading .local-wallpaper-layer,
  html.blog-entry-loading .home-entrance { visibility: hidden !important; }
  html.blog-entry-loading { scrollbar-color: transparent transparent; }
  html.blog-entry-loading::-webkit-scrollbar-thumb,
  html.blog-entry-loading::-webkit-scrollbar-track { background: transparent !important; }
  .blog-entry-loader__footer {
    position: absolute;
    z-index: 2;
    font-family: var(--font-jetbrains-mono), monospace;
    font-size: .58rem;
    font-weight: 600;
    color: var(--loader-muted);
    letter-spacing: .12em;
  }
  .blog-entry-loader__footer { right: clamp(1.3rem, 3vw, 3rem); bottom: clamp(1.3rem, 3vw, 3rem); left: clamp(1.3rem, 3vw, 3rem); display: flex; justify-content: space-between; }
  .blog-entry-loader__composition {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    width: min(31rem, 78vw);
    transform: translateY(0);
    transition: opacity 260ms ease, transform 620ms cubic-bezier(.22, 1, .36, 1);
  }
  .blog-entry-loader.is-visible .blog-entry-loader__composition { animation: blog-loader-compose-in 820ms cubic-bezier(.22, 1, .36, 1) both; }
  .is-leaving .blog-entry-loader__composition { opacity: 0; transform: translateY(-1.5rem) scale(.98); }
  .blog-entry-loader__eyebrow {
    margin: 0 0 2.1rem;
    font-family: var(--font-jetbrains-mono), monospace;
    font-size: .62rem;
    font-weight: 600;
    color: var(--loader-muted);
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  .blog-entry-loader__eyebrow span { color: var(--loader-pink); padding: 0 .35em; }
  .blog-entry-loader__dial { position: relative; display: grid; place-items: center; width: clamp(18rem, 43vw, 26rem); aspect-ratio: 1; border-radius: 50%; isolation: isolate; }
  .blog-entry-loader__dial::before {
    position: absolute;
    inset: .2rem;
    border-radius: inherit;
    content: "";
    background: conic-gradient(from -90deg, var(--loader-pink) 0 var(--loader-progress), var(--loader-track) var(--loader-progress) 100%);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 7px), #000 calc(100% - 6px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 7px), #000 calc(100% - 6px));
    filter: drop-shadow(0 0 10px rgb(255 139 189 / 45%));
  }
  .blog-entry-loader__dial::after { position: absolute; inset: 1.45rem; border: 1px solid var(--loader-soft); border-radius: inherit; content: ""; }
  .blog-entry-loader__halo {
    position: absolute;
    inset: -.6rem;
    border-radius: 50%;
    background: repeating-conic-gradient(from -90deg, rgb(255 255 255 / 28%) 0 1deg, transparent 1deg 15deg);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 3px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 3px));
  }
  .blog-entry-loader__feibi {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 4;
    display: block;
    width: calc(100% + 3.5rem);
    max-width: none;
    height: auto;
    filter: drop-shadow(0 .75rem 1rem rgb(0 0 0 / 42%));
    transform: translate(-48%, -50%);
    animation: blog-loader-feibi-float 5.5s ease-in-out infinite;
  }
  .blog-entry-loader__center {
    display: grid;
    place-items: center;
    z-index: 5;
    width: 13.5rem;
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 50%;
    background: linear-gradient(145deg, rgb(10 12 21 / 92%), rgb(19 15 28 / 84%));
    box-shadow: 0 0 3rem rgb(7 8 14 / 52%), inset 0 1px 0 rgb(255 255 255 / 8%);
    color: var(--loader-ink);
    backdrop-filter: blur(7px);
  }
  .blog-entry-loader__label,
  .blog-entry-loader__wordmark { font-family: var(--font-jetbrains-mono), monospace; font-size: .62rem; font-weight: 600; color: var(--loader-muted); letter-spacing: .2em; }
  .blog-entry-loader__center strong {
    display: flex;
    align-items: flex-start;
    margin: .55rem 0 .8rem;
    font-family: var(--font-inter), sans-serif;
    font-size: clamp(4.5rem, 8vw, 6.3rem);
    line-height: .82;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 28px rgb(255 255 255 / 12%);
  }
  .blog-entry-loader__center small { margin: .2rem 0 0 .25rem; font-size: .9rem; color: var(--loader-pink); }
  .blog-entry-loader__wordmark { color: var(--loader-blue); letter-spacing: .28em; }
  .blog-entry-loader__caption { min-height: 1.4em; margin: 2.7rem 0 0; text-align: center; font-size: .86rem; color: var(--loader-muted); }
  .blog-entry-loader.is-complete .blog-entry-loader__dial { animation: blog-loader-ready 500ms cubic-bezier(.22, 1, .36, 1) both; }
