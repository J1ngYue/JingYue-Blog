      radial-gradient(circle at 13% 18%, rgb(255 216 231 / 88%) 0 7.5rem, transparent 7.65rem),
      radial-gradient(circle at 88% 76%, rgb(255 230 124 / 62%) 0 9rem, transparent 9.15rem),
      radial-gradient(circle at 78% 14%, rgb(233 221 255 / 68%) 0 5.5rem, transparent 5.65rem),
      linear-gradient(145deg, #fffdf9 0%, #fff8fb 54%, #fffdf2 100%);
    pointer-events: none;
  }
  .blog-entry-loader__backdrop::before {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(32 27 34 / 13%) 1px, transparent 1px);
    background-size: 19px 19px;
    content: "";
    opacity: .38;
    -webkit-mask: linear-gradient(90deg, #000, transparent 38% 62%, #000);
    mask: linear-gradient(90deg, #000, transparent 38% 62%, #000);
  }
  .blog-entry-loader__scribbles { position: absolute; inset: 0; pointer-events: none; }
  .blog-entry-loader__scribbles i {
    position: absolute;
    width: clamp(2.4rem, 5vw, 4rem);
    aspect-ratio: 1;
    border: 3px solid var(--loader-ink);
    border-radius: 42% 58% 61% 39% / 48% 40% 60% 52%;
    opacity: .12;
    animation: blog-loader-scribble 4.6s ease-in-out infinite;
  }
  .blog-entry-loader__scribbles i:nth-child(1) { top: 11%; left: 8%; }
  .blog-entry-loader__scribbles i:nth-child(2) { top: 20%; right: 10%; width: 2.1rem; border-color: var(--loader-pink); animation-delay: -.8s; }
  .blog-entry-loader__scribbles i:nth-child(3) { bottom: 18%; left: 12%; width: 1.7rem; border-color: #bd8e00; animation-delay: -1.6s; }
  .blog-entry-loader__scribbles i:nth-child(4) { right: 7%; bottom: 12%; animation-delay: -2.4s; }
  .blog-entry-loader__scribbles i:nth-child(5) { top: 7%; left: 42%; width: 1.3rem; border-color: var(--loader-pink); animation-delay: -3.2s; }
  .blog-entry-loader__scribbles i:nth-child(6) { right: 28%; bottom: 7%; width: 1.5rem; border-color: #bd8e00; animation-delay: -4s; }
  .blog-entry-loader.is-visible.is-leaving { opacity: 0; pointer-events: none; visibility: visible; }
  .blog-entry-loader.is-hidden { opacity: 0; pointer-events: none; visibility: hidden; transition: none; }
  html.blog-entry-loading .home-entrance,
  html.blog-entry-loading .home-entrance::after,
  html.blog-entry-loading .home-entrance__tile { animation-play-state: paused !important; }
  html.blog-entry-loading #wallpaper-wrapper,
  html.blog-entry-loading .local-wallpaper-layer { visibility: hidden !important; }
  html.blog-entry-loader-active {
    background: var(--loader-paper, #fffdf9) !important;
    scrollbar-color: #d9d3d8 #fffdf9 !important;
  }
  html.blog-entry-loader-active::-webkit-scrollbar-thumb { background: #d9d3d8 !important; }
  html.blog-entry-loader-active::-webkit-scrollbar-track { background: #fffdf9 !important; }
  .blog-entry-loader__scene {
    position: relative;
    z-index: 2;
    display: grid;
    width: min(61rem, 88vw);
    gap: clamp(.8rem, 1.8vh, 1.4rem);
    transition: opacity 300ms ease, transform 440ms cubic-bezier(.4, 0, 1, 1);
  }
  .is-leaving .blog-entry-loader__scene { opacity: 0; transform: translateY(-.6rem) scale(.985); }
  .blog-entry-loader__heading { text-align: center; }
  .blog-entry-loader__heading p {
    display: flex;
