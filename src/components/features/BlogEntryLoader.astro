  .blog-entry-loader__scribbles i:nth-child(5) { top: 8%; left: 42%; border-color: #a88423; animation-delay: -3.6s; }
  .blog-entry-loader__scribbles i:nth-child(6) { right: 30%; bottom: 7%; animation-delay: -4.5s; }
