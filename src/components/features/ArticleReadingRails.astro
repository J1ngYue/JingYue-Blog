---
import { getCollection } from "astro:content";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ReadingNavigation from "@/components/features/ReadingNavigation.svelte";
import { notebookDefinitions } from "@/config/notebookConfig";
import { getSortedPosts } from "@/utils/content-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";

interface Props {
	headings: MarkdownHeading[];
	currentId: string;
	currentCategory?: string;
	encrypted?: boolean;
	libraryMode?: "posts" | "notebooks";
}

const {
	headings = [],
	currentId,
	currentCategory = "未分类",
	encrypted = false,
	libraryMode = "posts",
} = Astro.props;

interface LibraryEntry {
	id: string;
	title: string;
	href: string;
	published: Date;
}

interface LibraryGroup {
	name: string;
	entries: LibraryEntry[];
}

let libraryGroups: LibraryGroup[];

if (libraryMode === "notebooks") {
	const notes = (
		await getCollection("notebooks", ({ data }) => !data.draft)
	).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
	libraryGroups = notebookDefinitions
		.map((notebook) => ({
			name: notebook.title,
			entries: notes
				.filter((note) => note.data.notebook === notebook.slug)
				.map((note) => ({
					id: note.id,
					title: note.data.title,
					href: `/life/notebooks/${notebook.slug}/${note.data.slug}/`,
					published: note.data.published,
				})),
		}))
		.filter((group) => group.entries.length > 0);
} else {
	const posts = (await getSortedPosts()).filter(
		(entry) => entry.data.draft !== true,
	);
	const categoryPosts = new Map<string, typeof posts>();

	for (const entry of posts) {
		const category = entry.data.category || "未分类";
		const entries = categoryPosts.get(category) || [];
		entries.push(entry);
		categoryPosts.set(category, entries);
	}

	libraryGroups = Array.from(categoryPosts, ([name, entries]) => ({
		name,
		entries: entries.map((entry) => ({
			id: entry.id,
			title: entry.data.title,
			href: getPostUrlBySlug(entry.id),
			published: entry.data.published,
		})),
	})).sort((a, b) => a.name.localeCompare(b.name, "zh-CN"));
}

const libraryTitle = libraryMode === "notebooks" ? "全部笔记" : "全部文章";
const title =
	libraryGroups
		.flatMap((group) => group.entries)
		.find((entry) => entry.id === currentId)?.title || "文章目录";
---

<div class="article-reading-rails" data-article-reading-rails>
	<div class="article-reading-toc-edge" data-article-reading-toc-edge aria-hidden="true"></div>
	<button type="button" class="article-reading-toc__mobile-trigger" data-article-toc-mobile-trigger aria-label="打开阅读导航" aria-expanded="false" aria-controls="article-reading-toc-panel">
		<Icon is:inline name="material-symbols:format-list-bulleted-rounded" />
	</button>
	<aside class="article-reading-toc is-collapsed" id="article-reading-toc-panel" data-article-reading-toc aria-label="阅读导航">
		<button type="button" class="article-reading-toc__close" data-article-toc-close aria-label="收起阅读导航">
			<Icon is:inline name="material-symbols:close-rounded" />
		</button>
		<ReadingNavigation client:load headings={encrypted ? [] : headings} {title} {encrypted} {libraryGroups} {libraryTitle} {currentId} {currentCategory} />
	</aside>
</div>

<script>
	type ReadingRailsWindow = Window & {
		__articleReadingRailsBound?: boolean;
		__articleReadingRailsCleanup?: () => void;
	};
	const readingWindow = window as ReadingRailsWindow;

	function initArticleReadingRails() {
		const root = document.querySelector<HTMLElement>("[data-article-reading-rails]");
		if (root?.dataset.bound === "true") return;
		readingWindow.__articleReadingRailsCleanup?.();
		delete document.documentElement.dataset.articleTocCollapsed;
		if (!root) return;
		root.dataset.bound = "true";
		const toc = root.querySelector<HTMLElement>("[data-article-reading-toc]");
		const edge = root.querySelector<HTMLElement>("[data-article-reading-toc-edge]");
		const trigger = root.querySelector<HTMLButtonElement>("[data-article-toc-mobile-trigger]");
		const close = root.querySelector<HTMLButtonElement>("[data-article-toc-close]");
		if (!toc) return;
		const mobile = window.matchMedia("(max-width: 760px)");
		const hover = window.matchMedia("(hover: hover) and (pointer: fine)");
		const events = new AbortController();
		let collapseTimer: number | undefined;
		const cancelCollapse = () => window.clearTimeout(collapseTimer);
		const setExpanded = (expanded: boolean) => {
			cancelCollapse();
			toc.classList.toggle("is-collapsed", !expanded);
			toc.inert = !expanded;
			trigger?.setAttribute("aria-expanded", String(expanded));
			trigger?.setAttribute("aria-label", expanded ? "收起阅读导航" : "打开阅读导航");
			document.documentElement.dataset.articleTocCollapsed = String(!expanded);
		};
		const open = () => { if (!mobile.matches) setExpanded(true); };
		const scheduleCollapse = () => {
			cancelCollapse();
			if (mobile.matches || toc.contains(document.activeElement)) return;
			collapseTimer = window.setTimeout(() => setExpanded(false), 240);
		};
		const syncViewport = () => setExpanded(!mobile.matches && !hover.matches);
		const options = { signal: events.signal };
		mobile.addEventListener("change", syncViewport, options);
		trigger?.addEventListener("click", () => setExpanded(toc.classList.contains("is-collapsed")), options);
		close?.addEventListener("click", () => { setExpanded(false); trigger?.focus(); }, options);
		edge?.addEventListener("pointerenter", open, options);
		edge?.addEventListener("pointerleave", scheduleCollapse, options);
		toc.addEventListener("pointerenter", open, options);
		toc.addEventListener("pointerleave", scheduleCollapse, options);
		toc.addEventListener("focusin", cancelCollapse, options);
		toc.addEventListener("focusout", scheduleCollapse, options);
		root.addEventListener("article:navigate", () => { if (mobile.matches) setExpanded(false); }, options);
		root.addEventListener("keydown", (event) => {
			if (event.key === "Escape") { setExpanded(false); trigger?.focus(); }
		}, options);
		syncViewport();
		readingWindow.__articleReadingRailsCleanup = () => { cancelCollapse(); events.abort(); };
	}

	initArticleReadingRails();
	if (!readingWindow.__articleReadingRailsBound) {
		readingWindow.__articleReadingRailsBound = true;
		document.addEventListener("astro:page-load", initArticleReadingRails);
		document.addEventListener("swup:contentReplaced", initArticleReadingRails);
	}
</script>

<style>
	.article-reading-toc-edge { position: fixed; top: 4.75rem; bottom: 0; left: 0; z-index: 43; width: 1.5rem; }
	.article-reading-toc__mobile-trigger { position: fixed; top: 5.7rem; left: .45rem; z-index: 41; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--line-divider); border-radius: .8rem; background: var(--card-bg); color: var(--content-meta); box-shadow: 0 .5rem 1.5rem rgb(20 29 33 / 10%); cursor: pointer; }
	.article-reading-toc__mobile-trigger svg { width: 1.35rem; height: 1.35rem; }
	.article-reading-toc { position: fixed; top: 5.35rem; bottom: .75rem; left: 1rem; z-index: 42; display: flex; width: 20rem; flex-direction: column; overflow: hidden; isolation: isolate; border: 1.5px solid color-mix(in srgb, var(--deep-text) 65%, transparent); border-radius: 1.15rem; background: color-mix(in srgb, var(--card-bg) 93%, #dcefff); box-shadow: 0 .8rem 2.4rem rgb(20 29 33 / 9%); backdrop-filter: blur(1rem); transition: transform 380ms cubic-bezier(.22,.8,.2,1); }
	.article-reading-toc::before, .article-reading-toc::after { position: absolute; z-index: 0; pointer-events: none; content: ""; }
	.article-reading-toc::before { inset: 0; background: radial-gradient(circle at 78% 84%, rgb(118 199 241 / 24%), transparent 48%), radial-gradient(circle at 0 8%, rgb(243 198 224 / 18%), transparent 34%); }
	.article-reading-toc::after { right: 0; bottom: 0; left: 0; height: min(53vh, 27rem); background: url("/pio/models/pets/deepseek/loader-deepseek-whale-girl.webp") center bottom .6rem / 98% auto no-repeat; mask-image: linear-gradient(to bottom, transparent, #000 38%); opacity: .34; }
	:global(html.dark) .article-reading-toc { border-color: rgb(198 226 247 / 38%); background: color-mix(in srgb, var(--card-bg) 88%, #142c43); }
	:global(html.dark) .article-reading-toc::after { filter: brightness(1.45); opacity: .42; }
	.article-reading-toc.is-collapsed { transform: translateX(calc(-100% - 1.25rem)); }
	.article-reading-toc__close { position: absolute; top: .8rem; right: .45rem; z-index: 2; display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: .6rem; color: var(--content-meta); cursor: pointer; }
	.article-reading-toc__close:hover { background: var(--btn-card-bg-hover); }
	.article-reading-toc__close svg { width: 1.2rem; height: 1.2rem; }
	.article-reading-toc__mobile-trigger:focus-visible, .article-reading-toc__close:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
	:global(html:has([data-article-reading-rails]) #left-sidebar-wrapper),
	:global(html:has([data-article-reading-rails]) #left-sidebar-dynamic),
	:global(html:has([data-article-reading-rails]) #right-sidebar-static),
	:global(html:has([data-article-reading-rails]) #right-sidebar-dynamic),
	:global(html:has([data-article-reading-rails]) #mobile-bottom-sidebar),
	:global(html:has([data-article-reading-rails]) #floating-toc-wrapper) { display: none !important; }
	:global(html:has([data-article-reading-rails]) body.content-only-active #main-column-wrapper) { grid-column: 1 / -1 !important; width: 100% !important; margin-right: 0 !important; margin-left: 0 !important; }
	:global(html:has([data-article-reading-rails]) body.content-only-active #main-layout-container),
	:global(html:has([data-article-reading-rails]) body.content-only-active #main-grid),
	:global(html:has([data-article-reading-rails]) body.content-only-active #swup-container) { width: 100% !important; max-width: none !important; }
	:global(html:has([data-article-reading-rails]) body.content-only-active #main-layout-container),
	:global(html:has([data-article-reading-rails]) body.content-only-active #main-grid) { margin-inline: 0 !important; padding-inline: 0 !important; }
	@media (max-width: 760px) {
		.article-reading-toc-edge { display: none; }
		.article-reading-toc__mobile-trigger { top: 5.1rem; z-index: 41; }
		.article-reading-toc { top: 4.8rem; bottom: auto; left: .5rem; width: min(20rem, calc(100vw - 1rem)); height: min(72dvh, 36rem); border-radius: 1rem; }
		.article-reading-toc::after { height: 55%; background-size: auto 100%; }
	}
	@media (prefers-reduced-motion: reduce) { .article-reading-toc { transition-duration: .01ms; } }
</style>
