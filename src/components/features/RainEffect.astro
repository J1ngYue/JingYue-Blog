---
import { rainConfig } from "@/config";

const config = rainConfig;
---

<script is:inline define:vars={{ rainEffectConfig: config }}>
	(function initializeRainEffect() {
		if (window.rainEffectInitialized) return;

		class RainEffectManager {
			constructor(config) {
				this.config = config;
				this.canvas = null;
				this.host = null;
				this.context = null;
				this.drops = [];
				this.splashes = [];
				this.animationId = null;
				this.resizeFrame = null;
				this.lastFrameTime = 0;
				this.pixelRatio = 1;
				this.viewportWidth = 0;
				this.viewportHeight = 0;
				this.collisionEdges = [];
				this.collisionRefreshAt = 0;
				this.entranceAnimation = null;
				this.seed = 20260710;
				this.state = "off";
				this.boundResize = this.handleResize.bind(this);
				this.boundVisibility = this.handleVisibility.bind(this);
			}

			randomUnit() {
				this.seed =
					(this.seed * 1664525 + 1013904223) % 4294967296;
				return this.seed / 4294967296;
			}

			random(min, max) {
				return min + this.randomUnit() * (max - min);
			}

			getDropCount() {
				const baseCount = window.innerWidth <= 768
					? this.config.dropCount.mobile
					: this.config.dropCount.desktop;
				const intensity = Math.min(1, Math.max(0, this.config.intensity));
				const areaScale = Math.min(
					1.4,
					(this.viewportWidth * this.viewportHeight) / 1100000,
				);
				return Math.max(
					10,
					Math.round(baseCount * intensity * Math.max(0.65, areaScale)),
				);
			}

			getRevealProgress() {
				if (!document.documentElement.classList.contains("home-entrance-active")) {
					return 1;
				}
				if (!this.entranceAnimation) {
					const entrance = document.querySelector("[data-home-entrance]");
					this.entranceAnimation = entrance
						?.getAnimations()
						.find((item) => item.animationName === "home-entrance-finish") ?? null;
				}
				const animation = this.entranceAnimation;
				const timing = animation?.effect?.getComputedTiming();
				const currentTime = Number(animation?.currentTime);
				const duration = Number(timing?.duration);
				if (!Number.isFinite(currentTime) || !Number.isFinite(duration) || duration <= 0) {
					return 0;
				}
				const timelineProgress = Math.min(1, Math.max(0, currentTime / duration));
				const rainProgress = Math.min(
					1,
					Math.max(0, (timelineProgress - 0.6) / 0.4),
				);
				return rainProgress * rainProgress * (3 - 2 * rainProgress);
			}

			createDrop(randomY) {
				const speed = this.random(this.config.speed.min, this.config.speed.max);
				return {
					x: this.randomUnit() * this.viewportWidth,
					y: randomY
						? this.randomUnit() * this.viewportHeight
						: -40 - this.randomUnit() * this.viewportHeight * 0.3,
					speed,
					length: this.random(this.config.length.min, this.config.length.max),
					opacity: this.random(this.config.opacity.min, this.config.opacity.max),
					wind: speed * this.config.wind,
					radius: this.random(0.55, 1.35),
					finished: false,
				};
			}

			createDrops() {
				this.drops = Array.from(
					{ length: this.getDropCount() },
					() => this.createDrop(true),
				);
				this.splashes = [];
			}

			createCanvas() {
				this.canvas = document.querySelector("[data-hero-rain]");
				this.host = this.canvas?.parentElement ?? null;
				if (!this.canvas || !this.host) return;
				this.canvas.style.zIndex = String(this.config.zIndex);
				this.canvas.classList.add("is-active");
				this.context = this.canvas.getContext("2d", { alpha: true });
				this.resizeCanvas();
			}

			resizeCanvas() {
				if (!this.canvas || !this.host) return;
				const bounds = this.host.getBoundingClientRect();
				this.viewportWidth = Math.max(1, Math.round(bounds.width));
				this.viewportHeight = Math.max(1, Math.round(bounds.height));
				this.pixelRatio = window.innerWidth <= 768
					? 1
					: Math.min(window.devicePixelRatio || 1, 1.5);
				this.canvas.width = Math.round(this.viewportWidth * this.pixelRatio);
				this.canvas.height = Math.round(this.viewportHeight * this.pixelRatio);
				this.context?.setTransform(
					this.pixelRatio,
					0,
					0,
					this.pixelRatio,
					0,
					0,
				);
				this.refreshCollisionEdges(true);
			}

			refreshCollisionEdges(force = false) {
				const now = performance.now();
				if (!force && now < this.collisionRefreshAt) return;
				this.collisionRefreshAt = now + 500;
				const hostRect = this.host?.getBoundingClientRect();
				if (!hostRect) return;
				const selectors = [".home-hero-dialogue.is-open"];
				this.collisionEdges = selectors.flatMap((selector) =>
					Array.from(document.querySelectorAll(selector), (element) => {
						const rect = element.getBoundingClientRect();
						return {
							left: Math.max(0, rect.left - hostRect.left),
							right: Math.min(this.viewportWidth, rect.right - hostRect.left),
							top: rect.top - hostRect.top,
						};
					}).filter((edge) => edge.right > edge.left && edge.top > 0 && edge.top < this.viewportHeight),
				);
			}

			handleResize() {
				if (this.resizeFrame !== null) {
					cancelAnimationFrame(this.resizeFrame);
				}
				this.resizeFrame = requestAnimationFrame(() => {
					this.resizeCanvas();
					if (this.state === "active") this.createDrops();
					this.resizeFrame = null;
				});
			}

			handleVisibility() {
				if (this.state === "off") return;
				if (document.hidden) {
					if (this.animationId !== null) {
						cancelAnimationFrame(this.animationId);
						this.animationId = null;
					}
					return;
				}
				this.lastFrameTime = performance.now();
				if (this.animationId === null) {
					this.animationId = requestAnimationFrame((time) =>
						this.drawFrame(time),
					);
				}
			}

			resetDrop(drop) {
				Object.assign(drop, this.createDrop(false));
				drop.x = this.randomUnit() * (this.viewportWidth + 80);
			}

			spawnSplash(x, y) {
				const particleCount = window.innerWidth <= 768 ? 3 : 6;
				for (let index = 0; index < particleCount; index += 1) {
					this.splashes.push({
						x,
						y: y - 1,
						vx: this.random(-1.9, 1.9),
						vy: -this.random(1.4, 4.8),
						radius: this.random(0.7, 2.2),
						opacity: this.random(0.24, 0.56),
						life: 0,
						maxLife: 14 + Math.floor(this.randomUnit() * 16),
					});
				}
			}

			getRainColor() {
				return "255, 255, 255";
			}

			isHomePage() {
				return document.body.classList.contains("home-landing-active");
			}

			drawFrame(time) {
				if (this.state === "off" || !this.canvas || !this.context) {
					this.animationId = null;
					return;
				}

				const delta = Math.min(
					2.2,
					Math.max(0.5, (time - this.lastFrameTime) / 16.667),
				);
				this.lastFrameTime = time;
				const width = this.viewportWidth;
				const height = this.viewportHeight;
				const context = this.context;
				const rainColor = this.getRainColor();
				const revealProgress = this.getRevealProgress();
				const motionProgress = 0.48 + revealProgress * 0.52;
				const visibleDropLimit = revealProgress <= 0
					? 0
					: Math.max(2, Math.ceil(this.drops.length * revealProgress));
				let visibleCount = 0;
				this.refreshCollisionEdges();

				context.clearRect(0, 0, width, height);
				context.lineCap = "round";

				for (let dropIndex = 0; dropIndex < this.drops.length; dropIndex += 1) {
					if (dropIndex >= visibleDropLimit) continue;
					const drop = this.drops[dropIndex];
					if (drop.finished) continue;
					const previousY = drop.y;
					drop.x += drop.wind * delta * motionProgress;
					drop.y += drop.speed * delta * motionProgress;

					const hitEdge = this.collisionEdges.find(
						(edge) =>
							drop.x >= edge.left &&
							drop.x <= edge.right &&
							previousY < edge.top &&
							drop.y >= edge.top &&
							this.randomUnit() <= 0.62,
					);
					if (hitEdge) {
						if (revealProgress > 0.42) this.spawnSplash(drop.x, hitEdge.top);
						if (this.state === "draining") {
							drop.finished = true;
							continue;
						}
						this.resetDrop(drop);
						continue;
					}

					if (drop.y - drop.length > height || drop.x < -drop.length) {
						if (this.state === "draining") {
							if (revealProgress > 0.42) this.spawnSplash(drop.x, height - 1);
							drop.finished = true;
							continue;
						}
						if (revealProgress > 0.42) this.spawnSplash(drop.x, height - 1);
						this.resetDrop(drop);
						continue;
					}

					visibleCount += 1;
					context.globalAlpha = 1;
					context.strokeStyle = `rgba(${rainColor}, ${drop.opacity * (0.7 + revealProgress * 0.3)})`;
					context.lineWidth = drop.radius;
					context.beginPath();
					context.moveTo(drop.x, drop.y);
					context.lineTo(
						drop.x - this.config.wind * drop.length,
						drop.y - drop.length,
					);
					context.stroke();
				}

				for (let i = this.splashes.length - 1; i >= 0; i -= 1) {
					const splash = this.splashes[i];
					splash.life += delta;
					if (splash.life >= splash.maxLife) {
						this.splashes.splice(i, 1);
						continue;
					}
					splash.x += splash.vx * delta;
					splash.y += splash.vy * delta;
					splash.vy += 0.16 * delta;
					const opacity = splash.opacity * revealProgress * (1 - splash.life / splash.maxLife);
					context.globalAlpha = 1;
					context.fillStyle = `rgba(${rainColor}, ${opacity})`;
					context.beginPath();
					context.arc(splash.x, splash.y, splash.radius, 0, Math.PI * 2);
					context.fill();
				}

				context.globalAlpha = 1;
				if (
					this.state === "draining" &&
					visibleCount === 0 &&
					this.splashes.length === 0
				) {
					this.finishDrain();
					return;
				}
				this.animationId = requestAnimationFrame((nextTime) =>
					this.drawFrame(nextTime),
				);
			}

			start() {
				if (!this.isHomePage()) return;
				if (this.state === "active" && this.canvas?.isConnected) return;
				if (this.state === "draining" && this.canvas?.isConnected) {
					this.state = "active";
					this.createDrops();
					return;
				}
				if (this.state !== "off") this.finishDrain();
				this.entranceAnimation = null;
				if (
					window.matchMedia("(prefers-reduced-motion: reduce)").matches
				) {
					return;
				}
				this.createCanvas();
				if (!this.context) {
					this.finishDrain();
					return;
				}
				this.createDrops();
				this.state = "active";
				this.lastFrameTime = performance.now();
				window.addEventListener("resize", this.boundResize, {
					passive: true,
				});
				document.addEventListener(
					"visibilitychange",
					this.boundVisibility,
				);
				if (!document.hidden) {
					this.animationId = requestAnimationFrame((time) =>
						this.drawFrame(time),
					);
				}
			}

			stop() {
				if (this.state !== "active") return;
				this.state = "draining";
			}

			finishDrain() {
				this.state = "off";
				if (this.animationId !== null) {
					cancelAnimationFrame(this.animationId);
					this.animationId = null;
				}
				if (this.resizeFrame !== null) {
					cancelAnimationFrame(this.resizeFrame);
					this.resizeFrame = null;
				}
				window.removeEventListener("resize", this.boundResize);
				document.removeEventListener(
					"visibilitychange",
					this.boundVisibility,
				);
				this.context?.clearRect(0, 0, this.viewportWidth, this.viewportHeight);
				this.canvas?.classList.remove("is-active");
				this.canvas = null;
				this.host = null;
				this.context = null;
				this.drops = [];
				this.splashes = [];
				this.collisionEdges = [];
				this.entranceAnimation = null;
			}

			stopImmediate() {
				if (this.state === "off") return;
				this.finishDrain();
			}
		}

		const storedEnabled = localStorage.getItem("rainEnabled");
		const enabled =
			storedEnabled === null
				? rainEffectConfig.enable
				: storedEnabled === "true";
		const manager = new RainEffectManager(rainEffectConfig);
		window.rainEffectManager = manager;
		window.rainEffectInitialized = true;
		document.documentElement.setAttribute(
			"data-rain-enabled",
			String(enabled && manager.isHomePage()),
		);

		if (enabled) manager.start();

		window.addEventListener("rainToggle", (event) => {
			const nextEnabled = Boolean(event.detail?.enabled);
			document.documentElement.setAttribute(
				"data-rain-enabled",
				String(nextEnabled),
			);
			if (nextEnabled) manager.start();
			else manager.stop();
		});

		const syncRainEffect = () => {
			const stored = localStorage.getItem("rainEnabled");
			const shouldEnable =
				stored === null ? rainEffectConfig.enable : stored === "true";
			document.documentElement.setAttribute(
				"data-rain-enabled",
				String(shouldEnable && manager.isHomePage()),
			);
			if (shouldEnable && manager.isHomePage()) manager.start();
			else manager.stopImmediate();
		};

		document.addEventListener("astro:page-load", syncRainEffect);
		document.addEventListener("swup:contentReplaced", syncRainEffect);
		window.addEventListener("beforeunload", () => manager.stopImmediate());
	})();
</script>

<style is:global>
	:root {
		--home-entrance-duration: 7.5s;
		--home-rain-atmosphere:
			radial-gradient(ellipse at 50% 86%, rgb(171 204 224 / 0.1), transparent 48%),
			linear-gradient(180deg, rgb(8 22 37 / 0.05), rgb(4 14 26 / 0.16));
	}

	.home-hero-frame::after {
		position: absolute;
		inset: -3%;
		z-index: 0;
		background: var(--home-rain-atmosphere);
		content: "";
		opacity: 0;
		transform: scale(1.035);
		pointer-events: none;
		will-change: opacity, transform;
	}

	html[data-rain-enabled="true"].home-entrance-active .home-hero-frame::after {
		animation: home-hero-atmosphere var(--home-entrance-duration) cubic-bezier(0.45, 0, 0.2, 1) both;
	}

	html[data-rain-enabled="true"]:not(.home-entrance-active) .home-hero-frame::after {
		opacity: 1;
		transform: scale(1);
	}

	.home-hero-rain {
		position: absolute;
		inset: 0;
		z-index: 20;
		width: 100%;
		height: 100%;
		opacity: 0;
		pointer-events: none;
		contain: strict;
		transition: opacity 720ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.home-hero-rain.is-active {
		opacity: 1;
	}

	html[data-rain-enabled="true"].home-entrance-active .home-hero-rain.is-active {
		animation: home-rain-discovery var(--home-entrance-duration) cubic-bezier(0.45, 0, 0.2, 1) both;
	}

	html.blog-entry-loading .home-hero-frame::after,
	html.blog-entry-loading .home-hero-rain {
		animation-play-state: paused !important;
	}

	@keyframes home-hero-atmosphere {
		0%,
		40% {
			opacity: 0;
			transform: scale(1.035);
		}
		50% {
			opacity: 0.34;
		}
		60%,
		100% {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes home-rain-discovery {
		0%,
		60% {
			opacity: 0;
		}
		72% {
			opacity: 0.12;
		}
		82% {
			opacity: 0.3;
		}
		92% {
			opacity: 0.6;
		}
		100% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-hero-rain,
		.home-hero-frame::after {
			display: none;
		}
	}
</style>
