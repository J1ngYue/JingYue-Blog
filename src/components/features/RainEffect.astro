---
import { rainConfig } from "@/config";

const config = rainConfig;
---

<script is:inline define:vars={{ rainEffectConfig: config }}>
	(function initializeRainEffect() {
		if (window.rainEffectInitialized) return;

		class RainEffectManager {
			constructor(config) {
				this.config = config;
				this.canvas = null;
				this.context = null;
				this.drops = [];
				this.splashes = [];
				this.animationId = null;
				this.resizeFrame = null;
				this.lastFrameTime = 0;
				this.pixelRatio = 1;
				this.viewportWidth = 0;
				this.viewportHeight = 0;
				this.collisionEdges = [];
				this.collisionRefreshAt = 0;
				this.seed = 20260710;
				this.state = "off";
				this.boundResize = this.handleResize.bind(this);
				this.boundVisibility = this.handleVisibility.bind(this);
			}

			randomUnit() {
				this.seed =
					(this.seed * 1664525 + 1013904223) % 4294967296;
				return this.seed / 4294967296;
			}

			random(min, max) {
				return min + this.randomUnit() * (max - min);
			}

			getDropCount() {
				const intensity = 0.6;
				return Math.max(
					18,
					Math.round(
						(20 + intensity * 40) *
							Math.min(1, this.viewportWidth / 1280),
					),
				);
			}

			createDrop(randomY) {
				return {
					x: this.randomUnit() * Math.max(1, this.viewportWidth),
					y: randomY
						? this.randomUnit() * Math.max(1, this.viewportHeight)
						: -this.randomUnit() * Math.max(1, this.viewportHeight) * 0.5,
					speed: this.random(2.8, 6.4),
					length: this.random(9, 25),
					opacity: this.random(0.12, 0.32),
					radius: this.random(0.9, 2.2),
					finished: false,
				};
			}

			createDrops() {
				this.drops = Array.from(
					{ length: this.getDropCount() },
					() => this.createDrop(true),
				);
				this.splashes = [];
			}

			createCanvas() {
				document.getElementById("canvas_rain")?.remove();
				this.canvas = document.createElement("canvas");
				this.canvas.id = "canvas_rain";
				this.canvas.setAttribute("aria-hidden", "true");
				this.canvas.style.cssText = [
					"position:fixed",
					"inset:0",
					"width:100vw",
					"height:100vh",
					"pointer-events:none",
					`z-index:${this.config.zIndex}`,
					"contain:strict",
				].join(";");
				document.documentElement.appendChild(this.canvas);
				this.context = this.canvas.getContext("2d", { alpha: true });
				this.resizeCanvas();
			}

			resizeCanvas() {
				if (!this.canvas) return;
				this.viewportWidth = Math.max(1, window.innerWidth);
				this.viewportHeight = Math.max(1, window.innerHeight);
				this.pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
				this.canvas.width = Math.round(this.viewportWidth * this.pixelRatio);
				this.canvas.height = Math.round(this.viewportHeight * this.pixelRatio);
				this.context?.setTransform(
					this.pixelRatio,
					0,
					0,
					this.pixelRatio,
					0,
					0,
				);
				this.refreshCollisionEdges(true);
			}

			refreshCollisionEdges(force = false) {
				const now = performance.now();
				if (!force && now < this.collisionRefreshAt) return;
				this.collisionRefreshAt = now + 500;
				const selectors = [".home-hero-dialogue.is-open"];
				this.collisionEdges = selectors.flatMap((selector) =>
					Array.from(document.querySelectorAll(selector), (element) => {
						const rect = element.getBoundingClientRect();
						return {
							left: Math.max(0, rect.left),
							right: Math.min(window.innerWidth, rect.right),
							top: rect.top,
						};
					}).filter((edge) => edge.right > edge.left && edge.top > 0 && edge.top < window.innerHeight),
				);
			}

			handleResize() {
				if (this.resizeFrame !== null) {
					cancelAnimationFrame(this.resizeFrame);
				}
				this.resizeFrame = requestAnimationFrame(() => {
					this.resizeCanvas();
					if (this.state === "active") this.createDrops();
					this.resizeFrame = null;
				});
			}

			handleVisibility() {
				if (this.state === "off") return;
				if (document.hidden) {
					if (this.animationId !== null) {
						cancelAnimationFrame(this.animationId);
						this.animationId = null;
					}
					return;
				}
				this.lastFrameTime = performance.now();
				if (this.animationId === null) {
					this.animationId = requestAnimationFrame((time) =>
						this.drawFrame(time),
					);
				}
			}

			resetDrop(drop) {
				drop.x = this.randomUnit() * this.viewportWidth;
				drop.y = -this.randomUnit() * 40;
				drop.finished = false;
			}

			spawnSplash(x, y) {
				if (this.splashes.length > 90) return;
				const particleCount = 6 + Math.floor(this.randomUnit() * 4);
				for (let index = 0; index < particleCount; index += 1) {
					const angle =
						-Math.PI / 2 + (this.randomUnit() - 0.5) * 1.9;
					const speed = this.random(1.1, 3.3);
					this.splashes.push({
						x,
						y,
						vx: Math.cos(angle) * speed,
						vy: Math.sin(angle) * speed,
						radius: this.random(0.8, 1.9),
						life: 0,
						maxLife: 22 + Math.floor(this.randomUnit() * 16),
					});
				}
			}

			getRainColor() {
				return "255, 255, 255";
			}

			drawFrame(time) {
				if (this.state === "off" || !this.canvas || !this.context) {
					this.animationId = null;
					return;
				}

				const delta = Math.min(
					2.2,
					Math.max(0.5, (time - this.lastFrameTime) / 16.667),
				);
				this.lastFrameTime = time;
				const width = this.viewportWidth;
				const height = this.viewportHeight;
				const context = this.context;
				const rainColor = this.getRainColor();
				let visibleCount = 0;
				this.refreshCollisionEdges();

				context.clearRect(0, 0, width, height);
				context.lineCap = "round";

				for (const drop of this.drops) {
					if (drop.finished) continue;
					const previousY = drop.y;
					drop.y += drop.speed * delta;

					const hitEdge = this.collisionEdges.find((edge) =>
						drop.x >= edge.left &&
						drop.x <= edge.right &&
						previousY < edge.top &&
						drop.y >= edge.top,
					);
					if (hitEdge) {
						this.spawnSplash(drop.x, hitEdge.top);
						if (this.state === "draining") {
							drop.finished = true;
							continue;
						}
						this.resetDrop(drop);
						continue;
					}

					if (drop.y > height + drop.length) {
						if (this.state === "draining") {
							this.spawnSplash(drop.x, height - 1);
							drop.finished = true;
							continue;
						}
						this.spawnSplash(drop.x, height - 1);
						this.resetDrop(drop);
						continue;
					}

					if (drop.x > width + 12 || drop.x < -12) {
						if (this.state === "draining") {
							drop.finished = true;
							continue;
						}
						drop.x = drop.x > width ? -8 : width + 8;
					}

					visibleCount += 1;
					context.globalAlpha = 1;
					context.strokeStyle = `rgba(${rainColor}, ${drop.opacity})`;
					context.lineWidth = drop.radius;
					context.beginPath();
					context.moveTo(drop.x, drop.y - drop.length);
					context.lineTo(drop.x, drop.y);
					context.stroke();
				}

				for (let i = this.splashes.length - 1; i >= 0; i -= 1) {
					const splash = this.splashes[i];
					splash.life += delta;
					if (splash.life >= splash.maxLife) {
						this.splashes.splice(i, 1);
						continue;
					}
					splash.x += splash.vx * delta;
					splash.y += splash.vy * delta;
					splash.vy += 0.16 * delta;
					const opacity = 0.4 * (1 - splash.life / splash.maxLife);
					context.globalAlpha = 1;
					context.fillStyle = `rgba(${rainColor}, ${opacity})`;
					context.beginPath();
					context.arc(splash.x, splash.y, splash.radius, 0, Math.PI * 2);
					context.fill();
				}

				context.globalAlpha = 1;
				if (
					this.state === "draining" &&
					visibleCount === 0 &&
					this.splashes.length === 0
				) {
					this.finishDrain();
					return;
				}
				this.animationId = requestAnimationFrame((nextTime) =>
					this.drawFrame(nextTime),
				);
			}

			start() {
				if (this.state === "active" && this.canvas?.isConnected) return;
				if (this.state === "draining" && this.canvas?.isConnected) {
					this.state = "active";
					this.createDrops();
					return;
				}
				if (this.state !== "off") this.finishDrain();
				if (
					window.matchMedia("(prefers-reduced-motion: reduce)").matches
				) {
					return;
				}
				this.createCanvas();
				if (!this.context) {
					this.finishDrain();
					return;
				}
				this.createDrops();
				this.state = "active";
				this.lastFrameTime = performance.now();
				window.addEventListener("resize", this.boundResize, {
					passive: true,
				});
				document.addEventListener(
					"visibilitychange",
					this.boundVisibility,
				);
				if (!document.hidden) {
					this.animationId = requestAnimationFrame((time) =>
						this.drawFrame(time),
					);
				}
			}

			stop() {
				if (this.state !== "active") return;
				this.state = "draining";
			}

			finishDrain() {
				this.state = "off";
				if (this.animationId !== null) {
					cancelAnimationFrame(this.animationId);
					this.animationId = null;
				}
				if (this.resizeFrame !== null) {
					cancelAnimationFrame(this.resizeFrame);
					this.resizeFrame = null;
				}
				window.removeEventListener("resize", this.boundResize);
				document.removeEventListener(
					"visibilitychange",
					this.boundVisibility,
				);
				this.canvas?.remove();
				this.canvas = null;
				this.context = null;
				this.drops = [];
				this.splashes = [];
				this.collisionEdges = [];
			}

			stopImmediate() {
				if (this.state === "off") return;
				this.finishDrain();
			}
		}

		const storedEnabled = localStorage.getItem("rainEnabled");
		const enabled =
			storedEnabled === null
				? rainEffectConfig.enable
				: storedEnabled === "true";
		const manager = new RainEffectManager(rainEffectConfig);
		window.rainEffectManager = manager;
		window.rainEffectInitialized = true;
		document.documentElement.setAttribute(
			"data-rain-enabled",
			String(enabled),
		);

		if (enabled) manager.start();

		window.addEventListener("rainToggle", (event) => {
			const nextEnabled = Boolean(event.detail?.enabled);
			document.documentElement.setAttribute(
				"data-rain-enabled",
				String(nextEnabled),
			);
			if (nextEnabled) manager.start();
			else manager.stop();
		});

		const syncRainEffect = () => {
			const stored = localStorage.getItem("rainEnabled");
			const shouldEnable =
				stored === null ? rainEffectConfig.enable : stored === "true";
			document.documentElement.setAttribute(
				"data-rain-enabled",
				String(shouldEnable),
			);
			if (shouldEnable) manager.start();
			else manager.stop();
		};

		document.addEventListener("astro:page-load", syncRainEffect);
		document.addEventListener("swup:contentReplaced", syncRainEffect);
		window.addEventListener("beforeunload", () => manager.stopImmediate());
	})();
</script>
