---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import { githubUsername } from "@/config/profileConfig";
import { getSortedPosts } from "@/utils/content-utils";
import { getGithubContributionYears } from "@/utils/home-activity";
import { profileDateKey } from "@/utils/profile-calendar";
import { getPostUrlBySlug, url } from "@/utils/url-utils";

const timeZone = siteConfig.timezone || "Asia/Shanghai";
const githubYears = await getGithubContributionYears(githubUsername);
const posts = (await getSortedPosts())
	.filter((post) => !post.data.draft)
	.map((post) => ({
		title: post.data.title,
		date: profileDateKey(post.data.published, timeZone),
		href: getPostUrlBySlug(post.id),
	}));
---

<navbar-profile-overview data-posts={JSON.stringify(posts)} data-timezone={timeZone} data-site-start={siteConfig.siteStartDate || "2025-01-01"}>
	<div class="navbar-profile-card__activity" data-profile-activity="articles">
		<div class="navbar-profile-card__activity-heading">
			<button type="button" data-profile-activity-toggle aria-label="切换到 GitHub 活动"><span data-profile-year></span><Icon is:inline name="material-symbols:swap-horiz-rounded" /></button>
			<a data-profile-archive-link href={url("/archive/")}>文章归档 <Icon is:inline name="material-symbols:arrow-outward-rounded" /></a>
			<a data-profile-github-link hidden href={`https://github.com/${githubUsername}`} target="_blank" rel="noopener noreferrer">GitHub <Icon is:inline name="material-symbols:arrow-outward-rounded" /></a>
		</div>
		<div class="navbar-profile-card__activity-views">
		<div class="navbar-profile-card__heatmap navbar-profile-card__activity-pane" data-profile-pane="articles" role="group" aria-label="年度文章活动">
			{Array.from({ length: 12 }, (_, month) => (
				<div class="navbar-profile-card__heat-column">
					<span>{month + 1}</span>
					{Array.from({ length: 4 }, (_, week) => <button type="button" data-profile-cell={`${month + 1}-${week}`} aria-label={`${month + 1}月第${week + 1}周文章`} aria-pressed="false" data-level="0"></button>)}
				</div>
			))}
		</div>
		<div class="navbar-profile-card__activity-pane navbar-profile-card__github" data-profile-pane="github" inert>
			<div class="navbar-profile-card__github-heading"><span data-profile-github-summary>GitHub 活动加载中…</span><button type="button" data-profile-github-year aria-expanded="false" aria-controls="profile-github-popover">全年大图</button></div>
			<div class="navbar-profile-card__github-month" data-profile-github-month role="button" tabindex="0" aria-label="本月 GitHub 活动，点击固定全年大图" aria-expanded="false" aria-controls="profile-github-popover"></div>
		</div>
		</div>
	</div>
	<div class="navbar-profile-card__details">
		<div data-profile-calendar>
			<dl class="navbar-profile-card__countdowns">
				<div><dt>距周末</dt><dd data-profile-days="week">--</dd></div>
				<div><dt>距月底</dt><dd data-profile-days="month">--</dd></div>
				<div><dt>距年底</dt><dd data-profile-days="year">--</dd></div>
			</dl>
			{["holiday", "anniversary"].map((kind) => (
				<div class="navbar-profile-card__event" data-profile-event={kind}>
					<div><strong data-event-name></strong><time data-event-date></time></div>
					<div><progress max="100" value="0" aria-label={kind === "holiday" ? "节日倒计时" : "建站周年倒计时"}></progress><span data-event-days></span></div>
				</div>
			))}
		</div>
		<div data-profile-posts hidden>
			<div class="navbar-profile-card__posts-heading"><strong data-profile-posts-title></strong><button type="button" data-profile-back title="返回倒计时" aria-label="返回倒计时"><Icon is:inline name="material-symbols:close-rounded" /></button></div>
			<div class="navbar-profile-card__post-list" data-profile-post-list></div>
		</div>
	</div>
	<section id="profile-github-popover" class="navbar-profile-card__github-popover" data-profile-github-popover popover="manual" role="dialog" aria-label="GitHub 年度贡献" tabindex="-1">
		<header><div><strong>GitHub 年度贡献</strong><p data-profile-github-year-summary aria-live="polite">活动加载中…</p></div><div class="navbar-profile-card__github-actions"><select data-profile-github-year-select aria-label="选择贡献年份" disabled>{githubYears.map((year) => <option value={year}>{year} 年</option>)}</select><button type="button" data-profile-github-close aria-label="关闭年度贡献">×</button></div></header>
		<div class="navbar-profile-card__github-year-scroll" tabindex="0" role="group" aria-label="全年贡献热力图，可左右滚动"><div class="navbar-profile-card__github-year-months" data-profile-github-year-months></div><div class="navbar-profile-card__github-weeks" data-profile-github-year-grid></div></div>
		<footer><span data-profile-github-pin-hint>单击固定后可选择年份</span><span class="navbar-profile-card__github-legend" aria-label="绿色越深，贡献次数越多">少 {Array.from({ length: 5 }, (_, level) => <i class="navbar-profile-card__github-cell" data-level={level}></i>)} 多</span></footer>
	</section>
</navbar-profile-overview>

<script>
	import type { ActivityCalendar } from "@/utils/home-activity";
	import { getProfileCountdowns, profileDateKey } from "@/utils/profile-calendar";
	import { getGithubMonthDays } from "@/utils/profile-github";

	let githubRequest: Promise<ActivityCalendar | null> | undefined;
	const loadGithubActivity = () => githubRequest ??= fetch("/api/home-activity.json", { signal: AbortSignal.timeout(10_000) })
		.then(async (response) => response.ok ? (await response.json()).github as ActivityCalendar : null)
		.catch(() => null);
	const yearRequests = new Map<string, Promise<ActivityCalendar | null>>();
	const loadGithubYear = (year: string) => {
		if (!yearRequests.has(year)) yearRequests.set(year, fetch(`/api/github-activity/${year}.json`, { signal: AbortSignal.timeout(10_000) })
			.then(async (response) => response.ok ? await response.json() as ActivityCalendar : null)
			.catch(() => null).then((data) => { if (!data?.available) yearRequests.delete(year); return data; }));
		return yearRequests.get(year)!;
	};

	class NavbarProfileOverview extends HTMLElement {
		private cleanup?: () => void;
		connectedCallback() {
			this.cleanup?.();
			const controller = new AbortController();
			const posts = JSON.parse(this.dataset.posts || "[]") as { title: string; date: string; href: string }[];
			const cells = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-profile-cell]"));
			const calendar = this.querySelector<HTMLElement>("[data-profile-calendar]")!;
			const postPane = this.querySelector<HTMLElement>("[data-profile-posts]")!;
			const postList = this.querySelector<HTMLElement>("[data-profile-post-list]")!;
			const activity = this.querySelector<HTMLElement>("[data-profile-activity]")!;
			const card = this.closest<HTMLElement>(".navbar-profile-card")!;
			const panes = Array.from(activity.querySelectorAll<HTMLElement>("[data-profile-pane]"));
			const toggle = activity.querySelector<HTMLButtonElement>("[data-profile-activity-toggle]")!;
			const yearButton = activity.querySelector<HTMLButtonElement>("[data-profile-github-year]")!;
			const monthGrid = activity.querySelector<HTMLElement>("[data-profile-github-month]")!;
			const githubPane = activity.querySelector<HTMLElement>("[data-profile-pane=github]")!;
			const popover = this.querySelector<HTMLElement>("[data-profile-github-popover]")!;
			const yearGrid = popover.querySelector<HTMLElement>("[data-profile-github-year-grid]")!;
			const yearMonths = popover.querySelector<HTMLElement>("[data-profile-github-year-months]")!;
			const yearSelect = popover.querySelector<HTMLSelectElement>("[data-profile-github-year-select]")!;
			const yearSummary = popover.querySelector<HTMLElement>("[data-profile-github-year-summary]")!;
			const pinHint = popover.querySelector<HTMLElement>("[data-profile-github-pin-hint]")!;
			const summary = activity.querySelector<HTMLElement>("[data-profile-github-summary]")!;
			const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
			let github: ActivityCalendar | null = null;
			let githubLoaded = false;
			let rotationTimer = 0;
			let hovered = false;
			let pinned = false;
			let closeTimer = 0;
			let yearRequestId = 0;
			let renderedYear = "";
			let dateKey = "";
			let groups = new Map<string, typeof posts>();
			const positionPopover = () => {
				if (!popover.matches(":popover-open")) return;
				const anchor = activity.getBoundingClientRect();
				const bounds = popover.getBoundingClientRect();
				popover.style.left = `${Math.max(16, Math.min(card.getBoundingClientRect().left, window.innerWidth - bounds.width - 16))}px`;
				const below = anchor.bottom + 12;
				popover.style.top = `${Math.max(16, Math.min(below + bounds.height <= window.innerHeight - 16 ? below : anchor.top - bounds.height - 12, window.innerHeight - bounds.height - 16))}px`;
			};
			const closePopover = () => {
				window.clearTimeout(closeTimer);
				if (popover.matches(":popover-open")) popover.hidePopover();
				pinned = false;
				delete popover.dataset.pinned;
				yearSelect.disabled = true;
				yearButton.setAttribute("aria-expanded", "false");
				monthGrid.setAttribute("aria-expanded", "false");
			};
			const appendDays = (grid: HTMLElement, days: ActivityCalendar["days"]) => {
				for (const day of days) {
					const cell = document.createElement("span");
					cell.className = "navbar-profile-card__github-cell";
					cell.dataset.level = String(day.level);
					cell.dataset.date = day.date;
					cell.title = day.isOutsideRange ? `${day.date} · 暂无数据` : `${day.date} · ${day.count} 次贡献`;
					cell.setAttribute("aria-label", cell.title);
					if (grid === monthGrid) cell.textContent = String(Number(day.date.slice(8)));
					if (day.isOutsideRange) cell.dataset.outside = "true";
					grid.append(cell);
				}
			};
			const renderYear = async () => {
				const year = yearSelect.value;
				if (renderedYear === year) return;
				const requestId = ++yearRequestId;
				renderedYear = "";
				yearSummary.textContent = `${year} 年 · 加载中…`;
				yearGrid.replaceChildren();
				yearMonths.replaceChildren();
				popover.setAttribute("aria-busy", "true");
				const data = await loadGithubYear(year);
				if (controller.signal.aborted || requestId !== yearRequestId) return;
				popover.setAttribute("aria-busy", "false");
				if (!data?.available) {
					yearSummary.textContent = `${year} 年数据暂不可用，请稍后重新打开`;
					return;
				}
				renderedYear = year;
				const weeks = String(Math.ceil(data.days.length / 7));
				yearGrid.style.setProperty("--github-weeks", weeks);
				yearMonths.style.setProperty("--github-weeks", weeks);
				appendDays(yearGrid, data.days);
				data.days.forEach((day, index) => {
					if (!day.date.startsWith(year) || day.date.slice(8) !== "01") return;
					const label = document.createElement("span");
					label.textContent = `${Number(day.date.slice(5, 7))}月`;
					label.style.gridColumn = String(Math.floor(index / 7) + 1);
					yearMonths.append(label);
				});
				yearSummary.textContent = `${year} 年 · ${data.total} 次贡献`;
				positionPopover();
			};
			const openPopover = (fix = false) => {
				if (activity.dataset.profileActivity !== "github" || !github?.available) return;
				window.clearTimeout(closeTimer);
				if (fix) {
					pinned = true;
					popover.dataset.pinned = "true";
					card.closest<HTMLElement>(".navbar-brand-shell")!.dataset.profileOpen = "true";
				}
				yearSelect.disabled = !pinned;
				pinHint.textContent = pinned ? "已固定 · 可选择年份 · Esc 关闭" : "单击固定后可选择年份";
				if (!popover.matches(":popover-open")) popover.showPopover();
				yearButton.setAttribute("aria-expanded", "true");
				monthGrid.setAttribute("aria-expanded", "true");
				positionPopover();
				void renderYear();
				syncRotation();
			};
			const schedulePopoverClose = () => {
				window.clearTimeout(closeTimer);
				closeTimer = window.setTimeout(() => {
					if (!pinned && !githubPane.matches(":hover") && !popover.matches(":hover") && !popover.contains(document.activeElement)) {
						closePopover();
						syncRotation();
					}
				}, 150);
			};
			const renderGithub = () => {
				monthGrid.replaceChildren();
				if (!github?.available) {
					summary.textContent = "GitHub 活动暂不可用";
					yearButton.disabled = true;
					return;
				}
				const currentDays = getGithubMonthDays(github, dateKey);
				const monthTotal = currentDays.reduce((sum, day) => sum + (day.isOutsideRange ? 0 : day.count), 0);
				appendDays(monthGrid, currentDays);
				summary.textContent = `${Number(dateKey.slice(5, 7))}月 · ${monthTotal} 次贡献`;
				if (githubPane.matches(":hover")) openPopover();
			};
			const setActivity = (view: "articles" | "github") => {
				activity.dataset.profileActivity = view;
				for (const pane of panes) pane.inert = pane.dataset.profilePane !== view;
				this.querySelector("[data-profile-year]")!.textContent = view === "articles" ? `${dateKey.slice(0, 4)} · 文章活动` : `${dateKey.slice(0, 7).replace("-", ".")} · GitHub 活动`;
				toggle.setAttribute("aria-label", view === "articles" ? "切换到 GitHub 活动" : "切换到文章活动");
				activity.querySelector<HTMLElement>("[data-profile-archive-link]")!.hidden = view !== "articles";
				activity.querySelector<HTMLElement>("[data-profile-github-link]")!.hidden = view !== "github";
				if (view === "articles") closePopover();
			};
			const syncRotation = () => {
				window.clearTimeout(rotationTimer);
				const open = card.getAttribute("aria-hidden") === "false" || getComputedStyle(card).visibility === "visible";
				if (!open) closePopover();
				if (open && !githubLoaded) {
					githubLoaded = true;
					void loadGithubActivity().then((data) => {
						if (controller.signal.aborted) return;
						github = data;
						renderGithub();
					});
				}
				if (!open || document.hidden || hovered || popover.matches(":popover-open") || activity.querySelector(":focus-visible") || !postPane.hidden || motion.matches) return;
				rotationTimer = window.setTimeout(() => {
					if (getComputedStyle(card).visibility === "visible" && !document.hidden) setActivity(activity.dataset.profileActivity === "articles" ? "github" : "articles");
					syncRotation();
				}, 3_000);
			};
			toggle.addEventListener("click", () => {
				closePosts();
				setActivity(activity.dataset.profileActivity === "articles" ? "github" : "articles");
				syncRotation();
			}, { signal: controller.signal });
			yearButton.addEventListener("click", () => { openPopover(true); yearSelect.focus(); }, { signal: controller.signal });
			monthGrid.addEventListener("click", () => { openPopover(true); popover.focus(); }, { signal: controller.signal });
			monthGrid.addEventListener("keydown", (event) => {
				if (event.key !== "Enter" && event.key !== " ") return;
				event.preventDefault(); openPopover(true); popover.focus();
			}, { signal: controller.signal });
			githubPane.addEventListener("pointerenter", (event) => {
				if (event.pointerType === "mouse" || event.pointerType === "pen") openPopover();
			}, { signal: controller.signal });
			githubPane.addEventListener("pointerleave", schedulePopoverClose, { signal: controller.signal });
			popover.addEventListener("pointerenter", () => window.clearTimeout(closeTimer), { signal: controller.signal });
			popover.addEventListener("pointerleave", schedulePopoverClose, { signal: controller.signal });
			popover.addEventListener("click", (event) => {
				if (!(event.target as Element).closest("[data-profile-github-close]")) openPopover(true);
			}, { signal: controller.signal });
			popover.querySelector("[data-profile-github-close]")!.addEventListener("click", () => { closePopover(); yearButton.focus(); syncRotation(); }, { signal: controller.signal });
			yearSelect.addEventListener("change", () => { void renderYear(); }, { signal: controller.signal });
			document.addEventListener("keydown", (event) => {
				if (event.key !== "Escape" || !popover.matches(":popover-open")) return;
				event.preventDefault(); event.stopImmediatePropagation(); closePopover(); yearButton.focus(); syncRotation();
			}, { signal: controller.signal, capture: true });
			document.addEventListener("pointerdown", (event) => {
				if (popover.matches(":popover-open") && !popover.contains(event.target as Node) && !githubPane.contains(event.target as Node)) { closePopover(); syncRotation(); }
			}, { signal: controller.signal });
			window.addEventListener("resize", positionPopover, { signal: controller.signal });
			window.addEventListener("scroll", positionPopover, { signal: controller.signal, capture: true });
			activity.addEventListener("pointerenter", (event) => {
				if (event.pointerType !== "mouse" && event.pointerType !== "pen") return;
				hovered = true;
				syncRotation();
			}, { signal: controller.signal });
			activity.addEventListener("pointerleave", () => {
				hovered = false;
				syncRotation();
			}, { signal: controller.signal });
			activity.addEventListener("focusin", syncRotation, { signal: controller.signal });
			activity.addEventListener("focusout", (event) => {
				if (activity.contains(event.relatedTarget as Node | null)) return;
				schedulePopoverClose();
				syncRotation();
			}, { signal: controller.signal });
			const observer = new MutationObserver(syncRotation);
			observer.observe(card, { attributes: true, attributeFilter: ["aria-hidden"] });
			motion.addEventListener("change", syncRotation, { signal: controller.signal });
			const closePosts = () => {
				calendar.hidden = false;
				postPane.hidden = true;
				cells.forEach((cell) => cell.setAttribute("aria-pressed", "false"));
			};
			const update = () => {
				const now = new Date();
				const today = profileDateKey(now, this.dataset.timezone!);
				if (dateKey === today) return;
				dateKey = today;
				groups = new Map();
				for (const post of posts) {
					if (post.date.slice(0, 4) !== today.slice(0, 4) || post.date > today) continue;
					const [, month, day] = post.date.split("-").map(Number);
					const key = `${month}-${Math.min(3, Math.floor((day - 1) / 7))}`;
					groups.set(key, [...(groups.get(key) || []), post]);
				}
				setActivity(activity.dataset.profileActivity === "github" ? "github" : "articles");
				if (github) renderGithub();
				cells.forEach((cell) => {
					const count = groups.get(cell.dataset.profileCell!)?.length || 0;
					cell.dataset.level = String(Math.min(4, count));
					const [month, week] = cell.dataset.profileCell!.split("-").map(Number);
					const lastDay = new Date(Date.UTC(Number(today.slice(0, 4)), month, 0)).getUTCDate();
					const label = `${month}月 ${week * 7 + 1}–${week === 3 ? lastDay : week * 7 + 7}日，${count} 篇文章`;
					cell.title = label;
					cell.setAttribute("aria-label", label);
				});
				const countdowns = getProfileCountdowns(now, this.dataset.timezone!, this.dataset.siteStart!);
				for (const kind of ["week", "month", "year"] as const) {
					this.querySelector(`[data-profile-days="${kind}"]`)!.textContent = `${countdowns[kind]}天`;
				}
				for (const kind of ["holiday", "anniversary"] as const) {
					const event = countdowns[kind];
					const node = this.querySelector(`[data-profile-event="${kind}"]`)!;
					node.querySelector("[data-event-name]")!.textContent = event.name;
					const time = node.querySelector("time")!;
					time.textContent = `${Number(event.date.slice(5, 7))}月${Number(event.date.slice(8))}日`;
					time.dateTime = event.date;
					node.querySelector("[data-event-days]")!.textContent = `${event.days}天`;
					node.querySelector("progress")!.value = event.progress;
				}
				closePosts();
			};
			cells.forEach((cell) => cell.addEventListener("click", () => {
				const wasSelected = cell.getAttribute("aria-pressed") === "true";
				closePosts();
				if (wasSelected) { syncRotation(); return; }
				cell.setAttribute("aria-pressed", "true");
				calendar.hidden = true;
				postPane.hidden = false;
				syncRotation();
				this.querySelector("[data-profile-posts-title]")!.textContent = cell.title.split("，")[0];
				postList.replaceChildren();
				const matches = groups.get(cell.dataset.profileCell!) || [];
				if (!matches.length) postList.textContent = "这段时间还没有文章。";
				for (const post of matches) {
					const link = document.createElement("a");
					link.href = post.href;
					link.textContent = post.title;
					postList.append(link);
				}
			}, { signal: controller.signal }));
			this.querySelector("[data-profile-back]")!.addEventListener("click", () => {
				const selected = cells.find((cell) => cell.getAttribute("aria-pressed") === "true");
				closePosts();
				selected?.focus();
				syncRotation();
			}, { signal: controller.signal });
			document.addEventListener("visibilitychange", () => { update(); syncRotation(); }, { signal: controller.signal });
			const timer = window.setInterval(update, 60_000);
			update();
			syncRotation();
			this.cleanup = () => { closePopover(); controller.abort(); observer.disconnect(); window.clearInterval(timer); window.clearTimeout(rotationTimer); };
		}
		disconnectedCallback() { this.cleanup?.(); }
	}
	if (!customElements.get("navbar-profile-overview")) customElements.define("navbar-profile-overview", NavbarProfileOverview);
</script>
