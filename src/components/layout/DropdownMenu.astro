---
import { Icon } from "astro-icon/components";
import type { NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	link: NavBarLink;
	index: number;
	class?: string;
	isActive?: boolean;
}

const { link, index, class: className, isActive = false } = Astro.props;

if (!link) {
	return null;
}

const hasChildren = Boolean(link.children?.length);
---

<div
	class:list={["dropdown-container", { "is-active": isActive }, className]}
	data-dropdown
	data-dropdown-index={index}
>
	{hasChildren ? (
		<button
			type="button"
			class:list={["navbar-menu-item dropdown-trigger", { "is-active": isActive }]}
			aria-current={isActive ? "page" : undefined}
			aria-expanded="false"
			aria-haspopup="true"
			aria-controls={`navbar-dropdown-page-${index}`}
			data-dropdown-trigger
		>
			<span class="navbar-menu-item__layer navbar-menu-item__layer--base">
				<span class="navbar-menu-item__content">
					{link.icon && <Icon is:inline name={link.icon} class="text-[1.1rem] mr-1.5 navbar-icon" />}
					{link.name}
				</span>
				{!link.hideDropdownArrow && (
					<Icon is:inline name="material-symbols:keyboard-arrow-down-rounded" class="text-[1.2rem] transition-transform duration-200 dropdown-arrow ml-1" />
				)}
			</span>
			<span class="navbar-menu-item__layer navbar-menu-item__layer--inverse" aria-hidden="true">
				<span class="navbar-menu-item__content">
					{link.icon && <Icon is:inline name={link.icon} class="text-[1.1rem] mr-1.5 navbar-icon" />}
					{link.name}
				</span>
				{!link.hideDropdownArrow && (
					<Icon is:inline name="material-symbols:keyboard-arrow-down-rounded" class="text-[1.2rem] transition-transform duration-200 dropdown-arrow ml-1" />
				)}
			</span>
		</button>
	) : (
		<a
			aria-label={link.name}
			aria-current={isActive ? "page" : undefined}
			href={link.external ? link.url : url(link.url)}
			target={link.external ? "_blank" : undefined}
			class:list={["navbar-menu-item", { "is-active": isActive }]}
		>
			<span class="navbar-menu-item__layer navbar-menu-item__layer--base">
				<span class="navbar-menu-item__content">
					{link.icon && <Icon is:inline name={link.icon} class="text-[1.1rem] mr-1.5 navbar-icon" />}
					{link.name}
					{link.external && <Icon is:inline name="fa7-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-px ml-1 text-black/20 dark:text-white/20" />}
				</span>
			</span>
			<span class="navbar-menu-item__layer navbar-menu-item__layer--inverse" aria-hidden="true">
				<span class="navbar-menu-item__content">
					{link.icon && <Icon is:inline name={link.icon} class="text-[1.1rem] mr-1.5 navbar-icon" />}
					{link.name}
					{link.external && <Icon is:inline name="fa7-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-px ml-1" />}
				</span>
			</span>
		</a>
	)}
</div>
