---
import { Icon } from "astro-icon/components";
import { musicPlayerConfig } from "@/config/musicConfig";
import type { NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	links: NavBarLink[];
}

const processedLinks = Astro.props.links;
---
<div id="nav-menu-panel" class:list={["float-panel float-panel-closed transition-all fixed right-4 max-h-[80vh] overflow-y-auto jingyue-mobile-nav"]} role="navigation" aria-label="站点导航" aria-hidden="true" inert>
	<header class="jingyue-mobile-nav-heading">
		<span>JINGYUE</span>
		<small>探索我的个人空间</small>
		<button type="button" data-mobile-menu-close aria-label="关闭导航菜单"><Icon is:inline name="material-symbols:close-rounded" /></button>
	</header>
	<div class="mobile-menu-tools" role="group" aria-label="常用功能">
		<button type="button" data-mobile-menu-action="theme"><Icon is:inline name="material-symbols:dark-mode-outline-rounded" /><span>切换主题</span></button>
		{musicPlayerConfig.showInNavbar && <button type="button" data-mobile-menu-action="music"><Icon is:inline name="material-symbols:music-note-rounded" /><span>音乐</span></button>}
		<button type="button" data-mobile-menu-action="toc" hidden><Icon is:inline name="material-symbols:format-list-bulleted-rounded" /><span>阅读目录</span></button>
	</div>
    {processedLinks.map((link, index) => (
        <div class="mobile-menu-item">
            {link.children && link.children.length > 0 ? (
                /* 有子菜单的项目 */
                <div class="mobile-dropdown" data-mobile-dropdown>
                    <button
						type="button"
						class="group jingyue-mobile-trigger"
                        data-mobile-dropdown-trigger
                        aria-expanded="false"
                        aria-controls={`mobile-submenu-${index}`}
                    >
						<div class="jingyue-mobile-label">
							{link.icon && <Icon is:inline name={link.icon} class="jingyue-mobile-icon" />}
                            {link.name}
                        </div>
                        <Icon is:inline name="material-symbols:keyboard-arrow-down-rounded"
							  class="mobile-dropdown-arrow jingyue-mobile-arrow"
                        />
                    </button>
                    <div id={`mobile-submenu-${index}`} class="mobile-submenu" data-mobile-submenu inert>
                        {link.children.map((child) => (
                            <a href={child.external ? child.url : url(child.url)}
							   class="group jingyue-mobile-child"
                               target={child.external ? "_blank" : null}
                            >
								<div class="jingyue-mobile-label">
									{child.icon && <Icon is:inline name={child.icon} class="jingyue-mobile-icon" />}
                                    {child.name}
                                </div>
                                {child.external && <Icon is:inline name="fa7-solid:arrow-up-right-from-square"
                                      class="transition text-[0.75rem] text-black/25 dark:text-white/25 -translate-x-1"
                                />}
                            </a>
                        ))}
                    </div>
                </div>
            ) : (
                /* 普通链接项目 */
				<a href={link.external ? link.url : url(link.url)} class="group jingyue-mobile-trigger"
                   target={link.external ? "_blank" : null}
                >
					<div class="jingyue-mobile-label">
						{link.icon && <Icon is:inline name={link.icon} class="jingyue-mobile-icon" />}
                        {link.name}
                    </div>
					{!link.external && <Icon is:inline name="material-symbols:chevron-right-rounded"
						  class="transition text-[1.25rem] jingyue-mobile-arrow"
                    />}
					{link.external && <Icon is:inline name="fa7-solid:arrow-up-right-from-square"
                          class="transition text-[0.75rem] text-black/25 dark:text-white/25 -translate-x-1"
                    />}
                </a>
            )}
        </div>
    ))}
</div>

<style>
    @reference "../../styles/main.css";

    .mobile-submenu {
        @apply max-h-0 overflow-hidden transition-all duration-300 ease-in-out;
    }

    .mobile-dropdown[data-expanded="true"] .mobile-submenu {
        @apply max-h-96;
    }

    .mobile-dropdown[data-expanded="true"] .mobile-dropdown-arrow {
        @apply rotate-180;
    }

	.jingyue-mobile-nav {
		width: min(22rem, calc(100vw - 2rem));
		border: 1px solid color-mix(in oklch, var(--primary) 20%, rgba(255, 255, 255, 0.68));
		border-radius: 1.2rem;
		background: color-mix(in oklch, var(--card-bg) 88%, transparent);
		box-shadow: 0 1.5rem 4rem rgba(18, 31, 46, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.55);
		padding: 0.7rem;
		backdrop-filter: blur(1.4rem) saturate(145%);
	}

	@media (max-width: 640px) {
		.jingyue-mobile-nav {
			right: 0.65rem !important;
			width: min(18rem, calc(100vw - 1.3rem));
			max-height: calc(100dvh - 5.25rem);
			border-radius: 1.15rem;
			padding: 0.8rem;
		}

		.jingyue-mobile-trigger,
		.jingyue-mobile-child {
			min-height: 2.875rem;
		}
	}

	.jingyue-mobile-nav-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin: 0.15rem 0.15rem 0.55rem;
		border-bottom: 1px solid color-mix(in oklch, var(--primary) 18%, transparent);
		padding: 0.55rem 0.65rem 0.75rem;
	}

	.jingyue-mobile-nav-heading span {
		color: color-mix(in oklch, var(--primary) 72%, var(--deep-text, currentColor));
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.2em;
	}

	.jingyue-mobile-nav-heading small {
		color: color-mix(in oklch, var(--deep-text, currentColor) 52%, transparent);
		font-size: 0.62rem;
	}

	.jingyue-mobile-trigger,
	.jingyue-mobile-child {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		min-height: 2.75rem;
		border: 1px solid transparent;
		border-radius: 0.82rem;
		background: transparent;
		padding: 0.58rem 0.72rem;
		color: color-mix(in oklch, var(--deep-text, currentColor) 78%, transparent);
		font-size: 0.84rem;
		font-weight: 760;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
		transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease;
	}

	.jingyue-mobile-child {
		min-height: 2.5rem;
		margin-top: 0.14rem;
		padding-left: 1.55rem;
		color: color-mix(in oklch, var(--deep-text, currentColor) 64%, transparent);
		font-size: 0.78rem;
		font-weight: 650;
	}

	.jingyue-mobile-trigger:hover,
	.jingyue-mobile-trigger:focus-visible,
	.jingyue-mobile-child:hover,
	.jingyue-mobile-child:focus-visible {
		border-color: var(--ui-icon-border);
		background: var(--ui-icon-soft-bg);
		color: var(--ui-icon-color);
		outline: none;
	}

	.jingyue-mobile-trigger:focus-visible,
	.jingyue-mobile-child:focus-visible {
		box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary) 28%, transparent);
	}

	.jingyue-mobile-label {
		display: inline-flex;
		align-items: center;
		gap: 0.58rem;
	}

	:global(.jingyue-mobile-icon),
	:global(.jingyue-mobile-arrow) {
		width: 1.08rem;
		height: 1.08rem;
		color: var(--ui-icon-color);
	}

	:global(.jingyue-mobile-arrow) {
		transition: transform 180ms ease;
	}

	:global(html.dark) .jingyue-mobile-nav {
		border-color: color-mix(in oklch, var(--primary) 24%, rgba(255, 255, 255, 0.12));
		background: color-mix(in oklch, var(--card-bg) 90%, rgba(10, 17, 27, 0.28));
		box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-submenu,
		.jingyue-mobile-trigger,
		.jingyue-mobile-child,
		:global(.jingyue-mobile-arrow) {
			transition: none !important;
		}
	}
	.jingyue-mobile-nav-heading button { display: grid; place-items: center; flex-shrink: 0; width: 2.75rem; height: 2.75rem; border-radius: .7rem; cursor: pointer; color: var(--content-meta); }
	.jingyue-mobile-nav-heading button svg { width: 1.3rem; height: 1.3rem; }
	.mobile-menu-tools { display: none; }
	@media (max-width: 767.98px) {
		#nav-menu-panel {
			top: auto !important; bottom: calc(5.4rem + env(safe-area-inset-bottom, 0px));
			left: max(.75rem, env(safe-area-inset-left, 0px)); right: max(.75rem, env(safe-area-inset-right, 0px)) !important;
			width: auto; max-width: 30rem; margin-inline: auto; max-height: min(70dvh, calc(100dvh - 7rem));
			padding: .65rem; border: 1px solid var(--line-divider); border-radius: 1.4rem;
			background: var(--card-bg); z-index: 1050; overscroll-behavior: contain;
			transform-origin: bottom center; transition: opacity 180ms, transform 260ms cubic-bezier(.22, 1, .36, 1), visibility 260ms;
		}
		#nav-menu-panel.float-panel-closed { transform: translateY(.8rem) scale(.98); visibility: hidden; }
		.jingyue-mobile-nav-heading { align-items: center; gap: .35rem; padding: .2rem .5rem .5rem; }
		.jingyue-mobile-nav-heading small { margin-left: auto; }
		.mobile-menu-tools { display: flex; gap: .35rem; margin-bottom: .45rem; }
		.mobile-menu-tools button { display: flex; flex: 1; align-items: center; justify-content: center; gap: .35rem; min-height: 2.75rem; border-radius: .7rem; background: var(--btn-card-bg); color: var(--content-meta); font-size: .75rem; cursor: pointer; }
		.mobile-menu-tools button[hidden] { display: none; }
		.mobile-menu-tools svg { width: 1.1rem; height: 1.1rem; }
		.jingyue-mobile-trigger, .jingyue-mobile-child { min-height: 2.875rem; font-size: .88rem; }
		.jingyue-mobile-trigger[aria-current=page], .jingyue-mobile-child[aria-current=page] { background: var(--btn-card-bg); color: var(--content-meta); box-shadow: inset 3px 0 currentColor; }
	}
</style>

<script>
	const panel = document.getElementById("nav-menu-panel");
	if (panel && !panel.dataset.bound) {
		panel.dataset.bound = "true";
		let opener: HTMLElement | null = null;
		const setOpen = (open: boolean, restoreFocus = false) => {
			panel.classList.toggle("float-panel-closed", !open);
			panel.inert = !open;
			panel.setAttribute("aria-hidden", String(!open));
			for (const id of ["nav-menu-switch", "mobile-dock-menu"]) document.getElementById(id)?.setAttribute("aria-expanded", String(open));
			if (restoreFocus) opener?.focus({ preventScroll: true });
		};
		const toggle = () => {
			const open = panel.classList.contains("float-panel-closed");
			if (open) {
				opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
				window.dispatchEvent(new CustomEvent("jingyue:floating-panel-open", { detail: { panel: "mobile-navigation" } }));
			}
			setOpen(open);
		};
		const syncPage = () => {
			setOpen(false);
			panel.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
				if (link.origin === location.origin && link.pathname === location.pathname) link.setAttribute("aria-current", "page");
				else link.removeAttribute("aria-current");
			});
			panel.querySelector<HTMLElement>("[data-mobile-menu-action=toc]")?.toggleAttribute("hidden", !document.querySelector("[data-article-toc-mobile-trigger]"));
		};
		document.getElementById("nav-menu-switch")?.addEventListener("click", (event) => { event.stopPropagation(); toggle(); });
		window.addEventListener("jingyue:toggle-mobile-navigation", toggle);
		panel.addEventListener("click", (event) => {
			if (!(event.target instanceof Element)) return;
			const trigger = event.target.closest<HTMLButtonElement>("[data-mobile-dropdown-trigger]");
			if (trigger) {
				const selected = trigger.closest<HTMLElement>("[data-mobile-dropdown]");
				const expanded = selected?.dataset.expanded !== "true";
				panel.querySelectorAll<HTMLElement>("[data-mobile-dropdown]").forEach((dropdown) => {
					const open = dropdown === selected && expanded;
					dropdown.dataset.expanded = String(open);
					dropdown.querySelector("button")?.setAttribute("aria-expanded", String(open));
					dropdown.querySelector<HTMLElement>("[data-mobile-submenu]")?.toggleAttribute("inert", !open);
				});
			}
			if (event.target.closest("[data-mobile-menu-close]")) setOpen(false, true);
			if (event.target.closest("a")) setOpen(false);
			const action = event.target.closest<HTMLElement>("[data-mobile-menu-action]")?.dataset.mobileMenuAction;
			if (!action) return;
			event.stopPropagation();
			setOpen(false);
			if (action === "theme") window.dispatchEvent(new Event("firefly:toggle-theme"));
			if (action === "music") window.dispatchEvent(new Event("jingyue:toggle-music-mini"));
			if (action === "toc") document.querySelector<HTMLButtonElement>("[data-article-toc-mobile-trigger]")?.click();
		});
		document.addEventListener("click", (event) => {
			if (event.target instanceof Element && !panel.contains(event.target) && !event.target.closest("#nav-menu-switch, #mobile-dock-menu")) setOpen(false);
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && !panel.inert) { event.preventDefault(); setOpen(false, true); }
		});
		window.addEventListener("jingyue:floating-panel-open", (event) => {
			if ((event as CustomEvent<{ panel: string }>).detail.panel !== "mobile-navigation") setOpen(false);
		});
		window.addEventListener("firefly:open-search", () => setOpen(false));
		document.addEventListener("swup:contentReplaced", syncPage);
		document.addEventListener("astro:page-load", syncPage);
		syncPage();
	}
</script>
