    <img src="/pio/models/pets/feibi/loader-feibi-unified.webp" alt="菲比啾比" loading="lazy" decoding="async" />
    <img src="/pio/models/pets/doro/loader-duro-cute-v2.webp" alt="Duro" loading="lazy" decoding="async" />
    <img src="/pio/models/pets/gugugaga/loader-gugugaga-unified.webp" alt="咕咕嘎嘎" loading="lazy" decoding="async" />
    <img src="/pio/models/pets/deepseek/loader-deepseek-whale-girl.webp" alt="鲸鱼娘" loading="lazy" decoding="async" />
    <Image src={taffyMascot} alt="永雏塔菲" width={256} height={256} format="webp" loading="lazy" decoding="async" />
    <Image src={mamboMascot} alt="待兼诗歌剧（曼波）" width={256} height={256} format="webp" loading="lazy" decoding="async" />
    <Image src={roxyMascot} alt="洛琪希" width={256} height={256} format="webp" loading="lazy" decoding="async" />
    <Image src={azusaMascot} alt="阿梓从小就很可爱" width={256} height={256} format="webp" loading="lazy" decoding="async" />
    <Image src={cheeseMascot} alt="雪糕cheese" width={256} height={256} format="webp" loading="lazy" decoding="async" />
    <Image src={creamMascot} alt="奶油-cream-" width={256} height={256} format="webp" loading="lazy" decoding="async" />
    <Image src={luluMascot} alt="雫るる_Official" width={256} height={256} format="webp" loading="lazy" decoding="async" />
  </div>
  <div class="site-footer-content">
  <div class="site-footer-primary">
    <section class="site-footer-brand" aria-label="JingYue 的签名">
