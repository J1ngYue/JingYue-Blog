      <div class="site-footer-socials">
        {contacts.map((contact) => (
          <a href={contact.url} target={contact.url.startsWith("mailto:") ? undefined : "_blank"} rel="noopener noreferrer" aria-label={contact.name === "qq" ? "QQ" : contact.name === "Email" ? "邮箱" : contact.name} title={contact.name === "qq" ? "QQ" : contact.name === "Email" ? "邮箱" : contact.name}>
            <Icon name={contact.icon} aria-hidden="true" />
            <span>{contact.name === "qq" ? "QQ" : contact.name === "Email" ? "邮箱" : contact.name}</span>
            {contactDescriptions[contact.name] && <small>{contactDescriptions[contact.name]}</small>}
