---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import fallbackCover from "@/assets/images/cover.avif";
import CoverImage from "@/components/common/CoverImage.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { getFileDirFromPath, getPostUrlBySlug } from "@/utils/url-utils";

const posts = (await getSortedPosts()).filter(
	(entry) => entry.data.draft !== true,
);
const categoryPosts = new Map<string, typeof posts>();
for (const entry of posts) {
	const category = entry.data.category || "未分类";
	const entries = categoryPosts.get(category) || [];
	entries.push(entry);
	categoryPosts.set(category, entries);
}
const categories = Array.from(categoryPosts, ([name, entries]) => ({
	name,
	count: entries.length,
	posts: entries,
})).sort((a, b) => a.name.localeCompare(b.name, "zh-CN"));

const categoryIcon = (name: string) => {
	if (name.includes("指南")) return "material-symbols:menu-book-rounded";
	if (name.toLowerCase().includes("code"))
		return "material-symbols:code-rounded";
	return "material-symbols:folder-rounded";
};

const formatCardDate = (date: Date) =>
	new Intl.DateTimeFormat("en-CA", {
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	})
		.format(date)
		.replaceAll("-", "/");
---

<div class="article-index" data-article-index data-view="grid">
	<aside class="article-index__sidebar article-index__sidebar-left" aria-label="文章分类">
		<div class="article-index__side-card article-index__side-card--tree">
			<button type="button" class="article-index__all-filter is-active" data-article-filter="">
				<i aria-hidden="true"></i>
				<span>全部文章</span>
				<small>{posts.length}</small>
			</button>
			<nav class="article-index__category-tree">
				{categories.map((category, categoryIndex) => (
					<details class="article-index__category" open={categoryIndex === 0}>
						<summary data-article-filter={category.name}>
							<Icon is:inline name={categoryIcon(category.name)} />
							<span>{category.name}</span>
							<small>{category.count}</small>
						</summary>
						<div class="article-index__article-tree">
							{category.posts.map((entry) => (
								<a href={getPostUrlBySlug(entry.id)} title={entry.data.title}>
									<Icon is:inline name="material-symbols:description-outline-rounded" />
									<span>{entry.data.title}</span>
									<time datetime={entry.data.published.toISOString()}>
										{new Intl.DateTimeFormat("en-CA").format(entry.data.published)}
									</time>
								</a>
							))}
						</div>
					</details>
				))}
			</nav>
		</div>
	</aside>

	<main class="article-index__main">
		<header class="article-index__header">
			<div>
				<p>ARTICLE INDEX</p>
				<h1>文章列表</h1>
				<label
					class="article-index__view-switch"
					aria-label="切换文章卡片或列表视图"
					title="切换为列表视图"
				>
					<input
						type="checkbox"
						data-article-view
						aria-label="使用卡片文章布局"
						checked
					/>
					<span class="article-index__skull" aria-hidden="true">
						<span class="article-index__cranium"></span>
						<span class="article-index__mouth"></span>
					</span>
					<span class="article-index__arm-wrapper" aria-hidden="true">
						<span class="article-index__arm">
							<span class="article-index__bone"></span>
							<span class="article-index__bone"></span>
							<span class="article-index__hand">
								<span class="article-index__bone"></span>
								<span class="article-index__bone"></span>
								<span class="article-index__bone"></span>
								<span class="article-index__bone"></span>
							</span>
							<span class="article-index__big-bone"></span>
						</span>
					</span>
				</label>
			</div>
			<nav aria-label="文章快捷入口">
				<a href="/categories/">
					<Icon is:inline name="material-symbols:folder-open-rounded" />
					分类
				</a>
				<a href="/archive/">
					<Icon is:inline name="material-symbols:archive-rounded" />
					归档
				</a>
			</nav>
		</header>

		<div class="article-index__mobile-filter" aria-label="移动端文章分类">
			<button type="button" class="is-active" data-article-filter="">全部 {posts.length}</button>
			{categories.map((category) => (
				<button type="button" data-article-filter={category.name}>
					{category.name} {category.count}
				</button>
			))}
		</div>

		<p class="article-index__result" aria-live="polite">
			正在显示 <strong data-article-visible-count>{posts.length}</strong> 篇文章
		</p>

		<section class="article-index__grid" aria-label="文章列表">
			{posts.map((entry, index) => {
				const processedImage = processCoverImageSync(entry.data.image, entry.id);
				const apiUrls = getApiUrlList(entry.data.image, entry.id);
				const hasCover = Boolean(processedImage);
				const category = entry.data.category || "未分类";
				const shownTags = entry.data.tags.slice(0, 2);
				const remainingTags = Math.max(0, entry.data.tags.length - shownTags.length);
				return (
					<article
						class:list={[
							"article-index__card",
							{ "is-pinned": entry.data.pinned },
						]}
						data-article-card
						data-category={category}
						style={`--article-delay: ${Math.min(index, 8) * 45}ms`}
					>
						<a class="article-index__card-link" href={getPostUrlBySlug(entry.id)} aria-label={`阅读 ${entry.data.title}`}>
							<div class="article-index__cover" aria-hidden="true">
								{hasCover ? (
									<CoverImage
										src={processedImage}
										basePath={getFileDirFromPath(entry.filePath || "")}
										alt=""
										class="article-index__cover-image"
										preview
										loading={index < 3 ? "eager" : "lazy"}
										apiUrls={apiUrls}
									/>
								) : (
									<Picture
										src={fallbackCover}
										alt=""
										formats={["webp"]}
										fallbackFormat="webp"
										loading={index < 3 ? "eager" : "lazy"}
										width={480}
										height={300}
									/>
								)}
								<span aria-hidden="true"></span>
							</div>
							<div class="article-index__card-body">
								<div class="article-index__card-heading">
									{entry.data.pinned && (
										<span class="article-index__pinned" aria-label="置顶文章">
											<Icon is:inline name="material-symbols:keep-rounded" />
											置顶
										</span>
									)}
									<h2>{entry.data.title}</h2>
								</div>
								<div class="article-index__meta">
									<strong>#{category}</strong>
									<span class="article-index__date">
										<Icon is:inline name="material-symbols:calendar-month-rounded" />
										<time datetime={entry.data.published.toISOString()}>{formatCardDate(entry.data.published)}</time>
									</span>
									{shownTags.map((tag) => <span>{tag}</span>)}
									{remainingTags > 0 && <small>+{remainingTags}</small>}
								</div>
								{entry.data.description && (
									<p class="article-index__description">{entry.data.description}</p>
								)}
							</div>
						</a>
					</article>
				);
			})}
		</section>

		<div class="article-index__empty" data-article-empty hidden>
			<Icon is:inline name="material-symbols:inventory-2-outline-rounded" />
			<strong>这个分类暂时没有文章</strong>
		</div>
	</main>

	<aside class="article-index__sidebar article-index__sidebar-right" aria-label="页面目录">
		<div class="article-index__side-card">
			<h2><i aria-hidden="true"></i>目录</h2>
			<p>当前页面没有目录</p>
		</div>
	</aside>
</div>

<script>
	function initArticleIndex() {
		const root = document.querySelector<HTMLElement>("[data-article-index]");
		if (!root || root.dataset.bound === "true") return;
		root.dataset.bound = "true";

		const buttons = Array.from(
			root.querySelectorAll<HTMLElement>("[data-article-filter]"),
		);
		const cards = Array.from(
			root.querySelectorAll<HTMLElement>("[data-article-card]"),
		);
		const count = root.querySelector<HTMLElement>("[data-article-visible-count]");
		const empty = root.querySelector<HTMLElement>("[data-article-empty]");
		const viewInput = root.querySelector<HTMLInputElement>("[data-article-view]");
		const viewSwitch = viewInput?.closest<HTMLElement>(
			".article-index__view-switch",
		);
		let switchAnimationTimer: number | undefined;
		const replayViewSwitchAnimation = () => {
			if (!viewSwitch) return;
			viewSwitch.classList.remove("is-switching");
			// Force a layout pass so the same CSS animation can be replayed reliably.
			void viewSwitch.offsetWidth;
			viewSwitch.classList.add("is-switching");
			if (switchAnimationTimer !== undefined) {
				window.clearTimeout(switchAnimationTimer);
			}
			switchAnimationTimer = window.setTimeout(() => {
				viewSwitch.classList.remove("is-switching");
				switchAnimationTimer = undefined;
			}, 1560);
		};
		const storedView = localStorage.getItem("jingyue-article-view");
		if (storedView === "list" || storedView === "grid") {
			root.dataset.view = storedView;
		}
		const syncViewSwitch = () => {
			const isList = root.dataset.view === "list";
			if (viewInput) viewInput.checked = !isList;
			viewSwitch?.setAttribute(
				"title",
				isList ? "切换为卡片视图" : "切换为列表视图",
			);
		};
		syncViewSwitch();
		viewInput?.addEventListener("change", () => {
			const nextView = viewInput.checked ? "grid" : "list";
			root.dataset.view = nextView;
			localStorage.setItem("jingyue-article-view", nextView);
			syncViewSwitch();
			replayViewSwitchAnimation();
		});
		viewSwitch?.addEventListener("pointerdown", () => {
			viewSwitch.classList.add("is-pointer-focus");
		});
		viewInput?.addEventListener("keydown", () => {
			viewSwitch?.classList.remove("is-pointer-focus");
		});
		viewInput?.addEventListener("blur", () => {
			viewSwitch?.classList.remove("is-pointer-focus");
		});

		const applyFilter = (category: string, updateUrl = true) => {
			let visible = 0;
			cards.forEach((card) => {
				const matches = !category || card.dataset.category === category;
				card.hidden = !matches;
				if (matches) visible += 1;
			});
			buttons.forEach((button) => {
				const active = (button.dataset.articleFilter || "") === category;
				button.classList.toggle("is-active", active);
				button.setAttribute("aria-pressed", String(active));
			});
			if (count) count.textContent = String(visible);
			if (empty) empty.hidden = visible > 0;

			if (updateUrl) {
				const url = new URL(window.location.href);
				if (category) url.searchParams.set("category", category);
				else url.searchParams.delete("category");
				history.replaceState(history.state, "", url);
			}
		};

		buttons.forEach((button) => {
			button.addEventListener("click", () =>
				applyFilter(button.dataset.articleFilter || ""),
			);
		});

		const requested = new URL(window.location.href).searchParams.get("category") || "";
		applyFilter(requested, false);
		if (requested) {
			const requestedFilter = buttons.find(
				(button) => button.dataset.articleFilter === requested,
			);
			const requestedGroup = requestedFilter?.closest("details");
			if (requestedGroup) requestedGroup.open = true;
		}
	}

	initArticleIndex();
	document.addEventListener("swup:contentReplaced", initArticleIndex);
</script>

<style>
	:global(#main-column-wrapper:has(.article-index)) {
		overflow: visible !important;
	}

	.article-index {
		--text-90: #11171a;
		--text-75: #354047;
		--text-50: #68757c;
		--text-30: #929da3;
		--card-bg: #fff;
		--line-divider: rgb(28 47 55 / 14%);
		display: grid;
		box-sizing: border-box;
		grid-template-columns: 17.5rem minmax(0, 1fr) 17.5rem;
		gap: 1rem;
		align-items: start;
		padding: 0.5rem 0 3rem;
		color: var(--text-75);
	}

	:global(html.dark) .article-index {
		--text-90: #f5f7f8;
		--text-75: #d4dadd;
		--text-50: #9ca7ad;
		--text-30: #748188;
		--card-bg: #171c20;
		--line-divider: rgb(226 237 241 / 14%);
	}

	:global(html.dark) .article-index__card {
		background: color-mix(in srgb, #171c20 86%, transparent);
	}

	.article-index__sidebar {
		position: sticky;
		top: 1rem;
	}

	.article-index__side-card {
		padding: 1.45rem 1.5rem;
		border: 1px solid color-mix(in srgb, var(--line-divider) 78%, transparent);
		border-radius: 0.7rem;
		background: color-mix(in srgb, var(--card-bg) 94%, transparent);
		box-shadow: 0 0.65rem 1.8rem rgb(17 31 38 / 6%);
	}

	.article-index__side-card--tree {
		max-height: calc(100vh - 2rem);
		overflow-y: auto;
		padding: 1.35rem 1.1rem 1.45rem;
		scrollbar-color: color-mix(in srgb, var(--text-90) 24%, transparent) transparent;
		scrollbar-width: thin;
	}

	.article-index__side-card--tree::-webkit-scrollbar {
		width: 0.3rem;
	}

	.article-index__side-card--tree::-webkit-scrollbar-thumb {
		border-radius: 99rem;
		background: color-mix(in srgb, var(--text-90) 24%, transparent);
	}

	.article-index__side-card h2 {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0 0 1rem;
		color: var(--text-90);
		font-size: 1.05rem;
		letter-spacing: 0;
	}

	.article-index__side-card h2 i {
		width: 0.2rem;
		height: 1.1rem;
		border-radius: 99rem;
		background: var(--text-90);
	}

	.article-index__all-filter {
		display: grid;
		grid-template-columns: 0.2rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.72rem;
		width: 100%;
		margin: 0 0 0.7rem;
		padding: 0.18rem 0.28rem 0.45rem;
		background: transparent;
		color: var(--text-90);
		font-size: 1.05rem;
		font-weight: 800;
		text-align: left;
		cursor: pointer;
	}

	.article-index__all-filter i {
		width: 0.2rem;
		height: 1.1rem;
		border-radius: 99rem;
		background: var(--text-90);
	}

	.article-index__all-filter small {
		display: none;
	}

	.article-index__category-tree {
		display: grid;
		gap: 0.16rem;
	}

	.article-index__category {
		min-width: 0;
	}

	.article-index__category summary {
		display: grid;
		grid-template-columns: 1.15rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.58rem;
		width: 100%;
		min-height: 2.25rem;
		padding: 0.38rem 0.34rem;
		border-radius: 0.52rem;
		background: transparent;
		color: var(--text-75);
		font-size: 0.82rem;
		font-weight: 700;
		text-align: left;
		cursor: pointer;
		transition: background-color 180ms ease, color 180ms ease;
		list-style: none;
	}

	.article-index__category summary::-webkit-details-marker {
		display: none;
	}

	.article-index__category summary::after {
		width: 0.42rem;
		height: 0.42rem;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		content: "";
		transform: rotate(45deg) translate(-0.08rem, -0.08rem);
		transition: transform 180ms ease;
	}

	.article-index__category[open] summary::after {
		transform: rotate(225deg) translate(-0.08rem, -0.08rem);
	}

	.article-index__category summary:hover,
	.article-index__category summary.is-active {
		background: color-mix(in srgb, var(--text-90) 8%, transparent);
		color: var(--text-90);
	}

	.article-index__category summary small {
		display: none;
	}

	.article-index__article-tree {
		position: relative;
		display: grid;
		gap: 0.08rem;
		margin: 0.08rem 0 0.45rem 0.7rem;
		padding-left: 0.58rem;
	}

	.article-index__article-tree::before {
		position: absolute;
		inset: 0.15rem auto 0.15rem 0;
		width: 1px;
		background: color-mix(in srgb, var(--text-90) 17%, transparent);
		content: "";
	}

	.article-index__article-tree a {
		display: grid;
		grid-template-columns: 0.95rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.42rem;
		min-height: 2.18rem;
		padding: 0.35rem 0.42rem 0.35rem 0.55rem;
		border-radius: 0.85rem;
		color: var(--text-50);
		font-size: 0.75rem;
		transition: background-color 160ms ease, color 160ms ease;
	}

	.article-index__article-tree a:hover,
	.article-index__article-tree a:focus-visible {
		background: color-mix(in srgb, var(--text-90) 10%, transparent);
		color: var(--text-90);
		outline: none;
	}

	.article-index__article-tree a svg,
	.article-index__category summary svg {
		width: 0.95rem;
		height: 0.95rem;
		flex: 0 0 auto;
	}

	.article-index__article-tree a span {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.article-index__article-tree time {
		color: var(--text-30);
		font-size: 0.62rem;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.article-index__all-filter:focus-visible,
	.article-index__category summary:focus-visible,
	.article-index__article-tree a:focus-visible,
	.article-index__mobile-filter button:focus-visible,
	.article-index__header a:focus-visible {
		outline: 0.14rem solid color-mix(in srgb, var(--primary) 65%, white);
		outline-offset: 0.12rem;
	}

	.article-index__sidebar-right p {
		margin: 2.7rem 0 1.2rem;
		color: var(--text-30);
		font-size: 0.82rem;
		font-weight: 700;
		text-align: center;
	}

	.article-index__main {
		min-width: 0;
	}

	.article-index__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.75rem;
		padding: 0.1rem 0.15rem;
	}

	.article-index__header p {
		margin: 0;
		color: var(--text-50);
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 0.68rem;
		font-weight: 750;
		letter-spacing: 0;
	}

	.article-index__header h1 {
		margin: 0.15rem 0 0;
		color: var(--text-90);
		font-size: 2rem;
		line-height: 1;
		letter-spacing: 0;
	}

	.article-index__header > div {
		position: relative;
	}

	.article-index__view-switch {
		--skull-travel: 2.4375rem;
		position: relative;
		display: inline-flex;
		width: 5rem;
		height: 2.5rem;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		margin-top: 0.78rem;
		overflow: hidden;
		border-radius: 1.25rem;
		background: #141414;
		box-shadow: 0 0 0.1rem 0.1rem #000, inset 0 0 0.5rem 0.1rem #0b0b10;
		cursor: pointer;
		transition: box-shadow 180ms ease;
	}

	.article-index__view-switch:hover {
		box-shadow: 0 0 0.12rem 0.1rem #000, inset 0 0 0.65rem 0.12rem #050509;
	}

	.article-index__view-switch:has(input:focus-visible):not(.is-pointer-focus) {
		outline: 0.14rem solid color-mix(in srgb, var(--primary) 65%, white);
		outline-offset: 0.12rem;
	}

	.article-index__view-switch input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	.article-index__skull {
		position: absolute;
		top: 0.15625rem;
		left: 0.15625rem;
		z-index: 3;
		display: flex;
		width: 2.1875rem;
		height: 2.1875rem;
		align-items: center;
		justify-content: center;
		border-radius: 1.25rem;
		transform: translateX(0);
		transition: none;
		will-change: transform;
	}

	.article-index__view-switch input:checked ~ .article-index__skull {
		transform: translateX(var(--skull-travel));
	}

	.article-index__view-switch input:not(:checked) ~ .article-index__skull {
		transform: translateX(0);
	}

	.article-index__skull > span {
		position: absolute;
		filter: drop-shadow(0 1px 1px #000);
		transition: filter 0.24s ease;
	}

	.article-index__view-switch input:checked ~ .article-index__skull > span {
		filter: drop-shadow(0 1px 1px #000) brightness(1.875);
	}

	.article-index__view-switch.is-switching input:checked ~ .article-index__skull > span {
		animation: article-skull-brighten 1.5s linear both;
	}

	.article-index__view-switch.is-switching input:not(:checked) ~ .article-index__skull > span {
		animation: article-skull-dim 1.5s linear both;
	}

	.article-index__view-switch.is-switching input:checked ~ .article-index__skull {
		animation: article-skull-move-right 1.5s cubic-bezier(0.45, 0, 0.25, 1) both;
	}

	.article-index__view-switch.is-switching input:not(:checked) ~ .article-index__skull {
		animation: article-skull-move-left 1.5s cubic-bezier(0.45, 0, 0.25, 1) both;
	}

	.article-index__cranium {
		top: 0;
		left: 0;
		width: 100%;
		height: 1.75rem;
		border-radius: 1.25rem 1.25rem 0.6875rem 0.6875rem;
		background:
			linear-gradient(#888 0 54%, transparent 54% 94%, #888 94% 100%),
			radial-gradient(circle at 75% 69%, transparent 0 0.21875rem, #888 calc(1px + 0.21875rem) 0.6058rem, transparent calc(1px + 0.6058rem)),
