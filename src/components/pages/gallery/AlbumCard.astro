---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getLqipProps } from "@/utils/lqip-utils";
import { url } from "@/utils/url-utils";

interface Props {
	id: string;
	name: string;
	cover: string;
	description?: string;
	date?: string;
	location?: string;
	tags?: string[];
	photoCount: number;
	encrypted?: boolean;
}

const {
	id,
	name,
	cover,
	description,
	date,
	location,
	tags,
	photoCount,
	encrypted,
} = Astro.props;
const lqipProps = cover ? getLqipProps(cover, undefined, true) : { style: "" };
const searchText = [name, description, location, ...(tags || [])]
	.filter(Boolean)
	.join(" ")
	.toLocaleLowerCase();
---

<a
	href={url(`/gallery/${id}/`)}
	data-tags={tags?.join(",") || ""}
	data-search={searchText}
	class="album-card"
>
	<div class="album-card__media">
		{cover ? (
			<>
				<div class="lqip-placeholder" style={lqipProps.style} aria-hidden="true"></div>
				<img
					src={cover}
					alt={name}
					loading="lazy"
					decoding="async"
				/>
			</>
		) : (
			<div class="album-card__placeholder" aria-hidden="true">
				<Icon is:inline name="material-symbols:photo-library-outline-rounded" />
			</div>
		)}

		<div class="album-card__badges">
			{encrypted && (
				<span title="加密相册">
					<Icon is:inline name="material-symbols:lock-outline" />
				</span>
			)}
			<span>{photoCount} {i18n(I18nKey.galleryPhotos)}</span>
		</div>
	</div>

	<div class="album-card__body">
		<div class="album-card__heading">
			<h3>{name}</h3>
			<Icon is:inline name="material-symbols:arrow-outward-rounded" />
		</div>
		{description && <p title={description}>{description}</p>}
		<div class="album-card__meta">
			{date && <time datetime={date}>{date}</time>}
			{location && (
				<span>
					<Icon is:inline name="material-symbols:location-on-outline-rounded" />
					{location}
				</span>
			)}
		</div>
		{tags && tags.length > 0 && (
			<div class="album-card__tags">
				{tags.slice(0, 4).map((tag) => <span>{tag}</span>)}
			</div>
		)}
	</div>
</a>

<style>
	.album-card {
		display: grid;
		min-width: 0;
		overflow: hidden;
		border: 1px solid var(--gallery-border, rgb(20 24 27 / 18%));
		border-radius: 0.5rem;
		background: var(--gallery-surface, var(--card-bg));
		color: var(--gallery-text, var(--text-90));
		transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
	}

	.album-card[hidden] {
		display: none;
	}

	.album-card:hover {
		border-color: var(--gallery-text, var(--text-90));
		box-shadow: 0 0.7rem 1.5rem rgb(18 24 28 / 9%);
		transform: translateY(-0.12rem);
	}

	.album-card__media {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: color-mix(in srgb, var(--gallery-text, var(--text-90)) 8%, transparent);
	}

	.album-card__media > img,
	.album-card__media > .lqip-placeholder {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.album-card__media > img {
		object-fit: cover;
		opacity: 0;
		transition: opacity 500ms ease, transform 400ms ease;
	}

	.album-card:hover .album-card__media > img {
		transform: scale(1.025);
	}

	.album-card__placeholder {
		display: grid;
		height: 100%;
		place-items: center;
		color: var(--gallery-muted, var(--text-30));
	}

	.album-card__placeholder :global(svg) {
		width: 2.5rem;
		height: 2.5rem;
	}

	.album-card__badges {
		position: absolute;
		top: 0.7rem;
		right: 0.7rem;
		left: 0.7rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.album-card__badges span {
		display: inline-flex;
		min-height: 1.75rem;
		align-items: center;
		gap: 0.3rem;
		padding: 0.25rem 0.55rem;
		border: 1px solid rgb(255 255 255 / 28%);
		border-radius: 0.35rem;
		background: rgb(12 15 17 / 72%);
		color: #fff;
		font-size: 0.68rem;
		font-weight: 700;
		backdrop-filter: blur(0.5rem);
	}

	.album-card__badges span:last-child {
		margin-left: auto;
	}

	.album-card__badges :global(svg) {
		width: 0.85rem;
		height: 0.85rem;
	}

	.album-card__body {
		display: grid;
		gap: 0.65rem;
		padding: 0.9rem 1rem 1rem;
	}

	.album-card__heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.album-card__heading h3 {
		overflow-wrap: anywhere;
		margin: 0;
		font-size: 0.95rem;
		font-weight: 800;
		line-height: 1.35;
	}

	.album-card__heading :global(svg) {
		width: 1.05rem;
		height: 1.05rem;
		flex: 0 0 auto;
		color: var(--gallery-muted, var(--text-30));
		transition: color 180ms ease, transform 180ms ease;
	}

	.album-card:hover .album-card__heading :global(svg) {
		color: var(--gallery-text, var(--text-90));
		transform: translate(0.1rem, -0.1rem);
	}

	.album-card__body > p {
		display: -webkit-box;
		overflow: hidden;
		margin: 0;
		color: var(--gallery-muted, var(--text-50));
		font-size: 0.74rem;
		line-height: 1.55;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.album-card__meta {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 0.7rem;
		color: var(--gallery-muted, var(--text-30));
		font-size: 0.68rem;
	}

	.album-card__meta span {
		display: inline-flex;
		min-width: 0;
		align-items: center;
		gap: 0.2rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.album-card__meta :global(svg) {
		width: 0.85rem;
		height: 0.85rem;
		flex: 0 0 auto;
		color: currentColor;
	}

	.album-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.album-card__tags span {
		padding: 0.18rem 0.4rem;
		border: 1px solid var(--gallery-border, rgb(20 24 27 / 18%));
		border-radius: 0.3rem;
		color: var(--gallery-muted, var(--text-50));
		font-size: 0.62rem;
		font-weight: 650;
	}

	@media (prefers-reduced-motion: reduce) {
		.album-card,
		.album-card__media > img,
		.album-card__heading :global(svg) {
			transition: none;
		}
	}
</style>
