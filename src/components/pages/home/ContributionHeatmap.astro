---
import { Icon } from "astro-icon/components";
import type { ActivityCalendar, ActivityDay } from "@/utils/home-activity";

interface Props {
	blog?: ActivityCalendar;
	github?: ActivityCalendar;
	githubUsername?: string;
	eyebrow?: string;
	title?: string;
	description?: string;
}

interface MonthMarker {
	column: number;
	label: string;
	span: number;
}

const {
	blog,
	github,
	githubUsername = "",
	eyebrow = "ACTIVITY",
	title = "创作足迹",
	description = "把文字、动态与代码留下的痕迹，收进同一片微光里。",
} = Astro.props;

const datasets: Array<{
	id: "blog" | "github";
	label: string;
	noun: string;
	calendar: ActivityCalendar;
}> = [];
if (blog) {
	datasets.push({
		id: "blog",
		label: "博客活动",
		noun: "次创作",
		calendar: blog,
	});
}
if (github) {
	datasets.push({
		id: "github",
		label: "GitHub",
		noun: "次贡献",
		calendar: github,
	});
}
const hasTabs = datasets.length > 1;

function chunkWeeks(days: ActivityDay[]): ActivityDay[][] {
	return Array.from({ length: 53 }, (_, index) =>
		days.slice(index * 7, index * 7 + 7),
	);
}

function getMonthMarkers(days: ActivityDay[]): MonthMarker[] {
	const weeks = chunkWeeks(days);
	const starts = weeks
		.map((week, index) => {
			const date = new Date(`${week[0]?.date}T00:00:00Z`);
			return {
				column: index + 1,
				month: date.getUTCMonth(),
				label: `${date.getUTCMonth() + 1}月`,
			};
		})
		.filter((marker, index, markers) =>
			index === 0 ? true : marker.month !== markers[index - 1]?.month,
		);

	return starts.map((marker, index) => ({
		column: marker.column,
		label: marker.label,
		span: (starts[index + 1]?.column ?? 54) - marker.column,
	}));
}

function formatCellLabel(day: ActivityDay, noun: string): string {
	const date = new Date(`${day.date}T00:00:00Z`);
	const dateText = new Intl.DateTimeFormat("zh-CN", {
		timeZone: "UTC",
		year: "numeric",
		month: "long",
		day: "numeric",
	}).format(date);
	return `${dateText}，${day.count} ${noun}`;
}
---

<section
	class="activity-shell"
	aria-labelledby="activity-title"
	data-activity-heatmap
	data-activity-refresh-url="/api/home-activity.json"
>
	<div class="activity-heading">
		<div>
			<p class="activity-eyebrow">{eyebrow}</p>
			<h2 id="activity-title">{title}</h2>
			<p class="activity-copy">{description}</p>
		</div>
		{github && githubUsername && (
			<a
				class="activity-github-link"
				href={`https://github.com/${githubUsername}`}
				target="_blank"
				rel="noopener noreferrer"
			>
				<Icon is:inline name="fa7-brands:github" />
				<span>@{githubUsername}</span>
			</a>
		)}
	</div>

	{hasTabs && (
		<div class="activity-tabs" role="tablist" aria-label="活动数据来源">
			{datasets.map((dataset, index) => (
				<button
					type="button"
					id={`activity-tab-${dataset.id}`}
					class="activity-tab"
					class:list={[index === 0 && "is-active"]}
					role="tab"
					aria-selected={index === 0 ? "true" : "false"}
					aria-controls={`activity-panel-${dataset.id}`}
					tabindex={index === 0 ? 0 : -1}
					data-activity-tab={dataset.id}
				>
					{dataset.label}
				</button>
			))}
		</div>
	)}

	{datasets.map((dataset, datasetIndex) => {
		const weeks = chunkWeeks(dataset.calendar.days);
		const monthMarkers = getMonthMarkers(dataset.calendar.days);
		return (
			<div
				id={`activity-panel-${dataset.id}`}
				class="activity-panel"
				role={hasTabs ? "tabpanel" : undefined}
				aria-labelledby={hasTabs ? `activity-tab-${dataset.id}` : undefined}
				data-activity-panel={dataset.id}
				data-activity-noun={dataset.noun}
				hidden={datasetIndex !== 0}
			>
				<div data-activity-content hidden={!dataset.calendar.available}>
						<p class="activity-summary">
							过去一年共 <strong data-activity-total>{dataset.calendar.total}</strong> {dataset.noun}
						</p>

						<div
							class="activity-scroll"
							role="region"
							aria-label={`${dataset.label}年度热力图，可横向滚动`}
							tabindex="0"
						>
							<div class="activity-chart">
								<div class="activity-month-spacer" aria-hidden="true"></div>
								<div class="activity-months" aria-hidden="true">
									{monthMarkers.map((marker) => (
										<span
											style={`grid-column: ${marker.column} / span ${marker.span}`}
										>
											{marker.label}
										</span>
									))}
								</div>

								<div class="activity-weekdays" aria-hidden="true">
									<span style="grid-row: 2">周一</span>
									<span style="grid-row: 4">周三</span>
									<span style="grid-row: 6">周五</span>
								</div>

								<div
									class="activity-weeks"
									role="grid"
									aria-label={`${dataset.label}过去一年每日记录`}
									data-activity-grid
								>
									{weeks.map((week, weekIndex) => (
										<div class="activity-week" role="row">
											{week.map((day, dayIndex) => {
												const label = formatCellLabel(day, dataset.noun);
												const cellIndex = weekIndex * 7 + dayIndex;
												return (
													<button
														type="button"
														class={`activity-cell level-${day.level}`}
														class:list={[day.isOutsideRange && "is-outside"]}
														role="gridcell"
														aria-label={label}
														title={label}
														tabindex={cellIndex === 0 ? 0 : -1}
													data-cell-index={cellIndex}
													data-activity-date={day.date}
													data-tooltip={label}
														disabled={day.isOutsideRange}
													></button>
												);
											})}
										</div>
									))}
								</div>
							</div>
						</div>

						<div class="activity-legend" aria-label="活跃程度图例">
							<span>更少</span>
							{[0, 1, 2, 3, 4].map((level) => (
								<i class={`activity-cell level-${level}`} aria-hidden="true"></i>
							))}
							<span>更多</span>
						</div>
				</div>
				<div
					class="activity-empty"
					data-activity-empty-state
					hidden={dataset.calendar.available}
				>
						<Icon is:inline name={dataset.id === "github" ? "fa7-brands:github" : "material-symbols:edit-calendar-outline-rounded"} />
						<div>
							<h3>{dataset.id === "github" ? "GitHub 活跃记录暂未载入" : "博客活动暂未载入"}</h3>
							<p>{dataset.id === "github" ? "公开贡献数据恢复后，这里会自动更新。" : "当前没有可显示的博客活动数据。"}</p>
						</div>
						{dataset.id === "github" && githubUsername && (
							<a
								href={`https://github.com/${githubUsername}`}
								target="_blank"
								rel="noopener noreferrer"
							>
								前往 GitHub
							</a>
						)}
				</div>
			</div>
		);
	})}

	<div class="activity-tooltip" role="tooltip" hidden></div>
</section>

<script is:inline>
	(() => {
	const ACTIVITY_REFRESH_INTERVAL = 30_000;

	function formatLiveActivityLabel(day, noun) {
		const date = new Date(`${day.date}T00:00:00Z`);
		const dateText = new Intl.DateTimeFormat("zh-CN", {
			timeZone: "UTC",
			year: "numeric",
			month: "long",
			day: "numeric",
		}).format(date);
		return `${dateText}，${day.count} ${noun}`;
	}

	function updateLiveMonthMarkers(panel, days) {
		const months = panel.querySelector(".activity-months");
		if (!months || !Array.isArray(days) || days.length < 7) return;
		const starts = Array.from({ length: 53 }, (_, index) => {
			const day = days[index * 7];
			if (!day) return null;
			const date = new Date(`${day.date}T00:00:00Z`);
			return {
				column: index + 1,
				month: date.getUTCMonth(),
				label: `${date.getUTCMonth() + 1}月`,
			};
		}).filter(Boolean).filter((marker, index, markers) =>
			index === 0 || marker.month !== markers[index - 1]?.month,
		);
		months.replaceChildren(
			...starts.map((marker, index) => {
				const span = document.createElement("span");
				span.textContent = marker.label;
				span.style.gridColumn = `${marker.column} / span ${(starts[index + 1]?.column ?? 54) - marker.column}`;
				return span;
			}),
		);
	}

	function isValidLiveActivityDay(day) {
		return Boolean(
			day &&
				typeof day.date === "string" &&
				/^\d{4}-\d{2}-\d{2}$/.test(day.date) &&
				!Number.isNaN(Date.parse(`${day.date}T00:00:00Z`)) &&
				Number.isFinite(day.count) &&
				Number.isInteger(day.level) &&
				day.level >= 0 &&
				day.level <= 4 &&
				typeof day.isOutsideRange === "boolean",
		);
	}

	function updateLiveActivityPanel(root, id, calendar) {
		if (!calendar || typeof calendar.available !== "boolean") return false;
		const panel = root.querySelector(`[data-activity-panel="${id}"]`);
		if (!panel) return false;
		const content = panel.querySelector("[data-activity-content]");
		const emptyState = panel.querySelector("[data-activity-empty-state]");
		if (!content || !emptyState) return false;
		if (!calendar.available) {
			content.hidden = true;
			emptyState.hidden = false;
			return true;
		}
		if (!Array.isArray(calendar.days)) return false;
		const noun = panel.dataset.activityNoun || "次记录";
		const cells = Array.from(panel.querySelectorAll("button.activity-cell"));
		const total = panel.querySelector("[data-activity-total]");
		const months = panel.querySelector(".activity-months");
		const nextTotal = Number(calendar.total ?? 0);
		if (
			!total ||
			!months ||
			cells.length !== calendar.days.length ||
			!calendar.days.every(isValidLiveActivityDay) ||
			!Number.isFinite(nextTotal)
		) return false;

		const currentRovingIndex = cells.findIndex(
			(cell) => !cell.disabled && cell.tabIndex === 0,
		);
		const preparedDays = calendar.days.map((day) => ({
			...day,
			label: formatLiveActivityLabel(day, noun),
		}));

		cells.forEach((cell, index) => {
			const day = preparedDays[index];
			for (let level = 0; level <= 4; level += 1) {
				cell.classList.remove(`level-${level}`);
			}
			cell.classList.add(`level-${day.level}`);
			cell.classList.toggle("is-outside", Boolean(day.isOutsideRange));
			cell.disabled = Boolean(day.isOutsideRange);
			cell.dataset.activityDate = day.date;
			cell.dataset.tooltip = day.label;
			cell.dataset.cellIndex = String(index);
			cell.setAttribute("aria-label", day.label);
			cell.title = day.label;
			cell.tabIndex = -1;
		});
		const enabledCells = cells.filter((cell) => !cell.disabled);
		const nextRovingCell = cells[currentRovingIndex];
		if (nextRovingCell && !nextRovingCell.disabled) {
			nextRovingCell.tabIndex = 0;
		} else if (enabledCells[0]) {
			enabledCells[0].tabIndex = 0;
		}
		updateLiveMonthMarkers(panel, calendar.days);
		total.textContent = String(nextTotal);
		emptyState.hidden = true;
		content.hidden = false;
		return true;
	}

	async function refreshActivityHeatmap(root) {
		if (!root || root.dataset.activityRefreshing === "true") return;
		const endpoint = root.dataset.activityRefreshUrl;
		if (!endpoint) return;
		root.dataset.activityRefreshing = "true";
		try {
			const version = Math.floor(Date.now() / ACTIVITY_REFRESH_INTERVAL);
			const response = await fetch(`${endpoint}?v=${version}`, { cache: "no-store" });
			if (!response.ok) return;
			const payload = await response.json();
			const blogUpdated = updateLiveActivityPanel(root, "blog", payload.blog);
			const githubUpdated = updateLiveActivityPanel(root, "github", payload.github);
			if (blogUpdated || githubUpdated) {
				root.dataset.activityUpdatedAt = payload.generatedAt || new Date().toISOString();
			}
		} catch (_error) {
			// Keep the server-rendered snapshot when the newest deployment is unreachable.
		} finally {
			delete root.dataset.activityRefreshing;
		}
	}

	function refreshVisibleActivityHeatmaps() {
		document.querySelectorAll("[data-activity-heatmap]").forEach((root) => {
			void refreshActivityHeatmap(root);
		});
	}

	function initActivityHeatmaps() {
		document
			.querySelectorAll("[data-activity-heatmap]:not([data-activity-ready])")
			.forEach((root) => {
				root.setAttribute("data-activity-ready", "true");
				const tabs = Array.from(root.querySelectorAll("[data-activity-tab]"));
				const panels = Array.from(root.querySelectorAll("[data-activity-panel]"));
				const tooltip = root.querySelector(".activity-tooltip");

				const hideTooltip = () => {
					if (tooltip) tooltip.hidden = true;
				};

				const showTooltip = (cell) => {
					if (!tooltip || !cell?.dataset.tooltip) return;
					tooltip.textContent = cell.dataset.tooltip;
					tooltip.hidden = false;
					const cellRect = cell.getBoundingClientRect();
					const tooltipRect = tooltip.getBoundingClientRect();
					const left = Math.min(
						window.innerWidth - tooltipRect.width - 10,
						Math.max(10, cellRect.left + cellRect.width / 2 - tooltipRect.width / 2),
					);
					const top = Math.max(10, cellRect.top - tooltipRect.height - 8);
					tooltip.style.left = `${left}px`;
					tooltip.style.top = `${top}px`;
				};

				const activateTab = (id, focus = false) => {
					hideTooltip();
					tabs.forEach((tab) => {
						const active = tab.dataset.activityTab === id;
						tab.classList.toggle("is-active", active);
						tab.setAttribute("aria-selected", active ? "true" : "false");
						tab.tabIndex = active ? 0 : -1;
						if (active && focus) tab.focus();
					});
					panels.forEach((panel) => {
						panel.hidden = panel.dataset.activityPanel !== id;
					});
				};

				tabs.forEach((tab, index) => {
					tab.addEventListener("click", () => activateTab(tab.dataset.activityTab));
					tab.addEventListener("keydown", (event) => {
						if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
						event.preventDefault();
						const offset = event.key === "ArrowRight" ? 1 : -1;
						const nextIndex = (index + offset + tabs.length) % tabs.length;
						activateTab(tabs[nextIndex].dataset.activityTab, true);
					});
				});

				root.querySelectorAll("[data-activity-grid]").forEach((grid) => {
					const cells = Array.from(grid.querySelectorAll("button.activity-cell"));
					const byIndex = new Map(
						cells.map((cell) => [Number(cell.dataset.cellIndex), cell]),
					);
					const firstEnabledCell = cells.find((cell) => !cell.disabled);
					if (firstEnabledCell) firstEnabledCell.tabIndex = 0;

					cells.forEach((cell) => {
						cell.addEventListener("mouseenter", () => showTooltip(cell));
						cell.addEventListener("mouseleave", hideTooltip);
						cell.addEventListener("focus", () => showTooltip(cell));
						cell.addEventListener("blur", hideTooltip);
						cell.addEventListener("keydown", (event) => {
							const currentIndex = Number(cell.dataset.cellIndex);
							const offsets = {
								ArrowUp: -1,
								ArrowDown: 1,
								ArrowLeft: -7,
								ArrowRight: 7,
							};
							let target;
							const enabledCells = cells.filter((item) => !item.disabled);
							if (event.key === "Home") target = enabledCells[0];
							if (event.key === "End") target = enabledCells[enabledCells.length - 1];
							if (offsets[event.key]) target = byIndex.get(currentIndex + offsets[event.key]);
							if (!target || target.disabled) return;
							event.preventDefault();
							cells.forEach((item) => (item.tabIndex = -1));
							target.tabIndex = 0;
							target.focus();
						});
					});
				});
				void refreshActivityHeatmap(root);
			});
	}

	initActivityHeatmaps();
	if (!window.__fireflyActivityHeatmapBound) {
		window.__fireflyActivityHeatmapBound = true;
		document.addEventListener("swup:contentReplaced", initActivityHeatmaps);
		document.addEventListener("astro:page-load", initActivityHeatmaps);
		window.addEventListener("focus", refreshVisibleActivityHeatmaps);
		document.addEventListener("visibilitychange", () => {
			if (!document.hidden) refreshVisibleActivityHeatmaps();
		});
		window.__fireflyActivityRefreshTimer = window.setInterval(() => {
			if (!document.hidden) refreshVisibleActivityHeatmaps();
		}, ACTIVITY_REFRESH_INTERVAL);
	}

	function bindActivityHeatmapSwup() {
		if (window.__fireflyActivityHeatmapSwupBound || !window.swup?.hooks) return;
		window.__fireflyActivityHeatmapSwupBound = true;
		window.swup.hooks.on("content:replace", initActivityHeatmaps);
	}

	if (window.swup?.hooks) {
		bindActivityHeatmapSwup();
	} else {
		document.addEventListener("swup:enable", bindActivityHeatmapSwup, {
			once: true,
		});
	}
	})();
</script>

<style>
	.activity-shell {
		--activity-cell-size: 0.82rem;
		--activity-gap: 0.2rem;
		--activity-ink: var(--deep-text);
		--activity-empty: color-mix(in oklch, var(--activity-ink) 8%, transparent);
		position: relative;
		overflow: hidden;
		border: 1px solid color-mix(in oklch, var(--activity-ink) 12%, transparent);
		border-radius: 1.75rem;
		background: color-mix(in oklch, var(--card-bg) 90%, transparent);
		box-shadow: 0 1.4rem 4rem color-mix(in oklch, var(--deep-text) 10%, transparent);
		padding: clamp(1.15rem, 3vw, 2.4rem);
		backdrop-filter: blur(1.1rem);
	}

	:global(:root.dark) .activity-shell {
		--activity-ink: oklch(0.92 0.01 var(--hue));
	}

	.activity-shell::before {
		content: "";
		position: absolute;
		inset: 0 0 auto;
		height: 0.2rem;
		background: linear-gradient(90deg, transparent, var(--primary), transparent);
		opacity: 0.7;
	}

	.activity-heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.activity-eyebrow {
		margin: 0 0 0.45rem;
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.24em;
	}

	h2 {
		margin: 0;
		color: var(--activity-ink);
		font-size: clamp(1.8rem, 4vw, 2.8rem);
		line-height: 1.1;
	}

	.activity-copy {
		margin: 0.75rem 0 0;
		color: color-mix(in oklch, var(--activity-ink) 72%, transparent);
		line-height: 1.7;
	}

	.activity-github-link {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		border: 1px solid color-mix(in oklch, var(--activity-ink) 14%, transparent);
		border-radius: 999px;
		background: color-mix(in oklch, var(--page-bg) 72%, transparent);
		padding: 0.65rem 0.9rem;
		color: var(--activity-ink);
		font-size: 0.82rem;
		font-weight: 700;
		text-decoration: none;
		transition: border-color 180ms ease, color 180ms ease, background-color 180ms ease;
	}

	.activity-github-link:hover,
	.activity-github-link:focus-visible {
		border-color: var(--primary);
		background: color-mix(in oklch, var(--primary) 10%, var(--card-bg));
		color: var(--primary);
		outline: none;
	}

	.activity-github-link :global(svg) {
		width: 1rem;
		height: 1rem;
	}

	.activity-tabs {
		display: inline-flex;
		gap: 0.25rem;
		margin-top: 1.8rem;
		border-radius: 0.9rem;
		background: color-mix(in oklch, var(--activity-ink) 6%, transparent);
		padding: 0.25rem;
	}

	.activity-tab {
		cursor: pointer;
		border: 0;
		border-radius: 0.7rem;
		background: transparent;
		padding: 0.58rem 0.9rem;
		color: color-mix(in oklch, var(--activity-ink) 70%, transparent);
		font: inherit;
		font-size: 0.84rem;
		font-weight: 700;
		transition: color 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
	}

	.activity-tab.is-active {
		background: var(--card-bg);
		box-shadow: 0 0.3rem 1rem color-mix(in oklch, var(--deep-text) 8%, transparent);
		color: var(--primary);
	}

	.activity-tab:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	.activity-panel[hidden] {
		display: none !important;
	}

	[data-activity-content][hidden],
	[data-activity-empty-state][hidden] {
		display: none !important;
	}

	[data-activity-content][hidden],
	[data-activity-empty-state][hidden] {
		display: none !important;
	}

	.activity-summary {
		margin: 1.35rem 0 0.85rem;
		color: color-mix(in oklch, var(--activity-ink) 72%, transparent);
		font-size: 0.82rem;
	}

	.activity-summary strong {
		color: var(--activity-ink);
	}

	.activity-scroll {
		max-width: 100%;
		overflow-x: auto;
		overflow-y: hidden;
		border-radius: 0.75rem;
		padding: 0.35rem 0 0.6rem;
		scrollbar-color: color-mix(in oklch, var(--primary) 50%, transparent) transparent;
		scrollbar-width: thin;
	}

	.activity-scroll:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 4px;
	}

	.activity-chart {
		display: grid;
		grid-template-columns: 2.65rem max-content;
		grid-template-rows: 1.35rem max-content;
		width: max-content;
		min-width: 100%;
	}

	.activity-months {
		display: grid;
		grid-template-columns: repeat(53, var(--activity-cell-size));
		column-gap: var(--activity-gap);
		color: color-mix(in oklch, var(--activity-ink) 62%, transparent);
		font-size: 0.68rem;
		line-height: 1;
	}

	.activity-months span {
		overflow: hidden;
		white-space: nowrap;
	}

	.activity-weekdays {
		display: grid;
		grid-template-rows: repeat(7, var(--activity-cell-size));
		row-gap: var(--activity-gap);
		padding-right: 0.55rem;
		color: color-mix(in oklch, var(--activity-ink) 62%, transparent);
		font-size: 0.66rem;
