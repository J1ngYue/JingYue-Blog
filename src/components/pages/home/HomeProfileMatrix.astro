---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import homeData1 from "@/assets/images/HomeReference/home-data-1.webp";
import homeData2 from "@/assets/images/HomeReference/home-data-2.webp";
import homeData3 from "@/assets/images/HomeReference/home-data-3.webp";
import CoverImage from "@/components/common/CoverImage.astro";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";
import { processCoverImageSync } from "@/utils/image-utils";
import {
	getFileDirFromPath,
	getPostUrlBySlug,
	getTagUrl,
} from "@/utils/url-utils";
import "./HomeProfileMatrix.css";

interface Props {
	embedded?: boolean;
}

const { embedded = false } = Astro.props;
const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();
const dynamics = siteConfig.pages.dynamic ? await getCollection("dynamic") : [];

const pinnedSource = posts.filter((post) => post.data.pinned);
const pinnedPosts = (pinnedSource.length > 0 ? pinnedSource : posts).slice(
	0,
	4,
);
const latestSource = posts.filter((post) => !post.data.pinned);
const latestPosts = (latestSource.length > 0 ? latestSource : posts).slice(
	0,
	4,
);
const popularCategories = categories.slice(0, 3);
const popularTags = [...tags]
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
	.slice(0, 5);

const totalWords = posts.reduce((total, post) => {
	const body = (post.body || "")
		.replace(/```[\s\S]*?```/g, "")
		.replace(/`[^`]*`/g, "")
		.replace(/\s+/g, " ")
		.trim();
	return total + (body.match(/[\u4e00-\u9fa5a-zA-Z]/gi) || []).length;
}, 0);

const siteStartDate = siteConfig.siteStartDate || "2025-01-01";
const runningDays = Math.max(
	1,
	Math.ceil(
		(Date.now() - new Date(siteStartDate).getTime()) / (1000 * 60 * 60 * 24),
	),
);
const compactNumber = new Intl.NumberFormat("zh-CN", {
	notation: "compact",
	maximumFractionDigits: 1,
});
const formatDate = (value: Date) =>
	new Intl.DateTimeFormat("zh-CN", {
		timeZone: siteConfig.timezone || "Asia/Shanghai",
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	}).format(value);
const externalLink = (href: string) => /^https?:\/\//.test(href);
const postView = (post: (typeof posts)[number]) => ({
	...post,
	cover: processCoverImageSync(post.data.image, post.id),
	basePath: getFileDirFromPath(post.filePath || ""),
});
const pinnedViews = pinnedPosts.map(postView);
const latestViews = latestPosts.map(postView);
---

<section
	id={embedded ? undefined : "home-capabilities"}
	class:list={["home-capabilities", !embedded && "home-scroll-scene"]}
	aria-labelledby="home-capabilities-title"
	data-home-map-guide
	data-home-scroll-scene={embedded ? undefined : ""}
	data-home-page={embedded ? undefined : ""}
	data-home-section-tone={embedded ? undefined : "light"}
>
	<div class="home-capabilities__inner">
		<header class="home-capabilities__heading">
			<p>CONTEXT</p>
			<strong>站点数据</strong>
			<h2 id="home-capabilities-title">地图指南</h2>
		</header>

		<div class="home-capabilities__top-grid">
			<article class="guide-card guide-card--metric guide-card--visits">
				<Image src={homeData1} alt="" loading="lazy" widths={[480, 720]} sizes="(max-width: 1023px) 50vw, 28vw" />
				<div class="guide-card__shade"></div>
				<div class="guide-card__copy">
					<p>VISITS</p>
					<h3>站点访问</h3>
					<span>运行 {runningDays} 天 · {dynamics.length} 条动态</span>
				</div>
			</article>

			<a class="guide-card guide-card--metric guide-card--archive" href="/archive/">
				<Image src={homeData2} alt="" loading="lazy" widths={[720, 1080]} sizes="(max-width: 1023px) 50vw, 56vw" />
				<div class="guide-card__shade"></div>
				<div class="guide-card__copy">
					<p>ARCHIVE</p>
					<h3>文章档案</h3>
					<span>{posts.length} 篇文章 · {compactNumber.format(totalWords)} 字</span>
				</div>
				<Icon is:inline name="material-symbols:arrow-outward-rounded" />
			</a>
		</div>

		<div class="home-capabilities__content-grid">
			<section class="guide-card guide-card--pinned" aria-labelledby="guide-pinned-title" data-map-rotator data-map-delay="5200">
				<h3 id="guide-pinned-title">置顶文章</h3>
				<div class="guide-rotator">
					{pinnedViews.length > 0 ? pinnedViews.map((post, index) => (
						<article class:list={["guide-rotator__slide", index === 0 && "is-active"]} data-map-slide aria-hidden={index === 0 ? "false" : "true"}>
							{post.cover && (
								<a class="guide-rotator__cover" href={getPostUrlBySlug(post.id)} tabindex={index === 0 ? undefined : -1}>
									<CoverImage src={post.cover} basePath={post.basePath} alt="" preview loading="lazy" />
								</a>
							)}
							<div class="guide-rotator__body">
								<span>{post.data.category || "未分类"} / {formatDate(new Date(post.data.published))}</span>
								<a href={getPostUrlBySlug(post.id)} tabindex={index === 0 ? undefined : -1}>{post.data.title}</a>
								<p>{post.data.description || "查看这篇文章的完整内容。"}</p>
							</div>
						</article>
					)) : <p class="guide-card__empty">暂时还没有置顶文章。</p>}
				</div>
				{pinnedViews.length > 1 && (
					<div class="guide-dots" aria-label="切换置顶文章">
						{pinnedViews.map((post, index) => (
							<button type="button" data-map-dot aria-label={`查看 ${post.data.title}`} aria-current={index === 0 ? "true" : undefined}></button>
						))}
					</div>
				)}
			</section>

			<section class="guide-card guide-card--latest" aria-labelledby="guide-latest-title" data-map-rotator data-map-delay="6100">
				<Image class="guide-latest__fallback" src={homeData2} alt="" loading="lazy" widths={[480, 720]} sizes="(max-width: 1023px) 50vw, 28vw" />
				<h3 id="guide-latest-title">最新更新</h3>
				<div class="guide-rotator guide-rotator--latest">
					{latestViews.length > 0 ? latestViews.map((post, index) => (
						<article class:list={["guide-rotator__slide", index === 0 && "is-active"]} data-map-slide aria-hidden={index === 0 ? "false" : "true"}>
							{post.cover && (
								<div class="guide-latest__cover" aria-hidden="true">
									<CoverImage src={post.cover} basePath={post.basePath} alt="" preview loading="lazy" />
								</div>
							)}
							<div class="guide-latest__shade"></div>
							<div class="guide-latest__body">
								<span>{post.data.category || "未分类"} / {formatDate(new Date(post.data.published))}</span>
								<a href={getPostUrlBySlug(post.id)} tabindex={index === 0 ? undefined : -1}>{post.data.title}</a>
							</div>
						</article>
					)) : <p class="guide-card__empty">暂时还没有文章。</p>}
				</div>
				{latestViews.length > 1 && (
					<div class="guide-dots guide-dots--latest" aria-label="切换最新文章">
						{latestViews.map((post, index) => (
							<button type="button" data-map-dot aria-label={`查看 ${post.data.title}`} aria-current={index === 0 ? "true" : undefined}></button>
						))}
					</div>
				)}
			</section>

			<section class="guide-card guide-card--index" aria-labelledby="guide-categories-title">
				<p class="guide-card__eyebrow">CATEGORIES</p>
				<h3 id="guide-categories-title">分类索引</h3>
				<div class="guide-link-list">
					{popularCategories.map((category) => <a href={category.url}><span>{category.name}</span><strong>{category.count}</strong></a>)}
					<a href="/categories/"><span>查看全部</span><strong>{categories.length} 个分类</strong></a>
				</div>
			</section>

			<section class="guide-card guide-card--index guide-card--tags" aria-labelledby="guide-tags-title">
				<p class="guide-card__eyebrow">TAGS</p>
				<h3 id="guide-tags-title">标签索引</h3>
				<div class="guide-tag-list">
					{popularTags.map((tag) => <a href={getTagUrl(tag.name)}>#{tag.name}<span>{tag.count}</span></a>)}
					<a class="guide-tag-list__all" href="/tags/">全部标签 <Icon is:inline name="material-symbols:arrow-outward-rounded" /></a>
				</div>
			</section>

			<section class="guide-card guide-card--contact" aria-labelledby="guide-contact-title">
				<Image src={homeData3} alt="" loading="lazy" widths={[480, 720]} sizes="(max-width: 1023px) 50vw, 28vw" />
				<div class="guide-card__shade"></div>
				<div class="guide-card__copy">
					<p class="guide-card__eyebrow">SUBSCRIBE</p>
					<h3 id="guide-contact-title">订阅与联系</h3>
				</div>
				<nav aria-label="订阅与联系">
					{profileConfig.links.map((link) => (
						<a href={link.url} aria-label={link.name} title={link.name} target={externalLink(link.url) ? "_blank" : undefined} rel={externalLink(link.url) ? "noopener noreferrer" : undefined}>
							<Icon is:inline name={link.icon} />
						</a>
					))}
					<a href="/guestbook/" aria-label="留言板" title="留言板"><Icon is:inline name="material-symbols:edit-square-outline-rounded" /></a>
				</nav>
			</section>
		</div>
	</div>
</section>

<script>
	let cleanupHomeMapGuide = () => {};

	function initHomeMapGuide() {
		cleanupHomeMapGuide();
		const controller = new AbortController();
		const timers = new Set<number>();
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

		document.querySelectorAll<HTMLElement>("[data-home-map-guide]").forEach((guide) => {
			guide.querySelectorAll<HTMLElement>("[data-map-rotator]").forEach((rotator) => {
				const slides = Array.from(rotator.querySelectorAll<HTMLElement>("[data-map-slide]"));
				const dots = Array.from(rotator.querySelectorAll<HTMLButtonElement>("[data-map-dot]"));
				if (slides.length < 1) return;
				let activeIndex = 0;
				let timer: number | undefined;

				const show = (nextIndex: number) => {
					activeIndex = (nextIndex + slides.length) % slides.length;
					slides.forEach((slide, index) => {
						const active = index === activeIndex;
						slide.classList.toggle("is-active", active);
						slide.setAttribute("aria-hidden", String(!active));
						slide.querySelectorAll<HTMLElement>("a, button").forEach((control) => {
							control.tabIndex = active ? 0 : -1;
						});
					});
					dots.forEach((dot, index) => {
						if (index === activeIndex) dot.setAttribute("aria-current", "true");
						else dot.removeAttribute("aria-current");
					});
				};

				const stop = () => {
					if (timer === undefined) return;
					window.clearInterval(timer);
					timers.delete(timer);
					timer = undefined;
				};
				const start = () => {
					stop();
					if (slides.length < 2 || reducedMotion.matches) return;
					const delay = Number(rotator.dataset.mapDelay) || 5600;
					timer = window.setInterval(() => show(activeIndex + 1), delay);
					timers.add(timer);
				};

				dots.forEach((dot, index) => {
					dot.addEventListener("click", () => {
						show(index);
						start();
					}, { signal: controller.signal });
				});
				rotator.addEventListener("pointerenter", stop, { signal: controller.signal });
				rotator.addEventListener("pointerleave", start, { signal: controller.signal });
				rotator.addEventListener("focusin", stop, { signal: controller.signal });
				rotator.addEventListener("focusout", start, { signal: controller.signal });
				start();
			});
		});

		cleanupHomeMapGuide = () => {
			controller.abort();
			timers.forEach((timer) => window.clearInterval(timer));
			timers.clear();
		};
	}

	initHomeMapGuide();
	document.addEventListener("astro:page-load", initHomeMapGuide);
	document.addEventListener("astro:before-swap", cleanupHomeMapGuide);
</script>
