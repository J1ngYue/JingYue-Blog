---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import homeData1 from "@/assets/images/HomeReference/home-data-1.webp";
import homeData2 from "@/assets/images/HomeReference/home-data-2.webp";
import homeData3 from "@/assets/images/HomeReference/home-data-3.webp";
import CoverImage from "@/components/common/CoverImage.astro";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";
import { processCoverImageSync } from "@/utils/image-utils";
import {
	getFileDirFromPath,
	getPostUrlBySlug,
	getTagUrl,
} from "@/utils/url-utils";
import "./HomeProfileMatrix.css";

interface Props {
	embedded?: boolean;
}

const { embedded = false } = Astro.props;
const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();
const dynamics = siteConfig.pages.dynamic ? await getCollection("dynamic") : [];

const pinnedSource = posts.filter((post) => post.data.pinned);
const pinnedPosts = (pinnedSource.length > 0 ? pinnedSource : posts).slice(
	0,
	4,
);
const latestSource = posts.filter((post) => !post.data.pinned);
const latestPosts = (latestSource.length > 0 ? latestSource : posts).slice(
	0,
	4,
);
const popularCategories = categories.slice(0, 3);
const popularTags = [...tags]
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
	.slice(0, 5);

const totalWords = posts.reduce((total, post) => {
	const body = (post.body || "")
		.replace(/```[\s\S]*?```/g, "")
		.replace(/`[^`]*`/g, "")
		.replace(/\s+/g, " ")
		.trim();
	return total + (body.match(/[\u4e00-\u9fa5a-zA-Z]/gi) || []).length;
}, 0);

const siteStartDate = siteConfig.siteStartDate || "2025-01-01";
const runningDays = Math.max(
	1,
	Math.ceil(
		(Date.now() - new Date(siteStartDate).getTime()) / (1000 * 60 * 60 * 24),
	),
);
const compactNumber = new Intl.NumberFormat("zh-CN", {
	notation: "compact",
	maximumFractionDigits: 1,
});
const formatDate = (value: Date) =>
	new Intl.DateTimeFormat("zh-CN", {
		timeZone: siteConfig.timezone || "Asia/Shanghai",
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	}).format(value);
const externalLink = (href: string) => /^https?:\/\//.test(href);
const postView = (post: (typeof posts)[number]) => ({
	...post,
	cover: processCoverImageSync(post.data.image, post.id),
	basePath: getFileDirFromPath(post.filePath || ""),
});
const pinnedViews = pinnedPosts.map(postView);
const latestViews = latestPosts.map(postView);
const contactRegions = [
	...profileConfig.links,
	{
		name: "留言板",
		icon: "material-symbols:edit-square-outline-rounded",
		url: "/guestbook/",
	},
]
	.slice(0, 5)
	.map((link, index) => ({
		...link,
		region: ["top-left", "top-right", "bottom-left", "bottom-right", "center"][
			index
		],
	}));
---

<section
	id={embedded ? undefined : "home-capabilities"}
	class:list={["home-capabilities", !embedded && "home-scroll-scene"]}
	aria-labelledby="home-capabilities-title"
	data-home-map-guide
	data-guide-opening="pending"
	data-home-scroll-scene={embedded ? undefined : ""}
	data-home-page={embedded ? undefined : ""}
	data-home-section-tone={embedded ? undefined : "light"}
>
	<div class="home-capabilities__inner">
		<header class="home-capabilities__heading">
			<p>CONTEXT</p>
			<strong>站点数据</strong>
			<h2 id="home-capabilities-title">地图指南</h2>
		</header>

		<div class="home-capabilities__top-grid">
			<article class="guide-card guide-card--motion guide-card--metric guide-card--visits" data-guide-metric="visits">
				<Image src={homeData1} alt="" loading="lazy" widths={[480, 720]} sizes="(max-width: 1023px) 50vw, 28vw" />
				<div class="guide-card__shade"></div>
				<div class="guide-card__copy">
					<p>VISITS</p>
					<h3>站点访问</h3>
					<span>运行 {runningDays} 天 · {dynamics.length} 条动态</span>
				</div>
				<div class="guide-card__hover" aria-hidden="true">
					<div class="guide-card__hover-header"><span>01</span><small>LIVE SYSTEM</small></div>
					<strong>访问轨迹<span>·</span></strong>
					<div class="guide-card__hover-pills"><span>运行 {runningDays} 天</span><span>{dynamics.length} 条动态</span></div>
				</div>
			</article>

			<a class="guide-card guide-card--motion guide-card--metric guide-card--archive" data-guide-metric="archive" href="/archive/">
				<Image src={homeData2} alt="" loading="lazy" widths={[720, 1080]} sizes="(max-width: 1023px) 50vw, 56vw" />
				<div class="guide-card__shade"></div>
				<div class="guide-card__copy">
					<p>ARCHIVE</p>
					<h3>文章档案</h3>
					<span>{posts.length} 篇文章 · {compactNumber.format(totalWords)} 字</span>
				</div>
				<Icon is:inline name="material-symbols:arrow-outward-rounded" />
				<div class="guide-card__hover" aria-hidden="true">
					<div class="guide-card__hover-header"><span>02</span><small>CONTENT INDEX</small></div>
					<strong>文章档案<span>·</span></strong>
					<div class="guide-card__hover-pills"><span>{posts.length} 篇文章</span><span>{compactNumber.format(totalWords)} 字</span></div>
				</div>
			</a>
		</div>

		<div class="home-capabilities__content-grid">
			<section class="guide-card guide-card--motion guide-card--pinned" aria-labelledby="guide-pinned-title" data-map-rotator data-map-delay="5000" data-guide-axis="vertical">
				<h3 id="guide-pinned-title">置顶文章</h3>
				<div class="guide-rotator">
					{pinnedViews.length > 0 ? pinnedViews.map((post, index) => (
						<article class:list={["guide-rotator__slide", index === 0 && "is-active"]} data-map-slide hidden={index !== 0} aria-hidden={index === 0 ? "false" : "true"}>
							{post.cover && (
								<a class="guide-rotator__cover" href={getPostUrlBySlug(post.id)} tabindex={index === 0 ? undefined : -1}>
									<CoverImage src={post.cover} basePath={post.basePath} alt="" preview loading="lazy" />
								</a>
							)}
							<div class="guide-rotator__body">
								<span>{post.data.category || "未分类"} / {formatDate(new Date(post.data.published))}</span>
								<a href={getPostUrlBySlug(post.id)} tabindex={index === 0 ? undefined : -1}>{post.data.title}</a>
								<p>{post.data.description || "查看这篇文章的完整内容。"}</p>
							</div>
						</article>
					)) : <p class="guide-card__empty">暂时还没有置顶文章。</p>}
				</div>
				{pinnedViews.length > 1 && (
					<div class="guide-dots" aria-label="切换置顶文章">
						{pinnedViews.map((post, index) => (
							<button type="button" data-map-dot aria-label={`查看 ${post.data.title}`} aria-current={index === 0 ? "true" : undefined}></button>
						))}
					</div>
				)}
			</section>

			<section class="guide-card guide-card--motion guide-card--latest" aria-labelledby="guide-latest-title" data-map-rotator data-map-delay="5000" data-guide-axis="horizontal">
				<Image class="guide-latest__fallback" src={homeData2} alt="" loading="lazy" widths={[480, 720]} sizes="(max-width: 1023px) 50vw, 28vw" />
				<h3 id="guide-latest-title">最新更新</h3>
				<div class="guide-rotator guide-rotator--latest">
					{latestViews.length > 0 ? latestViews.map((post, index) => (
						<article class:list={["guide-rotator__slide", index === 0 && "is-active"]} data-map-slide hidden={index !== 0} aria-hidden={index === 0 ? "false" : "true"}>
							{post.cover && (
								<div class="guide-latest__cover" aria-hidden="true">
									<CoverImage src={post.cover} basePath={post.basePath} alt="" preview loading="lazy" />
								</div>
							)}
							<div class="guide-latest__shade"></div>
							<div class="guide-latest__body">
								<span>{post.data.category || "未分类"} / {formatDate(new Date(post.data.published))}</span>
								<a href={getPostUrlBySlug(post.id)} tabindex={index === 0 ? undefined : -1}>{post.data.title}</a>
							</div>
						</article>
					)) : <p class="guide-card__empty">暂时还没有文章。</p>}
				</div>
				{latestViews.length > 1 && (
					<div class="guide-dots guide-dots--latest" aria-label="切换最新文章">
						{latestViews.map((post, index) => (
							<button type="button" data-map-dot aria-label={`查看 ${post.data.title}`} aria-current={index === 0 ? "true" : undefined}></button>
						))}
					</div>
				)}
			</section>

			<section class="guide-card guide-card--motion guide-card--index guide-card--categories" aria-labelledby="guide-categories-title">
				<p class="guide-card__eyebrow">CATEGORIES</p>
				<h3 id="guide-categories-title">分类索引</h3>
				<div class="guide-link-list">
					{popularCategories.map((category) => <a href={category.url}><span>{category.name}</span><strong>{category.count}</strong></a>)}
					<a href="/categories/"><span>查看全部</span><strong>{categories.length} 个分类</strong></a>
				</div>
			</section>

			<section class="guide-card guide-card--motion guide-card--index guide-card--tags" aria-labelledby="guide-tags-title" data-tag-fan>
				<p class="guide-card__eyebrow">TAGS</p>
				<h3 id="guide-tags-title">标签索引</h3>
				<div class="guide-tag-list">
					{popularTags.map((tag) => <a href={getTagUrl(tag.name)}>#{tag.name}<span>{tag.count}</span></a>)}
					<a class="guide-tag-list__all" href="/tags/">全部标签 <Icon is:inline name="material-symbols:arrow-outward-rounded" /></a>
				</div>
			</section>

			<section class="guide-card guide-card--motion guide-card--contact" aria-labelledby="guide-contact-title" data-guide-contact tabindex="0">
				<Image src={homeData3} alt="" loading="lazy" widths={[480, 720]} sizes="(max-width: 1023px) 50vw, 28vw" />
				<div class="guide-card__shade"></div>
				<div class="guide-card__copy">
					<p class="guide-card__eyebrow">SUBSCRIBE</p>
					<h3 id="guide-contact-title">订阅与联系</h3>
				</div>
				<template data-guide-contact-template>
					<div class="guide-contact__overlay" role="group" aria-label="订阅与联系">
						<svg class="guide-contact__overlay-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
							<line class="guide-contact__overlay-line" x1="50" y1="0" x2="50" y2="26" vector-effect="non-scaling-stroke" />
							<line class="guide-contact__overlay-line" x1="50" y1="100" x2="50" y2="74" vector-effect="non-scaling-stroke" />
							<line class="guide-contact__overlay-line" x1="0" y1="50" x2="32" y2="50" vector-effect="non-scaling-stroke" />
							<line class="guide-contact__overlay-line" x1="100" y1="50" x2="68" y2="50" vector-effect="non-scaling-stroke" />
						</svg>
						{contactRegions.map((link) => (
							<a class={`guide-contact__region guide-contact__region--${link.region}`} href={link.url} aria-label={link.name} title={link.name} target={externalLink(link.url) ? "_blank" : undefined} rel={externalLink(link.url) ? "noopener noreferrer" : undefined}>
								<Icon is:inline name={link.icon} />
							</a>
						))}
					</div>
				</template>
			</section>
		</div>
	</div>
</section>

<script>
	import { gsap } from "gsap";

	let cleanupHomeMapGuide = () => {};
	type GuideOpeningTargets = {
		visitCard: HTMLElement;
		archiveCard: HTMLElement;
		pinnedCard: HTMLElement;
		latestCard: HTMLElement;
		dealCards: HTMLElement[];
	};
	type GuideDealPose = {
		element: HTMLElement;
		x: number;
		y: number;
		rotation: number;
		zIndex: number;
	};

	function getGuideOpeningTargets(guide: HTMLElement): GuideOpeningTargets | null {
		const visitCard = guide.querySelector<HTMLElement>(".guide-card--visits");
		const archiveCard = guide.querySelector<HTMLElement>(".guide-card--archive");
		const pinnedCard = guide.querySelector<HTMLElement>(".guide-card--pinned");
		const latestCard = guide.querySelector<HTMLElement>(".guide-card--latest");
		const dealCards = [
			guide.querySelector<HTMLElement>(".guide-card--categories"),
			guide.querySelector<HTMLElement>(".guide-card--tags"),
			guide.querySelector<HTMLElement>(".guide-card--contact"),
		];
		if (!visitCard || !archiveCard || !pinnedCard || !latestCard || dealCards.some((card) => !card)) return null;
		return {
			visitCard,
			archiveCard,
			pinnedCard,
			latestCard,
			dealCards: dealCards as HTMLElement[],
		};
	}

	function getDropOffset(guideRect: DOMRect, cardRect: DOMRect) {
		return -(cardRect.top - guideRect.top + cardRect.height * 1.15);
	}

	function getLeftEntryOffset(guideRect: DOMRect, cardRect: DOMRect) {
		return -(cardRect.right - guideRect.left + cardRect.width * 0.15);
	}

	function getLatestPeekOffset(guideRect: DOMRect, cardRect: DOMRect) {
		return guideRect.right - cardRect.left - cardRect.width * 0.2;
	}

	function getGuideDealPoses(guideRect: DOMRect, cards: HTMLElement[]): GuideDealPose[] {
		const deckCenterX = (guideRect.left + guideRect.right) / 2;
		const handPoses = [
			{ x: -0.16, y: 6, rotation: -13, zIndex: 1 },
			{ x: 0, y: -12, rotation: 0, zIndex: 3 },
			{ x: 0.16, y: 6, rotation: 13, zIndex: 2 },
		];
		const fanBottomInset = cards.reduce((inset, element, index) => {
			const rect = element.getBoundingClientRect();
			const pose = handPoses[index] ?? handPoses[1];
			const rotationOverflow = Math.abs(Math.sin((pose.rotation * Math.PI) / 180)) * rect.width * 0.5;
			return Math.max(inset, rotationOverflow + rect.height * 0.14 + 18);
		}, 24);

		return cards.map((element, index) => {
			const rect = element.getBoundingClientRect();
			const pose = handPoses[index] ?? handPoses[1];
			const cardCenterX = (rect.left + rect.right) / 2;
			const cardCenterY = (rect.top + rect.bottom) / 2;
			const deckCenterY = guideRect.bottom - rect.height * 0.5 - fanBottomInset + pose.y;
			return {
				element,
				x: deckCenterX + rect.width * pose.x - cardCenterX,
				y: deckCenterY - cardCenterY,
				rotation: pose.rotation,
				zIndex: pose.zIndex,
			};
		});
	}

	function initTagFan(guide: HTMLElement, signal: AbortSignal) {
		const card = guide.querySelector<HTMLElement>("[data-tag-fan]");
		const links = Array.from(card?.querySelectorAll<HTMLElement>(".guide-tag-list a") || []);
		if (!card || links.length < 3) return;

		const poses = [
			{ x: -0.55, y: -0.35, rotation: -7, zIndex: 1 },
			{ x: 0.18, y: -0.7, rotation: 4, zIndex: 3 },
			{ x: 0.62, y: 0.12, rotation: 16, zIndex: 2 },
			{ x: -0.32, y: 0.4, rotation: 9, zIndex: 1 },
			{ x: 0.12, y: -0.08, rotation: -6, zIndex: 2 },
			{ x: 0.48, y: 0.42, rotation: 13, zIndex: 4 },
		];
		let flat = false;

		const applyState = (nextFlat: boolean, immediate = false) => {
			if (flat === nextFlat && !immediate) return;
			flat = nextFlat;
			card.classList.toggle("is-flat", flat);
			const rem = Number.parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
			links.forEach((link, index) => {
				const pose = poses[index % poses.length];
				gsap.to(link, {
					x: flat ? 0 : pose.x * rem,
					y: flat ? 0 : pose.y * rem,
					rotation: flat ? 0 : pose.rotation,
					zIndex: flat ? index : pose.zIndex,
					duration: immediate ? 0 : flat ? 0.45 : 0.55,
					delay: immediate ? 0 : index * (flat ? 0.02 : 0.03),
					ease: flat ? "power3.out" : "back.out(1.4)",
					overwrite: "auto",
				});
			});
		};

		applyState(false, true);
		card.addEventListener("pointerenter", () => applyState(true), { signal });
		card.addEventListener("pointerleave", () => applyState(false), { signal });
		card.addEventListener("focusin", () => applyState(true), { signal });
		card.addEventListener("focusout", () => {
			requestAnimationFrame(() => {
				if (!card.contains(document.activeElement)) applyState(false);
			});
		}, { signal });
		signal.addEventListener("abort", () => {
			gsap.killTweensOf(links);
			gsap.set(links, { clearProps: "transform,zIndex" });
			card.classList.remove("is-flat");
		}, { once: true });
	}

	function initGuideRotators(
		guide: HTMLElement,
		reducedMotion: MediaQueryList,
		signal: AbortSignal,
		timers: Set<number>,
	) {
		guide.querySelectorAll<HTMLElement>("[data-map-rotator]").forEach((rotator) => {
			const slides = Array.from(rotator.querySelectorAll<HTMLElement>("[data-map-slide]"));
			const dots = Array.from(rotator.querySelectorAll<HTMLButtonElement>("[data-map-dot]"));
			if (slides.length === 0) return;

			let activeIndex = 0;
			let intervalId: number | undefined;
			let transitionId = 0;
			const vertical = rotator.dataset.guideAxis === "vertical";

			const syncState = () => {
				slides.forEach((slide, index) => {
					const active = index === activeIndex;
					slide.hidden = !active;
					slide.classList.toggle("is-active", active);
					slide.classList.remove("is-entering", "is-leaving");
					slide.setAttribute("aria-hidden", String(!active));
					slide.querySelectorAll<HTMLElement>("a, button").forEach((control) => {
						control.tabIndex = active ? 0 : -1;
					});
				});
				dots.forEach((dot, index) => {
					if (index === activeIndex) dot.setAttribute("aria-current", "true");
					else dot.removeAttribute("aria-current");
				});
			};

			const setActive = (nextIndex: number) => {
				const resolvedIndex = (nextIndex + slides.length) % slides.length;
				if (resolvedIndex === activeIndex || slides.length < 2) return;
				slides.forEach((slide) => slide.getAnimations().forEach((animation) => animation.cancel()));
				syncState();

				const currentSlide = slides[activeIndex];
				const nextSlide = slides[resolvedIndex];
				const currentTransition = ++transitionId;
				activeIndex = resolvedIndex;
				nextSlide.hidden = false;
				nextSlide.classList.add("is-active");
				nextSlide.setAttribute("aria-hidden", "false");
				dots.forEach((dot, index) => {
					if (index === activeIndex) dot.setAttribute("aria-current", "true");
					else dot.removeAttribute("aria-current");
				});

				if (reducedMotion.matches) {
					syncState();
					return;
				}

				const incoming = vertical
					? [{ transform: "translateY(110%)" }, { transform: "translateY(0)" }]
					: [{ transform: "translateX(110%)" }, { transform: "translateX(0)" }];
				const outgoing = vertical
					? [{ transform: "translateY(0)" }, { transform: "translateY(-110%)" }]
					: [{ transform: "translateX(0)" }, { transform: "translateX(-110%)" }];
				const options: KeyframeAnimationOptions = {
					duration: 520,
					easing: "cubic-bezier(0.65, 0, 0.35, 1)",
					fill: "both",
				};
				currentSlide.animate(outgoing, options);
				nextSlide.animate(incoming, options);
				const settleTimer = window.setTimeout(() => {
					timers.delete(settleTimer);
					if (currentTransition !== transitionId) return;
					slides.forEach((slide) => slide.getAnimations().forEach((animation) => animation.cancel()));
					syncState();
				}, 540);
				timers.add(settleTimer);
			};

			const stop = () => {
				if (intervalId === undefined) return;
				window.clearInterval(intervalId);
				timers.delete(intervalId);
				intervalId = undefined;
			};
			const start = () => {
				stop();
				if (slides.length < 2 || reducedMotion.matches) return;
				intervalId = window.setInterval(
					() => setActive(activeIndex + 1),
					Number(rotator.dataset.mapDelay) || 5000,
				);
				timers.add(intervalId);
			};

			dots.forEach((dot, index) => dot.addEventListener("click", () => {
				setActive(index);
				start();
			}, { signal }));
			rotator.addEventListener("pointerenter", stop, { signal });
			rotator.addEventListener("pointerleave", start, { signal });
			rotator.addEventListener("focusin", stop, { signal });
			rotator.addEventListener("focusout", () => {
				requestAnimationFrame(() => {
					if (!rotator.contains(document.activeElement)) start();
				});
			}, { signal });
			signal.addEventListener("abort", () => {
				stop();
				slides.forEach((slide) => slide.getAnimations().forEach((animation) => animation.cancel()));
			}, { once: true });
			syncState();
			start();
		});
	}

	function initContactOverlay(
		guide: HTMLElement,
		signal: AbortSignal,
		timers: Set<number>,
	) {
		const contact = guide.querySelector<HTMLElement>("[data-guide-contact]");
		const template = contact?.querySelector<HTMLTemplateElement>("[data-guide-contact-template]");
		const overlay = template?.content.firstElementChild?.cloneNode(true);
		if (!contact || !(overlay instanceof HTMLElement)) return;

		const lines = Array.from(overlay.querySelectorAll<SVGLineElement>(".guide-contact__overlay-line")).map((element) => ({
			element,
			x2: element.getAttribute("x2") || "",
			y2: element.getAttribute("y2") || "",
		}));
		const regions = Array.from(overlay.querySelectorAll<HTMLAnchorElement>(".guide-contact__region"));
		if (lines.length !== 4 || regions.length !== 5) return;

		const fineHover = window.matchMedia("(hover: hover) and (pointer: fine)");
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let active = false;
		let mounted = false;
		let pointerInside = false;
		let touchOpen = false;
		let removeTimer: number | undefined;

		const resetVisuals = () => {
			gsap.set(overlay, { autoAlpha: 0, scale: 0.92 });
			gsap.set(regions, { autoAlpha: 0, scale: 0.82 });
			lines.forEach(({ element }) => {
				element.setAttribute("x2", element.getAttribute("x1") || "");
				element.setAttribute("y2", element.getAttribute("y1") || "");
			});
		};
		const mount = () => {
			if (removeTimer !== undefined) {
				window.clearTimeout(removeTimer);
				timers.delete(removeTimer);
				removeTimer = undefined;
			}
			if (mounted) return;
			mounted = true;
			resetVisuals();
			contact.appendChild(overlay);
			contact.classList.add("has-overlay");
		};
		const unmount = () => {
			if (!mounted || active) return;
			mounted = false;
			overlay.remove();
			contact.classList.remove("has-overlay");
		};
		const setActive = (next: boolean) => {
			if (next) {
				mount();
				if (active) return;
				active = true;
				if (reducedMotion.matches) {
					lines.forEach(({ element, x2, y2 }) => {
						element.setAttribute("x2", x2);
						element.setAttribute("y2", y2);
					});
					gsap.set(overlay, { autoAlpha: 1, scale: 1 });
					gsap.set(regions, { autoAlpha: 1, scale: 1 });
					return;
				}
				gsap.to(overlay, { autoAlpha: 1, scale: 1, duration: 0.22, ease: "power3.out", overwrite: "auto" });
				lines.forEach(({ element, x2, y2 }, index) => {
					gsap.to(element, { attr: { x2, y2 }, duration: 0.2, delay: index * 0.03, ease: "power3.out", overwrite: "auto" });
				});
				regions.forEach((region, index) => {
					gsap.to(region, { autoAlpha: 1, scale: 1, duration: 0.22, delay: 0.26 + index * 0.03, ease: "back.out(1.8)", overwrite: "auto" });
				});
				return;
			}
			if (!active) return;
			active = false;
			if (reducedMotion.matches) {
				unmount();
				return;
			}
			gsap.to(regions, { autoAlpha: 0, scale: 0.82, duration: 0.16, ease: "power2.in", overwrite: "auto" });
			lines.forEach(({ element }, index) => {
				gsap.to(element, {
					attr: { x2: element.getAttribute("x1") || "0", y2: element.getAttribute("y1") || "0" },
					duration: 0.2,
					delay: 0.04 + index * 0.025,
					ease: "power3.inOut",
					overwrite: "auto",
				});
			});
			gsap.to(overlay, { autoAlpha: 0, scale: 0.92, duration: 0.16, delay: 0.18, ease: "power1.in", overwrite: "auto" });
			removeTimer = window.setTimeout(() => {
				if (removeTimer !== undefined) timers.delete(removeTimer);
				removeTimer = undefined;
				unmount();
			}, 500);
			timers.add(removeTimer);
		};
		const sync = () => setActive(pointerInside || contact.matches(":focus-within") || touchOpen);

		contact.addEventListener("pointerenter", () => {
			if (!fineHover.matches) return;
			pointerInside = true;
			sync();
		}, { signal });
		contact.addEventListener("pointerleave", () => {
			if (!fineHover.matches) return;
			pointerInside = false;
			sync();
		}, { signal });
		contact.addEventListener("focusin", sync, { signal });
		contact.addEventListener("focusout", () => requestAnimationFrame(sync), { signal });
		contact.addEventListener("click", (event) => {
			if (fineHover.matches || (event.target as Element).closest("a")) return;
			touchOpen = true;
			sync();
		}, { signal });
		document.addEventListener("pointerdown", (event) => {
			if (fineHover.matches || contact.contains(event.target as Node)) return;
			touchOpen = false;
			sync();
		}, { signal });
		contact.addEventListener("keydown", (event) => {
			if (event.key !== "Escape") return;
			touchOpen = false;
			pointerInside = false;
			setActive(false);
		}, { signal });
		signal.addEventListener("abort", () => {
			if (removeTimer !== undefined) window.clearTimeout(removeTimer);
			gsap.killTweensOf([overlay, ...lines.map(({ element }) => element), ...regions]);
			overlay.remove();
			contact.classList.remove("has-overlay");
		}, { once: true });
	}

	function initHomeMapGuide() {
		cleanupHomeMapGuide();
		const controller = new AbortController();
		const timers = new Set<number>();
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		const observers: IntersectionObserver[] = [];
		const timelines: Array<ReturnType<typeof gsap.timeline>> = [];

		document.querySelectorAll<HTMLElement>("[data-home-map-guide]").forEach((guide) => {
			guide.dataset.guideOpening = "pending";
			const targets = getGuideOpeningTargets(guide);
			const headings = Array.from(guide.querySelectorAll<HTMLElement>(".home-capabilities__heading > *"));
			const cards = targets ? [
				targets.visitCard,
				targets.archiveCard,
				targets.pinnedCard,
				targets.latestCard,
				...targets.dealCards,
			] : [];
			let openingReleased = false;

			const releaseOpening = () => {
				if (openingReleased) return;
				openingReleased = true;
				gsap.set(headings, { clearProps: "opacity,visibility,transform,filter" });
				gsap.set(cards, {
					clearProps: "opacity,visibility,transform,pointerEvents,transformOrigin,zIndex",
				});
				guide.dataset.guideOpening = "complete";
			};

			const playOpening = () => {
				if (guide.dataset.guideOpening !== "pending") return;
				guide.classList.add("is-visible");
				if (!targets || headings.length !== 3) {
					releaseOpening();
					return;
				}

				guide.dataset.guideOpening = "playing";
				const guideRect = guide.getBoundingClientRect();
				const visitRect = targets.visitCard.getBoundingClientRect();
				const archiveRect = targets.archiveCard.getBoundingClientRect();
				const pinnedRect = targets.pinnedCard.getBoundingClientRect();
				const latestRect = targets.latestCard.getBoundingClientRect();
				const dealPoses = getGuideDealPoses(guideRect, targets.dealCards);
				const visitLandingAt = 0.42;
				const dealStartAt = 1;
				const latestEntryAt = dealStartAt + 0.5;

				gsap.set(headings, { autoAlpha: 0, filter: "blur(12px)" });
				gsap.set(cards, { autoAlpha: 1, pointerEvents: "none" });
				gsap.set([targets.visitCard, targets.archiveCard, targets.pinnedCard, ...targets.dealCards], { autoAlpha: 0 });
				gsap.set(targets.visitCard, {
					y: getDropOffset(guideRect, visitRect),
					scaleX: 1,
					scaleY: 1,
					transformOrigin: "50% 100%",
				});
				gsap.set(targets.archiveCard, {
					y: getDropOffset(guideRect, archiveRect),
					scaleX: 1,
					scaleY: 1,
					transformOrigin: "50% 100%",
				});
				gsap.set(targets.pinnedCard, {
					x: getLeftEntryOffset(guideRect, pinnedRect),
					transformOrigin: "50% 50%",
				});
				gsap.set(targets.latestCard, {
					x: getLatestPeekOffset(guideRect, latestRect),
					transformOrigin: "50% 100%",
				});
				dealPoses.forEach(({ element, x, y, rotation, zIndex }) => {
					gsap.set(element, {
						x,
						y,
						scale: 0.92,
						rotation,
						zIndex,
						transformOrigin: "50% 108%",
					});
				});

				const timeline = gsap.timeline({ onComplete: releaseOpening });
				timelines.push(timeline);
				timeline
					.to(headings, {
						autoAlpha: 1,
						filter: "blur(0px)",
						duration: 0.32,
						stagger: 0.06,
						ease: "power2.out",
					}, 0)
					.to(targets.visitCard, {
						autoAlpha: 1,
						y: 0,
						scaleX: 1.012,
						scaleY: 0.976,
						duration: 0.32,
						ease: "power2.in",
					}, 0.1)
					.to(targets.visitCard, { y: -20, scaleX: 1, scaleY: 1, duration: 0.07, ease: "power2.out" }, visitLandingAt)
					.to(targets.visitCard, { y: 0, scaleX: 1.007, scaleY: 0.99, duration: 0.08, ease: "power1.in" }, 0.49)
					.to(targets.visitCard, { y: -9, scaleX: 1, scaleY: 1, duration: 0.06, ease: "power2.out" }, 0.57)
					.to(targets.visitCard, { y: 0, scale: 1, duration: 0.07, ease: "power1.in" }, 0.63)
					.to(targets.archiveCard, {
						autoAlpha: 1,
						y: 0,
						scaleX: 1.009,
						scaleY: 0.982,
						duration: 0.36,
						ease: "power2.in",
					}, visitLandingAt)
					.to(targets.archiveCard, { y: -14, scaleX: 1, scaleY: 1, duration: 0.1, ease: "power2.out" }, 0.78)
					.to(targets.archiveCard, { y: 0, scale: 1, duration: 0.1, ease: "power1.in" }, 0.88)
					.to(targets.pinnedCard, { autoAlpha: 1, x: 0, duration: 0.64, ease: "power4.out" }, 0.32)
					.to(targets.dealCards, { autoAlpha: 1, duration: 0.12, ease: "power2.out" }, dealStartAt)
					.to(targets.dealCards, {
						x: 0,
						y: 0,
						scale: 1,
						rotation: 0,
						duration: 0.28,
						stagger: 0.04,
						ease: "power3.out",
					}, dealStartAt + 0.14)
					.to(targets.latestCard, {
						x: getLatestPeekOffset(guideRect, latestRect) * 0.74,
						rotation: -3.2,
						transformOrigin: "0% 100%",
						duration: 0.12,
						ease: "power1.inOut",
					}, latestEntryAt)
					.to(targets.latestCard, {
						x: getLatestPeekOffset(guideRect, latestRect) * 0.48,
						rotation: 3,
						transformOrigin: "100% 100%",
						duration: 0.12,
						ease: "power1.inOut",
					}, latestEntryAt + 0.12)
					.to(targets.latestCard, {
						x: getLatestPeekOffset(guideRect, latestRect) * 0.22,
						rotation: -1.6,
						transformOrigin: "0% 100%",
						duration: 0.12,
						ease: "power1.inOut",
					}, latestEntryAt + 0.24)
					.to(targets.latestCard, {
						x: 0,
						rotation: 0,
						transformOrigin: "50% 50%",
						duration: 0.14,
						ease: "power2.out",
					}, latestEntryAt + 0.36);
			};

			const observeOpening = () => {
				if (controller.signal.aborted) return;
				if (!("IntersectionObserver" in window)) {
					playOpening();
					return;
				}
				const openingObserver = new IntersectionObserver((entries) => {
					if (!entries.some((entry) => entry.isIntersecting)) return;
					openingObserver.disconnect();
					playOpening();
				}, { rootMargin: "0px 0px -30% 0px" });
				openingObserver.observe(guide);
				observers.push(openingObserver);
			};
			if (reducedMotion.matches || !window.matchMedia("(min-width: 769px)").matches) {
				guide.classList.add("is-visible");
				releaseOpening();
			} else {
				const entrance = document.querySelector<HTMLElement>("[data-home-entrance]");
				if (!entrance || entrance.dataset.homeEntranceState === "complete") {
					observeOpening();
				} else {
					window.addEventListener("firefly:home-entrance-complete", observeOpening, {
						once: true,
						signal: controller.signal,
					});
				}
			}

			initTagFan(guide, controller.signal);
			initGuideRotators(guide, reducedMotion, controller.signal, timers);
			initContactOverlay(guide, controller.signal, timers);
		});

		cleanupHomeMapGuide = () => {
			controller.abort();
			observers.forEach((observer) => observer.disconnect());
			timelines.forEach((timeline) => timeline.kill());
			timers.forEach((timer) => window.clearInterval(timer));
			timers.forEach((timer) => window.clearTimeout(timer));
			timers.clear();
			document.querySelectorAll<HTMLElement>("[data-home-map-guide]").forEach((guide) => {
				const targets = getGuideOpeningTargets(guide);
				const headings = Array.from(guide.querySelectorAll<HTMLElement>(".home-capabilities__heading > *"));
				const cards = targets ? [targets.visitCard, targets.archiveCard, targets.pinnedCard, targets.latestCard, ...targets.dealCards] : [];
				gsap.set(headings, { clearProps: "opacity,visibility,transform,filter" });
				gsap.set(cards, { clearProps: "opacity,visibility,transform,pointerEvents,transformOrigin,zIndex" });
				guide.dataset.guideOpening = "complete";
			});
		};
	}

	initHomeMapGuide();
	document.addEventListener("astro:page-load", initHomeMapGuide);
	document.addEventListener("astro:before-swap", cleanupHomeMapGuide);
</script>
