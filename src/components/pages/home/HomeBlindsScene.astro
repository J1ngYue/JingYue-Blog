---
interface Props {
	index: number;
	item: {
		eyebrow: string;
		title: string;
		description: string;
		image: string;
		alt: string;
	};
}

const { index, item } = Astro.props;
---

<!-- Postcard composition adapted from MmzMing/my-blog. -->
<article
	class:list={["home-blinds-scene", { "home-blinds-scene--raised": index % 2 === 1 }]}
	data-home-exhibit-slide
	data-slide-index={index}
	style={`--scene-offset: ${index > 2 ? index - 5 : index}`}
	aria-label={item.title}
>
	<span class="home-blinds-scene__string" aria-hidden="true"></span>
	<div class="home-blinds-scene__rail" aria-hidden="true">
		<span class="home-blinds-scene__rail-dot"></span>
		<span class="home-blinds-scene__rail-eyebrow">{item.eyebrow}</span>
		<span class="home-blinds-scene__rail-line"></span>
		<span class="home-blinds-scene__rail-title">{item.title}</span>
	</div>
	<div class="home-blinds-scene__card">
		<span class="home-blinds-scene__tape" aria-hidden="true"></span>
		<span class="home-blinds-scene__sticker" aria-hidden="true">{index + 1}</span>
		<div class="home-blinds-scene__frame">
			<img class="home-blinds-scene__image" src={item.image} alt={item.alt} loading="lazy" decoding="async" width="1200" height="900" />
		</div>
		<div class="home-blinds-scene__band">
			<svg class="home-blinds-scene__doodles" viewBox="0 0 720 96" fill="none" preserveAspectRatio="none" aria-hidden="true">
				<path class="home-blinds-scene__doodle-pencil" d="M42 74q12-9 24 0t24 0t24 0" />
				<circle class="home-blinds-scene__doodle-pencil" cx="196" cy="30" r="8" />
				<path class="home-blinds-scene__doodle-accent" d="M664 20l4.5 11 11 4.5-11 4.5-4.5 11-4.5-11-11-4.5 11-4.5z" />
			</svg>
			<p class="home-blinds-scene__caption">{item.description}</p>
			<span class="home-blinds-scene__signature">JingYue
				<svg viewBox="0 0 272 24" fill="none" aria-hidden="true"><path d="M4 12C44 22 100 2 152 10S234 20 268 4" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" /></svg>
			</span>
		</div>
	</div>
</article>
