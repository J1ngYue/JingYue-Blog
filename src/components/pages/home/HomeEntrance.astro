---
const tileSlots = Array.from({ length: 120 });
---

<div class="home-entrance" data-home-entrance aria-hidden="true">
	<div class="home-entrance__mosaic" data-home-entrance-mosaic aria-hidden="true">
		{tileSlots.map(() => (
			<span class="home-entrance__tile" data-home-entrance-tile hidden>
				<i class="home-entrance__tile-image"></i>
			</span>
		))}
	</div>
</div>

<script>
	const ACTIVE_CLASS = "home-entrance-active";
	const PLAYING_CLASS = "home-entrance-playing";
	const COMPLETE_EVENT = "firefly:home-entrance-complete";
	const STAGE_EVENT = "firefly:home-entrance-stage";
	const REVEAL_STAGES = [
		{ name: "wordmark", progress: 0.63 },
		{ name: "clock", progress: 0.75 },
		{ name: "dialogue", progress: 0.82 },
	] as const;

	async function initHomeEntrance() {
		const root = document.querySelector<HTMLElement>(
			"[data-home-entrance]:not([data-home-entrance-ready])",
		);
		if (!root) return;

		root.dataset.homeEntranceReady = "true";
		root.dataset.homeEntranceStage = "cover";
		const html = document.documentElement;
		let finished = false;
		let stageFrame = 0;
		const publishedStages = new Set<string>();

		const publishStage = (stage: string) => {
			if (publishedStages.has(stage)) return;
			publishedStages.add(stage);
			root.dataset.homeEntranceStage = stage;
			window.dispatchEvent(
				new CustomEvent(STAGE_EVENT, { detail: { stage } }),
			);
		};
		const finish = () => {
			if (finished) return;
			finished = true;
			if (stageFrame) cancelAnimationFrame(stageFrame);
			for (const stage of REVEAL_STAGES) publishStage(stage.name);
			root.dataset.homeEntranceState = "complete";
			html.classList.remove(ACTIVE_CLASS, PLAYING_CLASS);
			window.dispatchEvent(new CustomEvent(COMPLETE_EVENT));

			const removeEntrance = () => root.remove();
			if ("requestIdleCallback" in window) {
				window.requestIdleCallback(removeEntrance, { timeout: 2000 });
			} else {
				requestAnimationFrame(() => requestAnimationFrame(removeEntrance));
			}
		};

		html.classList.add(ACTIVE_CLASS);
		window.scrollTo(0, 0);
		requestAnimationFrame(() => window.scrollTo(0, 0));
		const waitForEntryLoader = () =>
			new Promise<void>((resolve) => {
				if (!html.classList.contains("blog-entry-loader-active")) {
					resolve();
					return;
				}
				window.addEventListener("firefly:blog-entry-complete", () => resolve(), {
					once: true,
				});
			});
		const getReadyWallpaperPreview = () => {
			const layer = landing?.querySelector<HTMLElement>(
				'[data-local-wallpaper-surface="home"][data-wallpaper-ready="true"]',
			);
			const image = layer?.querySelector<HTMLImageElement>("img");
			if (image) return image.currentSrc || image.src;
			const video = layer?.querySelector<HTMLVideoElement>("video");
			return video?.poster || "";
		};
		const waitForWallpaperPreview = () =>
			new Promise<string>((resolve) => {
				let settled = false;
				const settle = (previewUrl = "") => {
					if (settled) return;
					settled = true;
					window.clearTimeout(safetyTimer);
					window.removeEventListener(
						"firefly:home-wallpaper-ready",
						handleReady,
					);
					resolve(previewUrl);
				};
				const handleReady = (event: Event) => {
					const detail = (
						event as CustomEvent<{
							previewUrl?: string;
							fallback?: boolean;
							skipped?: boolean;
						}>
					).detail;
					settle(
						detail?.fallback || detail?.skipped
							? ""
							: detail?.previewUrl || getReadyWallpaperPreview(),
					);
				};
				window.addEventListener("firefly:home-wallpaper-ready", handleReady);
				const safetyTimer = window.setTimeout(() => settle(), 12_000);
				const readyPreview = getReadyWallpaperPreview();
				if (readyPreview) settle(readyPreview);
			});

		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			finish();
			return;
		}

		const landing = root.closest<HTMLElement>("[data-home-landing]");
		const wallpaperPromise = waitForWallpaperPreview();
		const entryLoaderPromise = waitForEntryLoader();
		const wallpaperUrl = await wallpaperPromise;
		if (!root.isConnected) return;
		if (!wallpaperUrl) {
			await entryLoaderPromise;
			finish();
			return;
		}

		root.style.setProperty(
			"--home-entrance-wallpaper",
			`url(${JSON.stringify(wallpaperUrl)})`,
		);

		const tiles = Array.from(
			root.querySelectorAll<HTMLElement>("[data-home-entrance-tile]"),
		);
		const layoutTiles = () => {
			const { width: entranceWidth, height: entranceHeight } =
				root.getBoundingClientRect();
			root.style.setProperty("--home-entrance-width", `${entranceWidth}px`);
			root.style.setProperty("--home-entrance-height", `${entranceHeight}px`);
			const columns =
				entranceWidth <= 640 ? 5 : entranceWidth < entranceHeight ? 6 : 10;
			const tileSize = Math.ceil(entranceWidth / columns);
			const rows = Math.ceil(entranceHeight / tileSize);
			const activeCount = columns * rows;

			tiles.forEach((tile, index) => {
				const active = index < activeCount;
				tile.hidden = !active;
				if (!active) return;

				const column = index % columns;
				const row = Math.floor(index / columns);
				const left = column * tileSize;
				const top = row * tileSize;
				const wave = (column + row * 2) % 6;
				const offsetX = Math.round(
					(((index * 37) % 9) - 4) * tileSize * 0.62,
				);
				const offsetY = Math.round(
					(((index * 53) % 11) - 5) * tileSize * 0.52,
				);

				tile.style.setProperty("--tile-left", `${left}px`);
				tile.style.setProperty("--tile-top", `${top}px`);
				tile.style.setProperty("--tile-size", `${tileSize}px`);
				tile.style.setProperty("--tile-offset-x", `${offsetX}px`);
				tile.style.setProperty("--tile-offset-y", `${offsetY}px`);
				tile.style.setProperty("--tile-delay", `${0.03 + wave * 0.11}s`);
			});
		};
		layoutTiles();
		const geometryObserver = new ResizeObserver(layoutTiles);
		geometryObserver.observe(root);

		tiles.forEach((tile) => {
			tile.addEventListener(
				"animationend",
				(event) => {
					if (event.animationName === "home-entrance-tile") {
						tile.dataset.tileSettled = "true";
					}
				},
				{ once: true },
			);
		});
		await entryLoaderPromise;
		if (!root.isConnected) return;

		const handleAnimationEnd = (event: AnimationEvent) => {
			if (event.target !== root || event.animationName !== "home-entrance-finish") {
				return;
			}
			root.removeEventListener("animationend", handleAnimationEnd);
			geometryObserver.disconnect();
			for (const tile of tiles) tile.dataset.tileSettled = "true";
			finish();
		};
		root.addEventListener("animationend", handleAnimationEnd);
		root.dataset.homeEntrancePlaying = "true";
		html.classList.add(PLAYING_CLASS);

		const updateStages = () => {
			const animation = root
				.getAnimations()
				.find(
					(item) =>
						item instanceof CSSAnimation &&
						item.animationName === "home-entrance-finish",
				);
			const timing = animation?.effect?.getComputedTiming();
			const currentTime = Number(animation?.currentTime);
			const duration = Number(timing?.duration);
			if (Number.isFinite(currentTime) && Number.isFinite(duration) && duration > 0) {
				const progress = Math.min(1, Math.max(0, currentTime / duration));
				for (const stage of REVEAL_STAGES) {
					if (progress >= stage.progress) publishStage(stage.name);
				}
			}
			if (!finished && root.isConnected) {
				stageFrame = requestAnimationFrame(updateStages);
			}
		};
		stageFrame = requestAnimationFrame(updateStages);
	}

	initHomeEntrance();
	document.addEventListener("astro:page-load", initHomeEntrance);
	document.addEventListener("astro:before-swap", () => {
		document.documentElement.classList.remove(ACTIVE_CLASS, PLAYING_CLASS);
	});
</script>

<style>
	.home-entrance {
		--home-entrance-duration: 3.2s;
		--home-puzzle-duration: 1.78s;
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		background:
			radial-gradient(circle at 68% 18%, rgb(39 72 108 / 0.22), transparent 34%),
			linear-gradient(150deg, #05070a 0%, #0b111a 52%, #05070a 100%);
		pointer-events: none;
		will-change: opacity;
		contain: paint;
	}

	.home-entrance[data-home-entrance-playing="true"] {
		animation: home-entrance-finish var(--home-entrance-duration) cubic-bezier(0.45, 0, 0.2, 1) both;
	}

	.home-entrance::after {
		position: absolute;
		inset: 0;
		z-index: 4;
		background:
			linear-gradient(90deg, rgba(7, 13, 19, 0.58), rgba(7, 13, 19, 0.12) 58%, rgba(7, 13, 19, 0.36)),
			linear-gradient(180deg, rgba(7, 13, 19, 0.08), rgba(7, 13, 19, 0.3));
		content: "";
		opacity: 1;
		pointer-events: none;
	}

	:global(.home-landing.has-local-wallpaper) .home-entrance::after,
	:global(html[data-has-local-wallpaper="true"]:not([data-wallpaper-mode="none"])) .home-entrance::after {
		background: transparent;
	}

	.home-entrance__mosaic {
		position: absolute;
		inset: 0;
		z-index: 3;
		overflow: hidden;
	}

	.home-entrance__tile {
		position: absolute;
		top: var(--tile-top);
		left: var(--tile-left);
		display: block;
		width: calc(var(--tile-size) + 1px);
		height: calc(var(--tile-size) + 1px);
		overflow: hidden;
		border: 0;
		box-shadow: none;
	}

	.home-entrance[data-home-entrance-playing="true"] .home-entrance__tile-image {
		animation: home-entrance-tile var(--home-puzzle-duration) var(--tile-delay) cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.home-entrance__tile[hidden] {
		display: none;
	}

	.home-entrance__tile[data-tile-settled="true"] .home-entrance__tile-image {
		animation: none !important;
		opacity: 1;
		transform: none;
	}

	.home-entrance__tile-image {
		position: absolute;
		inset: 0;
		display: block;
		overflow: hidden;
		opacity: 0;
	}

	.home-entrance__tile-image::before {
		position: absolute;
		top: calc(var(--home-wallpaper-offset-y, 0px) - var(--tile-top));
		left: calc(var(--home-wallpaper-offset-x, 0px) - var(--tile-left));
		width: var(--home-wallpaper-render-width, var(--home-entrance-width));
		height: var(--home-wallpaper-render-height, var(--home-entrance-height));
		background-image: var(--home-entrance-wallpaper, none);
		background-position: 0 0;
		background-repeat: no-repeat;
		background-size: 100% 100%;
		content: "";
	}

	@keyframes home-entrance-tile {
		0% {
			opacity: 0;
			transform: translate(var(--tile-offset-x), var(--tile-offset-y));
		}
		12% {
			opacity: 1;
		}
		76%,
		100% {
			opacity: 1;
			transform: translate(0, 0);
		}
	}

	@keyframes home-entrance-finish {
		0%,
		88% {
			opacity: 1;
			visibility: visible;
		}
		94% {
			opacity: 0.62;
			visibility: visible;
		}
		98% {
			opacity: 0.18;
			visibility: visible;
		}
		100% {
			opacity: 0;
			visibility: hidden;
		}
	}

	/* 入场时也保留视口滚动轨道，避免拼图完成后滚动条出现导致整页变窄。 */
	:global(html.home-entrance-active) {
		overflow-y: scroll !important;
		overflow-x: clip !important;
		scrollbar-gutter: stable;
	}

	:global(html.home-entrance-active body) {
		overflow-x: clip !important;
	}

	@media (prefers-reduced-motion: reduce) {
		.home-entrance {
			display: none;
		}
	}
</style>
