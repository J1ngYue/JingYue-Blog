---
import { Icon } from "astro-icon/components";
import {
	linkDirectoryCategories,
	linkDirectoryItems,
} from "@/config/linkDirectory";
import { siteConfig } from "@/config/siteConfig";
import { url } from "@/utils/url-utils";

const categoryMeta = {
	我的网站: {
		icon: "material-symbols:space-dashboard-outline-rounded",
		description: "站内内容与互动入口",
	},
	常用网站: {
		icon: "material-symbols:star-outline-rounded",
		description: "日常访问的网络服务",
	},
	资源网站: {
		icon: "material-symbols:inventory-2-outline-rounded",
		description: "主题、素材与开发资源",
	},
	工具网站: {
		icon: "material-symbols:construction-rounded",
		description: "提升效率的实用工具",
	},
	学习网站: {
		icon: "material-symbols:school-outline-rounded",
		description: "系统课程与技术教程",
	},
	文档: {
		icon: "material-symbols:description-outline-rounded",
		description: "常用框架官方参考",
	},
	"AI 工具": {
		icon: "material-symbols:auto-awesome-rounded",
		description: "创作、研究与协作助手",
	},
} as const;

const categoryCounts = new Map(
	linkDirectoryCategories.map((category) => [
		category,
		linkDirectoryItems.filter((item) => item.category === category).length,
	]),
);
const internalCount = linkDirectoryItems.filter(
	(item) => !item.external,
).length;
const externalCount = linkDirectoryItems.length - internalCount;

const getLinkHref = (href: string, external?: boolean) =>
	external ? href : url(href);
const getHostname = (href: string, external?: boolean) => {
	if (!external) return siteConfig.title;
	try {
		return new URL(href).hostname.replace(/^www\./, "");
	} catch {
		return href;
	}
};
---

<section
	class="site-directory"
	data-site-directory
	data-view="grid"
	aria-labelledby="site-directory-title"
>
	<header class="site-directory__hero">
		<div class="site-directory__intro">
			<p><Icon is:inline name="material-symbols:bookmark-rounded" /> NAVIGATION</p>
			<h1 id="site-directory-title">网站导航</h1>
			<span>在一个地方找到站内入口、常用服务和可靠的学习资源。</span>
		</div>

		<div class="site-directory__overview" aria-label="导航概览">
			<div>
				<Icon is:inline name="material-symbols:link-rounded" />
				<span>全部链接</span>
				<strong>{linkDirectoryItems.length}</strong>
			</div>
			<div>
				<Icon is:inline name="material-symbols:category-outline-rounded" />
				<span>内容分类</span>
				<strong>{linkDirectoryCategories.length}</strong>
			</div>
			<div>
				<Icon is:inline name="material-symbols:home-app-logo" />
				<span>站内入口</span>
				<strong>{internalCount}</strong>
			</div>
			<div>
				<Icon is:inline name="material-symbols:travel-explore-rounded" />
				<span>外部资源</span>
				<strong>{externalCount}</strong>
			</div>
		</div>
	</header>

	<section class="site-directory__controls" aria-label="搜索与显示设置">
		<label class="site-directory__search">
			<Icon is:inline name="material-symbols:search-rounded" />
			<span class="sr-only">搜索网站</span>
			<input
				type="search"
				placeholder="搜索名称、描述或域名"
				autocomplete="off"
				data-directory-search
			/>
			<button type="button" data-directory-clear hidden aria-label="清空搜索">
				<Icon is:inline name="material-symbols:close-rounded" />
			</button>
		</label>

		<div class="site-directory__control-meta">
			<span data-directory-result role="status">显示全部 {linkDirectoryItems.length} 个链接</span>
			<button
				type="button"
				class="site-directory__view"
				data-directory-view
				aria-label="切换为列表视图"
				title="切换布局"
			>
				<Icon is:inline class="directory-view-grid" name="material-symbols:grid-view-rounded" />
				<Icon is:inline class="directory-view-list" name="material-symbols:view-list-rounded" />
			</button>
		</div>
	</section>

	<nav class="site-directory__filters" aria-label="网站分类">
		<button type="button" class="is-active" data-directory-filter="">
			<span>全部</span><small>{linkDirectoryItems.length}</small>
		</button>
		{linkDirectoryCategories.map((category) => (
			<button type="button" data-directory-filter={category}>
				<Icon is:inline name={categoryMeta[category].icon} />
				<span>{category}</span><small>{categoryCounts.get(category)}</small>
			</button>
		))}
	</nav>

	<div class="site-directory__empty" data-directory-empty hidden>
		<Icon is:inline name="material-symbols:search-off-rounded" />
		<strong>没有找到匹配的网站</strong>
		<span>换一个关键词，或查看其他分类。</span>
		<button type="button" data-directory-reset>查看全部链接</button>
	</div>

	<div class="site-directory__groups">
		{linkDirectoryCategories.map((category, categoryIndex) => {
			const items = linkDirectoryItems.filter((item) => item.category === category);
			const meta = categoryMeta[category];
			return (
				<section
					class="site-directory__group"
					data-directory-group={category}
					style={`--directory-group-index: ${categoryIndex}`}
				>
					<header>
						<span class="site-directory__group-icon">
							<Icon is:inline name={meta.icon} />
						</span>
						<div>
							<h2>{category}</h2>
							<p>{meta.description}</p>
						</div>
						<small>{items.length} 个链接</small>
					</header>

					<div class="site-directory__grid">
						{items.map((item) => {
							const hostname = getHostname(item.href, item.external);
							const searchText = `${item.title} ${item.description} ${hostname}`.toLocaleLowerCase();
							return (
								<a
									class="site-directory__card"
									href={getLinkHref(item.href, item.external)}
									target={item.external ? "_blank" : undefined}
									rel={item.external ? "noopener noreferrer" : undefined}
									data-directory-card
									data-category={item.category}
									data-search={searchText}
								>
									<div class="site-directory__card-heading">
										<span
											class:list={[
												"site-directory__card-icon",
												{ "site-directory__card-icon--brand": item.external },
											]}
											style={`--directory-icon-color: ${item.iconColor}; --directory-icon-color-dark: ${item.iconColorDark ?? item.iconColor}`}
										>
											<Icon is:inline name={item.icon} />
										</span>
										<div>
											<h3>{item.title}</h3>
											<small>{item.external ? "外部资源" : "站内入口"}</small>
										</div>
									</div>
									<p>{item.description}</p>
									<footer>
										<span>{hostname}</span>
										<Icon
											is:inline
											name={item.external
												? "material-symbols:arrow-outward-rounded"
												: "material-symbols:arrow-forward-rounded"}
										/>
									</footer>
								</a>
							);
						})}
					</div>
				</section>
			);
		})}
	</div>
</section>

<script>
	function initSiteDirectory() {
		const root = document.querySelector<HTMLElement>("[data-site-directory]");
		if (!root || root.dataset.bound === "true") return;
		root.dataset.bound = "true";

		const filterButtons = Array.from(
			root.querySelectorAll<HTMLButtonElement>("[data-directory-filter]"),
		);
		const groups = Array.from(
			root.querySelectorAll<HTMLElement>("[data-directory-group]"),
		);
		const cards = Array.from(
			root.querySelectorAll<HTMLElement>("[data-directory-card]"),
		);
		const searchInput = root.querySelector<HTMLInputElement>("[data-directory-search]");
		const clearButton = root.querySelector<HTMLButtonElement>("[data-directory-clear]");
		const resetButton = root.querySelector<HTMLButtonElement>("[data-directory-reset]");
		const emptyState = root.querySelector<HTMLElement>("[data-directory-empty]");
		const result = root.querySelector<HTMLElement>("[data-directory-result]");
		const viewButton = root.querySelector<HTMLButtonElement>("[data-directory-view]");
		let activeCategory = "";

		const applyDirectoryState = (updateUrl = true) => {
			const query = searchInput?.value.trim().toLocaleLowerCase() || "";
			let visibleCount = 0;

			cards.forEach((card) => {
				const categoryMatches = !activeCategory || card.dataset.category === activeCategory;
				const queryMatches = !query || card.dataset.search?.includes(query);
				card.hidden = !(categoryMatches && queryMatches);
				if (!card.hidden) visibleCount += 1;
			});

			groups.forEach((group) => {
				group.hidden = !Array.from(
					group.querySelectorAll<HTMLElement>("[data-directory-card]"),
				).some((card) => !card.hidden);
			});

			filterButtons.forEach((button) => {
				const active = (button.dataset.directoryFilter || "") === activeCategory;
				button.classList.toggle("is-active", active);
				button.setAttribute("aria-pressed", String(active));
			});

			if (clearButton) clearButton.hidden = !query;
			if (emptyState) emptyState.hidden = visibleCount > 0;
			if (result) {
				result.textContent = query || activeCategory
					? `找到 ${visibleCount} 个链接`
					: `显示全部 ${visibleCount} 个链接`;
			}

			if (updateUrl) {
				const nextUrl = new URL(window.location.href);
				if (activeCategory) nextUrl.searchParams.set("category", activeCategory);
				else nextUrl.searchParams.delete("category");
				if (query) nextUrl.searchParams.set("q", query);
				else nextUrl.searchParams.delete("q");
				history.replaceState(history.state, "", nextUrl);
			}
		};

		const applyView = (view: "grid" | "list") => {
			root.dataset.view = view;
			viewButton?.setAttribute(
				"aria-label",
				view === "grid" ? "切换为列表视图" : "切换为网格视图",
			);
			localStorage.setItem("jingyue-directory-view", view);
		};

		filterButtons.forEach((button) => {
			button.addEventListener("click", () => {
				activeCategory = button.dataset.directoryFilter || "";
				applyDirectoryState();
			});
		});
		searchInput?.addEventListener("input", () => applyDirectoryState());
		searchInput?.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && searchInput.value) {
				searchInput.value = "";
				applyDirectoryState();
			}
		});
		clearButton?.addEventListener("click", () => {
			if (!searchInput) return;
			searchInput.value = "";
			searchInput.focus();
			applyDirectoryState();
		});
		resetButton?.addEventListener("click", () => {
			activeCategory = "";
			if (searchInput) searchInput.value = "";
			applyDirectoryState();
			searchInput?.focus();
		});
		viewButton?.addEventListener("click", () => {
			applyView(root.dataset.view === "list" ? "grid" : "list");
		});

		const requested = new URL(window.location.href);
		const requestedCategory = requested.searchParams.get("category") || "";
		activeCategory = filterButtons.some(
			(button) => button.dataset.directoryFilter === requestedCategory,
		)
			? requestedCategory
			: "";
		if (searchInput) searchInput.value = requested.searchParams.get("q") || "";
		applyDirectoryState(false);
		applyView(localStorage.getItem("jingyue-directory-view") === "list" ? "list" : "grid");
	}

	initSiteDirectory();
	document.addEventListener("swup:contentReplaced", initSiteDirectory);
</script>

<style>
	.site-directory {
		--directory-text: #11171a;
		--directory-muted: #5f6d74;
		--directory-subtle: #8a969c;
		--directory-surface: #fff;
		--directory-surface-soft: #f5f8f8;
		--directory-line: rgb(28 47 55 / 14%);
		--directory-card-line: rgb(17 23 26 / 38%);
		--directory-card-line-hover: #11171a;
		box-sizing: border-box;
		width: min(88rem, calc(100vw - 2rem));
		min-width: 0;
		margin: 0 auto;
		padding: 0.5rem 0 4rem;
		color: var(--directory-muted);
	}

	:global(html.dark) .site-directory {
		--directory-text: #f5f7f8;
		--directory-muted: #c1c9cd;
		--directory-subtle: #7f8b91;
		--directory-surface: #171c20;
		--directory-surface-soft: #11171a;
		--directory-line: rgb(226 237 241 / 14%);
		--directory-card-line: rgb(245 247 248 / 30%);
		--directory-card-line-hover: #f5f7f8;
	}

	.site-directory__hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 2rem;
		padding: 1.3rem 0 1.6rem;
		border-bottom: 1px solid var(--directory-line);
	}

	.site-directory__intro > p {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		color: var(--directory-muted);
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 0.72rem;
		font-weight: 750;
	}

	.site-directory__intro > p svg {
		width: 1.05rem;
		height: 1.05rem;
		color: var(--ui-icon-color);
	}

	.site-directory__intro h1 {
		margin: 0.5rem 0 0;
		color: var(--directory-text);
		font-size: 3rem;
		line-height: 1;
		letter-spacing: 0;
	}

	.site-directory__intro > span {
		display: block;
		max-width: 42rem;
		margin-top: 0.85rem;
		color: var(--directory-muted);
		font-size: 0.98rem;
		line-height: 1.65;
	}

	.site-directory__overview {
		display: grid;
		grid-template-columns: repeat(4, minmax(7.25rem, 1fr));
		gap: 0.55rem;
	}

	.site-directory__overview > div {
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto auto;
		column-gap: 0.5rem;
		padding: 0.7rem 0.8rem;
		border-left: 2px solid var(--directory-line);
	}

	.site-directory__overview svg {
		grid-row: 1 / 3;
		align-self: center;
		width: 1.2rem;
		height: 1.2rem;
		color: var(--ui-icon-color);
	}

	.site-directory__overview span {
		color: var(--directory-subtle);
		font-size: 0.68rem;
	}

	.site-directory__overview strong {
		color: var(--directory-text);
		font-size: 1.05rem;
		line-height: 1.2;
	}

	.site-directory__controls {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.25rem 0 0.8rem;
	}

	.site-directory__search {
		display: flex;
		width: min(31rem, 100%);
		height: 2.8rem;
		align-items: center;
		gap: 0.6rem;
		padding: 0 0.8rem;
		border: 1px solid var(--directory-line);
		border-radius: 0.5rem;
		background: var(--directory-surface);
		transition: border-color 180ms ease, box-shadow 180ms ease;
	}

	.site-directory__search:focus-within {
		border-color: var(--primary);
		box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--primary) 13%, transparent);
	}

	.site-directory__search > svg {
		width: 1.2rem;
		height: 1.2rem;
		flex: 0 0 auto;
		color: var(--directory-subtle);
	}

	.site-directory__search input {
		width: 100%;
		min-width: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--directory-text);
		font: inherit;
		font-size: 0.86rem;
	}

	.site-directory__search input::placeholder {
		color: var(--directory-subtle);
	}

	.site-directory__search button,
	.site-directory__view {
		display: grid;
		place-items: center;
		border: 0;
		background: transparent;
		color: var(--directory-muted);
		cursor: pointer;
	}

	.site-directory__search button {
		width: 2rem;
		height: 2rem;
		flex: 0 0 auto;
		border-radius: 0.35rem;
	}

	.site-directory__search button:hover {
		background: var(--directory-surface-soft);
		color: var(--directory-text);
	}

	.site-directory__control-meta {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		color: var(--directory-subtle);
		font-size: 0.76rem;
	}

	.site-directory__view {
		width: 2.8rem;
		height: 2.8rem;
		border: 1px solid var(--directory-line);
		border-radius: 0.5rem;
		background: var(--directory-surface);
		transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease;
	}

	.site-directory__view:hover {
		border-color: var(--primary);
		background: color-mix(in srgb, var(--primary) 8%, var(--directory-surface));
		color: var(--primary);
	}

	.site-directory__view svg {
		width: 1.25rem;
		height: 1.25rem;
	}

	.site-directory__view .directory-view-list,
	.site-directory[data-view="list"] .directory-view-grid {
		display: none;
	}

	.site-directory[data-view="list"] .directory-view-list {
		display: block;
	}

	.site-directory__filters {
		display: flex;
		gap: 0.45rem;
		margin-bottom: 2rem;
		overflow-x: auto;
		padding: 0.35rem 0 0.65rem;
		scrollbar-width: none;
	}

	.site-directory__filters::-webkit-scrollbar {
		display: none;
	}

	.site-directory__filters button {
		display: inline-flex;
		min-height: 2.35rem;
		align-items: center;
		gap: 0.38rem;
		flex: 0 0 auto;
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--directory-line);
		border-radius: 0.45rem;
		background: var(--directory-surface);
		color: var(--directory-muted);
		cursor: pointer;
		font: inherit;
		font-size: 0.78rem;
		font-weight: 650;
		transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease;
	}

	.site-directory__filters button svg {
		width: 1rem;
		height: 1rem;
	}

	.site-directory__filters button.is-active,
	.site-directory__filters button:hover {
		border-color: var(--directory-text);
		background: var(--directory-text);
		color: var(--directory-surface);
	}

	.site-directory__filters small {
		min-width: 1.2rem;
		padding: 0.06rem 0.28rem;
		border-radius: 99rem;
		background: color-mix(in srgb, currentColor 12%, transparent);
		font-size: 0.64rem;
		text-align: center;
	}

	.site-directory__groups {
		display: grid;
		gap: 2.5rem;
	}

	.site-directory__group[hidden],
	.site-directory__card[hidden],
	.site-directory__empty[hidden],
	.site-directory__search button[hidden] {
		display: none;
	}

	.site-directory__group > header {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.9rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--directory-line);
	}

	.site-directory__group-icon {
		display: grid;
		width: 2.45rem;
		height: 2.45rem;
		place-items: center;
		border-radius: 0.45rem;
		background: var(--ui-icon-soft-bg);
		color: var(--ui-icon-color);
	}

	.site-directory__group-icon svg {
		width: 1.25rem;
		height: 1.25rem;
	}

	.site-directory__group h2,
	.site-directory__group p {
		margin: 0;
	}

	.site-directory__group h2 {
		color: var(--directory-text);
		font-size: 1rem;
		letter-spacing: 0;
	}

	.site-directory__group header p {
		margin-top: 0.12rem;
		color: var(--directory-subtle);
		font-size: 0.72rem;
	}

	.site-directory__group header > small {
		color: var(--directory-subtle);
		font-size: 0.7rem;
	}

	.site-directory__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.site-directory[data-view="list"] .site-directory__grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.site-directory__card {
		display: flex;
		min-width: 0;
		min-height: 10rem;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1rem;
		border: 2px solid var(--directory-card-line);
		border-radius: 0.5rem;
		background: var(--directory-surface);
		color: inherit;
		text-decoration: none;
		transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
	}

	.site-directory__card:hover {
		border-color: var(--directory-card-line-hover);
		box-shadow: 0 0.8rem 1.8rem rgb(20 24 26 / 10%);
		transform: translateY(-0.15rem);
	}

	.site-directory__card-heading {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 0.7rem;
	}

	.site-directory__card-icon {
		display: grid;
		width: 2.5rem;
		height: 2.5rem;
		flex: 0 0 auto;
		place-items: center;
		border-radius: 0.5rem;
		background: var(--ui-icon-soft-bg);
		box-shadow: inset 0 0 0 1px var(--ui-icon-border);
		color: var(--ui-icon-color);
	}

	.site-directory__card-icon--brand {
		background: color-mix(in srgb, var(--directory-icon-color) 13%, var(--directory-surface));
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--directory-icon-color) 18%, transparent);
		color: var(--directory-icon-color);
	}

	:global(html.dark) .site-directory__card-icon--brand {
		background: color-mix(in srgb, var(--directory-icon-color-dark) 16%, var(--directory-surface));
		color: var(--directory-icon-color-dark);
	}

	.site-directory__card-icon svg {
		width: 1.25rem;
		height: 1.25rem;
	}

	.site-directory__card-heading > div {
		min-width: 0;
	}

	.site-directory__card h3 {
		overflow: hidden;
