---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import {
	type NotebookDefinition,
	notebookDefinitions,
} from "@/config/notebookConfig";

interface Props {
	notebook: NotebookDefinition;
	notes: CollectionEntry<"notebooks">[];
}

const { notebook, notes } = Astro.props;
const sortedNotes = [...notes].sort(
	(a, b) => b.data.published.getTime() - a.data.published.getTime(),
);
const currentYear =
	sortedNotes[0]?.data.published.getFullYear() || new Date().getFullYear();
const activity = Array.from({ length: 12 }, (_, month) => ({
	month,
	count: sortedNotes.filter(
		(note) =>
			note.data.published.getFullYear() === currentYear &&
			note.data.published.getMonth() === month,
	).length,
}));

const groups = new Map<string, CollectionEntry<"notebooks">[]>();
for (const note of sortedNotes) {
	const key = `${note.data.published.getFullYear()}-${note.data.published.getMonth()}`;
	groups.set(key, [...(groups.get(key) || []), note]);
}
const groupedNotes = Array.from(groups.entries()).map(([key, entries]) => {
	const [year, month] = key.split("-").map(Number);
	return { year, month, entries };
});

const notebookIcons: Record<string, string> = {
	engineering: "material-symbols:code-blocks-outline-rounded",
	"daily-review": "material-symbols:fact-check-outline-rounded",
	inspiration: "material-symbols:lightbulb-outline-rounded",
	learning: "material-symbols:school-outline-rounded",
	"media-notes": "material-symbols:movie-outline-rounded",
	"life-list": "material-symbols:checklist-rounded",
};

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat("zh-CN", {
		month: "2-digit",
		day: "2-digit",
		timeZone: "Asia/Shanghai",
	})
		.format(date)
		.replace("/", "-");
---

<div class="notebook-collection">
	<nav class="notebook-breadcrumb" aria-label="面包屑">
		<a href="/life/notebooks/">笔记本</a>
		<Icon is:inline name="material-symbols:chevron-right-rounded" />
		<span aria-current="page">{notebook.title}</span>
	</nav>

	<nav class="notebook-switcher" aria-label="切换笔记本">
		{notebookDefinitions.map((item) => (
			<a
				href={`/life/notebooks/${item.slug}/`}
				class:list={[item.slug === notebook.slug && "is-active"]}
				aria-current={item.slug === notebook.slug ? "page" : undefined}
			>
				<Icon is:inline name={notebookIcons[item.slug]} aria-hidden="true" />
				{item.title}
			</a>
		))}
	</nav>

	<section class="notebook-activity" aria-labelledby="notebook-activity-title">
		<header>
			<div>
				<p>NOTEBOOK ACTIVITY</p>
				<h2 id="notebook-activity-title">
					<Icon is:inline name="material-symbols:calendar-month-outline-rounded" aria-hidden="true" />
					{currentYear} 年笔记足迹
				</h2>
			</div>
			<span>
				<Icon is:inline name="material-symbols:description-outline-rounded" aria-hidden="true" />
				{sortedNotes.length} 篇
			</span>
		</header>
		<div class="notebook-activity__months" role="list" aria-label={`${currentYear} 年每月笔记数量`}>
			{activity.map((item) => (
				<div
					role="listitem"
					class:list={["notebook-activity__month", item.count > 0 && "has-notes"]}
					aria-label={`${item.month + 1} 月，${item.count} 篇笔记`}
				>
					<i aria-hidden="true">
						<Icon is:inline name="material-symbols:edit-note-outline-rounded" />
						<strong>{item.count}</strong>
						<small>篇</small>
					</i>
					<span>{item.month + 1}月</span>
				</div>
			))}
		</div>
	</section>

	<div class="notebook-timeline">
		{groupedNotes.length > 0 ? (
			groupedNotes.map((group, index) => (
				<section class="notebook-timeline__group">
					<header>
						{index === 0 || groupedNotes[index - 1]?.year !== group.year ? (
							<strong>{group.year} 年</strong>
						) : (
							<span aria-hidden="true"></span>
						)}
						<h2>{group.month + 1} 月</h2>
						<small>{group.entries.length} 篇</small>
					</header>
					<div>
						{group.entries.map((note) => (
							<a
								class="notebook-timeline__entry"
								href={`/life/notebooks/${notebook.slug}/${note.data.slug}/`}
							>
								<span class="notebook-timeline__date">
									<Icon is:inline name="material-symbols:calendar-month-outline-rounded" aria-hidden="true" />
									<time datetime={note.data.published.toISOString()}>{formatDate(note.data.published)}</time>
								</span>
								<span class="notebook-timeline__type">
									<Icon is:inline name="material-symbols:description-outline-rounded" aria-hidden="true" />
									笔记
								</span>
								<span class="notebook-timeline__content">
									<strong>{note.data.title}</strong>
									<small>{note.data.description}</small>
								</span>
								<Icon is:inline name="material-symbols:arrow-forward-rounded" />
							</a>
						))}
					</div>
				</section>
			))
		) : (
			<div class="notebook-empty">
				<Icon is:inline name="material-symbols:edit-note-rounded" />
				<h2>还没有笔记</h2>
				<p>下一次灵感到来时，就从这里写下第一句。</p>
			</div>
		)}
	</div>
</div>

<style>
	.notebook-collection {
		--timeline-line: color-mix(in srgb, var(--record-ink) 19%, transparent);
		--notebook-outline: color-mix(in srgb, var(--record-ink) 30%, transparent);
		--notebook-paper: color-mix(in srgb, var(--card-bg) 97%, transparent);
		min-width: 0;
	}

	.notebook-breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		margin-bottom: 0.9rem;
		color: var(--content-meta);
		font-size: 0.76rem;
	}

	.notebook-breadcrumb a {
		color: inherit;
		transition: color 150ms ease;
	}

	.notebook-breadcrumb a:hover {
		color: var(--record-ink);
	}

	.notebook-breadcrumb :global(svg) {
		width: 0.95rem;
		height: 0.95rem;
	}

	.notebook-switcher {
		display: flex;
		gap: 0.45rem;
		overflow-x: auto;
		padding: 0.2rem 0 0.8rem;
		scrollbar-width: thin;
	}

	.notebook-switcher a {
		flex: 0 0 auto;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border: 1px solid var(--notebook-outline);
		border-radius: 0.4rem;
		padding: 0.46rem 0.8rem;
		background: var(--notebook-paper);
		color: var(--record-ink);
		font-size: 0.8rem;
		font-weight: 650;
		transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
	}

	.notebook-switcher a:hover,
	.notebook-switcher a:focus-visible {
		border-color: var(--record-ink);
		background: var(--notebook-paper);
		box-shadow: inset 0 0 0 1px var(--record-ink);
		color: var(--record-ink);
	}

	.notebook-switcher a:focus-visible {
		outline: 0.12rem solid var(--record-ink);
		outline-offset: 0.12rem;
	}

	.notebook-switcher a.is-active {
		border-color: var(--record-ink);
		background: var(--notebook-paper);
		box-shadow: inset 0 0 0 1px var(--record-ink);
		color: var(--record-ink);
	}

	.notebook-switcher a :global(svg) {
		width: 1rem;
		height: 1rem;
		flex: 0 0 auto;
	}

	.notebook-activity {
		margin-top: 0.5rem;
		border: 1px solid var(--notebook-outline);
		border-radius: 0.55rem;
		padding: 1rem;
		background: var(--notebook-paper);
		box-shadow: 0 0.45rem 1rem rgb(0 0 0 / 4%);
	}

	.notebook-activity header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
	}

	.notebook-activity header p {
		margin: 0;
		color: var(--record-ink);
		font-family: inherit;
		font-size: 0.62rem;
		font-weight: 750;
		letter-spacing: 0;
	}

	.notebook-activity header h2 {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0.25rem 0 0;
		font-size: 1rem;
		font-weight: 800;
	}

	.notebook-activity header > span {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		border: 1px solid var(--record-ink);
		border-radius: 0.35rem;
		background: var(--notebook-paper);
		padding: 0.3rem 0.65rem;
		box-shadow: inset 0 0 0 1px var(--record-ink);
		color: var(--record-ink);
		font-size: 0.7rem;
	}

	.notebook-activity header :global(svg) {
		width: 1rem;
		height: 1rem;
		flex: 0 0 auto;
	}

	.notebook-activity__months {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 0.4rem;
		margin-top: 0.9rem;
	}

	.notebook-activity__month {
		display: grid;
		gap: 0.35rem;
		text-align: center;
	}

	.notebook-activity__month i {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.2rem;
		min-height: 2.7rem;
		border: 1px solid var(--notebook-outline);
		border-radius: 0.25rem;
		background: var(--notebook-paper);
		color: var(--content-meta);
		font-style: normal;
	}

	.notebook-activity__month.has-notes i {
		border-color: var(--record-ink);
		background: var(--notebook-paper);
		box-shadow: inset 0 0 0 1px var(--record-ink), 0 0.35rem 0.85rem rgb(0 0 0 / 7%);
		color: var(--record-ink);
	}

	.notebook-activity__month i :global(svg) {
		width: 0.9rem;
		height: 0.9rem;
	}

	.notebook-activity__month i strong {
		font-size: 0.72rem;
		font-variant-numeric: tabular-nums;
	}

	.notebook-activity__month i small {
		font-size: 0.56rem;
		font-style: normal;
	}

	.notebook-activity__month span {
		color: var(--content-meta);
		font-size: 0.6rem;
	}

	.notebook-timeline {
		position: relative;
		margin-top: 2rem;
		padding-left: 1rem;
	}

	.notebook-timeline::before {
		position: absolute;
		top: 0.55rem;
		bottom: 0.5rem;
		left: 0.2rem;
		border-left: 1px dashed var(--timeline-line);
		content: "";
	}

	.notebook-timeline__group {
		position: relative;
		padding: 0 0 1.7rem 1rem;
	}

	.notebook-timeline__group::before {
		position: absolute;
		top: 0.45rem;
		left: -1.18rem;
		width: 0.68rem;
		height: 0.68rem;
		border: 0.16rem solid var(--card-bg);
		border-radius: 50%;
		background: var(--record-ink);
		box-shadow: 0 0 0 1px var(--record-ink);
		content: "";
	}

	.notebook-timeline__group > header {
		display: flex;
		align-items: baseline;
		gap: 0.55rem;
		margin-bottom: 0.55rem;
	}

	.notebook-timeline__group > header strong {
		font-size: 1.2rem;
		font-weight: 850;
	}

	.notebook-timeline__group > header h2 {
		margin: 0;
		font-size: 1rem;
		font-weight: 800;
	}

	.notebook-timeline__group > header small {
		color: var(--content-meta);
		font-size: 0.68rem;
	}

	.notebook-timeline__group > div {
		display: grid;
		gap: 0.55rem;
	}

	.notebook-timeline__entry {
		position: relative;
		display: grid;
		grid-template-columns: 3.8rem 3.4rem minmax(0, 1fr) 1.25rem;
		align-items: center;
		gap: 0.65rem;
		min-height: 4rem;
		border: 1px solid var(--notebook-outline);
		border-radius: 0.5rem;
		padding: 0.55rem 0.7rem;
		background: var(--notebook-paper);
		color: inherit;
		transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, box-shadow 150ms ease;
	}

	.notebook-timeline__entry::before {
		position: absolute;
		top: 50%;
		right: calc(100% + 0.55rem);
		width: 1.25rem;
		border-top: 1px dashed var(--timeline-line);
		content: "";
	}

	.notebook-timeline__entry:hover {
		border-color: var(--record-ink);
		background: var(--notebook-paper);
		box-shadow: inset 0 0 0 1px var(--record-ink), 0 0.5rem 1rem rgb(0 0 0 / 7%);
		color: var(--record-ink);
	}

	.notebook-timeline__entry:focus-visible {
		outline: 0.12rem solid var(--record-ink);
		outline-offset: 0.12rem;
	}

	.notebook-timeline__date {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--content-meta);
	}

	.notebook-timeline__date :global(svg) {
		width: 0.9rem;
		height: 0.9rem;
		flex: 0 0 auto;
	}

	.notebook-timeline__date time {
		color: var(--content-meta);
		font-size: 0.72rem;
		font-variant-numeric: tabular-nums;
	}

	.notebook-timeline__type {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.2rem;
		border: 1px solid var(--line-divider);
		border-radius: 0.35rem;
		padding: 0.2rem 0.35rem;
		color: var(--content-meta);
		font-size: 0.66rem;
		text-align: center;
		white-space: nowrap;
	}

	.notebook-timeline__type :global(svg) {
		width: 0.85rem;
		height: 0.85rem;
	}

	.notebook-timeline__content {
		display: grid;
		min-width: 0;
	}

	.notebook-timeline__content strong {
		overflow: hidden;
		font-size: 0.82rem;
		font-weight: 650;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.notebook-timeline__content small {
		overflow: hidden;
		margin-top: 0.15rem;
		color: var(--content-meta);
		font-size: 0.68rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.notebook-timeline__entry :global(svg) {
		width: 1rem;
		height: 1rem;
		color: var(--content-meta);
	}

	.notebook-empty {
		display: grid;
		min-height: 16rem;
		place-items: center;
		align-content: center;
		border: 1px dashed var(--line-divider);
		border-radius: 0.75rem;
		color: var(--content-meta);
		text-align: center;
	}

	.notebook-empty :global(svg) {
		width: 2rem;
		height: 2rem;
		color: var(--ui-icon-color);
	}

	.notebook-empty h2 {
		margin: 0.5rem 0 0;
		color: var(--record-ink);
		font-size: 1rem;
	}

	.notebook-empty p {
		margin: 0.25rem 0 0;
		font-size: 0.75rem;
	}

	@media (max-width: 700px) {
		.notebook-activity__months {
			grid-template-columns: repeat(6, minmax(0, 1fr));
			row-gap: 0.65rem;
		}

		.notebook-timeline {
			padding-left: 0.6rem;
		}

		.notebook-timeline__entry {
			grid-template-columns: 3.1rem 2.3rem minmax(0, 1fr);
			gap: 0.4rem;
		}

		.notebook-timeline__entry > :global(svg) {
			display: none;
		}

		.notebook-timeline__content small {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.notebook-timeline__entry {
			transition: none;
		}
	}
</style>
