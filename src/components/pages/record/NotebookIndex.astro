---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import {
	getNotebookDefinition,
	notebookDefinitions,
} from "@/config/notebookConfig";

const notes = (await getCollection("notebooks"))
	.filter((note) => !note.data.draft)
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const latestNote = notes[0];
const featuredNotebook = latestNote
	? getNotebookDefinition(latestNote.data.notebook)
	: undefined;
const latestNotes = notes.slice(0, 10);

const noteCounts = new Map<string, number>();
for (const note of notes) {
	noteCounts.set(
		note.data.notebook,
		(noteCounts.get(note.data.notebook) || 0) + 1,
	);
}

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat("zh-CN", {
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
		timeZone: "Asia/Shanghai",
	})
		.format(date)
		.replaceAll("/", "-");

const formatShortDate = (date: Date) =>
	new Intl.DateTimeFormat("zh-CN", {
		month: "long",
		day: "numeric",
		timeZone: "Asia/Shanghai",
	}).format(date);
---

<section class="notebook-overview" aria-label="笔记本概览" data-notebook-overview>
	{featuredNotebook && latestNote && (
		<a
			class="notebook-highlight"
			href={`/life/notebooks/${featuredNotebook.slug}/${latestNote.data.slug}/`}
		>
			<span class="notebook-highlight__icon" aria-hidden="true">
				<Icon is:inline name="material-symbols:bookmark-outline-rounded" />
			</span>
			<strong>{latestNote.data.title}</strong>
			<span>{featuredNotebook.title}</span>
			<Icon is:inline name="material-symbols:arrow-forward-rounded" />
		</a>
	)}

	<div class="notebook-stats" aria-label="笔记本统计">
		<span>
			<Icon is:inline name="material-symbols:menu-book-outline-rounded" />
			<strong>{notebookDefinitions.length}</strong> 本
		</span>
		<i aria-hidden="true"></i>
		<span>
			<Icon is:inline name="material-symbols:edit-note-outline-rounded" />
			<strong>{notes.length}</strong> 篇
		</span>
		<i aria-hidden="true"></i>
		{latestNote && (
			<time datetime={latestNote.data.published.toISOString()}>
				<Icon is:inline name="material-symbols:schedule-outline-rounded" />
				{formatDate(latestNote.data.published)}
			</time>
		)}
	</div>

	<section class="notebook-shelf" aria-labelledby="notebook-shelf-title">
		<header class="notebook-section-heading">
			<div>
				<span aria-hidden="true"></span>
				<h2 id="notebook-shelf-title">我的笔记本</h2>
			</div>
			<nav class="notebook-shelf__controls" aria-label="滚动笔记本列表">
				<button type="button" aria-label="向左滚动" data-notebook-scroll="previous">
					<Icon is:inline name="material-symbols:chevron-left-rounded" />
				</button>
				<button type="button" aria-label="向右滚动" data-notebook-scroll="next">
					<Icon is:inline name="material-symbols:chevron-right-rounded" />
				</button>
			</nav>
		</header>

		<div class="notebook-shelf__scroller" data-notebook-shelf tabindex="0">
			{notebookDefinitions.map((notebook) => {
				const notebookNotes = notes.filter(
					(note) => note.data.notebook === notebook.slug,
				);
				const latest = notebookNotes[0];
				const count = noteCounts.get(notebook.slug) || 0;

				return (
					<a
						class="notebook-book"
						href={`/life/notebooks/${notebook.slug}/`}
						aria-label={`${notebook.title}，${count} 篇笔记`}
					>
						<div class="notebook-book__volume">
							<span class="notebook-book__pages" aria-hidden="true"></span>
							<span class="notebook-book__inside" aria-hidden="true">
								<small>JINGYUE NOTES</small>
								<strong>{latest?.data.title || notebook.title}</strong>
								<span>{count > 0 ? `收录 ${count} 篇笔记` : "等待写下第一页"}</span>
							</span>
							<span class="notebook-book__leaf notebook-book__leaf--one" aria-hidden="true">
								<small>RECENT NOTE</small>
								<strong>{latest?.data.title || "等待写下第一页"}</strong>
								<em>{latest ? formatShortDate(latest.data.published) : notebook.title}</em>
							</span>
							<span class="notebook-book__leaf notebook-book__leaf--two" aria-hidden="true">
								<small>COLLECTION</small>
								<strong>{count} 篇笔记</strong>
								<em>{notebook.description}</em>
							</span>
							<span class="notebook-book__leaf notebook-book__leaf--three" aria-hidden="true">
								<small>JINGYUE NOTES</small>
								<strong>{notebook.title}</strong>
								<em>把片刻的想法整理成可以再次翻阅的文字。</em>
							</span>
							<div class="notebook-book__cover">
								<div class="notebook-book__image">
									<ImageWrapper
										src={notebook.cover}
										alt={notebook.title}
										widths={[360, 540]}
										sizes="14rem"
										fadeIn={false}
									/>
								</div>
								<div class="notebook-book__paper">
									<h3>{notebook.title}</h3>
									<p>{notebook.description}</p>
									<footer>
										<span>{count} 篇</span>
										<i aria-hidden="true"></i>
										<time datetime={latest?.data.published.toISOString()}>
											{latest ? formatDate(latest.data.published) : "等待记录"}
										</time>
									</footer>
								</div>
								<span class="notebook-book__spine" aria-hidden="true"></span>
							</div>
						</div>
					</a>
				);
			})}
		</div>
	</section>

	<section class="notebook-recent" aria-labelledby="notebook-recent-title">
		<header class="notebook-section-heading notebook-section-heading--recent">
			<div>
				<Icon is:inline name="material-symbols:history-rounded" aria-hidden="true" />
				<h2 id="notebook-recent-title">最新笔记</h2>
				<p>最近更新，继续加油</p>
			</div>
		</header>

		<div class="notebook-recent__grid">
			{latestNotes.map((note) => {
				const notebook = getNotebookDefinition(note.data.notebook);
				if (!notebook) return null;

				return (
					<article class="notebook-note-card">
						<span class="notebook-note-card__backdrop" aria-hidden="true">
							<ImageWrapper
								src={notebook.cover}
								alt=""
								widths={[480, 720]}
								sizes="36rem"
								fadeIn={false}
							/>
						</span>
						<header>
							<span class="notebook-note-card__avatar" aria-hidden="true">
								<ImageWrapper
									src={notebook.cover}
									alt=""
									widths={[96]}
									sizes="2.35rem"
								/>
							</span>
							<span class="notebook-note-card__identity">
								<strong>{note.data.title}</strong>
								<time datetime={note.data.published.toISOString()}>
									<Icon is:inline name="material-symbols:schedule-outline-rounded" />
									{formatShortDate(note.data.published)}
								</time>
							</span>
						</header>

						<a
							class="notebook-note-card__body"
							href={`/life/notebooks/${notebook.slug}/${note.data.slug}/`}
						>
							<p>{note.data.description}</p>
							<span>{notebook.description}</span>
							<ul aria-label="笔记标签">
								{note.data.tags.slice(0, 3).map((tag) => <li>#{tag}</li>)}
							</ul>
						</a>

						<footer>
							<span>#{notebook.title}</span>
							<a
								href={`/life/notebooks/${notebook.slug}/${note.data.slug}/`}
								aria-label={`阅读${note.data.title}`}
							>
								<Icon is:inline name="material-symbols:arrow-outward-rounded" />
								阅读
							</a>
						</footer>
					</article>
				);
			})}
		</div>
	</section>

	<p class="notebook-footnote">
		<Icon is:inline name="material-symbols:star-outline-rounded" />
		每一页都是成长的足迹
	</p>
</section>

<script is:inline data-swup-ignore-script>
	(function bindNotebookShelf() {
		function syncShelf(shelf) {
			if (!(shelf instanceof HTMLElement)) return;
			var root = shelf.closest("[data-notebook-overview]");
			if (!root) return;
			var maxScroll = Math.max(0, shelf.scrollWidth - shelf.clientWidth);
			var previous = root.querySelector('[data-notebook-scroll="previous"]');
			var next = root.querySelector('[data-notebook-scroll="next"]');
			if (previous instanceof HTMLButtonElement) previous.disabled = shelf.scrollLeft <= 2;
			if (next instanceof HTMLButtonElement) next.disabled = shelf.scrollLeft >= maxScroll - 2;
		}

		function syncAllShelves() {
			document.querySelectorAll("[data-notebook-shelf]").forEach(syncShelf);
		}

		if (!window.__jingyueNotebookShelfBound) {
			window.__jingyueNotebookShelfBound = true;
			document.addEventListener("click", function (event) {
				if (!(event.target instanceof Element)) return;
				var button = event.target.closest("[data-notebook-scroll]");
				if (!(button instanceof HTMLButtonElement)) return;
				var root = button.closest("[data-notebook-overview]");
				var shelf = root && root.querySelector("[data-notebook-shelf]");
				if (!(shelf instanceof HTMLElement)) return;
				var direction = button.dataset.notebookScroll === "previous" ? -1 : 1;
				shelf.scrollBy({
					left: direction * Math.max(240, shelf.clientWidth * 0.82),
					behavior: "smooth",
				});
				window.setTimeout(function () { syncShelf(shelf); }, 420);
			});
			document.addEventListener("scroll", function (event) {
				if (event.target instanceof HTMLElement && event.target.matches("[data-notebook-shelf]")) {
					syncShelf(event.target);
				}
			}, true);
			window.addEventListener("resize", syncAllShelves, { passive: true });
			document.addEventListener("astro:page-load", syncAllShelves);
			document.addEventListener("swup:contentReplaced", syncAllShelves);
		}

		syncAllShelves();
	})();
</script>

<style>
	.notebook-overview {
		--notebook-ink: var(--record-ink, #151515);
		--notebook-muted: var(--record-muted, #747474);
		--notebook-line: color-mix(in srgb, var(--notebook-ink) 17%, transparent);
		--notebook-page-ease: cubic-bezier(0.4, 0, 0.6, 1);
		min-width: 0;
		font-family: var(--font-navbar-title, inherit);
	}

	.notebook-highlight,
	.notebook-stats,
	.notebook-highlight__icon,
	.notebook-section-heading,
	.notebook-section-heading > div,
	.notebook-shelf__controls,
	.notebook-book__paper footer,
	.notebook-note-card header,
	.notebook-note-card footer,
	.notebook-note-card footer a,
	.notebook-note-card__identity time,
	.notebook-footnote {
		display: flex;
		align-items: center;
	}

	.notebook-highlight {
		gap: 0.7rem;
		min-height: 3.65rem;
		border: 1px solid var(--notebook-line);
		border-radius: 0.5rem;
		padding: 0.78rem 1rem;
		color: inherit;
		transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease;
	}

	.notebook-highlight:hover {
		border-color: var(--notebook-ink);
		background: var(--btn-plain-bg-hover);
		transform: translateX(0.15rem);
	}

	.notebook-highlight__icon {
		justify-content: center;
		width: 2rem;
		height: 2rem;
		flex: 0 0 auto;
		border: 1px solid var(--notebook-ink);
		border-radius: 50%;
		background: var(--card-bg);
		color: var(--notebook-ink);
	}

	.notebook-highlight__icon :global(svg) {
		width: 1.1rem;
		height: 1.1rem;
	}

	.notebook-highlight strong {
		overflow: hidden;
		font-size: 1rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.notebook-highlight > span:not(.notebook-highlight__icon) {
		margin-left: auto;
		color: var(--notebook-muted);
		font-size: 0.84rem;
		white-space: nowrap;
	}

	.notebook-highlight > :global(svg) {
		width: 1.15rem;
		height: 1.15rem;
		flex: 0 0 auto;
	}

	.notebook-stats {
		flex-wrap: wrap;
		gap: 0.62rem;
		padding: 0.85rem 0.2rem 0;
		color: var(--notebook-muted);
		font-size: 0.88rem;
		font-variant-numeric: tabular-nums;
	}

	.notebook-stats span,
	.notebook-stats time {
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
	}

	.notebook-stats strong {
		color: var(--notebook-ink);
		font-size: 1rem;
	}

	.notebook-stats i {
		width: 0.2rem;
		height: 0.2rem;
		border-radius: 50%;
		background: currentColor;
	}

	.notebook-stats :global(svg) {
		width: 1.05rem;
		height: 1.05rem;
	}

	.notebook-shelf,
	.notebook-recent {
		margin-top: 2rem;
	}

	.notebook-section-heading {
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.8rem;
	}

	.notebook-section-heading > div {
		gap: 0.55rem;
		min-width: 0;
	}

	.notebook-section-heading > div > span {
		width: 0.22rem;
		height: 1.2rem;
		background: var(--notebook-ink);
	}

	.notebook-section-heading h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 800;
	}

	.notebook-section-heading p {
		margin: 0 0 0 0.25rem;
		color: var(--notebook-muted);
		font-size: 0.84rem;
	}

	.notebook-section-heading--recent > div > :global(svg) {
		width: 1.12rem;
		height: 1.12rem;
	}

	.notebook-shelf__controls {
		gap: 0.35rem;
	}

	.notebook-shelf__controls button {
		display: grid;
		width: 2.35rem;
		height: 2.35rem;
		place-items: center;
		border: 1px solid var(--notebook-line);
		border-radius: 50%;
		background: var(--card-bg);
		color: var(--notebook-ink);
		transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
	}

	.notebook-shelf__controls button:hover:not(:disabled),
	.notebook-shelf__controls button:focus-visible:not(:disabled) {
		border-color: var(--notebook-ink);
		background: var(--notebook-ink);
		color: var(--card-bg);
	}

	.notebook-shelf__controls button:disabled {
		cursor: default;
		opacity: 0.34;
	}

	.notebook-shelf__controls :global(svg) {
		width: 1.2rem;
		height: 1.2rem;
	}

	.notebook-shelf__scroller {
		display: flex;
		gap: 2.25rem;
		overflow-x: auto;
		overflow-y: hidden;
		padding: 1.85rem 0.65rem 1.45rem 1rem;
		scroll-behavior: smooth;
		scroll-padding-inline: 1rem;
		scroll-snap-type: x mandatory;
		scrollbar-color: color-mix(in srgb, var(--notebook-ink) 28%, transparent) transparent;
		scrollbar-width: thin;
	}

	.notebook-shelf__scroller:focus-visible {
		outline: 0.12rem solid var(--notebook-ink);
		outline-offset: 0.18rem;
	}

	.notebook-book {
		position: relative;
		z-index: 1;
		width: 14.75rem;
		flex: 0 0 14.75rem;
		color: inherit;
		cursor: pointer;
		scroll-snap-align: start;
	}

	.notebook-book:hover,
	.notebook-book:focus-visible {
		z-index: 3;
	}

	.notebook-book__volume {
		position: relative;
		height: 18.2rem;
		perspective: 110rem;
		perspective-origin: 36% 50%;
		transform-style: preserve-3d;
		transition: filter 520ms var(--notebook-page-ease);
	}

	.notebook-book:hover .notebook-book__volume,
	.notebook-book:focus-visible .notebook-book__volume {
		filter: drop-shadow(0 0.7rem 0.8rem rgb(0 0 0 / 16%));
	}

	.notebook-book:focus-visible {
		outline: none;
	}

	.notebook-book__cover {
		position: absolute;
		inset: 0 0.18rem 0.34rem 0;
		z-index: 30;
		display: grid;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--notebook-ink) 24%, transparent);
		border-radius: 0.18rem 0.48rem 0.48rem 0.18rem;
		background: var(--card-bg);
		box-shadow: 0 0.45rem 0.9rem rgb(0 0 0 / 11%);
		grid-template-rows: 10.15rem minmax(0, 1fr);
		transform-origin: left center;
		transform-style: preserve-3d;
		transition:
			box-shadow 680ms var(--notebook-page-ease) 160ms,
			transform 820ms var(--notebook-page-ease) 160ms;
	}

	.notebook-book:hover .notebook-book__cover,
	.notebook-book:focus-visible .notebook-book__cover {
		box-shadow: 0.95rem 0.7rem 1.25rem rgb(0 0 0 / 19%);
		transform: translateX(-0.38rem) rotateY(-63deg);
		transition-delay: 0ms;
		transition-duration: 620ms, 720ms;
		transition-timing-function: var(--notebook-page-ease), var(--notebook-page-ease);
	}

	.notebook-book__inside {
		position: absolute;
		inset: 0.34rem 0.2rem 0.55rem 0.72rem;
		z-index: 20;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		border: 1px solid color-mix(in srgb, var(--notebook-ink) 11%, transparent);
		border-radius: 0.08rem 0.72rem 0.62rem 0.06rem;
		padding: 1.1rem 0.75rem 1.2rem 7.35rem;
		background:
			radial-gradient(120% 72% at 96% 50%, rgb(255 255 255 / 48%), transparent 46%),
			linear-gradient(90deg, rgb(0 0 0 / 7%), transparent 18%, transparent 82%, rgb(0 0 0 / 3%)),
			repeating-linear-gradient(to bottom, transparent 0 1.35rem, color-mix(in srgb, var(--notebook-ink) 8%, transparent) 1.38rem),
			color-mix(in srgb, var(--card-bg) 88%, #f4ecdc);
		box-shadow:
			inset 0.28rem 0 0.72rem rgb(0 0 0 / 6%),
			inset -0.18rem 0 0.45rem rgb(255 255 255 / 42%);
		color: var(--notebook-ink);
	}

	.notebook-book__inside small {
		margin-bottom: 0.45rem;
		color: var(--notebook-muted);
		font-size: 0.55rem;
		letter-spacing: 0;
	}

	.notebook-book__inside strong {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		font-size: 0.85rem;
		line-height: 1.45;
	}

	.notebook-book__inside > span {
		margin-top: 0.45rem;
		color: var(--notebook-muted);
		font-size: 0.66rem;
	}

	.notebook-book__leaf {
		position: absolute;
		inset: 0.42rem 0.28rem 0.62rem 0.72rem;
		display: flex;
		flex-direction: column;
		border: 1px solid color-mix(in srgb, var(--notebook-ink) 9%, transparent);
		border-left: 0;
		border-radius: 0.06rem 0.82rem 0.7rem 0.04rem;
		padding: 1rem 0.82rem 0.9rem 7.1rem;
		background:
			radial-gradient(125% 74% at 96% 50%, rgb(255 255 255 / 52%), transparent 45%),
			linear-gradient(100deg, rgb(0 0 0 / 7%), transparent 15%, transparent 80%, rgb(0 0 0 / 3%)),
			repeating-linear-gradient(
				to bottom,
				transparent 0 1.48rem,
				color-mix(in srgb, var(--notebook-ink) 7%, transparent) 1.51rem 1.54rem
			),
			color-mix(in srgb, var(--card-bg) 88%, #f5eddd);
		box-shadow:
			inset 0.24rem 0 0.52rem rgb(0 0 0 / 5%),
			inset -0.2rem 0 0.52rem rgb(255 255 255 / 46%);
		backface-visibility: hidden;
		pointer-events: none;
		transform: rotateY(0deg);
		transform-origin: 0.18rem center;
		transform-style: preserve-3d;
		transition-property: transform, box-shadow;
		transition-duration: 780ms, 660ms;
		transition-timing-function: var(--notebook-page-ease), var(--notebook-page-ease);
		will-change: transform;
	}

	.notebook-book__leaf::after {
		position: absolute;
		inset: 0.3rem 0.08rem 0.3rem auto;
		width: 1rem;
		border-radius: 50%;
		background: linear-gradient(90deg, transparent, rgb(255 255 255 / 42%));
		content: "";
		opacity: 0.62;
		pointer-events: none;
	}

	.notebook-book__leaf small {
		color: var(--notebook-muted);
		font-size: 0.54rem;
		font-weight: 750;
		letter-spacing: 0;
	}

	.notebook-book__leaf strong {
		display: -webkit-box;
		overflow: hidden;
		margin-top: 0.48rem;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		font-size: 0.84rem;
		line-height: 1.45;
	}

	.notebook-book__leaf em {
		display: -webkit-box;
		overflow: hidden;
		margin-top: auto;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		color: var(--notebook-muted);
		font-size: 0.62rem;
		font-style: normal;
		line-height: 1.5;
	}

	.notebook-book__leaf--one {
		z-index: 28;
		transition-delay: 220ms, 220ms;
	}

	.notebook-book__leaf--two {
		z-index: 27;
		inset: 0.46rem 0.31rem 0.66rem 0.74rem;
		transition-delay: 110ms, 110ms;
	}

	.notebook-book__leaf--three {
		z-index: 26;
		inset: 0.5rem 0.34rem 0.7rem 0.76rem;
		transition-delay: 0ms;
	}

	.notebook-book:hover .notebook-book__leaf--one,
	.notebook-book:focus-visible .notebook-book__leaf--one {
		box-shadow: 0.5rem 0.22rem 0.66rem rgb(0 0 0 / 11%);
		transform: translateX(-0.07rem) rotateY(-53deg) skewY(-0.2deg) scaleX(0.992);
		transition-duration: 720ms, 600ms;
