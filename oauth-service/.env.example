# OAuth 服务公开 API 根地址。Vercel 项目名为 jingyue-oauth 时使用下方地址。
OAUTH_SERVICE_URL=https://jingyue-oauth.vercel.app/api

# Firefly 与 Waline 的正式地址，用于限制 OAuth 返回目标，不能带末尾斜杠。
SITE_URL=https://your-blog.example.com
WALINE_SERVER_URL=https://your-waline.example.com

# 至少 32 个随机字符，只用于加密短期 OAuth 状态与身份票据。
OAUTH_SESSION_SECRET=

# QQ 互联网站应用
QQ_ID=
QQ_SECRET=

# 微信开放平台网站应用
WECHAT_ID=
WECHAT_SECRET=

# Google Cloud OAuth 2.0 Web application
GOOGLE_ID=
GOOGLE_SECRET=

# GitHub OAuth App
GITHUB_ID=
GITHUB_SECRET=
